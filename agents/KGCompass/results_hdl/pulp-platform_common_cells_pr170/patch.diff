diff --git a/src/shift_reg.sv b/src/shift_reg.sv
index 7193fbc..1bbc903 100644
--- a/src/shift_reg.sv
+++ b/src/shift_reg.sv
@@ -19,10 +19,14 @@ module shift_reg #(
 )(
     input  logic clk_i,    // Clock
     input  logic rst_ni,   // Asynchronous reset active low
+    input  logic valid_i,   // Data valid, used to enable clock gating of the datapath
     input  dtype d_i,
+    output logic valid_o,
     output dtype d_o
 );
 
+    assign valid_o = valid_i;
+
     // register of depth 0 is a wire
     if (Depth == 0) begin : gen_pass_through
         assign d_o = d_i;
@@ -31,21 +35,27 @@ module shift_reg #(
         always_ff @(posedge clk_i or negedge rst_ni) begin
             if (~rst_ni) begin
                 d_o <= '0;
-            end else begin
+            end else if (valid_i) begin
                 d_o <= d_i;
             end
         end
     // if depth is greater than 1 it becomes a shift register
     end else if (Depth > 1) begin : gen_shift_reg
         dtype [Depth-1:0] reg_d, reg_q;
+        logic [Depth-1:0] valid_d, valid_q;
+
         assign d_o = reg_q[Depth-1];
         assign reg_d = {reg_q[Depth-2:0], d_i};
 
+        assign valid_d = {valid_q[Depth-2:0], valid_i};
+
         always_ff @(posedge clk_i or negedge rst_ni) begin
             if (~rst_ni) begin
-                reg_q <= '0;
-            end else begin
-                reg_q <= reg_d;
+                reg_q   <= '0;
+                valid_q <= '0;
+            end else if (valid_i) begin
+                reg_q   <= reg_d;
+                valid_q <= valid_d;
             end
         end
     end