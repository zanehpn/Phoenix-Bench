234 ) (
235   input  logic                                                    clk_i,
236   input  logic                                                    rst_ni,
237   input  logic                                                    test_i,
238   AXI_BUS.Slave                                                   slv_ports [Cfg.NoSlvPorts-1:0],
239   AXI_BUS.Master                                                  mst_ports [Cfg.NoMstPorts-1:0],
240   input  rule_t [Cfg.NoAddrRules-1:0]                             addr_map_i,
241   input  logic  [Cfg.NoSlvPorts-1:0]                              en_default_mst_port_i,
