242       WTHRU_RWALLOCATE                  : return 4'b1110;
243       WBACK_NOALLOCATE                  : return 4'b0111;
244       WBACK_RALLOCATE                   : return 4'b0111;
245       WBACK_WALLOCATE                   : return 4'b1111;
246       WBACK_RWALLOCATE                  : return 4'b1111;
247     endcase // mtype
248   endfunction
