│                                                                    │
│  if (cycle_cntr_q == div_q - 1) begin                              │
│    clk_gate_state_d = IDLE;                                        │
│  end                                                               │
│                                                                    │
│                                                                    │
│ When div_q == 0, the expression div_q - 1 underflows, so the state │
│ transition condition is never reached in a meaningful way.         │
│                                                                    │
