│                                                                    │
│ The cleanest fix is to emit evt_write_req_o in the stage-1 error   │
│ replay path when the replayed request is a store using write-back  │
│ policy.                                                            │
│                                                                    │
│ That means updating the st1_req_is_error_i branch in               │
│ hpdcache_ctrl_pe.sv so that, before returning the error response,  │
│ it also flags evt_write_req_o for replayed write-back stores.      │
│                                                                    │
│ This is minimal and aligns with the described intended behavior    │
│ without changing the normal cache-hit flow.                        │
│                                                                    │
│ ────────────────────────────────────────────────────────────────── │
│                                                                    │
│                    Phase 2: FIX IMPLEMENTATION                     │
│                                                                    │
│                                                                    │
│  [file]rtl/src/hpdcache_ctrl_pe.sv[/file]                          │
│  [original]                                                        │
│                  else if (st1_req_is_error_i) begin                │
│                      st1_rtab_commit_o = st1_req_rtab_i;           │
│                      st1_rsp_valid_o = st1_req_need_rsp_i;         │
│                      st1_rsp_error_o = st1_req_need_rsp_i;         │
│                  end                                               │
│  [/original]                                                       │
│  [patched]                                                         │
│                  else if (st1_req_is_error_i) begin                │
│                      st1_rtab_commit_o = st1_req_rtab_i;           │
│                      st1_rsp_valid_o = st1_req_need_rsp_i;         │
│                      st1_rsp_error_o = st1_req_need_rsp_i;         │
│                                                                    │
│                      // Performance event: replayed write-back     │
│  store completed via error path                                    │
│                      if (is_store(st1_req_op_i) &&                 │
│                          (st1_req_wr_wb_i || (st1_req_wr_auto_i &  │
│  st1_dir_hit_wback_i))) begin                                      │
│                          evt_write_req_o = 1'b1;                   │
│                      end                                           │
│                  end                                               │
│  [/patched]                                                        │
│  [/file]                                                           │
│                                                                    │
