185         // the number of wait cycles.
186         toggle_ffs_en = 1'b0;
187         if (cycle_cntr_q == div_q - 1) begin
188           clk_gate_state_d = IDLE;
189         end
190       end
191 
192       default: begin
193         clk_gate_state_d = IDLE;
194       end
195     endcase
196   end
