19 //! AXI Package
20 /// Contains all necessary type definitions, constants, and generally useful functions.
21 package axi_pkg;
22   /// AXI Transaction Burst Type.
23   typedef logic [1:0] burst_t;
24   /// AXI Transaction Response Type.
25   typedef logic [1:0] resp_t;
26   /// AXI Transaction Cacheability Type.
27   typedef logic [3:0] cache_t;
28   /// AXI Transaction Protection Type.
29   typedef logic [2:0] prot_t;
30   /// AXI Transaction Quality of Service Type.
31   typedef logic [3:0] qos_t;
32   /// AXI Transaction Region Type.
33   typedef logic [3:0] region_t;
34   /// AXI Transaction Length Type.
35   typedef logic [7:0] len_t;
36   /// AXI Transaction Size Type.
37   typedef logic [2:0] size_t;
38   /// AXI5 Atomic Operation Type.
39   typedef logic [5:0] atop_t; // atomic operations
40   /// AXI5 Non-Secure Address Identifier.
41   typedef logic [3:0] nsaid_t;
42 
43   /// In a fixed burst:
44   /// - The address is the same for every transfer in the burst.
45   /// - The byte lanes that are valid are constant for all beats in the burst.  However, within
46   ///   those byte lanes, the actual bytes that have `wstrb` asserted can differ for each beat in
47   ///   the burst.
48   /// This burst type is used for repeated accesses to the same location such as when loading or
49   /// emptying a FIFO.
50   localparam BURST_FIXED = 2'b00;
51   /// In an incrementing burst, the address for each transfer in the burst is an increment of the
52   /// address for the previous transfer.  The increment value depends on the size of the transfer.
53   /// For example, the address for each transfer in a burst with a size of 4 bytes is the previous
54   /// address plus four.
55   /// This burst type is used for accesses to normal sequential memory.
56   localparam BURST_INCR  = 2'b01;
57   /// A wrapping burst is similar to an incrementing burst, except that the address wraps around to
58   /// a lower address if an upper address limit is reached.
59   /// The following restrictions apply to wrapping bursts:
60   /// - The start address must be aligned to the size of each transfer.
61   /// - The length of the burst must be 2, 4, 8, or 16 transfers.
62   localparam BURST_WRAP  = 2'b10;
63 
64   /// Normal access success.  Indicates that a normal access has been successful. Can also indicate
65   /// that an exclusive access has failed.
66   localparam RESP_OKAY   = 2'b00;
67   /// Exclusive access okay.  Indicates that either the read or write portion of an exclusive access
68   /// has been successful.
69   localparam RESP_EXOKAY = 2'b01;
70   /// Slave error.  Used when the access has reached the slave successfully, but the slave wishes to
71   /// return an error condition to the originating master.
72   localparam RESP_SLVERR = 2'b10;
73   /// Decode error.  Generated, typically by an interconnect component, to indicate that there is no
74   /// slave at the transaction address.
75   localparam RESP_DECERR = 2'b11;
76 
77   /// When this bit is asserted, the interconnect, or any component, can delay the transaction
78   /// reaching its final destination for any number of cycles.
79   localparam CACHE_BUFFERABLE = 4'b0001;
80   /// When HIGH, Modifiable indicates that the characteristics of the transaction can be modified.
81   /// When Modifiable is LOW, the transaction is Non-modifiable.
82   localparam CACHE_MODIFIABLE = 4'b0010;
83   /// When this bit is asserted, read allocation of the transaction is recommended but is not
84   /// mandatory.
85   localparam CACHE_RD_ALLOC   = 4'b0100;
86   /// When this bit is asserted, write allocation of the transaction is recommended but is not
87   /// mandatory.
88   localparam CACHE_WR_ALLOC   = 4'b1000;
89 
90   /// Maximum number of bytes per burst, as specified by `size` (see Table A3-2).
91   function automatic shortint unsigned num_bytes(size_t size);
92     return 1 << size;
93   endfunction
94 
95   /// An overly long address type.
96   /// It lets us define functions that work generically for shorter addresses.  We rely on the
97   /// synthesizer to optimize the unused bits away.
98   typedef logic [127:0] largest_addr_t;
99 
100   /// Aligned address of burst (see A3-51).
101   function automatic largest_addr_t aligned_addr(largest_addr_t addr, size_t size);
102     return (addr >> size) << size;
103   endfunction
104 
105   /// Warp boundary of a `BURST_WRAP` transfer (see A3-51).
106   /// This is the lowest address accessed within a wrapping burst.
107   /// This address is aligned to the size and length of the burst.
108   /// The length of a `BURST_WRAP` has to be 2, 4, 8, or 16 transfers.
109   function automatic largest_addr_t wrap_boundary (largest_addr_t addr, size_t size, len_t len);
110     largest_addr_t wrap_addr;
111 
112     // pragma translate_off
113     `ifndef VERILATOR
114       assume (len == len_t'(4'b1) || len == len_t'(4'b11) || len == len_t'(4'b111) ||
115           len == len_t'(4'b1111)) else
116         $error("AXI BURST_WRAP with not allowed len of: %0h", len);
117     `endif
118     // pragma translate_on
119 
120     // In A3-51 the wrap boundary is defined as:
121     // `Wrap_Boundary = (INT(Start_Address / (Number_Bytes × Burst_Length))) ×
122     //    (Number_Bytes × Burst_Length)`
123     // Whereas the aligned address is defined as:
124     // `Aligned_Address = (INT(Start_Address / Number_Bytes)) × Number_Bytes`
125     // This leads to the wrap boundary using the same calculation as the aligned address, difference
126     // being the additional dependency on the burst length. The addition in the case statement
127     // is equal to the multiplication with `Burst_Length` as a shift (used by `aligned_addr`) is
128     // equivalent with multiplication and division by a power of two, which conveniently are the
129     // only allowed values for `len` of a `BURST_WRAP`.
130     unique case (len)
131       4'b1    : wrap_addr = (addr >> (unsigned'(size) + 1)) << (unsigned'(size) + 1); // multiply `Number_Bytes` by `2`
132       4'b11   : wrap_addr = (addr >> (unsigned'(size) + 2)) << (unsigned'(size) + 2); // multiply `Number_Bytes` by `4`
133       4'b111  : wrap_addr = (addr >> (unsigned'(size) + 3)) << (unsigned'(size) + 3); // multiply `Number_Bytes` by `8`
134       4'b1111 : wrap_addr = (addr >> (unsigned'(size) + 4)) << (unsigned'(size) + 4); // multiply `Number_Bytes` by `16`
135       default : wrap_addr = '0;
136     endcase
137     return wrap_addr;
138   endfunction
139 
140   /// Address of beat (see A3-51).
141   function automatic largest_addr_t
142   beat_addr(largest_addr_t addr, size_t size, len_t len, burst_t burst, shortint unsigned i_beat);
143     largest_addr_t ret_addr = addr;
144     largest_addr_t wrp_bond = '0;
145     if (burst == BURST_WRAP) begin
146       // do not trigger the function if there is no wrapping burst, to prevent assumptions firing
147       wrp_bond = wrap_boundary(addr, size, len);
148     end
149     if (i_beat != 0 && burst != BURST_FIXED) begin
150       // From A3-51:
151       // For an INCR burst, and for a WRAP burst for which the address has not wrapped, this
152       // equation determines the address of any transfer after the first transfer in a burst:
153       // `Address_N = Aligned_Address + (N – 1) × Number_Bytes` (N counts from 1 to len!)
154       ret_addr = aligned_addr(addr, size) + i_beat * num_bytes(size);
155       // From A3-51:
156       // For a WRAP burst, if Address_N = Wrap_Boundary + (Number_Bytes × Burst_Length), then:
157       // * Use this equation for the current transfer:
158       //     `Address_N = Wrap_Boundary`
159       // * Use this equation for any subsequent transfers:
160       //     `Address_N = Start_Address + ((N – 1) × Number_Bytes) – (Number_Bytes × Burst_Length)`
161       // This means that the address calculation of a `BURST_WRAP` fundamentally works the same
162       // as for a `BURST_INC`, the difference is when the calculated address increments
163       // over the wrap threshold, the address wraps around by subtracting the accessed address
164       // space from the normal `BURST_INCR` address. The lower wrap boundary is equivalent to
165       // The wrap trigger condition minus the container size (`num_bytes(size) * (len + 1)`).
166       if (burst == BURST_WRAP && ret_addr >= wrp_bond + (num_bytes(size) * (len + 1))) begin
167         ret_addr = ret_addr - (num_bytes(size) * (len + 1));
168       end
169     end
170     return ret_addr;
171   endfunction
172 
173   /// Index of lowest byte in beat (see A3-51).
174   function automatic shortint unsigned
175   beat_lower_byte(largest_addr_t addr, size_t size, len_t len, burst_t burst,
176       shortint unsigned strobe_width, shortint unsigned i_beat);
177     largest_addr_t _addr = beat_addr(addr, size, len, burst, i_beat);
178     return _addr - (_addr / strobe_width) * strobe_width;
179   endfunction
180 
181   /// Index of highest byte in beat (see A3-51).
182   function automatic shortint unsigned
183   beat_upper_byte(largest_addr_t addr, size_t size, len_t len, burst_t burst,
184       shortint unsigned strobe_width, shortint unsigned i_beat);
185     if (i_beat == 0) begin
186       return aligned_addr(addr, size) + (num_bytes(size) - 1) - (addr / strobe_width) * strobe_width;
187     end else begin
188       return beat_lower_byte(addr, size, len, burst, strobe_width, i_beat) + num_bytes(size) - 1;
189     end
190   endfunction
191 
192   /// Is the bufferable bit set?
193   function automatic logic bufferable(cache_t cache);
194     return |(cache & CACHE_BUFFERABLE);
195   endfunction
196 
197   /// Is the modifiable bit set?
198   function automatic logic modifiable(cache_t cache);
199     return |(cache & CACHE_MODIFIABLE);
200   endfunction
201 
202   /// Memory Type.
203   typedef enum logic [3:0] {
204     DEVICE_NONBUFFERABLE,
205     DEVICE_BUFFERABLE,
206     NORMAL_NONCACHEABLE_NONBUFFERABLE,
207     NORMAL_NONCACHEABLE_BUFFERABLE,
208     WTHRU_NOALLOCATE,
209     WTHRU_RALLOCATE,
210     WTHRU_WALLOCATE,
211     WTHRU_RWALLOCATE,
212     WBACK_NOALLOCATE,
213     WBACK_RALLOCATE,
214     WBACK_WALLOCATE,
215     WBACK_RWALLOCATE
216   } mem_type_t;
217 
218   /// Create an `AR_CACHE` field from a `mem_type_t` type.
219   function automatic logic [3:0] get_arcache(mem_type_t mtype);
220     unique case (mtype)
221       DEVICE_NONBUFFERABLE              : return 4'b0000;
222       DEVICE_BUFFERABLE                 : return 4'b0001;
223       NORMAL_NONCACHEABLE_NONBUFFERABLE : return 4'b0010;
224       NORMAL_NONCACHEABLE_BUFFERABLE    : return 4'b0011;
225       WTHRU_NOALLOCATE                  : return 4'b1010;
226       WTHRU_RALLOCATE                   : return 4'b1110;
227       WTHRU_WALLOCATE                   : return 4'b1010;
228       WTHRU_RWALLOCATE                  : return 4'b1110;
229       WBACK_NOALLOCATE                  : return 4'b1011;
230       WBACK_RALLOCATE                   : return 4'b1111;
231       WBACK_WALLOCATE                   : return 4'b1011;
232       WBACK_RWALLOCATE                  : return 4'b1111;
233     endcase // mtype
234   endfunction
235 
236   /// Create an `AW_CACHE` field from a `mem_type_t` type.
237   function automatic logic [3:0] get_awcache(mem_type_t mtype);
238     unique case (mtype)
239       DEVICE_NONBUFFERABLE              : return 4'b0000;
240       DEVICE_BUFFERABLE                 : return 4'b0001;
241       NORMAL_NONCACHEABLE_NONBUFFERABLE : return 4'b0010;
242       NORMAL_NONCACHEABLE_BUFFERABLE    : return 4'b0011;
243       WTHRU_NOALLOCATE                  : return 4'b0110;
244       WTHRU_RALLOCATE                   : return 4'b0110;
245       WTHRU_WALLOCATE                   : return 4'b1110;
246       WTHRU_RWALLOCATE                  : return 4'b1110;
247       WBACK_NOALLOCATE                  : return 4'b0111;
248       WBACK_RALLOCATE                   : return 4'b0111;
249       WBACK_WALLOCATE                   : return 4'b1111;
250       WBACK_RWALLOCATE                  : return 4'b1111;
251     endcase // mtype
252   endfunction
253 
254   /// RESP precedence: DECERR > SLVERR > OKAY > EXOKAY.  This is not defined in the AXI standard but
255   /// depends on the implementation.  We consistently use the precedence above.  Rationale:
256   /// - EXOKAY means an exclusive access was successful, whereas OKAY means it was not.  Thus, if
257   ///   OKAY and EXOKAY are to be merged, OKAY precedes because the exclusive access was not fully
258   ///   successful.
259   /// - Both DECERR and SLVERR mean (part of) a transaction were unsuccessful, whereas OKAY means an
260   ///   entire transaction was successful.  Thus both DECERR and SLVERR precede OKAY.
261   /// - DECERR means (part of) a transactions could not be routed to a slave component, whereas
262   ///   SLVERR means the transaction reached a slave component but lead to an error condition there.
263   ///   Thus DECERR precedes SLVERR because DECERR happens earlier in the handling of a transaction.
264   function automatic resp_t resp_precedence(resp_t resp_a, resp_t resp_b);
265     unique case (resp_a)
266       RESP_OKAY: begin
267         // Any response except EXOKAY precedes OKAY.
268         if (resp_b == RESP_EXOKAY) begin
269           return resp_a;
270         end else begin
271           return resp_b;
272         end
273       end
274       RESP_EXOKAY: begin
275         // Any response precedes EXOKAY.
276         return resp_b;
277       end
278       RESP_SLVERR: begin
279         // Only DECERR precedes SLVERR.
280         if (resp_b == RESP_DECERR) begin
281           return resp_b;
282         end else begin
283           return resp_a;
284         end
285       end
286       RESP_DECERR: begin
287         // No response precedes DECERR.
288         return resp_a;
289       end
290     endcase
291   endfunction
292 
293   // ATOP[5:0]
294   /// - Sends a single data value with an address.
295   /// - The target swaps the value at the addressed location with the data value that is supplied in
296   ///   the transaction.
297   /// - The original data value at the addressed location is returned.
298   /// - Outbound data size is 1, 2, 4, or 8 bytes.
299   /// - Inbound data size is the same as the outbound data size.
300   localparam ATOP_ATOMICSWAP  = 6'b110000;
301   /// - Sends two data values, the compare value and the swap value, to the addressed location.
302   ///   The compare and swap values are of equal size.
303   /// - The data value at the addressed location is checked against the compare value:
304   ///   - If the values match, the swap value is written to the addressed location.
305   ///   - If the values do not match, the swap value is not written to the addressed location.
306   /// - The original data value at the addressed location is returned.
307   /// - Outbound data size is 2, 4, 8, 16, or 32 bytes.
308   /// - Inbound data size is half of the outbound data size because the outbound data contains both
309   ///   compare and swap values, whereas the inbound data has only the original data value.
</code>
