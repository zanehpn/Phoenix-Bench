│            local_operands[i] = operands_i[i] >>                    │
│  LANE*fpnew_pkg::fp_width(src_fmt_i);                              │
│          end                                                       │
│  [/original]                                                       │
│  [patched]                                                         │
│          for (int unsigned i = 0; i < NUM_OPERANDS; i++) begin     │
