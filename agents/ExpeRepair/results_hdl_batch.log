214   /// Create an `AR_CACHE` field from a `mem_type_t` type.
215   function automatic logic [3:0] get_arcache(mem_type_t mtype);
216     unique case (mtype)
217       DEVICE_NONBUFFERABLE              : return 4'b0000;
218       DEVICE_BUFFERABLE                 : return 4'b0001;
219       NORMAL_NONCACHEABLE_NONBUFFERABLE : return 4'b0010;
220       NORMAL_NONCACHEABLE_BUFFERABLE    : return 4'b0011;
221       WTHRU_NOALLOCATE                  : return 4'b1010;
222       WTHRU_RALLOCATE                   : return 4'b1110;
223       WTHRU_WALLOCATE                   : return 4'b1010;
224       WTHRU_RWALLOCATE                  : return 4'b1110;
225       WBACK_NOALLOCATE                  : return 4'b1011;
226       WBACK_RALLOCATE                   : return 4'b1111;
227       WBACK_WALLOCATE                   : return 4'b1011;
228       WBACK_RWALLOCATE                  : return 4'b1111;
229     endcase // mtype
230   endfunction
