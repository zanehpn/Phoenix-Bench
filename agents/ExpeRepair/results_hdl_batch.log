249   if (!ATOPs) begin : gen_assert_atops_unsupported
250     assume property( @(posedge clk_i) (slv_req_i.aw_valid |-> slv_req_i.aw.atop == '0)) else
251      $fatal(1, "Got ATOP but not configured to support ATOPs!");
