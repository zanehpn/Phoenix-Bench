65   typedef struct packed {
66     logic [WIDTH-1:0]   result;
67     fpnew_pkg::status_t status;
68     TagType             tag;
69   } output_t;
70 
71   // Handshake signals for the blocks
72   logic [NUM_OPGROUPS-1:0] opgrp_in_ready, opgrp_out_valid, opgrp_out_ready, opgrp_ext, opgrp_busy;
73   output_t [NUM_OPGROUPS-1:0] opgrp_outputs;
74 
75   logic [NUM_FORMATS-1:0][NUM_OPERANDS-1:0] is_boxed;
76 
77   // -----------
78   // Input Side
79   // -----------
80   assign in_ready_o = in_valid_i & opgrp_in_ready[fpnew_pkg::get_opgroup(op_i)];
81 
82   // NaN-boxing check
83   for (genvar fmt = 0; fmt < int'(NUM_FORMATS); fmt++) begin : gen_nanbox_check
84     localparam int unsigned FP_WIDTH = fpnew_pkg::fp_width(fpnew_pkg::fp_format_e'(fmt));
85     // NaN boxing is only generated if it's enabled and needed
86     if (Features.EnableNanBox && (FP_WIDTH < WIDTH)) begin : check
87       for (genvar op = 0; op < int'(NUM_OPERANDS); op++) begin : operands
88         assign is_boxed[fmt][op] = (!vectorial_op_i)
89                                    ? operands_i[op][WIDTH-1:FP_WIDTH] == '1
90                                    : 1'b1;
91       end
92     end else begin : no_check
93       assign is_boxed[fmt] = '1;
94     end
95   end
96 
97   // Filter out the mask if not used
98   MaskType simd_mask;
99   assign simd_mask = simd_mask_i | ~{NumLanes{logic'(EnableSIMDMask)}};
100 
101   // -------------------------
102   // Generate Operation Blocks
103   // -------------------------
104   for (genvar opgrp = 0; opgrp < int'(NUM_OPGROUPS); opgrp++) begin : gen_operation_groups
105     localparam int unsigned NUM_OPS = fpnew_pkg::num_operands(fpnew_pkg::opgroup_e'(opgrp));
106 
107     logic in_valid;
108     logic [NUM_FORMATS-1:0][NUM_OPS-1:0] input_boxed;
109 
110     assign in_valid = in_valid_i & (fpnew_pkg::get_opgroup(op_i) == fpnew_pkg::opgroup_e'(opgrp));
111 
112     // slice out input boxing
113     always_comb begin : slice_inputs
114       for (int unsigned fmt = 0; fmt < NUM_FORMATS; fmt++)
115         input_boxed[fmt] = is_boxed[fmt][NUM_OPS-1:0];
116     end
117 
118     fpnew_opgroup_block #(
119       .OpGroup       ( fpnew_pkg::opgroup_e'(opgrp)    ),
120       .Width         ( WIDTH                           ),
121       .EnableVectors ( Features.EnableVectors          ),
