16 // AXI4-Lite Multiplexer: This module multiplexes the AXI4-Lite slave ports down to one master port.
17 //                        The multiplexing happens in a round robin fashion, responses get
18 //                        sent back in order.
19 
20 // register macros
21 `include "common_cells/registers.svh"
22 
23 module axi_lite_mux #(
24   // AXI4-Lite parameter and channel types
25   parameter type          aw_chan_t  = logic, // AW LITE Channel Type
26   parameter type           w_chan_t  = logic, //  W LITE Channel Type
27   parameter type           b_chan_t  = logic, //  B LITE Channel Type
28   parameter type          ar_chan_t  = logic, // AR LITE Channel Type
29   parameter type           r_chan_t  = logic, //  R LITE Channel Type
30   parameter type          axi_req_t  = logic, // AXI4-Lite request type
31   parameter type         axi_resp_t  = logic, // AXI4-Lite response type
32   parameter int unsigned NoSlvPorts  = 32'd0, // Number of slave ports
33   // Maximum number of outstanding transactions per write or read
34   parameter int unsigned MaxTrans    = 32'd0,
35   // If enabled, this multiplexer is purely combinatorial
36   parameter bit          FallThrough = 1'b0,
37   // add spill register on write master port, adds a cycle latency on write channels
38   parameter bit          SpillAw     = 1'b1,
39   parameter bit          SpillW      = 1'b0,
40   parameter bit          SpillB      = 1'b0,
41   // add spill register on read master port, adds a cycle latency on read channels
42   parameter bit          SpillAr     = 1'b1,
43   parameter bit          SpillR      = 1'b0
44 ) (
45   input  logic                       clk_i,    // Clock
46   input  logic                       rst_ni,   // Asynchronous reset active low
47   input  logic                       test_i,   // Test Mode enable
48   // slave ports (AXI4-Lite inputs), connect master modules here
49   input  axi_req_t  [NoSlvPorts-1:0] slv_reqs_i,
50   output axi_resp_t [NoSlvPorts-1:0] slv_resps_o,
51   // master port (AXI4-Lite output), connect slave module here
52   output axi_req_t                   mst_req_o,
53   input  axi_resp_t                  mst_resp_i
54 );
55   // pass through if only one slave port
56   if (NoSlvPorts == 32'h1) begin : gen_no_mux
57     spill_register #(
58       .T       ( aw_chan_t  ),
59       .Bypass  ( ~SpillAw   )
60     ) i_aw_spill_reg (
61       .clk_i   ( clk_i                    ),
62       .rst_ni  ( rst_ni                   ),
63       .valid_i ( slv_reqs_i[0].aw_valid   ),
64       .ready_o ( slv_resps_o[0].aw_ready  ),
65       .data_i  ( slv_reqs_i[0].aw         ),
66       .valid_o ( mst_req_o.aw_valid       ),
67       .ready_i ( mst_resp_i.aw_ready      ),
68       .data_o  ( mst_req_o.aw             )
69     );
70     spill_register #(
71       .T       ( w_chan_t ),
72       .Bypass  ( ~SpillW  )
73     ) i_w_spill_reg (
74       .clk_i   ( clk_i                   ),
75       .rst_ni  ( rst_ni                  ),
76       .valid_i ( slv_reqs_i[0].w_valid   ),
77       .ready_o ( slv_resps_o[0].w_ready  ),
78       .data_i  ( slv_reqs_i[0].w         ),
79       .valid_o ( mst_req_o.w_valid       ),
80       .ready_i ( mst_resp_i.w_ready      ),
81       .data_o  ( mst_req_o.w             )
82     );
83     spill_register #(
84       .T       ( b_chan_t ),
85       .Bypass  ( ~SpillB  )
86     ) i_b_spill_reg (
87       .clk_i   ( clk_i                  ),
88       .rst_ni  ( rst_ni                 ),
89       .valid_i ( mst_resp_i.b_valid     ),
90       .ready_o ( mst_req_o.b_ready      ),
91       .data_i  ( mst_resp_i.b           ),
92       .valid_o ( slv_resps_o[0].b_valid ),
93       .ready_i ( slv_reqs_i[0].b_ready  ),
94       .data_o  ( slv_resps_o[0].b       )
95     );
96     spill_register #(
97       .T       ( ar_chan_t ),
98       .Bypass  ( ~SpillAr  )
99     ) i_ar_spill_reg (
100       .clk_i   ( clk_i                    ),
101       .rst_ni  ( rst_ni                   ),
102       .valid_i ( slv_reqs_i[0].ar_valid   ),
103       .ready_o ( slv_resps_o[0].ar_ready  ),
104       .data_i  ( slv_reqs_i[0].ar         ),
105       .valid_o ( mst_req_o.ar_valid       ),
106       .ready_i ( mst_resp_i.ar_ready      ),
107       .data_o  ( mst_req_o.ar             )
108     );
109     spill_register #(
110       .T       ( r_chan_t ),
111       .Bypass  ( ~SpillR  )
112     ) i_r_spill_reg (
113       .clk_i   ( clk_i                  ),
114       .rst_ni  ( rst_ni                 ),
115       .valid_i ( mst_resp_i.r_valid     ),
116       .ready_o ( mst_req_o.r_ready      ),
117       .data_i  ( mst_resp_i.r           ),
118       .valid_o ( slv_resps_o[0].r_valid ),
119       .ready_i ( slv_reqs_i[0].r_ready  ),
120       .data_o  ( slv_resps_o[0].r       )
121     );
122 
123   // other non degenerate cases
124   end else begin : gen_mux
125     // typedef for the FIFO types
126     typedef logic [$clog2(NoSlvPorts)-1:0] select_t;
127 
128     // input to the AW arbitration tree, unpacked from request struct
129     aw_chan_t [NoSlvPorts-1:0] slv_aw_chans;
130     logic     [NoSlvPorts-1:0] slv_aw_valids, slv_aw_readies;
131 
132     // AW channel arb tree decision
133     select_t  aw_select;
134     aw_chan_t mst_aw_chan;
135     logic     mst_aw_valid, mst_aw_ready;
136 
137     // AW master handshake internal, so that we are able to stall, if w_fifo is full
138     logic     aw_valid,     aw_ready;
139 
140     // FF to lock the AW valid signal, when a new arbitration decision is made the decision
141     // gets pushed into the W FIFO, when it now stalls prevent subsequent pushing
142     // This FF removes AW to W dependency
143     logic     lock_aw_valid_d, lock_aw_valid_q;
144     logic     load_aw_lock;
145 
146     // signals for the FIFO that holds the last switching decision of the AW channel
147     logic     w_fifo_full,  w_fifo_empty;
148     logic     w_fifo_push,  w_fifo_pop;
149 
150     // W channel spill reg
151     select_t  w_select;
152     w_chan_t  mst_w_chan;
153     logic     mst_w_valid,  mst_w_ready;
154 
155     // switching decision for the B response back routing
156     select_t  b_select;
157     // signals for the FIFO that holds the last switching decision of the AW channel
158     logic     b_fifo_full,  b_fifo_empty;
159     logic     /*w_fifo_pop*/b_fifo_pop;
160 
161     // B channel spill reg
162     b_chan_t  mst_b_chan;
163     logic     mst_b_valid,  mst_b_ready;
164 
165     // input to the AR arbitration tree, unpacked from request struct
166     ar_chan_t [NoSlvPorts-1:0] slv_ar_chans;
167     logic     [NoSlvPorts-1:0] slv_ar_valids, slv_ar_readies;
168 
169     // AR channel for when spill is enabled
170     select_t  ar_select;
171     ar_chan_t mst_ar_chan;
172     logic     mst_ar_valid, mst_ar_ready;
173 
174     // AR master handshake internal, so that we are able to stall, if R_fifo is full
175     logic     ar_valid,     ar_ready;
176 
177     // master ID in the r_id
178     select_t  r_select;
179 
180     // signals for the FIFO that holds the last switching decision of the AR channel
181     logic     r_fifo_full,  r_fifo_empty;
182     logic     r_fifo_push,  r_fifo_pop;
183 
184     // R channel spill reg
185     r_chan_t  mst_r_chan;
186     logic     mst_r_valid,  mst_r_ready;
187 
188     //--------------------------------------
189     // AW Channel
190     //--------------------------------------
191     // unpach AW channel from request/response array
192     for (genvar i = 0; i < NoSlvPorts; i++) begin : gen_aw_arb_input
193       assign slv_aw_chans[i]         = slv_reqs_i[i].aw;
194       assign slv_aw_valids[i]        = slv_reqs_i[i].aw_valid;
195       assign slv_resps_o[i].aw_ready = slv_aw_readies[i];
196     end
197     rr_arb_tree #(
198       .NumIn    ( NoSlvPorts ),
199       .DataType ( aw_chan_t  ),
200       .AxiVldRdy( 1'b1       ),
201       .LockIn   ( 1'b1       )
202     ) i_aw_arbiter (
203       .clk_i  ( clk_i          ),
204       .rst_ni ( rst_ni         ),
205       .flush_i( 1'b0           ),
206       .rr_i   ( '0             ),
207       .req_i  ( slv_aw_valids  ),
208       .gnt_o  ( slv_aw_readies ),
209       .data_i ( slv_aw_chans   ),
</code>
