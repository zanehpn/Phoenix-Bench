765   // Branch not-taken address //
766   //////////////////////////////
767 
768   if (BranchPredictor) begin : g_calc_nt_addr
769     assign nt_branch_addr_o = pc_id_i + (instr_is_compressed_i ? 32'd2 : 32'd4);
