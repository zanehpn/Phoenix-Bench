369   flopenr #(2)     IPageTypeMReg (clk, reset, ~StallM, IPageTypeE, IPageTypeM); //PageType (kilo, mega, giga, tera) from IMMU
370   flopenr #(2)     IPageTypeWReg (clk, reset, ~StallW, IPageTypeM, IPageTypeW); //PageType (kilo, mega, giga, tera) from IMMU
371   flopenr #(2)     DPageTypeWReg (clk, reset, ~StallW, DPageTypeM, DPageTypeW); //PageType (kilo, mega, giga, tera) from DMMU
372 
373   flopenr #(P.PPN_BITS) IPPNDReg (clk, reset, ~StallD, IPPNF, IPPND); //Physical Page Number for IMMU
374   flopenr #(P.PPN_BITS) IPPNEReg (clk, reset, ~StallE, IPPND, IPPNE); //Physical Page Number for IMMU
375   flopenr #(P.PPN_BITS) IPPNMReg (clk, reset, ~StallM, IPPNE, IPPNM); //Physical Page Number for IMMU
376   flopenr #(P.PPN_BITS) IPPNWReg (clk, reset, ~StallW, IPPNM, IPPNW); //Physical Page Number for IMMU
377   flopenr #(P.PPN_BITS) DPPNWReg (clk, reset, ~StallW, DPPNM, DPPNW); //Physical Page Number for DMMU
378 
379   flopenr #(1)  ReadAccessWReg    (clk, reset, ~StallW, ReadAccessM, ReadAccessW);   //LoadAccess
380   flopenr #(1)  WriteAccessWReg   (clk, reset, ~StallW, WriteAccessM, WriteAccessW); //StoreAccess
381 
382   flopenr #(1)  ExecuteAccessDReg (clk, reset, ~StallD, ExecuteAccessF, ExecuteAccessD); //Instruction Fetch Access
383   flopenr #(1)  ExecuteAccessEReg (clk, reset, ~StallE, ExecuteAccessD, ExecuteAccessE); //Instruction Fetch Access
384   flopenr #(1)  ExecuteAccessMReg (clk, reset, ~StallM, ExecuteAccessE, ExecuteAccessM); //Instruction Fetch Access
385   flopenr #(1)  ExecuteAccessWReg (clk, reset, ~StallW, ExecuteAccessM, ExecuteAccessW); //Instruction Fetch Access
386 
387   // Initially connecting the writeback stage signals, but may need to use M stage
388   // and gate on ~FlushW.
389 
390 
391   // count the number of valid instructions to provide ordering to RVVI tracer
392   always @(posedge clk)
393     if (reset) order <= 0;
394     else if (valid) order <= order + 1;
395 
396   assign valid  = ((InstrValidW | TrapW) & ~StallW) & ~reset;
397   assign rvvi.clk = clk;
398   assign rvvi.valid[0][0]    = valid;
399   assign rvvi.order[0][0]    = order;
400   assign rvvi.insn[0][0]     = InstrRawW;
401   assign rvvi.pc_rdata[0][0] = PCW;
402   assign rvvi.trap[0][0]     = TrapW;
403   assign rvvi.halt[0][0]     = HaltW;
404   assign rvvi.intr[0][0]     = InterruptW;
405   assign rvvi.mode[0][0]     = PrivilegeModeW;
406   assign rvvi.ixl[0][0]      = PrivilegeModeW == 2'b11 ? 2'b10 :
407                                PrivilegeModeW == 2'b01 ? STATUS_SXL : STATUS_UXL;
408   assign rvvi.pc_wdata[0][0] = ~FlushW ? PCM :
409                                ~FlushM ? PCE :
410                                ~FlushE ? PCD :
411                                ~FlushD ? PCF : PCNextF;
412 
413   for(genvar index = 0; index < NUM_REGS; index += 1) begin
414     assign rvvi.x_wdata[0][0][index] = rf[index];
415     assign rvvi.x_wb[0][0][index]    = rf_wb[index];
416   end
417   for(genvar index = 0; index < 32; index += 1) begin
418     assign rvvi.f_wdata[0][0][index] = frf[index];
419     assign rvvi.f_wb[0][0][index]    = frf_wb[index];
420   end
421 
