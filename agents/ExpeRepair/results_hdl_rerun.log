900   if (WritebackStage) begin : gen_wb_stage
901     // When the writeback stage is present a load/store could be in ID or WB. A Load/store in ID can
902     // see a response before it moves to WB when it is unaligned otherwise we should only see
903     // a response when load/store is in WB.
904     assign outstanding_load_resp  = outstanding_load_wb |
905       (outstanding_load_id  & load_store_unit_i.split_misaligned_access);
906 
907     assign outstanding_store_resp = outstanding_store_wb |
908       (outstanding_store_id & load_store_unit_i.split_misaligned_access);
909 
910     // When writing back the result of a load, the load must have made it to writeback
911     `ASSERT(NoMemRFWriteWithoutPendingLoad, rf_we_lsu |-> outstanding_load_wb, clk_i, !rst_ni)
912   end else begin : gen_no_wb_stage
913     // Without writeback stage only look into whether load or store is in ID to determine if
914     // a response is expected.
915     assign outstanding_load_resp  = outstanding_load_id;
916     assign outstanding_store_resp = outstanding_store_id;
917 
918     `ASSERT(NoMemRFWriteWithoutPendingLoad, rf_we_lsu |-> outstanding_load_id, clk_i, !rst_ni)
919   end
