111   // Compute permissions checks that apply when MSECCFG.MML is unset. This is the original PMP
112   // behaviour before Smepmp was added.
113   function automatic logic orig_perm_check(logic                pmp_cfg_lock,
114                                            ibex_pkg::priv_lvl_e priv_mode,
115                                            logic                permission_check);
116       return (priv_mode == PRIV_LVL_M) ?
117           // For M-mode, any region which matches with the L-bit clear, or with sufficient
118           // access permissions will be allowed
119           (~pmp_cfg_lock | permission_check) :
120           // For other modes, the lock bit doesn't matter
121           permission_check;
122   endfunction
