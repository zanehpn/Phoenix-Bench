129   output logic                 illegal_csr_insn_o,     // access to non-existent CSR,
130                                                         // with wrong priviledge level, or
131                                                         // missing write permissions
132   output logic                 double_fault_seen_o,
133   // Performance Counters
134   input  logic                 instr_ret_i,                 // instr retired in ID/EX stage
135   input  logic                 instr_ret_compressed_i,      // compressed instr retired
136   input  logic                 instr_ret_spec_i,            // speculative instr_ret_i
137   input  logic                 instr_ret_compressed_spec_i, // speculative instr_ret_compressed_i
