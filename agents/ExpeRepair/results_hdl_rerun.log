124   // Access fault determination / prioritization
125   function automatic logic access_fault_check (logic                     csr_pmp_mseccfg_mmwp,
126                                                logic                     csr_pmp_mseccfg_mml,
127                                                ibex_pkg::pmp_req_e       pmp_req_type,
128                                                logic [PMPNumRegions-1:0] match_all,
129                                                ibex_pkg::priv_lvl_e      priv_mode,
130                                                logic [PMPNumRegions-1:0] final_perm_check);
131 
132 
133     // When MSECCFG.MMWP is set default deny always, otherwise allow for M-mode, deny for other
134     // modes. Also deny unmatched for M-mode whe MSECCFG.MML is set and request type is EXEC.
135     logic access_fail = csr_pmp_mseccfg_mmwp | (priv_mode != PRIV_LVL_M) |
136                         (csr_pmp_mseccfg_mml && (pmp_req_type == PMP_ACC_EXEC));
137 
138     // PMP entries are statically prioritized, from 0 to N-1
139     // The lowest-numbered PMP entry which matches an address determines accessibility
140     for (int r = 0; r < PMPNumRegions; r++) begin
141       if (match_all[r]) begin
142         access_fail = ~final_perm_check[r];
143         break;
144       end
145     end
146     return access_fail;
147   endfunction
