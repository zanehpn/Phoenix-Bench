490     end else begin : g_ecc_correction_nr
491       always_ff @(posedge clk_i) begin
492         if (ecc_err_ic1) begin
493           ecc_correction_ways_q  <= ecc_correction_ways_d;
494           ecc_correction_index_q <= lookup_index_ic1;
