423   // Interrupts
424   assign rvvi.m_ext_intr[0][0]   = MExtInt;
425   assign rvvi.s_ext_intr[0][0]   = SExtInt;
426   assign rvvi.m_timer_intr[0][0] = MTimerInt;
427   assign rvvi.m_soft_intr[0][0]  = MSwInt;
428 `endif
