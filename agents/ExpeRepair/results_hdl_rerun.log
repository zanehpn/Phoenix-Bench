641             exc_cause_o = exc_cause_e'({2'b11, mfip_id});
642           end else if (irqs_i.irq_external) begin
643             exc_cause_o = EXC_CAUSE_IRQ_EXTERNAL_M;
644           end else if (irqs_i.irq_software) begin
645             exc_cause_o = EXC_CAUSE_IRQ_SOFTWARE_M;
646           end else begin // irqs_i.irq_timer
647             exc_cause_o = EXC_CAUSE_IRQ_TIMER_M;
648           end
649         end
650 
651         ctrl_fsm_ns = DECODE;
652       end
653 
654       DBG_TAKEN_IF: begin
655         pc_mux_o     = PC_EXC;
656         exc_pc_mux_o = EXC_PC_DBD;
657 
658         // enter debug mode and save PC in IF to dpc
659         // jump to debug exception handler in debug memory
660         flush_id         = 1'b1;
661         pc_set_o         = 1'b1;
662 
663         csr_save_if_o    = 1'b1;
664         debug_csr_save_o = 1'b1;
665 
666         csr_save_cause_o = 1'b1;
667         if (trigger_match_i) begin
668           debug_cause_o = DBG_CAUSE_TRIGGER;
669         end else if (debug_single_step_i) begin
670           debug_cause_o = DBG_CAUSE_STEP;
671         end else begin
672           debug_cause_o = DBG_CAUSE_HALTREQ;
673         end
674 
675         // enter debug mode
676         debug_mode_d = 1'b1;
677 
678         ctrl_fsm_ns  = DECODE;
679       end
680 
681       DBG_TAKEN_ID: begin
682         // enter debug mode and save PC in ID to dpc, used when encountering
683         // 1. EBREAK during debug mode
684         // 2. EBREAK with forced entry into debug mode (ebreakm or ebreaku set).
685         // regular ebreak's go through FLUSH.
686         //
687         // for 1. do not update dcsr and dpc, for 2. do so [Debug Spec v0.13.2, p.39]
688         // jump to debug exception handler in debug memory
689         flush_id      = 1'b1;
690         pc_mux_o      = PC_EXC;
691         pc_set_o      = 1'b1;
692         exc_pc_mux_o  = EXC_PC_DBD;
693 
694         // update dcsr and dpc
695         if (ebreak_into_debug && !debug_mode_q) begin // ebreak with forced entry
696 
697           // dpc (set to the address of the EBREAK, i.e. set to PC in ID stage)
698           csr_save_cause_o = 1'b1;
699           csr_save_id_o    = 1'b1;
700 
701           // dcsr
702           debug_csr_save_o = 1'b1;
703           debug_cause_o    = DBG_CAUSE_EBREAK;
704         end
705 
706         // enter debug mode
707         debug_mode_d = 1'b1;
708 
709         ctrl_fsm_ns  = DECODE;
710       end
711 
712       FLUSH: begin
713         // flush the pipeline
714         halt_if     = 1'b1;
715         flush_id    = 1'b1;
716         ctrl_fsm_ns = DECODE;
717 
718         // As pc_mux and exc_pc_mux can take various values in this state they aren't set early
719         // here.
720 
721         // exceptions: set exception PC, save PC and exception cause
722         // exc_req_lsu is high for one clock cycle only (in DECODE)
723         if (exc_req_q || store_err_q || load_err_q || (cheri_pmode_i & cheri_wb_err_q)) begin
724           pc_set_o         = 1'b1;
725           pc_mux_o         = PC_EXC;
726           exc_pc_mux_o     = debug_mode_q ? EXC_PC_DBG_EXC : EXC_PC_EXC;
727 
728           if (WritebackStage) begin : g_writeback_mepc_save
729             // With the writeback stage present whether an instruction accessing memory will cause
730             // an exception is only known when it is in writeback. So when taking such an exception
731             // epc must come from writeback.
732             csr_save_id_o  = ~(store_err_q | load_err_q | (cheri_pmode_i & cheri_wb_err_q));
733             csr_save_wb_o  = store_err_q | load_err_q | (cheri_pmode_i & cheri_wb_err_q);
734           end else begin : g_no_writeback_mepc_save
735             csr_save_id_o  = 1'b0;
736           end
737 
738           csr_save_cause_o = 1'b1;
739 
740           // Exception/fault prioritisation logic will have set exactly 1 X_prio signal
