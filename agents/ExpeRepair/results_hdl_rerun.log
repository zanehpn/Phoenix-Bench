│ pdata <= { ~P_C,     ~P_B, ~P_RIGHT, ~P_LEFT, ~P_DOWN, ~P_UP};     │
│ 4'b0XX0: pdata <= { ~P_START, ~P_A,   1'b0,     1'b0,  ~P_DOWN,    │
│ ~P_UP}; endcase end[/original] [patched]always @(posedge clk)      │
│ begin priority casex({SMS,JCNT,TH}) 4'b1XXX: pdata <= { ~P_C,      │
