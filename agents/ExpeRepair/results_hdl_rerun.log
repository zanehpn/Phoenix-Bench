228     end
229 
230     // Once the permission checks of the regions are done, decide if the access is
231     // denied by figuring out the matching region and its permission check.
232     assign pmp_req_err_o[c] = access_fault_check(csr_pmp_mseccfg_i.mmwp,
233                                                  csr_pmp_mseccfg_i.mml,
234                                                  pmp_req_type_i[c],
