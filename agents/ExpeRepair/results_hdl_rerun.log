│  -           4: mdata <= MOUSE[2:0] | {P_START,P_C,P_B,P_A};       │
│  -           5: mdata <= dx[7:4];                                  │
│  -           6: mdata <= dx[3:0];                                  │
│  -           7: mdata <= dy[7:4];                                  │
│  -   default: mdata <= dy[3:0];                                    │
│  -   endcase                                                       │
│  -                                                                 │
