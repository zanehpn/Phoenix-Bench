324 
325         .ready_i             ( fetch_ready                ),
326         .valid_o             ( fetch_valid_raw            ),
327         .rdata_o             ( fetch_rdata                ),
328         .addr_o              ( fetch_addr                 ),
329         .err_o               ( fetch_err                  ),
330         .err_plus2_o         ( fetch_err_plus2            ),
331 
332         .instr_req_o         ( instr_req_o                ),
333         .instr_addr_o        ( instr_addr_o               ),
334         .instr_gnt_i         ( instr_gnt_i                ),
335         .instr_rvalid_i      ( instr_rvalid_i             ),
336         .instr_rdata_i       ( instr_rdata_i[31:0]        ),
337         .instr_err_i         ( instr_err                  ),
338 
339         .busy_o              ( prefetch_busy              )
340     );
341     // ICache tieoffs
342     logic                   unused_icen, unused_icinv, unused_scr_key_valid;
343     logic [TagSizeECC-1:0]  unused_tag_ram_input [IC_NUM_WAYS];
344     logic [LineSizeECC-1:0] unused_data_ram_input [IC_NUM_WAYS];
345     assign unused_icen           = icache_enable_i;
346     assign unused_icinv          = icache_inval_i;
347     assign unused_tag_ram_input  = ic_tag_rdata_i;
348     assign unused_data_ram_input = ic_data_rdata_i;
349     assign unused_scr_key_valid  = ic_scr_key_valid_i;
350     assign ic_tag_req_o          = 'b0;
351     assign ic_tag_write_o        = 'b0;
352     assign ic_tag_addr_o         = 'b0;
353     assign ic_tag_wdata_o        = 'b0;
354     assign ic_data_req_o         = 'b0;
355     assign ic_data_write_o       = 'b0;
356     assign ic_data_addr_o        = 'b0;
357     assign ic_data_wdata_o       = 'b0;
358     assign ic_scr_key_req_o      = 'b0;
359     assign icache_ecc_error_o    = 'b0;
360 
361 `ifndef SYNTHESIS
362     // If we don't instantiate an icache and this is a simulation then we have a problem because the
363     // simulator might discard the icache module entirely, including some DPI exports that it
364     // implies. This then causes problems for linking against C++ testbench code that expected them.
365     // As a slightly ugly hack, let's define the DPI functions here (the real versions are defined
366     // in prim_util_get_scramble_params.svh)
367     export "DPI-C" function simutil_get_scramble_key;
368     export "DPI-C" function simutil_get_scramble_nonce;
369     function automatic int simutil_get_scramble_key(output bit [127:0] val);
370       return 0;
371     endfunction
372     function automatic int simutil_get_scramble_nonce(output bit [319:0] nonce);
373       return 0;
374     endfunction
375 `endif
376   end
377 
378   assign unused_fetch_addr_n0 = fetch_addr_n[0];
379 
380   assign branch_req  = pc_set_i | predict_branch_taken;
381 
382   assign pc_if_o     = if_instr_addr;
383   assign if_busy_o   = prefetch_busy;
384 
385   // PMP errors
386   // An error can come from the instruction address, or the next instruction address for unaligned,
387   // uncompressed instructions.
388   assign if_instr_pmp_err = pmp_err_if_i |
389                             (if_instr_addr[2] & ~instr_is_compressed & pmp_err_if_plus2_i);
390 
391   // Combine bus errors and pmp errors
392   assign if_instr_err = if_instr_bus_err | if_instr_pmp_err;
393 
394   // Capture the second half of the address for errors on the second part of an instruction
395   assign if_instr_err_plus2 = ((if_instr_addr[2] & ~instr_is_compressed & pmp_err_if_plus2_i) |
396                                fetch_err_plus2) & ~pmp_err_if_i;
397 
398   // compressed instruction decoding, or more precisely compressed instruction
399   // expander
400   //
401   // since it does not matter where we decompress instructions, we do it here
402   // to ease timing closure
403   ibex_compressed_decoder compressed_decoder_i (
404     .clk_i          (clk_i),
405     .rst_ni         (rst_ni),
406     .valid_i        (fetch_valid & ~fetch_err),
407     .instr_i        (if_instr_rdata),
408     .instr_o        (instr_decompressed),
409     .is_compressed_o(instr_is_compressed),
410     .illegal_instr_o(illegal_c_insn)
411   );
412 
413   // Dummy instruction insertion
414   if (DummyInstructions) begin : gen_dummy_instr
415     // SEC_CM: CTRL_FLOW.UNPREDICTABLE
416     logic        insert_dummy_instr;
417     logic [31:0] dummy_instr_data;
418 
419     ibex_dummy_instr #(
420       .RndCnstLfsrSeed (RndCnstLfsrSeed),
421       .RndCnstLfsrPerm (RndCnstLfsrPerm)
422     ) dummy_instr_i (
423       .clk_i                (clk_i),
424       .rst_ni               (rst_ni),
425       .dummy_instr_en_i     (dummy_instr_en_i),
426       .dummy_instr_mask_i   (dummy_instr_mask_i),
427       .dummy_instr_seed_en_i(dummy_instr_seed_en_i),
428       .dummy_instr_seed_i   (dummy_instr_seed_i),
429       .fetch_valid_i        (fetch_valid),
430       .id_in_ready_i        (id_in_ready_i),
431       .insert_dummy_instr_o (insert_dummy_instr),
432       .dummy_instr_data_o   (dummy_instr_data)
433     );
434 
435     // Mux between actual instructions and dummy instructions
436     assign instr_out               = insert_dummy_instr ? dummy_instr_data : instr_decompressed;
437     assign instr_is_compressed_out = insert_dummy_instr ? 1'b0 : instr_is_compressed;
438     assign illegal_c_instr_out     = insert_dummy_instr ? 1'b0 : illegal_c_insn;
439     assign instr_err_out           = insert_dummy_instr ? 1'b0 : if_instr_err;
440 
441     // Stall the IF stage if we insert a dummy instruction. The dummy will execute between whatever
442     // is currently in the ID stage and whatever is valid from the prefetch buffer this cycle. The
443     // PC of the dummy instruction will match whatever is next from the prefetch buffer.
444     assign stall_dummy_instr = insert_dummy_instr;
445 
446     // Register the dummy instruction indication into the ID stage
447     always_ff @(posedge clk_i or negedge rst_ni) begin
448       if (!rst_ni) begin
449         dummy_instr_id_o <= 1'b0;
450       end else if (if_id_pipe_reg_we) begin
451         dummy_instr_id_o <= insert_dummy_instr;
452       end
453     end
454 
455   end else begin : gen_no_dummy_instr
456     logic        unused_dummy_en;
457     logic [2:0]  unused_dummy_mask;
458     logic        unused_dummy_seed_en;
459     logic [31:0] unused_dummy_seed;
460 
461     assign unused_dummy_en         = dummy_instr_en_i;
462     assign unused_dummy_mask       = dummy_instr_mask_i;
463     assign unused_dummy_seed_en    = dummy_instr_seed_en_i;
464     assign unused_dummy_seed       = dummy_instr_seed_i;
465     assign instr_out               = instr_decompressed;
466     assign instr_is_compressed_out = instr_is_compressed;
467     assign illegal_c_instr_out     = illegal_c_insn;
468     assign instr_err_out           = if_instr_err;
469     assign stall_dummy_instr       = 1'b0;
470     assign dummy_instr_id_o        = 1'b0;
471   end
472 
473   // The ID stage becomes valid as soon as any instruction is registered in the ID stage flops.
474   // Note that the current instruction is squashed by the incoming pc_set_i signal.
475   // Valid is held until it is explicitly cleared (due to an instruction completing or an exception)
476   assign instr_valid_id_d = (if_instr_valid & id_in_ready_i & ~pc_set_i) |
477                             (instr_valid_id_q & ~instr_valid_clear_i);
478   assign instr_new_id_d   = if_instr_valid & id_in_ready_i;
479 
480   always_ff @(posedge clk_i or negedge rst_ni) begin
481     if (!rst_ni) begin
482       instr_valid_id_q <= 1'b0;
483       instr_new_id_q   <= 1'b0;
484     end else begin
485       instr_valid_id_q <= instr_valid_id_d;
486       instr_new_id_q   <= instr_new_id_d;
487     end
488   end
489 
490   assign instr_valid_id_o = instr_valid_id_q;
491   // Signal when a new instruction enters the ID stage (only used for RVFI signalling).
492   assign instr_new_id_o   = instr_new_id_q;
493 
494   // IF-ID pipeline registers, frozen when the ID stage is stalled
495   assign if_id_pipe_reg_we = instr_new_id_d;
496 
497   if (ResetAll) begin : g_instr_rdata_ra
498     always_ff @(posedge clk_i or negedge rst_ni) begin
499       if (!rst_ni) begin
500         instr_rdata_id_o         <= '0;
501         instr_rdata_alu_id_o     <= '0;
502         instr_fetch_err_o        <= '0;
503         instr_fetch_err_plus2_o  <= '0;
504         instr_rdata_c_id_o       <= '0;
505         instr_is_compressed_id_o <= '0;
506         illegal_c_insn_id_o      <= '0;
507         pc_id_o                  <= '0;
508       end else if (if_id_pipe_reg_we) begin
509         instr_rdata_id_o         <= instr_out;
510         // To reduce fan-out and help timing from the instr_rdata_id flops they are replicated.
511         instr_rdata_alu_id_o     <= instr_out;
512         instr_fetch_err_o        <= instr_err_out;
513         instr_fetch_err_plus2_o  <= if_instr_err_plus2;
514         instr_rdata_c_id_o       <= if_instr_rdata[15:0];
515         instr_is_compressed_id_o <= instr_is_compressed_out;
516         illegal_c_insn_id_o      <= illegal_c_instr_out;
517         pc_id_o                  <= pc_if_o;
518       end
519     end
520   end else begin : g_instr_rdata_nr
521     always_ff @(posedge clk_i) begin
522       if (if_id_pipe_reg_we) begin
523         instr_rdata_id_o         <= instr_out;
524         // To reduce fan-out and help timing from the instr_rdata_id flops they are replicated.
525         instr_rdata_alu_id_o     <= instr_out;
526         instr_fetch_err_o        <= instr_err_out;
527         instr_fetch_err_plus2_o  <= if_instr_err_plus2;
528         instr_rdata_c_id_o       <= if_instr_rdata[15:0];
529         instr_is_compressed_id_o <= instr_is_compressed_out;
530         illegal_c_insn_id_o      <= illegal_c_instr_out;
531         pc_id_o                  <= pc_if_o;
532       end
533     end
534   end
535 
536   // Check for expected increments of the PC when security hardening enabled
537   if (PCIncrCheck) begin : g_secure_pc
538     // SEC_CM: PC.CTRL_FLOW.CONSISTENCY
539     logic [31:0] prev_instr_addr_incr, prev_instr_addr_incr_buf;
540     logic        prev_instr_seq_q, prev_instr_seq_d;
541 
542     // Do not check for sequential increase after a branch, jump, exception, interrupt or debug
543     // request, all of which will set branch_req. Also do not check after reset or for dummys.
544     assign prev_instr_seq_d = (prev_instr_seq_q | instr_new_id_d) &
545         ~branch_req & ~if_instr_err & ~stall_dummy_instr;
546 
547     always_ff @(posedge clk_i or negedge rst_ni) begin
548       if (!rst_ni) begin
549         prev_instr_seq_q <= 1'b0;
</code>
<intended_behavior></intended_behavior>, <file>rtl/ibex_prefetch_buffer.sv</file>
