47   input  logic                  instr_fetch_cheri_acc_vio_i,         
48   input  logic                  instr_fetch_cheri_bound_vio_i,         
49 
50   input  logic [31:0]           pc_id_i,                 // instr address
51 
52   // to IF-ID pipeline stage
53   output logic                  instr_valid_clear_o,     // kill instr in IF-ID reg
54   output logic                  id_in_ready_o,           // ID stage is ready for new instr
55   output logic                  controller_run_o,        // Controller is in standard instruction
56                                                          // run mode
57 
58   // to prefetcher
59   output logic                  instr_req_o,             // start fetching instructions
60   output logic                  pc_set_o,                // jump to address set by pc_mux
61   output ibex_pkg::pc_sel_e     pc_mux_o,                // IF stage fetch address selector
62                                                          // (boot, normal, exception...)
63   output logic                  nt_branch_mispredict_o,  // Not-taken branch in ID/EX was
64                                                          // mispredicted (predicted taken)
65   output ibex_pkg::exc_pc_sel_e exc_pc_mux_o,            // IF stage selector for exception PC
66   output ibex_pkg::exc_cause_e  exc_cause_o,             // for IF stage, CSRs
67 
