378   ////////////////
379   // Interrupts //
380   ////////////////
381 
382   // Enter debug mode due to an external debug_req_i or because the core is in
383   // single step mode (dcsr.step == 1). Single step must be qualified with
384   // instruction valid otherwise the core will immediately enter debug mode
385   // due to a recently flushed IF (or a delay in an instruction returning from
386   // memory) before it has had anything to single step.
387   // Also enter debug mode on a trigger match (hardware breakpoint)
388 
389   // Set `do_single_step_q` when a valid instruction is seen outside of debug mode and core is in
390   // single step mode. The first valid instruction on debug mode entry will clear it. Hold its value
391   // when there is no valid instruction so `do_single_step_d` remains asserted until debug mode is
392   // entered.
393   assign do_single_step_d = instr_valid_i ? ~debug_mode_q & debug_single_step_i : do_single_step_q;
394   // Enter debug mode due to:
395   // * external `debug_req_i`
396   // * core in single step mode (dcsr.step == 1).
397   // * trigger match (hardware breakpoint)
398   //
399   // `debug_req_i` and `do_single_step_d` request debug mode with priority. This results in a debug
400   // mode entry even if the controller goes to `FLUSH` in preparation for handling an exception or
401   // interrupt. `trigger_match_i` is not a priority entry into debug mode as it must be ignored
402   // where control flow changes such that the instruction causing the trigger is no longer being
403   // executed.
404   assign enter_debug_mode_prio_d = (debug_req_i | do_single_step_d) & ~debug_mode_q;
405   assign enter_debug_mode = enter_debug_mode_prio_d | (trigger_match_i & ~debug_mode_q);
406 
407   // Set when an ebreak should enter debug mode rather than jump to exception
408   // handler
409   assign ebreak_into_debug = priv_mode_i == PRIV_LVL_M ? debug_ebreakm_i :
410                              priv_mode_i == PRIV_LVL_U ? debug_ebreaku_i :
411                                                          1'b0;
412 
413   // Interrupts including NMI are ignored,
414   // - while in debug mode [Debug Spec v0.13.2, p.39],
415   // - while in NMI mode (nested NMIs are not supported, NMI has highest priority and
416   //   cannot be interrupted by regular interrupts).
417   assign handle_irq = ~debug_mode_q & ~nmi_mode_q &
418       (irq_nm_i | (irq_pending_i & csr_mstatus_mie_i));
419 
420   // generate ID of fast interrupts, highest priority to lowest ID
421   always_comb begin : gen_mfip_id
422     mfip_id = 4'd0;
423 
424     for (int i = 14; i >= 0; i--) begin
425       if (irqs_i.irq_fast[i]) begin
426         mfip_id = i[3:0];
427       end
428     end
429   end
430 
431   assign unused_irq_timer = irqs_i.irq_timer;
432 
433   /////////////////////
434   // Core controller //
435   /////////////////////
436 
437   always_comb begin
438     // Default values
439     instr_req_o           = 1'b1;
440 
441     csr_save_if_o         = 1'b0;
442     csr_save_id_o         = 1'b0;
443     csr_save_wb_o         = 1'b0;
444     csr_restore_mret_id_o = 1'b0;
445     csr_restore_dret_id_o = 1'b0;
446     csr_save_cause_o      = 1'b0;
447     csr_mepcc_clrtag_o    = 1'b0;
448     csr_mtval_o           = '0;
449 
450     // The values of pc_mux and exc_pc_mux are only relevant if pc_set is set. Some of the states
451     // below always set pc_mux and exc_pc_mux but only set pc_set if certain conditions are met.
452     // This avoid having to factor those conditions into the pc_mux and exc_pc_mux select signals
453     // helping timing.
454     pc_mux_o               = PC_BOOT;
455     pc_set_o               = 1'b0;
456     nt_branch_mispredict_o = 1'b0;
457 
458     exc_pc_mux_o           = EXC_PC_IRQ;
459     exc_cause_o            = EXC_CAUSE_INSN_ADDR_MISA; // = 6'h00
460 
461     ctrl_fsm_ns            = ctrl_fsm_cs;
462 
463     ctrl_busy_o            = 1'b1;
464 
465     halt_if                = 1'b0;
466     retain_id              = 1'b0;
467     flush_id               = 1'b0;
468 
469     debug_csr_save_o       = 1'b0;
470     debug_cause_o          = DBG_CAUSE_EBREAK;
471     debug_mode_d           = debug_mode_q;
472     nmi_mode_d             = nmi_mode_q;
473 
474     perf_tbranch_o         = 1'b0;
475     perf_jump_o            = 1'b0;
476 
477     controller_run_o       = 1'b0;
478 
479     unique case (ctrl_fsm_cs)
480       RESET: begin
481         instr_req_o   = 1'b0;
482         pc_mux_o      = PC_BOOT;
483         pc_set_o      = 1'b1;
484         ctrl_fsm_ns   = BOOT_SET;
485       end
486 
487       BOOT_SET: begin
488         // copy boot address to instr fetch address
489         instr_req_o   = 1'b1;
490         pc_mux_o      = PC_BOOT;
491         pc_set_o      = 1'b1;
492 
493         ctrl_fsm_ns = FIRST_FETCH;
494       end
495 
496       WAIT_SLEEP: begin
497         ctrl_busy_o   = 1'b0;
498         instr_req_o   = 1'b0;
499         halt_if       = 1'b1;
500         flush_id      = 1'b1;
501         ctrl_fsm_ns   = SLEEP;
502       end
503 
504       SLEEP: begin
505         // instruction in IF stage is already valid
506         // we begin execution when an interrupt has arrived
507         instr_req_o   = 1'b0;
508         halt_if       = 1'b1;
509         flush_id      = 1'b1;
510 
511         // normal execution flow
512         // in debug mode or single step mode we leave immediately (wfi=nop)
513         if (irq_nm_i || irq_pending_i || debug_req_i || debug_mode_q || debug_single_step_i) begin
514           ctrl_fsm_ns = FIRST_FETCH;
515         end else begin
