20 module pad_io
21 (
22 	input        clk,
23 	input        reset,
24 
25 	input        MODE,
26 	input        SMS,
27 
28 	input        P_UP,
29 	input        P_DOWN,
30 	input        P_LEFT,
31 	input        P_RIGHT,
32 	input        P_A,
33 	input        P_B,
34 	input        P_C,
35 	input        P_START,
36 	input        P_MODE,
37 	input        P_X,
38 	input        P_Y,
39 	input        P_Z,
40 
41 	input        GUN_EN,
42 	input        GUN_TYPE,
43 	input        GUN_SENSOR,
44 	input        GUN_A,
45 	input        GUN_B,
46 	input        GUN_C,
47 	input        GUN_START,
48 
49 	input        MOUSE_EN,
50 	input        MOUSE_FLIPY,
51 	input [24:0] MOUSE,
52 
53 	output [6:0] port_out,
54 	input  [6:0] port_in,
55 	input  [6:0] port_dir
56 );
57 logic [5:0] pdata;
58 reg   [4:0] mdata;
59 wire [6:0] gdata;
60 assign port_out = (~port_dir & port_in) | (port_dir & (GUN_EN ? gdata : MOUSE_EN ? {2'b00,mdata} : {1'b1, pdata}));
61 
62 // GAMEPAD ------------------------------------------------------
63 
64 reg       TH;
65 reg [1:0] JCNT;
66 always @(posedge clk) begin
67 	reg [19:0] JTMR;
68 	reg [10:0] FLTMR;
69 
70 	reg THd;
71 
72 	if(reset) begin
73 		TH   <= 1;
74 		JCNT <= 3;
75 	end
76 	else begin
77 		if(~&FLTMR) FLTMR <= FLTMR + 1'd1;
78 		if(~port_dir[6]) begin
79 			TH <= port_in[6];
80 			FLTMR <= 0;
81 		end
82 		else if(FLTMR == (210*7)) TH <= 1;
83 	
84 		THd <= TH;
85 		if(JTMR > (11600*7) || ~MODE) JCNT <= 0;
86 		if(~THd & TH) JCNT <= JCNT + 1'd1;
87 
88 		if(~&JTMR) JTMR <= JTMR + 1'd1;
89 		if(THd & ~TH) JTMR <= 0;
90 	end
91 end
92 
93 always @(posedge clk) begin
94 	priority casex({SMS,JCNT,TH})
95 		4'b1XXX: pdata <= { ~P_B,     ~P_A, ~P_RIGHT, ~P_LEFT, ~P_DOWN, ~P_UP}; 
96 		4'b0100: pdata <= { ~P_START, ~P_A,   1'b0,     1'b0,    1'b0,   1'b0};
97 		4'b0110: pdata <= { ~P_START, ~P_A,   1'b1,     1'b1,    1'b1,   1'b1};
98 		4'b0111: pdata <= { ~P_C,     ~P_B, ~P_MODE,  ~P_X,    ~P_Y,    ~P_Z };
99 		4'b0XX1: pdata <= { ~P_C,     ~P_B, ~P_RIGHT, ~P_LEFT, ~P_DOWN, ~P_UP};
100 		4'b0XX0: pdata <= { ~P_START, ~P_A,   1'b0,     1'b0,  ~P_DOWN, ~P_UP};
101 	endcase
102 end
103 
104 // MOUSE ------------------------------------------------------
105 
106 reg   [8:0] dx,dy;
107 reg  [10:0] curdx,curdy;
108 wire [10:0] newdx = curdx + {{3{MOUSE[4]}},MOUSE[15:8]};
109 wire [10:0] newdy = MOUSE_FLIPY ? (curdy - {{3{MOUSE[5]}},MOUSE[23:16]}) : (curdy + {{3{MOUSE[5]}},MOUSE[23:16]});
110 
111 wire MTH = port_in[6] & ~port_dir[6];
112 wire MTR = port_in[5] & ~port_dir[5];
113 
114 always @(posedge clk) begin
115 	reg old_stb;
116 	reg mtrd,mtrd2;
117 	reg [3:0] cnt;
118 	reg [8:0] delay;
119 	
120 	if(!delay) begin
121 		if(mtrd ^ MTR) delay <= 1;
122 	end
123 	else begin
124 		if(&delay) mtrd <= MTR;
125 		delay <= delay + 1'd1;
126 	end
127 
128 	mtrd2 <= mtrd;
129 	if(mtrd2 ^ mtrd) begin
130 		if(~&cnt) cnt <= cnt + 1'd1;
131 		if(!cnt) begin
132 			dx <= curdx[8:0];
133 			dy <= curdy[8:0];
134 			curdx <= 0;
135 			curdy <= 0;
136 		end
137 	end
138 	else begin
139 		old_stb <= MOUSE[24];
140 		if(old_stb != MOUSE[24]) begin
141 			if($signed(newdx) > $signed(10'd255)) curdx <= 10'd255;
142 			else if($signed(newdx) < $signed(-10'd255)) curdx <= -10'd255;
143 			else curdx <= newdx;
144 
145 			if($signed(newdy) > $signed(10'd255)) curdy <= 10'd255;
146 			else if($signed(newdy) < $signed(-10'd255)) curdy <= -10'd255;
147 			else curdy <= newdy;
148 		end;
149 	end
150 	
151 	case(cnt)
152 			0: mdata <= 4'b1011;
153 			1: mdata <= 4'b1111;
154 			2: mdata <= 4'b1111;
155 			3: mdata <= {dy[8],dx[8]};
156 			4: mdata <= MOUSE[2:0] | {P_START,P_C,P_B,P_A};
157 			5: mdata <= dx[7:4];
158 			6: mdata <= dx[3:0];
159 			7: mdata <= dy[7:4];
160 	default: mdata <= dy[3:0];
161 	endcase
162 
163 	if(MTH) begin
164 		mdata <= 0;
165 		cnt <= 0;
166 	end
167 
168 	mdata[4] <= mtrd2;
169 end
170 
171 
172 // GUN ------------------------------------------------------
173 
174 reg [5:0] mdo; // Menacer
175 reg [5:0] jdo; // Justifier
176 reg gth;
177 reg jth;
178 reg mth;
179 
180 assign gdata = GUN_TYPE ? {gth & jth, jdo} : {gth & mth, mdo};
181 wire [6:4] gdi   = port_in[6:4] | port_dir[6:4];
182 
183 always @(posedge clk) begin
184 	reg jgunsel; // Justifier blue gun or pink gun.
185 	reg jgunen;  // Justifier gun enabled.
186 	reg mrsten;  // Menacer RST signal level
187 
188 	if(reset) begin
189 		jth  <= 1;
190 		mth  <= 1;
191 	end
192 	else begin
193 		gth <= gdi[6];
194 
195 		// Menacer
196 		mrsten <= gdi[5];
197 		if(mrsten & ~gdi[5] & ~gdi[4]) mth <= 1'b1;
198 		if(GUN_SENSOR) mth <= 1'b0;
199 		mdo <= {2'b00, GUN_START, GUN_C, GUN_A, GUN_B};
200 
201 		// Justifier
202 		jgunsel <= gdi[5];
203 		jgunen <= gdi[4];
204 		jdo[5:3] <= {jgunsel, jgunen, 1'b0};
205 		if(~jgunen) begin
206 			if(~jgunsel) begin
207 				// Blue gun
208 				jdo[2:0] <= {!GUN_SENSOR & gth, !GUN_START,!GUN_A};
209 				if(GUN_SENSOR) jth <= 1'b0;
210 			end
211 			else begin
212 				// Pink gun (2nd player not supported yet)
213 				jdo[2:0] <= {gth, 2'b11};
214 			end
215 		end
216 		else begin
217 			jdo[2:0] <= gth ? 3'b000 : 3'b011;
218 			jth <= 1;
219 		end
220 	end
221 end
222
</code>
