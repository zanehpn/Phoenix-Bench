565   for (genvar fb = 0; fb < NUM_FB; fb++) begin : gen_fbs
566 
567     /////////////////////////////
568     // Fill buffer allocations //
569     /////////////////////////////
570 
571     // Allocate the lowest available buffer
572     if (fb == 0) begin : gen_fb_zero
573       assign fill_alloc_sel[fb] = ~fill_busy_q[fb];
574     end else begin : gen_fb_rest
575       assign fill_alloc_sel[fb] = ~fill_busy_q[fb] & (&fill_busy_q[fb-1:0]);
576     end
577 
578     assign fill_alloc[fb]      = fill_alloc_sel[fb] & fill_new_alloc;
579     assign fill_busy_d[fb]     = fill_alloc[fb] | (fill_busy_q[fb] & ~fill_done[fb]);
580 
581     // Track which other fill buffers are older than this one (for age-based arbitration)
582     // TODO sparsify
583     assign fill_older_d[fb]    = (fill_alloc[fb] ? fill_busy_q : fill_older_q[fb]) & ~fill_done;
584 
585     // A fill buffer can release once all its actions are completed
586                                  // all data written to the cache (unless hit or error)
587     assign fill_done[fb]       = (fill_ram_done_q[fb] | fill_hit_q[fb] | ~fill_cache_q[fb] |
588                                   (|fill_err_q[fb])) &
589                                  // all data output unless stale due to intervening branch
590                                  (fill_out_done[fb] | fill_stale_q[fb] | branch_or_mispredict) &
591                                  // all external requests completed
592                                  fill_rvd_done[fb];
593 
594     /////////////////////////////////
595     // Fill buffer status tracking //
596     /////////////////////////////////
597 
598     // Track staleness (requests become stale when a branch intervenes)
599     assign fill_stale_d[fb]    = fill_busy_q[fb] & (branch_or_mispredict | fill_stale_q[fb]);
600     // Track whether or not this request should allocate to the cache
601     // Any invalidation or disabling of the cache while the buffer is busy will stop allocation
602     assign fill_cache_d[fb]    = (fill_alloc[fb] & fill_cache_new) |
603                                  (fill_cache_q[fb] & fill_busy_q[fb] &
604                                   icache_enable_i & ~icache_inval_i & ~inval_lock);
605     // Record whether the request hit in the cache
606     assign fill_hit_ic1[fb]    = lookup_valid_ic1 & fill_in_ic1[fb] & tag_hit_ic1 & ~ecc_err_ic1;
607     assign fill_hit_d[fb]      = fill_hit_ic1[fb] | (fill_hit_q[fb] & fill_busy_q[fb]);
608 
609     ///////////////////////////////////////////
610     // Fill buffer external request tracking //
611     ///////////////////////////////////////////
612 
613     // Make an external request
614     assign fill_ext_req[fb]    = fill_busy_q[fb] & ~fill_ext_done_d[fb];
615 
616     // Count the number of completed external requests (each line requires IC_LINE_BEATS requests)
617     assign fill_ext_cnt_d[fb]  = fill_alloc[fb] ?
618                                    {{IC_LINE_BEATS_W{1'b0}},fill_spec_done} :
619                                    (fill_ext_cnt_q[fb] + {{IC_LINE_BEATS_W{1'b0}},
620                                                           fill_ext_arb[fb] & instr_gnt_i});
621     // External request must be held until granted
622     assign fill_ext_hold_d[fb] = (fill_alloc[fb] & fill_spec_hold) |
623                                  (fill_ext_arb[fb] & ~instr_gnt_i);
624     // External requests are completed when the counter is filled or when the request is cancelled
625     assign fill_ext_done_d[fb] = (fill_ext_cnt_q[fb][IC_LINE_BEATS_W] |
626                                   // external requests are considered complete if the request hit
627                                   fill_hit_ic1[fb] | fill_hit_q[fb] |
628                                   // cancel if the line won't be cached and, it is stale
629                                   (~fill_cache_q[fb] & (branch_or_mispredict | fill_stale_q[fb] |
630                                    // or we're already at the end of the line
631                                                         fill_ext_beat[fb][IC_LINE_BEATS_W]))) &
632                                  // can't cancel while we are waiting for a grant on the bus
633                                  ~fill_ext_hold_q[fb] & fill_busy_q[fb];
634     // Track whether this fill buffer expects to receive beats of data
635     assign fill_rvd_exp[fb]    = fill_busy_q[fb] & ~fill_rvd_done[fb];
636     // Count the number of rvalid beats received
637     assign fill_rvd_cnt_d[fb]  = fill_alloc[fb] ? '0 :
638                                                   (fill_rvd_cnt_q[fb] +
639                                                    {{IC_LINE_BEATS_W{1'b0}},fill_rvd_arb[fb]});
640     // External data is complete when all issued external requests have received their data
641     assign fill_rvd_done[fb]   = (fill_ext_done_q[fb] & ~fill_ext_hold_q[fb]) &
642                                  (fill_rvd_cnt_q[fb] == fill_ext_cnt_q[fb]);
643 
644     //////////////////////////////////////
645     // Fill buffer data output tracking //
646     //////////////////////////////////////
647 
648     // Send data to the IF stage for requests that are not stale, have not completed their
649     // data output, and have data available to send.
650     // Data is available if:
651     // - The request hit in the cache
652     // - Buffered data is available (fill_rvd_cnt_q is ahead of fill_out_cnt_q)
653     // - Data is available from the bus this cycle (fill_rvd_arb)
654     assign fill_out_req[fb]    = fill_busy_q[fb] & ~fill_stale_q[fb] & ~fill_out_done[fb] &
655                                  (fill_hit_ic1[fb] | fill_hit_q[fb] |
656                                   (fill_rvd_beat[fb] > fill_out_cnt_q[fb]) | fill_rvd_arb[fb]);
657 
658     // Calculate when a beat of data is output. Any ECC error squashes the output that cycle.
659     assign fill_out_grant[fb]  = fill_out_arb[fb] & output_ready;
660 
661     // Count the beats of data output to the IF stage
662     assign fill_out_cnt_d[fb]  = fill_alloc[fb] ? {1'b0,lookup_addr_ic0[IC_LINE_W-1:BUS_W]} :
663                                                   (fill_out_cnt_q[fb] +
664                                                    {{IC_LINE_BEATS_W{1'b0}},fill_out_grant[fb]});
665     // Data output complete when the counter fills
666     assign fill_out_done[fb]   = fill_out_cnt_q[fb][IC_LINE_BEATS_W];
667 
668     //////////////////////////////////////
669     // Fill buffer ram request tracking //
670     //////////////////////////////////////
671 
672                                  // make a fill request once all data beats received
673     assign fill_ram_req[fb]    = fill_busy_q[fb] & fill_rvd_cnt_q[fb][IC_LINE_BEATS_W] &
674                                  // unless the request hit, was non-allocating or got an error
675                                  ~fill_hit_q[fb] & fill_cache_q[fb] & ~|fill_err_q[fb] &
676                                  // or the request was already completed
677                                  ~fill_ram_done_q[fb];
678 
679     // Record when a cache allocation request has been completed
680     assign fill_ram_done_d[fb] = fill_ram_arb[fb] | (fill_ram_done_q[fb] & fill_busy_q[fb]);
681 
682     //////////////////////////////
683     // Fill buffer line offsets //
684     //////////////////////////////
685 
686     // When we branch into the middle of a line, the output count will not start from zero. This
687     // beat count is used to know which incoming rdata beats are relevant.
688     assign fill_ext_beat[fb]   = {1'b0,fill_addr_q[fb][IC_LINE_W-1:BUS_W]} +
689                                  fill_ext_cnt_q[fb][IC_LINE_BEATS_W:0];
690     assign fill_ext_off[fb]    = fill_ext_beat[fb][IC_LINE_BEATS_W-1:0];
691     assign fill_rvd_beat[fb]   = {1'b0,fill_addr_q[fb][IC_LINE_W-1:BUS_W]} +
692                                  fill_rvd_cnt_q[fb][IC_LINE_BEATS_W:0];
693     assign fill_rvd_off[fb]    = fill_rvd_beat[fb][IC_LINE_BEATS_W-1:0];
694 
695     /////////////////////////////
696     // Fill buffer arbitration //
697     /////////////////////////////
698 
699     // Age based arbitration - all these signals are one-hot
700     assign fill_ext_arb[fb]    = fill_ext_req[fb] & ~|(fill_ext_req & fill_older_q[fb]);
701     assign fill_ram_arb[fb]    = fill_ram_req[fb] & fill_grant_ic0 &
702                                  ~|(fill_ram_req & fill_older_q[fb]);
703     // Calculate which fill buffer is the oldest one which still needs to output data to IF
704     assign fill_data_sel[fb]   = ~|(fill_busy_q & ~fill_out_done & ~fill_stale_q &
705                                     fill_older_q[fb]);
706     // Arbitrate the request which has data available to send, and is the oldest outstanding
707     assign fill_out_arb[fb]    = fill_out_req[fb] & fill_data_sel[fb];
708     // Assign incoming rvalid data to the oldest fill buffer expecting it
709     assign fill_rvd_arb[fb]    = instr_rvalid_i & fill_rvd_exp[fb] &
710                                  ~|(fill_rvd_exp & fill_older_q[fb]);
711 
712     /////////////////////////////
713     // Fill buffer data muxing //
714     /////////////////////////////
715 
716     // Output data muxing controls
717     // 1. Select data from the fill buffer data register
718     assign fill_data_reg[fb]   = fill_busy_q[fb] & ~fill_stale_q[fb] &
719                                  ~fill_out_done[fb] & fill_data_sel[fb] &
720     //                           The incoming data is already ahead of the output count
721                                  ((fill_rvd_beat[fb] > fill_out_cnt_q[fb]) | fill_hit_q[fb] |
722                                   (|fill_err_q[fb]));
723     // 2. Select IC1 hit data
724     assign fill_data_hit[fb]   = fill_busy_q[fb] & fill_hit_ic1[fb] & fill_data_sel[fb];
725     // 3. Select incoming instr_rdata_i
726     assign fill_data_rvd[fb]   = fill_busy_q[fb] & fill_rvd_arb[fb] & ~fill_hit_q[fb] &
727                                  ~fill_hit_ic1[fb] & ~fill_stale_q[fb] & ~fill_out_done[fb] &
728     //                           The incoming data lines up with the output count
729                                  (fill_rvd_beat[fb] == fill_out_cnt_q[fb]) & fill_data_sel[fb];
730 
731 
732     ///////////////////////////
733     // Fill buffer registers //
734     ///////////////////////////
735 
736     // Fill buffer general enable
737     assign fill_entry_en[fb]   = fill_alloc[fb] | fill_busy_q[fb];
738 
739     always_ff @(posedge clk_i or negedge rst_ni) begin
740       if (!rst_ni) begin
741         fill_busy_q[fb]     <= 1'b0;
742         fill_older_q[fb]    <= '0;
743         fill_stale_q[fb]    <= 1'b0;
744         fill_cache_q[fb]    <= 1'b0;
745         fill_hit_q[fb]      <= 1'b0;
746         fill_ext_cnt_q[fb]  <= '0;
747         fill_ext_hold_q[fb] <= 1'b0;
748         fill_ext_done_q[fb] <= 1'b0;
749         fill_rvd_cnt_q[fb]  <= '0;
750         fill_ram_done_q[fb] <= 1'b0;
751         fill_out_cnt_q[fb]  <= '0;
752       end else if (fill_entry_en[fb]) begin
753         fill_busy_q[fb]     <= fill_busy_d[fb];
754         fill_older_q[fb]    <= fill_older_d[fb];
755         fill_stale_q[fb]    <= fill_stale_d[fb];
756         fill_cache_q[fb]    <= fill_cache_d[fb];
757         fill_hit_q[fb]      <= fill_hit_d[fb];
758         fill_ext_cnt_q[fb]  <= fill_ext_cnt_d[fb];
759         fill_ext_hold_q[fb] <= fill_ext_hold_d[fb];
760         fill_ext_done_q[fb] <= fill_ext_done_d[fb];
761         fill_rvd_cnt_q[fb]  <= fill_rvd_cnt_d[fb];
762         fill_ram_done_q[fb] <= fill_ram_done_d[fb];
763         fill_out_cnt_q[fb]  <= fill_out_cnt_d[fb];
764       end
765     end
766 
767     ////////////////////////////////////////
768     // Fill buffer address / data storage //
769     ////////////////////////////////////////
</code>
