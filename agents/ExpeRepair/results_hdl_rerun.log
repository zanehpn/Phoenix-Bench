1 ///////////////////////////////////////////
2 // gpio_apb.sv
3 //
4 // Written: David_Harris@hmc.edu 14 January 2021
5 // Modified: bbracker@hmc.edu 15 Apr. 2021
6 //
7 // Purpose: General Purpose I/O peripheral
8 //   See FE310-G002-Manual-v19p05 for specifications
9 //   No interrupts, drive strength, or pull-ups supported
10 //
11 // Documentation: RISC-V System on Chip Design
12 //
13 // A component of the CORE-V-WALLY configurable RISC-V project.
14 // https://github.com/openhwgroup/cvw
15 //
16 // Copyright (C) 2021-23 Harvey Mudd College & Oklahoma State University
17 //
18 // SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
19 //
20 // Licensed under the Solderpad Hardware License v 2.1 (the “License”); you may not use this file
21 // except in compliance with the License, or, at your option, the Apache License version 2.0. You
22 // may obtain a copy of the License at
23 //
24 // https://solderpad.org/licenses/SHL-2.1/
25 //
26 // Unless required by applicable law or agreed to in writing, any work distributed under the
27 // License is distributed on an “AS IS” BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND,
28 // either express or implied. See the License for the specific language governing permissions
29 // and limitations under the License.
30 ////////////////////////////////////////////////////////////////////////////////////////////////
31 
32 module gpio_apb import cvw::*;  #(parameter cvw_t P) (
33   input  logic                PCLK, PRESETn,
34   input  logic                PSEL,
35   input  logic [7:0]          PADDR,
36   input  logic [P.XLEN-1:0]   PWDATA,
37   input  logic [P.XLEN/8-1:0] PSTRB,
38   input  logic                PWRITE,
39   input  logic                PENABLE,
40   output logic [P.XLEN-1:0]   PRDATA,
41   output logic                PREADY,
42   input  logic [31:0]         iof0, iof1,
43   input  logic [31:0]         GPIOIN,
44   output logic [31:0]         GPIOOUT, GPIOEN,
45   output logic                GPIOIntr
46 );
47 
48   // register map
49   localparam GPIO_INPUT_VAL  = 8'h00;
50   localparam GPIO_INPUT_EN   = 8'h04;
51   localparam GPIO_OUTPUT_EN  = 8'h08;
52   localparam GPIO_OUTPUT_VAL = 8'h0C;
53   localparam GPIO_RISE_IE    = 8'h18;
54   localparam GPIO_RISE_IP    = 8'h1C;
55   localparam GPIO_FALL_IE    = 8'h20;
56   localparam GPIO_FALL_IP    = 8'h24;
57   localparam GPIO_HIGH_IE    = 8'h28;
58   localparam GPIO_HIGH_IP    = 8'h2C;
59   localparam GPIO_LOW_IE     = 8'h30;
60   localparam GPIO_LOW_IP     = 8'h34;
61   localparam GPIO_IOF_EN     = 8'h38;
62   localparam GPIO_IOF_SEL    = 8'h3C;
63   localparam GPIO_OUT_XOR    = 8'h40;
64 
65   logic [31:0]                input0d, input1d, input2d, input3d;
66   logic [31:0]                input_val, input_en, output_en, output_val;
67   logic [31:0]                rise_ie, rise_ip, fall_ie, fall_ip, high_ie, high_ip, low_ie, low_ip;
68   logic [31:0]                out_xor, iof_en, iof_sel, iof_out, gpio_out;
69   logic [7:0]                 entry;
70   logic [31:0]                Din, Dout;
71   logic                       memwrite;
72 
73   // APB I/O
74   assign entry    = {PADDR[7:2],2'b00};       // 32-bit word-aligned accesses
75   assign memwrite = PWRITE & PENABLE & PSEL;  // only write in access phase
76   assign PREADY   = 1'b1;                     // GPIO never takes >1 cycle to respond
77 
78   // account for subword read/write circuitry
79   // -- Note GPIO registers are 32 bits no matter what; access them with LW SW.
80   assign Din = PWDATA[31:0];
81   if (P.XLEN == 64) assign PRDATA = {Dout, Dout};
82   else              assign PRDATA = Dout;
83 
84   // register access
85   always_ff @(posedge PCLK)
86     if (~PRESETn) begin
87       input_en  <= '0;
88       output_en <= '0;
89       output_val <= '0;
90       rise_ie    <= '0;
91       rise_ip    <= '0;
92       fall_ie    <= '0;
93       fall_ip    <= '0;
94       high_ie    <= '0;
95       high_ip    <= '0;
96       low_ie     <= '0;
97       low_ip     <= '0;
98       iof_en     <= '0;
99       iof_sel    <= '0;
100       out_xor    <= '0;
101     end else begin     // writes
102         // According to FE310 spec: Once the interrupt is pending, it will remain set until a 1 is written to the *_ip register at that bit.
103         /* verilator lint_off CASEINCOMPLETE */
104       if (memwrite)
105         case(entry)
106           GPIO_INPUT_EN:   input_en   <= Din;
107           GPIO_OUTPUT_EN:  output_en  <= Din;
108           GPIO_OUTPUT_VAL: output_val <= Din;
109           GPIO_RISE_IE:    rise_ie    <= Din;
110           GPIO_FALL_IE:    fall_ie    <= Din;
111           GPIO_HIGH_IE:    high_ie    <= Din;
112           GPIO_LOW_IE:     low_ie     <= Din;
113           GPIO_IOF_EN:     iof_en     <= Din;
114           GPIO_IOF_SEL:    iof_sel    <= Din;
115           GPIO_OUT_XOR:    out_xor    <= Din;
116         endcase
117         /* verilator lint_on CASEINCOMPLETE */
118 
119       // interrupts can be cleared by writing corresponding bits to a register
120       if (memwrite & entry == GPIO_RISE_IP)   rise_ip <= rise_ip & ~Din;
121       else                                    rise_ip <= rise_ip | (input2d & ~input3d);
122       if (memwrite & (entry == GPIO_FALL_IP)) fall_ip <= fall_ip & ~Din;
123       else                                    fall_ip <= fall_ip | (~input2d & input3d);
124       if (memwrite & (entry == GPIO_HIGH_IP)) high_ip <= high_ip & ~Din;
125       else                                    high_ip <= high_ip | input3d;
126       if (memwrite & (entry == GPIO_LOW_IP))  low_ip  <= low_ip  & ~Din;
127       else                                    low_ip  <= low_ip  | ~input3d;
128 
129       case(entry) // flop to sample inputs
130         GPIO_INPUT_VAL:   Dout <= input_val;
131         GPIO_INPUT_EN:    Dout <= input_en;
132         GPIO_OUTPUT_EN:   Dout <= output_en;
133         GPIO_OUTPUT_VAL:  Dout <= output_val;
134         GPIO_RISE_IE:     Dout <= rise_ie;
135         GPIO_RISE_IP:     Dout <= rise_ip;
136         GPIO_FALL_IE:     Dout <= fall_ie;
137         GPIO_FALL_IP:     Dout <= fall_ip;
138         GPIO_HIGH_IE:     Dout <= high_ie;
139         GPIO_HIGH_IP:     Dout <= high_ip;
140         GPIO_LOW_IE:      Dout <= low_ie;
141         GPIO_LOW_IP:      Dout <= low_ip;
142         GPIO_IOF_EN:      Dout <= iof_en;
143         GPIO_IOF_SEL:     Dout <= iof_sel;
144         GPIO_OUT_XOR:     Dout <= out_xor;
145         default:          Dout <= '0;
146       endcase
147     end
148 
149   // chip i/o
150   // connect OUT to IN for loopback testing
151   if (P.GPIO_LOOPBACK_TEST) assign input0d = ((output_en & GPIOOUT) | (~output_en & GPIOIN)) & input_en;
152   else                      assign input0d = GPIOIN & input_en;
153 
154   // synchroninzer for inputs
155   flop #(32) sync1(PCLK,input0d,input1d);
156   flop #(32) sync2(PCLK,input1d,input2d);
157   flop #(32) sync3(PCLK,input2d,input3d);
158   assign input_val = input3d;
159   assign iof_out   = iof_sel & iof1 | ~iof_sel & iof0;        // per-bit mux between iof1 and iof0
160   assign gpio_out  = iof_en & iof_out | ~iof_en & output_val; // per-bit mux between IOF and output_val
161   assign GPIOOUT   = gpio_out ^ out_xor;                      // per-bit flip output polarity
162   assign GPIOEN    = output_en;
163 
164   assign GPIOIntr  = |{(rise_ip & rise_ie),(fall_ip & fall_ie),(high_ip & high_ie),(low_ip & low_ie)};
