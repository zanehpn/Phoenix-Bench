│  -reg  [10:0] curdx,curdy;                                         │
│  -wire [10:0] newdx = curdx + {{3{MOUSE[4]}},MOUSE[15:8]};         │
│  -wire [10:0] newdy = MOUSE_FLIPY ? (curdy -                       │
│  {{3{MOUSE[5]}},MOUSE[23:16]}) : (curdy +                          │
│  {{3{MOUSE[5]}},MOUSE[23:16]});                                    │
