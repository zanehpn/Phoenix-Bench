525         end
526 
527         // handle interrupts
528         if (handle_irq) begin
529           // We are handling an interrupt. Set halt_if to tell IF not to give
530           // us any more instructions before it redirects to the handler, but
531           // don't set flush_id: we must allow this instruction to complete
532           // (since it might have outstanding loads or stores).
533           ctrl_fsm_ns = IRQ_TAKEN;
534           halt_if     = 1'b1;
535         end
536 
537         // enter debug mode
538         if (enter_debug_mode) begin
539           ctrl_fsm_ns = DBG_TAKEN_IF;
540           // Halt IF only for now, ID will be flushed in DBG_TAKEN_IF as the
541           // ID state is needed for correct debug mode entry
542           halt_if     = 1'b1;
543         end
544       end
545 
546       DECODE: begin
547         // normal operating mode of the ID stage, in case of debug and interrupt requests,
548         // priorities are as follows (lower number == higher priority)
549         // 1. currently running (multicycle) instructions and exceptions caused by these
550         // 2. debug requests
551         // 3. interrupt requests
552 
553         controller_run_o = 1'b1;
554 
555         // Set PC mux for branch and jump here to ease timing. Value is only relevant if pc_set_o is
556         // also set. Setting the mux value here avoids factoring in special_req and instr_valid_i
557         // which helps timing.
558         pc_mux_o = PC_JUMP;
559 
560 
561         // Get ready for special instructions, exceptions, pipeline flushes
562         if (special_req) begin
563           // Halt IF but don't flush ID. This leaves a valid instruction in
564           // ID so controller can determine appropriate action in the
565           // FLUSH state.
566           retain_id = 1'b1;
567 
568           // Wait for the writeback stage to either be ready for a new instruction or raise its own
569           // exception before going to FLUSH. If the instruction in writeback raises an exception it
570           // must take priority over any exception from an instruction in ID/EX. Only once the
571           // writeback stage is ready can we be certain that won't happen. Without a writeback
572           // stage ready_wb_i == 1 so the FSM will always go directly to FLUSH.
573 
574           if (ready_wb_i | wb_exception_o) begin
575             ctrl_fsm_ns = FLUSH;
576           end
577         end
578 
579         if (branch_set_i || jump_set_i || (cheri_pmode_i & cheri_branch_req_i)) begin
580           // Only set the PC if the branch predictor hasn't already done the branch for us
581           pc_set_o       = BranchPredictor ? ~instr_bp_taken_i : 1'b1;
582 
583           perf_tbranch_o = branch_set_i;
584           perf_jump_o    = jump_set_i;
585         end
586 
587         if (BranchPredictor) begin
588           if (instr_bp_taken_i & branch_not_set_i) begin
589             // If the instruction is a branch that was predicted to be taken but was not taken
590             // signal a mispredict.
591             nt_branch_mispredict_o = 1'b1;
592           end
593         end
594 
595         // If entering debug mode or handling an IRQ the core needs to wait until any instruction in
596         // ID or WB has finished executing. Stall IF during that time.
597         if ((enter_debug_mode || handle_irq) && (stall || id_wb_pending)) begin
598           halt_if = 1'b1;
599         end
600 
601         if (!stall && !special_req && !id_wb_pending) begin
602           if (enter_debug_mode) begin
603             // enter debug mode
604             ctrl_fsm_ns = DBG_TAKEN_IF;
605             // Halt IF only for now, ID will be flushed in DBG_TAKEN_IF as the
606             // ID state is needed for correct debug mode entry
607             halt_if     = 1'b1;
608           end else if (handle_irq) begin
609             // handle interrupt (not in debug mode)
610             ctrl_fsm_ns = IRQ_TAKEN;
611             // We are handling an interrupt (not in debug mode). Set halt_if to
612             // tell IF not to give us any more instructions before it redirects
613             // to the handler, but don't set flush_id: we must allow this
614             // instruction to complete (since it might have outstanding loads
615             // or stores).
616             halt_if     = 1'b1;
617           end
618         end
619 
620       end // DECODE
621 
622       IRQ_TAKEN: begin
623         pc_mux_o     = PC_EXC;
624         exc_pc_mux_o = EXC_PC_IRQ;
625 
626         if (handle_irq) begin
627           pc_set_o         = 1'b1;
628 
629           csr_save_if_o    = 1'b1;
630           csr_save_cause_o = 1'b1;
631 
632           // interrupt priorities according to Privileged Spec v1.11 p.31
633           if (irq_nm_i && !nmi_mode_q) begin
634             exc_cause_o = EXC_CAUSE_IRQ_NM;
635             nmi_mode_d  = 1'b1; // enter NMI mode
636           end else if (irqs_i.irq_fast != 15'b0) begin
637             // generate exception cause ID from fast interrupt ID:
638             // - first bit distinguishes interrupts from exceptions,
639             // - second bit adds 16 to fast interrupt ID
