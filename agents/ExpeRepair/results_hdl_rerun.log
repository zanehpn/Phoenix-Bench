136   // FSM state encoding
137   //typedef enum logic [3:0] {
138   //  RESET, BOOT_SET, WAIT_SLEEP, SLEEP, FIRST_FETCH, DECODE, FLUSH,
139   //  IRQ_TAKEN, DBG_TAKEN_IF, DBG_TAKEN_ID
140   //} ctrl_fsm_e;
