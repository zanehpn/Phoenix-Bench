410       CSR_MCAUSE: csr_rdata_int = {mcause_q[5], 26'b0, mcause_q[4:0]};
411 
412       // mtval: trap value
413       CSR_MTVAL: csr_rdata_int = mtval_q;
414 
415       // mip: interrupt pending
416       CSR_MIP: begin
417         csr_rdata_int                                     = '0;
418         csr_rdata_int[CSR_MSIX_BIT]                       = mip.irq_software;
419         csr_rdata_int[CSR_MTIX_BIT]                       = mip.irq_timer;
420         csr_rdata_int[CSR_MEIX_BIT]                       = mip.irq_external;
421         csr_rdata_int[CSR_MFIX_BIT_HIGH:CSR_MFIX_BIT_LOW] = mip.irq_fast;
422       end
423 
424       CSR_MSECCFG: begin
425         if (PMPEnable) begin
426           csr_rdata_int                       = '0;
427           csr_rdata_int[CSR_MSECCFG_MML_BIT]  = pmp_mseccfg.mml;
428           csr_rdata_int[CSR_MSECCFG_MMWP_BIT] = pmp_mseccfg.mmwp;
429           csr_rdata_int[CSR_MSECCFG_RLB_BIT]  = pmp_mseccfg.rlb;
430         end else begin
431           illegal_csr = 1'b1;
432         end
433       end
434 
435       CSR_MSECCFGH: begin
436         if (PMPEnable) begin
437           csr_rdata_int = '0;
438         end else begin
439           illegal_csr = 1'b1;
440         end
441       end
442 
443       // PMP registers
444       CSR_PMPCFG0:   csr_rdata_int = {pmp_cfg_rdata[3],  pmp_cfg_rdata[2],
445                                       pmp_cfg_rdata[1],  pmp_cfg_rdata[0]};
