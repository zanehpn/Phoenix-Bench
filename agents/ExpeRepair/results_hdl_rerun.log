141   input  logic                 branch_taken_i,              // branch was taken
142   input  logic                 mem_load_i,                  // load from memory in this cycle
143   input  logic                 mem_store_i,                 // store to memory in this cycle
144   input  logic                 dside_wait_i,                // core waiting for the dside
145   input  logic                 mul_wait_i,                  // core waiting for multiply
146   input  logic                 div_wait_i,                   // core waiting for divide
147 
148   input  logic                 cheri_branch_req_i,
149   input  logic [31:0]          cheri_branch_target_i,
150   input  pcc_cap_t             pcc_cap_i,
151   output pcc_cap_t             pcc_cap_o,
152 
153   output logic                 csr_dbg_tclr_fault_o,
154   output logic                 cheri_fatal_err_o
155   );
