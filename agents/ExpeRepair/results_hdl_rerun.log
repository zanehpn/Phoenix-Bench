150   // Access checking
151   // ---------------
152 
153   for (genvar r = 0; r < PMPNumRegions; r++) begin : g_addr_exp
154     // Start address for TOR matching
155     if (r == 0) begin : g_entry0
156       assign region_start_addr[r] = (csr_pmp_cfg_i[r].mode == PMP_MODE_TOR) ? 34'h000000000 :
157                                                                               csr_pmp_addr_i[r];
158     end else begin : g_oth
159       assign region_start_addr[r] = (csr_pmp_cfg_i[r].mode == PMP_MODE_TOR) ? csr_pmp_addr_i[r-1] :
160                                                                               csr_pmp_addr_i[r];
161     end
162     // Address mask for NA matching
163     for (genvar b = PMPGranularity + 2; b < 34; b++) begin : g_bitmask
164       if (b == 2) begin : g_bit0
165         // Always mask bit 2 for NAPOT
166         assign region_addr_mask[r][b] = (csr_pmp_cfg_i[r].mode != PMP_MODE_NAPOT);
167       end else begin : g_others
168         // We will mask this bit if it is within the programmed granule
169         // i.e. addr = yyyy 0111
170         //                  ^
171         //                  | This bit pos is the top of the mask, all lower bits set
172         // thus mask = 1111 0000
173         if (PMPGranularity == 0) begin : g_region_addr_mask_zero_granularity
174           assign region_addr_mask[r][b] = (csr_pmp_cfg_i[r].mode != PMP_MODE_NAPOT) |
175                                           ~&csr_pmp_addr_i[r][b-1:2];
176         end else begin : g_region_addr_mask_other_granularity
177           assign region_addr_mask[r][b] = (csr_pmp_cfg_i[r].mode != PMP_MODE_NAPOT) |
178                                           ~&csr_pmp_addr_i[r][b-1:PMPGranularity+1];
179         end
180       end
181     end
182   end
183 
184   for (genvar c = 0; c < PMPNumChan; c++) begin : g_access_check
185     for (genvar r = 0; r < PMPNumRegions; r++) begin : g_regions
186       // Comparators are sized according to granularity
187       assign region_match_eq[c][r] = (pmp_req_addr_i[c][33:PMPGranularity+2] &
188                                       region_addr_mask[r]) ==
189                                      (region_start_addr[r][33:PMPGranularity+2] &
190                                       region_addr_mask[r]);
191       assign region_match_gt[c][r] = pmp_req_addr_i[c][33:PMPGranularity+2] >
192                                      region_start_addr[r][33:PMPGranularity+2];
193       assign region_match_lt[c][r] = pmp_req_addr_i[c][33:PMPGranularity+2] <
194                                      csr_pmp_addr_i[r][33:PMPGranularity+2];
195 
196       always_comb begin
197         region_match_all[c][r] = 1'b0;
198         unique case (csr_pmp_cfg_i[r].mode)
199           PMP_MODE_OFF:   region_match_all[c][r] = 1'b0;
200           PMP_MODE_NA4:   region_match_all[c][r] = region_match_eq[c][r];
201           PMP_MODE_NAPOT: region_match_all[c][r] = region_match_eq[c][r];
202           PMP_MODE_TOR: begin
203             region_match_all[c][r] = (region_match_eq[c][r] | region_match_gt[c][r]) &
204                                      region_match_lt[c][r];
205           end
206           default:        region_match_all[c][r] = 1'b0;
207         endcase
208       end
209 
210       // Basic permission check compares cfg register only.
211       assign region_basic_perm_check[c][r] =
212           ((pmp_req_type_i[c] == PMP_ACC_EXEC)  & csr_pmp_cfg_i[r].exec) |
213           ((pmp_req_type_i[c] == PMP_ACC_WRITE) & csr_pmp_cfg_i[r].write) |
214           ((pmp_req_type_i[c] == PMP_ACC_READ)  & csr_pmp_cfg_i[r].read);
215 
216       // Check specific required permissions since the behaviour is different
217       // between Smepmp implementation and original PMP.
218       assign region_perm_check[c][r] = perm_check_wrapper(csr_pmp_mseccfg_i.mml,
219                                                           csr_pmp_cfg_i[r],
220                                                           pmp_req_type_i[c],
221                                                           priv_mode_i[c],
222                                                           region_basic_perm_check[c][r]);
223 
224       // Address bits below PMP granularity (which starts at 4 byte) are deliberately unused.
