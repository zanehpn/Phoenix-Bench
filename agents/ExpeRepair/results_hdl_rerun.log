85   input  logic                  irq_pending_i,           // interrupt request pending
86   input  ibex_pkg::irqs_t       irqs_i,                  // interrupt requests qualified with
87                                                          // mie CSR
88   input  logic                  irq_nm_i,                // non-maskeable interrupt
89   output logic                  nmi_mode_o,              // core executing NMI handler
90 
91   // debug signals
92   input  logic                  debug_req_i,
93   output ibex_pkg::dbg_cause_e  debug_cause_o,
94   output logic                  debug_csr_save_o,
95   output logic                  debug_mode_o,
96   input  logic                  debug_single_step_i,
97   input  logic                  debug_ebreakm_i,
98   input  logic                  debug_ebreaku_i,
99   input  logic                  trigger_match_i,
100 
101   output logic                  csr_save_if_o,
102   output logic                  csr_save_id_o,
103   output logic                  csr_save_wb_o,
104   output logic                  csr_restore_mret_id_o,
105   output logic                  csr_restore_dret_id_o,
106   output logic                  csr_save_cause_o,
107   output logic                  csr_mepcc_clrtag_o,
