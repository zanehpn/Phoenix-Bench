412       logic [1:0]  tag_err_bank_ic1;
413       logic [27:0] tag_rdata_padded_ic1;
414 
415       // Expand the tag rdata with extra padding if the tag size is less than the maximum
416       assign tag_rdata_padded_ic1 = {tag_rdata_ic1[way][TagSizeECC-1-:6],
417                                      {22-IC_TAG_SIZE{1'b0}},
418                                      tag_rdata_ic1[way][IC_TAG_SIZE-1:0]};
