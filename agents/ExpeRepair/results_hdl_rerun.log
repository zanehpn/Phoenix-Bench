747                 exc_cause_o = EXC_CAUSE_CHERI_FAULT;
748                 csr_mtval_o = {21'h0, 1'b1, 5'h0, 5'h1};   // s=1, cap_idx=0
749                 csr_mepcc_clrtag_o = 1'b1;
750               end else begin                            // ext memory error
751                 exc_cause_o = EXC_CAUSE_INSTR_ACCESS_FAULT;
752                 csr_mtval_o = instr_fetch_err_plus2_i ? (pc_id_i + 32'd2) : pc_id_i;
753               end
754             end
755             illegal_insn_prio: begin
756               exc_cause_o = EXC_CAUSE_ILLEGAL_INSN;
757               csr_mtval_o = (CHERIoTEn & cheri_pmode_i) ? 32'h0 : 
758                             (instr_is_compressed_i ? {16'b0, instr_compressed_i} : instr_i);
759             end
760             ecall_insn_prio: begin
761               exc_cause_o = (priv_mode_i == PRIV_LVL_M) ? EXC_CAUSE_ECALL_MMODE :
762                                                           EXC_CAUSE_ECALL_UMODE;
763             end
