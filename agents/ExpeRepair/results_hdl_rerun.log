157   import ibex_pkg::*;
158 
159   localparam int unsigned RV32BEnabled = (RV32B == RV32BNone) ? 0 : 1;
160   localparam int unsigned RV32MEnabled = (RV32M == RV32MNone) ? 0 : 1;
161   localparam int unsigned PMPAddrWidth = (PMPGranularity > 0) ? 33 - PMPGranularity : 32;
162 
163   // misa
164   localparam logic [31:0] MISA_VALUE =
165       (0                 <<  0)  // A - Atomic Instructions extension
166     | (RV32BEnabled      <<  1)  // B - Bit-Manipulation extension
167     | (1                 <<  2)  // C - Compressed extension
168     | (0                 <<  3)  // D - Double precision floating-point extension
169     | (32'(RV32E)        <<  4)  // E - RV32E base ISA
170     | (0                 <<  5)  // F - Single precision floating-point extension
171     | (32'(!RV32E)       <<  8)  // I - RV32I/64I/128I base ISA
172     | (RV32MEnabled      << 12)  // M - Integer Multiply/Divide extension
173     | (0                 << 13)  // N - User level interrupts supported
174     | (0                 << 18)  // S - Supervisor mode implemented
175     | (1                 << 20)  // U - User mode implemented
176     | (32'(CHERIoTEn)    << 23)  // X - Non-standard extensions present
177     | (32'(CSR_MISA_MXL) << 30); // M-XLEN
178 
