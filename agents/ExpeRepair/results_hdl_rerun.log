891 
892   logic outstanding_load_id;
893   logic outstanding_store_id;
894 
895   assign outstanding_load_id  = id_stage_i.instr_executing & id_stage_i.lsu_req_dec &
896                                 ~id_stage_i.lsu_we;
897   assign outstanding_store_id = id_stage_i.instr_executing & id_stage_i.lsu_req_dec &
898                                 id_stage_i.lsu_we;
