346   // PMP errors
347   // An error can come from the instruction address, or the next instruction address for unaligned,
348   // uncompressed instructions.
349   assign if_instr_pmp_err = pmp_err_if_i |
350                             (if_instr_addr[1] & ~instr_is_compressed & pmp_err_if_plus2_i);
351 
352   // Combine bus errors and pmp errors
353   assign if_instr_err = if_instr_bus_err | if_instr_pmp_err | cheri_acc_vio | cheri_bound_vio;
354 
355   // Capture the second half of the address for errors on the second part of an instruction
356   // LEC_NOT_COMPATIBLE
357   assign if_instr_err_plus2 = ((if_instr_addr[1] & ~instr_is_compressed & pmp_err_if_plus2_i) |
358                                fetch_err_plus2) & ~pmp_err_if_i;
359 
360   // pre-calculate headroom to improve memory read timing
361   logic [33:0] instr_hdrm;
362   logic        hdrm_ge4, hdrm_ge2, hdrm_ok, base_ok;
363   logic        allow_all;
364 
365   // allow_all is used to permit the pc wraparound case (pc = 0xffff_fffe, uncompressed instruction)
366   // - in this case fetch should be allowed if pcc bounds is specified as the entire 32-bit space. 
367   // - If we don't treat this as a specail case the fetch would be erred since headroom < 4
368   assign allow_all  = (pcc_cap_i.base32==0) & (pcc_cap_i.top33==33'h1_0000_0000);
369 
370   assign instr_hdrm = {1'b0, pcc_cap_i.top33} - {2'b00, if_instr_addr};
371   assign hdrm_ge4   = (|instr_hdrm[32:2]) & ~instr_hdrm[33];     // >= 4
372   assign hdrm_ge2   = (|instr_hdrm[32:1]) & ~instr_hdrm[33];     // >= 2
373   assign hdrm_ok    = allow_all || (instr_is_compressed ? hdrm_ge2 : hdrm_ge4);
374   assign base_ok    = ~(if_instr_addr < pcc_cap_i.base32);
375 
376   // only issue cheri_acc_vio on valid fetches
377   assign cheri_bound_vio = CHERIoTEn & cheri_pmode_i & ~debug_mode_i & (~base_ok  || ~hdrm_ok);
378 
379   // In order to have constant timing (avoid side-channel leakage due to data-dependent behavior), 
380   // if base vio or headroom < 4 (we are only authorized to fetch 2 bytes), force the fetch_fifo
381   // to treat the current rdata as a unaligned compressed instruction if pc[1]=1, and push it to 
382   // ID stage without waiting for the 2nd part of 32-bit instruciton. 
383   // 
384   assign cheri_force_uc = CHERIoTEn & cheri_pmode_i & ~allow_all & (~base_ok | ~hdrm_ge4);
385 
386   // we still check seal/perm here to be safe, however by ISA those can't happen at fetch time 
