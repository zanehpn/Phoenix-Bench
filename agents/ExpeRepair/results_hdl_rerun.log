469         end
470       end
471     end else begin : g_lookup_ind_nr
472       always_ff @(posedge clk_i) begin
473         if (lookup_grant_ic0) begin
474           lookup_index_ic1 <= lookup_addr_ic0[IC_INDEX_HI-:IC_INDEX_W];
475         end
476       end
477     end
478 
479     // Store the ways with errors to be invalidated
480     if (ResetAll) begin : g_ecc_correction_ra
481       always_ff @(posedge clk_i or negedge rst_ni) begin
482         if (!rst_ni) begin
483           ecc_correction_ways_q  <= '0;
484           ecc_correction_index_q <= '0;
485         end else if (ecc_err_ic1) begin
