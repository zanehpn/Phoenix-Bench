28   // decoder related signals
29   input  logic                  illegal_insn_i,          // decoder has an invalid instr
30   input  logic                  ecall_insn_i,            // decoder has ECALL instr
31   input  logic                  mret_insn_i,             // decoder has MRET instr
32   input  logic                  dret_insn_i,             // decoder has DRET instr
33   input  logic                  wfi_insn_i,              // decoder has WFI instr
34   input  logic                  ebrk_insn_i,             // decoder has EBREAK instr
35   input  logic                  csr_pipe_flush_i,        // do CSR-related pipeline flush
36   input  logic                  csr_access_i,            // decoder has CSR access instr
37   input  logic                  csr_cheri_always_ok_i,   // cheri safe-listed CSR registers
38 
39   // instr from IF-ID pipeline stage
40   input  logic                  instr_valid_i,           // instr is valid
41   input  logic [31:0]           instr_i,                 // uncompressed instr data for mtval
42   input  logic [15:0]           instr_compressed_i,      // instr compressed data for mtval
43   input  logic                  instr_is_compressed_i,   // instr is compressed
44   input  logic                  instr_bp_taken_i,        // instr was predicted taken branch
45   input  logic                  instr_fetch_err_i,       // instr has error
