836         .hpdcache_dir_entry_t          (hpdcache_dir_entry_t),
837         .hpdcache_data_word_t          (hpdcache_data_word_t),
838         .hpdcache_data_be_t            (hpdcache_data_be_t),
839         .hpdcache_req_data_t           (hpdcache_req_data_t),
840         .hpdcache_req_be_t             (hpdcache_req_be_t),
841         .hpdcache_access_data_t        (hpdcache_access_data_t),
842         .hpdcache_access_be_t          (hpdcache_access_be_t)
843     ) hpdcache_memctrl_i(
844         .clk_i,
845         .rst_ni,
846 
847         .ready_o                       (hpdcache_init_ready),
848 
849         .dir_match_i                   (st0_req_cachedir_read),
850         .dir_match_set_i               (st0_req_set),
851         .dir_match_tag_i               (st1_req.addr_tag),
852         .dir_updt_sel_victim_i         (st1_req_updt_sel_victim),
853         .dir_hit_way_o                 (st1_dir_hit_way),
854         .dir_hit_tag_o                 (st1_dir_hit_tag),
855         .dir_hit_wback_o               (st1_dir_hit_wback),
856         .dir_hit_dirty_o               (st1_dir_hit_dirty),
857         .dir_hit_fetch_o               (st1_dir_hit_fetch),
858 
859         .dir_updt_i                    (st2_dir_updt_q),
860         .dir_updt_set_i                (st2_dir_updt_set_q),
861         .dir_updt_way_i                (st2_dir_updt_way_q),
862         .dir_updt_tag_i                (st2_dir_updt_tag_q),
863         .dir_updt_valid_i              (st2_dir_updt_valid_q),
