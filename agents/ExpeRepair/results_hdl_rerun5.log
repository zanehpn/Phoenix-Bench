312     function automatic hpdcache_mem_size_t get_hpdcache_mem_size(int unsigned bytes);
313         if      (bytes ==   0) return 0;
314         else if (bytes <=   2) return 1;
315         else if (bytes <=   4) return 2;
316         else if (bytes <=   8) return 3;
317         else if (bytes <=  16) return 4;
318         else if (bytes <=  32) return 5;
319         else if (bytes <=  64) return 6;
320         else if (bytes <= 128) return 7;
321         else begin
322 `ifndef HPDCACHE_ASSERT_OFF
323             assert (1) $error("hpdcache: unsupported number of bytes");
324 `endif
325             return 0;
326         end
327     endfunction
