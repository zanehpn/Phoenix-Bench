│  // Stream join dynamic: Joins a dynamically selected subset of    │
│  `N_INP` input stream handshakes                                   │
│  // into one output stream handshake.                              │
│  // For each output handshake, every selected input stream         │
│  handshakes exactly once. Input streams                            │
│  // are granted independently and do not need to handshake         │
│  simultaneously.                                                   │
│  //                                                                │
│  // This module has no data ports because stream data does not ne  │
│  to be joined internally: data                                     │
│  // can be handled externally while this module provides the       │
│  synchronization handshakes.                                       │
│                                                                    │
│  module stream_join_dynamic #(                                     │
│      parameter int unsigned N_INP = 0  // Synopsys DC requires a   │
│  default value for parameters.                                     │
│  ) (                                                               │
│      input  logic                clk_i,                            │
│      input  logic                rst_ni,                           │
│      input  logic [N_INP-1:0]    valid_i,                          │
│      output logic [N_INP-1:0]    ready_o,                          │
│      input  logic [N_INP-1:0]    sel_i,                            │
│      output logic                valid_o,                          │
│      input  logic                ready_i                           │
│  );                                                                │
│                                                                    │
│      logic [N_INP-1:0] sel_q, sel_d;                               │
│      logic [N_INP-1:0] pending_q, pending_d;                       │
│      logic             active_q, active_d;                         │
│                                                                    │
│      logic [N_INP-1:0] sel_eff;                                    │
│      logic [N_INP-1:0] handshakes;                                 │
│      logic [N_INP-1:0] pending_n;                                  │
│      logic             any_sel;                                    │
│      logic             all_done;                                   │
│      logic             out_handshake;                              │
│                                                                    │
│      always_comb begin                                             │
│          // Defaults                                               │
│          sel_d         = sel_q;                                    │
│          pending_d     = pending_q;                                │
│          active_d      = active_q;                                 │
│          ready_o       = '0;                                       │
│          valid_o       = 1'b0;                                     │
│                                                                    │
│          // Selection is dynamic while idle, and latched while     │
│  active.                                                           │
│          sel_eff       = active_q ? sel_q : sel_i;                 │
│                                                                    │
│          // Inputs that are selected and not consumed yet can      │
│  handshake.                                                        │
│          ready_o       = sel_eff & ~pending_q;                     │
│          handshakes    = valid_i & ready_o;                        │
│          pending_n     = pending_q | handshakes;                   │
│                                                                    │
│          any_sel       = |sel_eff;                                 │
│          all_done      = any_sel && (pending_n == sel_eff);        │
│          valid_o       = all_done;                                 │
│          out_handshake = valid_o && ready_i;                       │
│                                                                    │
│          if (out_handshake) begin                                  │
│              // Transaction complete.                              │
│              sel_d     = '0;                                       │
│              pending_d = '0;                                       │
│              active_d  = 1'b0;                                     │
│          end else if (all_done || (|pending_n)) begin              │
│              // Transaction in progress / waiting for output       │
│  handshake.                                                        │
│              sel_d     = sel_eff;                                  │
│              pending_d = pending_n;                                │
│              active_d  = 1'b1;                                     │
│          end else begin                                            │
│              // Idle.                                              │
│              sel_d     = '0;                                       │
│              pending_d = '0;                                       │
│              active_d  = 1'b0;                                     │
│          end                                                       │
│      end                                                           │
│                                                                    │
│      always_ff @(posedge clk_i, negedge rst_ni) begin              │
│          if (!rst_ni) begin                                        │
│              sel_q     <= '0;                                      │
│              pending_q <= '0;                                      │
│              active_q  <= 1'b0;                                    │
│          end else begin                                            │
│              sel_q     <= sel_d;                                   │
│              pending_q <= pending_d;                               │
│              active_q  <= active_d;                                │
│          end                                                       │
│      end                                                           │
