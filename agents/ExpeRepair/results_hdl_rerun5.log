1046     //  Assertions
1047     //  {{{
1048 `ifndef HPDCACHE_ASSERT_OFF
1049     //  Check that the cache controller is being used by one and only one among a core request, the
1050     //  RTAB or the miss handler.
1051     assert property (@(posedge clk_i) disable iff (!rst_ni)
1052             $onehot0({core_req_ready_o, st0_rtab_pop_try_ready, refill_req_ready_o})) else
1053                     $error("ctrl: only one request can be served per cycle");
1054 
1055     //  Check that requests have a valid size field. The check is not necessary for the fence,
1056     //  invalidation and flush CMOs because these requests do not use the size field.
1057     property prop_core_req_size_max;
1058         @(posedge clk_i) disable iff (!rst_ni) (
1059             core_req_valid_i && core_req_ready_o &&
1060             !(is_cmo_fence(core_req_i.op) ||
1061               is_cmo_inval(core_req_i.op) ||
1062               is_cmo_flush(core_req_i.op))
1063         ) |-> (
1064             (2**core_req_i.size) <= HPDcacheCfg.reqDataBytes
1065         );
1066     endproperty
1067 
1068     assert property (prop_core_req_size_max) else
1069             $error("ctrl: bad SIZE for request");
1070 
1071     //  Check that stores and AMOs requests have a valid Byte Enable field. In particular, check
1072     //  that it is aligned with respect to the address
1073     function automatic bit check_is_be_aligned(
1074       input hpdcache_req_offset_t req_offset,
1075       input hpdcache_req_be_t req_be
1076     );
1077         int offset = int'(req_offset) % HPDcacheCfg.reqDataBytes;
1078         return (((req_be >> offset) << offset) == req_be);
1079     endfunction
1080 
1081     property prop_core_req_be_align;
1082         @(posedge clk_i) disable iff (!rst_ni) (
1083             core_req_valid_i && core_req_ready_o &&
1084             (is_store(core_req_i.op) || is_amo(core_req_i.op))
1085         ) |-> (
1086             check_is_be_aligned(core_req_i.addr_offset, core_req_i.be)
1087         );
1088     endproperty
1089 
1090     assert property (prop_core_req_be_align) else
1091             $error("ctrl: bad BE alignment for request");
1092 
1093     //  Check that only one cache victim way is required when reserving a slot in the MSHR
1094     assert property (@(posedge clk_i) disable iff (!rst_ni)
1095         st2_mshr_alloc_q |-> $onehot(st2_mshr_alloc_victim_way_q)) else
1096             $error("ctrl: no victim way selected during MSHR allocation");
1097 `endif
1098     //  }}}
