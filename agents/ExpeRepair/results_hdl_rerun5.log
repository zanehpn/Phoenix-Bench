742     //  Pipeline stage 1 registers
743     //  {{{
744     always_ff @(posedge clk_i)
745     begin : st1_req_payload_ff
746         if (core_req_ready_o | st0_rtab_pop_try_ready) begin
747             st1_req_q <= st0_req;
748         end
749     end
750 
751     always_ff @(posedge clk_i or negedge rst_ni)
752     begin : st1_req_valid_ff
753         if (!rst_ni) begin
754             st1_req_valid_q        <= 1'b0;
755             st1_req_is_error_q     <= 1'b0;
756             st1_req_rtab_q         <= 1'b0;
757             st1_rtab_pop_try_ptr_q <= '0;
758         end else begin
759             st1_req_valid_q    <= st1_req_valid_d;
760             st1_req_is_error_q <= st1_req_is_error_d;
761             if (core_req_ready_o | st0_rtab_pop_try_ready) begin
762                 st1_req_rtab_q <= st0_rtab_pop_try_ready;
763                 if (st0_rtab_pop_try_ready) begin
764                     st1_rtab_pop_try_ptr_q <= st0_rtab_pop_try_ptr;
765                 end
766             end
767         end
768     end
769     //  }}}
770 
771     //  Pipeline stage 2 registers
772     //  {{{
773     always_ff @(posedge clk_i)
774     begin : st2_metadata_ff
775         if (st2_mshr_alloc_d) begin
776             st2_mshr_alloc_need_rsp_q    <= st2_mshr_alloc_need_rsp_d;
777             st2_mshr_alloc_addr_q        <= st1_req_addr;
778             st2_mshr_alloc_sid_q         <= st1_req.sid;
779             st2_mshr_alloc_tid_q         <= st1_req.tid;
780             st2_mshr_alloc_is_prefetch_q <= st1_req_is_cmo_prefetch;
781             st2_mshr_alloc_wback_q       <= st2_mshr_alloc_wback_d;
782             st2_mshr_alloc_victim_way_q  <= st1_dir_victim_way;
783         end
784 
785         if (st2_flush_alloc_d) begin
786             st2_flush_alloc_nline_q <= st1_dir_hit ? st1_req_nline   : st1_victim_nline;
787             st2_flush_alloc_way_q   <= st1_dir_hit ? st1_dir_hit_way : st1_dir_victim_way;
788         end
789 
790         if (st2_dir_updt_d) begin
791             st2_dir_updt_tag_q    <= st1_dir_hit ? st1_dir_hit_tag : st1_dir_victim_tag;
792             st2_dir_updt_set_q    <= st1_req_set;
793             st2_dir_updt_way_q    <= st1_dir_hit ? st1_dir_hit_way : st1_dir_victim_way;
794             st2_dir_updt_valid_q  <= st2_dir_updt_valid_d;
795             st2_dir_updt_wback_q  <= st2_dir_updt_wback_d;
796             st2_dir_updt_dirty_q  <= st2_dir_updt_dirty_d;
797             st2_dir_updt_fetch_q  <= st2_dir_updt_fetch_d;
798         end
799     end
800 
801     always_ff @(posedge clk_i or negedge rst_ni)
802     begin : st2_valid_ff
803         if (!rst_ni) begin
804             st2_mshr_alloc_q  <= 1'b0;
805             st2_flush_alloc_q <= 1'b0;
806             st2_dir_updt_q    <= 1'b0;
807         end else begin
808             st2_mshr_alloc_q  <= st2_mshr_alloc_d;
809             st2_flush_alloc_q <= st2_flush_alloc_d;
810             st2_dir_updt_q    <= st2_dir_updt_d;
811         end
812     end
813     //  }}}
814 
815     //  Controller for the HPDcache directory and data memory arrays
816     //  {{{
817     assign st0_req_set = st0_req.addr_offset[HPDcacheCfg.clOffsetWidth +: HPDcacheCfg.setWidth];
818     assign st0_req_word = st0_req.addr_offset[HPDcacheCfg.wordByteIdxWidth +:
819                                               HPDcacheCfg.clWordIdxWidth];
820 
821     assign st1_req_set = st1_req.addr_offset[HPDcacheCfg.clOffsetWidth +: HPDcacheCfg.setWidth];
822     assign st1_req_word = st1_req.addr_offset[HPDcacheCfg.wordByteIdxWidth +:
823                                               HPDcacheCfg.clWordIdxWidth];
824     assign st1_req_addr = {st1_req.addr_tag, st1_req.addr_offset};
825     assign st1_req_nline = st1_req_addr[HPDcacheCfg.clOffsetWidth +: HPDcacheCfg.nlineWidth];
826 
827     assign st1_victim_nline = {st1_dir_victim_tag, st1_req_set};
828 
829     hpdcache_memctrl #(
830         .HPDcacheCfg                   (HPDcacheCfg),
831         .hpdcache_nline_t              (hpdcache_nline_t),
832         .hpdcache_tag_t                (hpdcache_tag_t),
833         .hpdcache_set_t                (hpdcache_set_t),
834         .hpdcache_word_t               (hpdcache_word_t),
