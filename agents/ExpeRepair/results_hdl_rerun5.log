97   input  logic                  debug_ebreakm_i,
98   input  logic                  debug_ebreaku_i,
99   input  logic                  trigger_match_i,
100 
101   output logic                  csr_save_if_o,
102   output logic                  csr_save_id_o,
103   output logic                  csr_save_wb_o,
104   output logic                  csr_restore_mret_id_o,
105   output logic                  csr_restore_dret_id_o,
106   output logic                  csr_save_cause_o,
