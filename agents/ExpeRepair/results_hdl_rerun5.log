│  // one output handshake. Each selected input handshakes exactly   │
│  once per output handshake.                                        │
│  // Selected inputs can handshake independently (not necessarily   │
│  simultaneously).                                                  │
│  module stream_join_dynamic #(                                     │
│      parameter int unsigned N_INP = 0    // Synopsys DC requires   │
│  default value for parameters.                                     │
