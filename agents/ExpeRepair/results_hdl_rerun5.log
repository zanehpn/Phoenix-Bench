452       CSR_PMPADDR0:  csr_rdata_int = pmp_addr_rdata[0];
453       CSR_PMPADDR1:  csr_rdata_int = pmp_addr_rdata[1];
454       CSR_PMPADDR2:  csr_rdata_int = pmp_addr_rdata[2];
455       CSR_PMPADDR3:  csr_rdata_int = pmp_addr_rdata[3];
456       CSR_PMPADDR4:  csr_rdata_int = pmp_addr_rdata[4];
457       CSR_PMPADDR5:  csr_rdata_int = pmp_addr_rdata[5];
458       CSR_PMPADDR6:  csr_rdata_int = pmp_addr_rdata[6];
459       CSR_PMPADDR7:  csr_rdata_int = pmp_addr_rdata[7];
460       CSR_PMPADDR8:  csr_rdata_int = pmp_addr_rdata[8];
461       CSR_PMPADDR9:  csr_rdata_int = pmp_addr_rdata[9];
462       CSR_PMPADDR10: csr_rdata_int = pmp_addr_rdata[10];
463       CSR_PMPADDR11: csr_rdata_int = pmp_addr_rdata[11];
464       CSR_PMPADDR12: csr_rdata_int = pmp_addr_rdata[12];
465       CSR_PMPADDR13: csr_rdata_int = pmp_addr_rdata[13];
466       CSR_PMPADDR14: csr_rdata_int = pmp_addr_rdata[14];
467       CSR_PMPADDR15: csr_rdata_int = pmp_addr_rdata[15];
