621     mstack_d.mpp   = mstatus_q.mpp;
622     mstack_epc_d   = mepc_q;
623     mstack_cause_d = mcause_q;
624 
625     mcountinhibit_we = 1'b0;
626     mhpmcounter_we   = '0;
627     mhpmcounterh_we  = '0;
628 
629     cpuctrl_we       = 1'b0;
