6 /**
7  * Prefetcher Buffer for 32 bit memory interface
8  *
9  * Prefetch Buffer that caches instructions. This cuts overly long critical
10  * paths to the instruction cache.
11  */
12 module ibex_prefetch_buffer #(
13   parameter bit ResetAll        = 1'b0
14 ) (
15   input  logic        clk_i,
16   input  logic        rst_ni,
17 
18   input  logic        req_i,
19 
20   input  logic        branch_i,
21   input  logic        branch_mispredict_i,
22   input  logic [31:0] mispredict_addr_i,
23   input  logic [31:0] addr_i,
24 
25 
26   input  logic        ready_i,
27   output logic        valid_o,
28   output logic [31:0] rdata_o,
29   output logic [31:0] addr_o,
30   output logic        err_o,
31   output logic        err_plus2_o,
32 
33   input  logic       cheri_force_uc_i,
34 
35   // goes to instruction memory / instruction cache
36   output logic        instr_req_o,
37   input  logic        instr_gnt_i,
38   output logic [31:0] instr_addr_o,
39   input  logic [31:0] instr_rdata_i,
40   input  logic        instr_err_i,
41   input  logic        instr_rvalid_i,
42 
43   // Prefetch Buffer Status
44   output logic        busy_o
45 );
46 
47   localparam int unsigned NUM_REQS  = 2;
48 
49   logic                valid_new_req, valid_req;
50   logic                valid_req_d, valid_req_q;
51   logic                discard_req_d, discard_req_q;
52   logic [NUM_REQS-1:0] rdata_outstanding_n, rdata_outstanding_s, rdata_outstanding_q;
53   logic [NUM_REQS-1:0] branch_discard_n, branch_discard_s, branch_discard_q;
54   logic [NUM_REQS-1:0] rdata_outstanding_rev;
55 
56   logic [31:0]         stored_addr_d, stored_addr_q;
57   logic                stored_addr_en;
58   logic [31:0]         fetch_addr_d, fetch_addr_q;
59   logic                fetch_addr_en;
60   logic [31:0]         instr_addr, instr_addr_w_aligned;
61 
62   logic                fifo_valid;
63   logic [31:0]         fifo_addr;
64   logic                fifo_ready;
65   logic                fifo_clear;
66   logic [NUM_REQS-1:0] fifo_busy;
67 
68   logic                valid_raw;
69 
70   logic                branch_or_mispredict;
71 
72   ////////////////////////////
73   // Prefetch buffer status //
74   ////////////////////////////
75 
76   assign busy_o = (|rdata_outstanding_q) | instr_req_o;
77 
78   assign branch_or_mispredict = branch_i | branch_mispredict_i;
79 
80   //////////////////////////////////////////////
81   // Fetch fifo - consumes addresses and data //
82   //////////////////////////////////////////////
83 
84   // A branch will invalidate any previously fetched instructions.
85   // Note that the FENCE.I instruction relies on this flushing behaviour on branch. If it is
86   // altered the FENCE.I implementation may require changes.
87   assign fifo_clear = branch_or_mispredict;
88 
89   // Reversed version of rdata_outstanding_q which can be overlaid with fifo fill state
90   for (genvar i = 0; i < NUM_REQS; i++) begin : gen_rd_rev
91     assign rdata_outstanding_rev[i] = rdata_outstanding_q[NUM_REQS-1-i];
92   end
93 
94   // The fifo is ready to accept a new request if it is not full - including space reserved for
95   // requests already outstanding.
96   // Overlay the fifo fill state with the outstanding requests to see if there is space.
97   assign fifo_ready = ~&(fifo_busy | rdata_outstanding_rev);
98 
99   ibex_fetch_fifo #(
100     .NUM_REQS (NUM_REQS),
101     .ResetAll (ResetAll)
102   ) fifo_i (
103       .clk_i                 ( clk_i             ),
104       .rst_ni                ( rst_ni            ),
105 
106       .clear_i               ( fifo_clear        ),
107       .busy_o                ( fifo_busy         ),
108 
109       .in_valid_i            ( fifo_valid        ),
110       .in_addr_i             ( fifo_addr         ),
111       .in_rdata_i            ( instr_rdata_i     ),
112       .in_err_i              ( instr_err_i       ),
113       .cheri_force_uc_i      ( cheri_force_uc_i  ),
114 
115       .out_valid_o           ( valid_raw         ),
116       .out_ready_i           ( ready_i           ),
117       .out_rdata_o           ( rdata_o           ),
118       .out_addr_o            ( addr_o            ),
119       .out_err_o             ( err_o             ),
120       .out_err_plus2_o       ( err_plus2_o       )
121   );
122 
123   //////////////
124   // Requests //
125   //////////////
126 
127   // Make a new request any time there is space in the FIFO, and space in the request queue
128   assign valid_new_req = req_i & (fifo_ready | branch_or_mispredict) &
129                          ~rdata_outstanding_q[NUM_REQS-1];
130 
131   assign valid_req = valid_req_q | valid_new_req;
132 
133   // Hold the request stable for requests that didn't get granted
134   assign valid_req_d = valid_req & ~instr_gnt_i;
135 
136   // Record whether an outstanding bus request is cancelled by a branch
137   assign discard_req_d = valid_req_q & (branch_or_mispredict | discard_req_q);
138 
139   ////////////////
140   // Fetch addr //
141   ////////////////
142 
143   // Two addresses are tracked in the prefetch buffer:
144   // 1. stored_addr_q - This is the address issued on the bus. It stays stable until
145   //                    the request is granted.
146   // 2. fetch_addr_q  - This is our next address to fetch from. It is updated on branches to
147   //                    capture the new address, and then for each new request issued.
148   // A third address is tracked in the fetch FIFO itself:
149   // 3. instr_addr_q  - This is the address at the head of the FIFO, efectively our oldest fetched
150   //                    address. This address is updated on branches, and does its own increment
151   //                    each time the FIFO is popped.
152 
153   // 1. stored_addr_q
154 
155   // Only update stored_addr_q for new ungranted requests
156   assign stored_addr_en = valid_new_req & ~valid_req_q & ~instr_gnt_i;
157 
158   // Store whatever address was issued on the bus
159   assign stored_addr_d = instr_addr;
160 
161   // CPU resets with a branch, so no need to reset these addresses
162   if (ResetAll) begin : g_stored_addr_ra
163     always_ff @(posedge clk_i or negedge rst_ni) begin
164       if (!rst_ni) begin
165         stored_addr_q <= '0;
166       end else if (stored_addr_en) begin
167         stored_addr_q <= stored_addr_d;
168       end
169     end
170   end else begin : g_stored_addr_nr
171     always_ff @(posedge clk_i) begin
172       if (stored_addr_en) begin
173         stored_addr_q <= stored_addr_d;
174       end
175     end
176   end
177   // 2. fetch_addr_q
178 
179   // Update on a branch or as soon as a request is issued
180   assign fetch_addr_en = branch_or_mispredict | (valid_new_req & ~valid_req_q);
181 
182   assign fetch_addr_d = (branch_i            ? addr_i :
183                          branch_mispredict_i ? {mispredict_addr_i[31:2], 2'b00} :
184                                                {fetch_addr_q[31:2], 2'b00}) +
185                         // Current address + 4
186                         {{29{1'b0}},(valid_new_req & ~valid_req_q),2'b00};
187 
188   if (ResetAll) begin : g_fetch_addr_ra
189     always_ff @(posedge clk_i or negedge rst_ni) begin
190       if (!rst_ni) begin
191         fetch_addr_q <= '0;
192       end else if (fetch_addr_en) begin
193         fetch_addr_q <= fetch_addr_d;
194       end
195     end
196   end else begin : g_fetch_addr_nr
197     always_ff @(posedge clk_i) begin
198       if (fetch_addr_en) begin
199         fetch_addr_q <= fetch_addr_d;
200       end
201     end
202   end
203 
204   // Address mux
205   assign instr_addr = valid_req_q         ? stored_addr_q :
206                       branch_i            ? addr_i :
207                       branch_mispredict_i ? mispredict_addr_i :
208                                             fetch_addr_q;
209 
210   assign instr_addr_w_aligned = {instr_addr[31:2], 2'b00};
211 
212   ///////////////////////////////
213   // Request outstanding queue //
214   ///////////////////////////////
215 
216   for (genvar i = 0; i < NUM_REQS; i++) begin : g_outstanding_reqs
217     // Request 0 (always the oldest outstanding request)
218     if (i == 0) begin : g_req0
219       // A request becomes outstanding once granted, and is cleared once the rvalid is received.
220       // Outstanding requests shift down the queue towards entry 0.
221       assign rdata_outstanding_n[i] = (valid_req & instr_gnt_i) |
222                                       rdata_outstanding_q[i];
223       // If a branch is received at any point while a request is outstanding, it must be tracked
224       // to ensure we discard the data once received
225       assign branch_discard_n[i]    = (valid_req & instr_gnt_i & discard_req_d) |
226                                       (branch_or_mispredict & rdata_outstanding_q[i]) |
227                                       branch_discard_q[i];
228 
229     end else begin : g_reqtop
230     // Entries > 0 consider the FIFO fill state to calculate their next state (by checking
231     // whether the previous entry is valid)
232 
233       assign rdata_outstanding_n[i] = (valid_req & instr_gnt_i &
234                                        rdata_outstanding_q[i-1]) |
235                                       rdata_outstanding_q[i];
236       assign branch_discard_n[i]    = (valid_req & instr_gnt_i & discard_req_d &
237                                        rdata_outstanding_q[i-1]) |
238                                       (branch_or_mispredict & rdata_outstanding_q[i]) |
239                                       branch_discard_q[i];
240     end
241   end
242 
243   // Shift the entries down on each instr_rvalid_i
244   assign rdata_outstanding_s = instr_rvalid_i ? {1'b0,rdata_outstanding_n[NUM_REQS-1:1]} :
245                                                 rdata_outstanding_n;
246   assign branch_discard_s    = instr_rvalid_i ? {1'b0,branch_discard_n[NUM_REQS-1:1]} :
247                                                 branch_discard_n;
248 
249   // Push a new entry to the FIFO once complete (and not cancelled by a branch)
250   assign fifo_valid = instr_rvalid_i & ~branch_discard_q[0];
251 
252   assign fifo_addr = branch_i ? addr_i : mispredict_addr_i;
253 
254   ///////////////
255   // Registers //
256   ///////////////
257 
258   always_ff @(posedge clk_i or negedge rst_ni) begin
259     if (!rst_ni) begin
260       valid_req_q          <= 1'b0;
261       discard_req_q        <= 1'b0;
262       rdata_outstanding_q  <= 'b0;
263       branch_discard_q     <= 'b0;
264     end else begin
265       valid_req_q          <= valid_req_d;
266       discard_req_q        <= discard_req_d;
267       rdata_outstanding_q  <= rdata_outstanding_s;
268       branch_discard_q     <= branch_discard_s;
269     end
