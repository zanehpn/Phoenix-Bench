673     //  Miss Status Holding Register component
674     //  {{{
675     hpdcache_mshr #(
676         .HPDcacheCfg              (HPDcacheCfg),
677         .hpdcache_nline_t         (hpdcache_nline_t),
678         .hpdcache_tag_t           (hpdcache_tag_t),
679         .hpdcache_set_t           (hpdcache_set_t),
