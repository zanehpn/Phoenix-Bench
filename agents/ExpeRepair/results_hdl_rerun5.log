443       // PMP registers
444       CSR_PMPCFG0:   csr_rdata_int = {pmp_cfg_rdata[3],  pmp_cfg_rdata[2],
445                                       pmp_cfg_rdata[1],  pmp_cfg_rdata[0]};
446       CSR_PMPCFG1:   csr_rdata_int = {pmp_cfg_rdata[7],  pmp_cfg_rdata[6],
447                                       pmp_cfg_rdata[5],  pmp_cfg_rdata[4]};
