228     //  Miss Request FSM
229     //  {{{
230     always_comb
231     begin : miss_req_fsm_comb
232         mshr_alloc_ready_o = 1'b0;
233         mshr_alloc         = 1'b0;
234         mshr_alloc_cs      = 1'b0;
235         mem_req_valid_o    = 1'b0;
236 
237         miss_req_fsm_d     = miss_req_fsm_q;
238 
239         unique case (miss_req_fsm_q)
240             MISS_REQ_IDLE: begin
241                 mshr_alloc_ready_o = 1'b1;
242                 mshr_alloc         = mshr_alloc_i;
243                 mshr_alloc_cs      = mshr_alloc_cs_i;
244                 if (mshr_alloc_i) begin
245                     miss_req_fsm_d = MISS_REQ_SEND;
246                 end else begin
247                     miss_req_fsm_d = MISS_REQ_IDLE;
248                 end
249             end
250             MISS_REQ_SEND: begin
251                 mem_req_valid_o = 1'b1;
252                 if (mem_req_ready_i) begin
253                     miss_req_fsm_d = MISS_REQ_IDLE;
254                 end else begin
255                     miss_req_fsm_d = MISS_REQ_SEND;
256                 end
257             end
258         endcase
259     end
