531         csr_rdata_int = tmatch_control_rdata;
532         illegal_csr   = ~DbgTriggerEn;
533       end
534       CSR_TDATA2: begin
535         csr_rdata_int = tmatch_value_rdata;
536         illegal_csr   = ~DbgTriggerEn;
537       end
538       CSR_TDATA3: begin
539         csr_rdata_int = '0;
540         illegal_csr   = ~DbgTriggerEn;
541       end
542       CSR_MCONTEXT: begin
543         csr_rdata_int = '0;
544         illegal_csr   = ~DbgTriggerEn;
545       end
546       CSR_SCONTEXT: begin
547         csr_rdata_int = '0;
548         illegal_csr   = ~DbgTriggerEn;
549       end
