411 
412       // mtval: trap value
413       CSR_MTVAL: csr_rdata_int = mtval_q;
414 
415       // mip: interrupt pending
416       CSR_MIP: begin
417         csr_rdata_int                                     = '0;
418         csr_rdata_int[CSR_MSIX_BIT]                       = mip.irq_software;
419         csr_rdata_int[CSR_MTIX_BIT]                       = mip.irq_timer;
420         csr_rdata_int[CSR_MEIX_BIT]                       = mip.irq_external;
421         csr_rdata_int[CSR_MFIX_BIT_HIGH:CSR_MFIX_BIT_LOW] = mip.irq_fast;
422       end
423 
424       CSR_MSECCFG: begin
425         if (PMPEnable) begin
426           csr_rdata_int                       = '0;
427           csr_rdata_int[CSR_MSECCFG_MML_BIT]  = pmp_mseccfg.mml;
