551       // Custom CSR for controlling CPU features
552       CSR_CPUCTRL: begin
553         csr_rdata_int = {{32 - $bits(cpu_ctrl_t) {1'b0}}, cpuctrl_q};
554       end
555 
556       // Custom CSR for LFSR re-seeding (cannot be read)
557       CSR_SECURESEED: begin
558         csr_rdata_int = '0;
559       end
560 
561       // MSHWM CSR (stack high watermark in cheriot)
562       CSR_MSHWM:  begin
563         if (cheri_pmode_i) begin
564           csr_rdata_int = cheri_pmode_i ? mshwm_q : 32'h0;
565         end else begin
566           illegal_csr = 1'b1;
567         end
568       end
569 
570       CSR_MSHWMB: begin
571         if (cheri_pmode_i) begin
572           csr_rdata_int = cheri_pmode_i ? mshwmb_q : 32'h0;
573         end else begin
574           illegal_csr = 1'b1;
575         end
576       end
577 
578       CSR_CDBG_CTRL: begin
579         if (cheri_pmode_i) begin
580           csr_rdata_int = cheri_pmode_i ? cdbg_ctrl_q : 32'h0;
581         end else begin
582           illegal_csr = 1'b1;
583         end
584       end
585 
586       default: begin
587         illegal_csr = 1'b1;
588       end
589     endcase
590   end
591 
592   // write logic
593   always_comb begin
594     exception_pc = pc_id_i;
595 
596     priv_lvl_d   = priv_lvl_q;
597     mstatus_en   = 1'b0;
598     mstatus_d    = mstatus_q;
599     mie_en       = 1'b0;
600     mscratch_en  = 1'b0;
