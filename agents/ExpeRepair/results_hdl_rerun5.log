305   logic [31:0] csr_wdata_int;
306   logic [31:0] csr_rdata_int;
307   logic        csr_we_int;
308   logic        csr_wr;
309 
310   // Access violation signals
311   logic        illegal_csr;
312   logic        illegal_csr_priv;
313   logic        illegal_csr_write;
314 
315   logic [7:0]  unused_boot_addr;
316   logic [2:0]  unused_csr_addr;
317 
318   logic        mepc_en_combi, mepc_en_cheri;
319   logic [31:0] mepc_d_combi;
320 
321   logic        mtvec_en_combi, mtvec_en_cheri;
322   logic [31:0] mtvec_d_combi;
323 
324   logic        depc_en_combi, depc_en_cheri;
325   logic [31:0] depc_d_combi;
326 
327   logic        dscratch0_en_combi, dscratch0_en_cheri;
328   logic [31:0] dscratch0_d_combi;
329   logic        dscratch1_en_combi, dscratch1_en_cheri;
330   logic [31:0] dscratch1_d_combi;
331 
332   assign unused_boot_addr = boot_addr_i[7:0];
333 
334   logic [31:0] misa_value_masked;
335 
336   assign misa_value_masked = MISA_VALUE & ~{8'h0, ~cheri_pmode_i, 23'h0};
337 
338 
339   /////////////
340   // CSR reg //
341   /////////////
342 
343   logic [$bits(csr_num_e)-1:0] csr_addr;
344   assign csr_addr           = {csr_addr_i};
345   assign unused_csr_addr    = csr_addr[7:5];
346   assign mhpmcounter_idx    = csr_addr[4:0];
347 
348   // See RISC-V Privileged Specification, version 1.11, Section 2.1
349   assign illegal_csr_priv   = (csr_addr[9:8] > {priv_lvl_q});
350   assign illegal_csr_write  = (csr_addr[11:10] == 2'b11) && csr_wr;
351   assign illegal_csr_insn_o = csr_access_i & (illegal_csr | illegal_csr_write | illegal_csr_priv);
352 
353   // mip CSR is purely combinational - must be able to re-enable the clock upon WFI
354   assign mip.irq_software = irq_software_i;
355   assign mip.irq_timer    = irq_timer_i;
356   assign mip.irq_external = irq_external_i;
357   assign mip.irq_fast     = irq_fast_i;
358 
359   // read logic
360   always_comb begin
361     csr_rdata_int = '0;
362     illegal_csr   = 1'b0;
363 
364     unique case (csr_addr_i)
365       // mvendorid: encoding of manufacturer/provider
366       CSR_MVENDORID: csr_rdata_int = (CHERIoTEn&cheri_pmode_i) ? CSR_MVENDORID_CHERI_VALUE : CSR_MVENDORID_VALUE;
367       // marchid: encoding of base microarchitecture
368       CSR_MARCHID: csr_rdata_int = (CHERIoTEn&cheri_pmode_i) ? CSR_MARCHID_CHERI_VALUE : CSR_MARCHID_VALUE;
369       // mimpid: encoding of processor implementation version
370       CSR_MIMPID: csr_rdata_int = CSR_MIMPID_VALUE;
371       // mhartid: unique hardware thread id
372       CSR_MHARTID: csr_rdata_int = hart_id_i;
373 
374       // mstatus: always M-mode, contains IE bit
375       CSR_MSTATUS: begin
376         csr_rdata_int                                                   = '0;
377         csr_rdata_int[CSR_MSTATUS_MIE_BIT]                              = mstatus_q.mie;
378         csr_rdata_int[CSR_MSTATUS_MPIE_BIT]                             = mstatus_q.mpie;
379         csr_rdata_int[CSR_MSTATUS_MPP_BIT_HIGH:CSR_MSTATUS_MPP_BIT_LOW] = mstatus_q.mpp;
380         csr_rdata_int[CSR_MSTATUS_MPRV_BIT]                             = mstatus_q.mprv;
381         csr_rdata_int[CSR_MSTATUS_TW_BIT]                               = mstatus_q.tw;
382       end
383 
384       // misa
385       CSR_MISA: csr_rdata_int = misa_value_masked;
386 
387       // interrupt enable
388       CSR_MIE: begin
389         csr_rdata_int                                     = '0;
390         csr_rdata_int[CSR_MSIX_BIT]                       = mie_q.irq_software;
391         csr_rdata_int[CSR_MTIX_BIT]                       = mie_q.irq_timer;
392         csr_rdata_int[CSR_MEIX_BIT]                       = mie_q.irq_external;
393         csr_rdata_int[CSR_MFIX_BIT_HIGH:CSR_MFIX_BIT_LOW] = mie_q.irq_fast;
394       end
395 
396       // mcounteren: machine counter enable
397       CSR_MCOUNTEREN: begin
398         csr_rdata_int = '0;
399       end
400 
401       CSR_MSCRATCH: csr_rdata_int = mscratch_q;
402 
403       // mtvec: trap-vector base address
404       CSR_MTVEC: csr_rdata_int = mtvec_q;
405 
406       // mepc: exception program counter
407       CSR_MEPC: csr_rdata_int = mepc_q;
408 
409       // mcause: exception cause
