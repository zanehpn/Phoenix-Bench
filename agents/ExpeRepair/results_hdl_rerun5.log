│  // Stream join dynamic: Joins a *selected subset* of N_INP input  │
│  stream handshakes to one output                                   │
│  // stream handshake. For each output handshake, every selected    │
│  input stream handshakes exactly once.                             │
│  // Selected inputs can handshake independently (not necessarily   │
│  the same cycle).                                                  │
│  //                                                                │
│  // This module has no data ports because stream data can be       │
│  handled externally.                                               │
│                                                                    │
│  module stream_join_dynamic #(                                     │
│      parameter int unsigned N_INP = 0                              │
│  ) (                                                               │
│      input  logic             clk_i,                               │
│      input  logic             rst_ni,                              │
│      input  logic [N_INP-1:0] sel_i,                               │
│      input  logic [N_INP-1:0] valid_i,                             │
│      output logic [N_INP-1:0] ready_o,                             │
│      output logic             valid_o,                             │
│      input  logic             ready_i                              │
│  );                                                                │
│                                                                    │
│    typedef enum logic {COLLECT, WAIT_OUT} state_t;                 │
│                                                                    │
│    state_t inp_state_d, inp_state_q;                               │
│                                                                    │
│    logic [N_INP-1:0] pending_d, pending_q;                         │
│    logic [N_INP-1:0] active_pending;                               │
│    logic [N_INP-1:0] all_zeros;                                    │
│                                                                    │
│    always_comb begin                                               │
│      inp_state_d     = inp_state_q;                                │
│      pending_d       = pending_q;                                  │
│      ready_o         = '0;                                         │
│      valid_o         = 1'b0;                                       │
│      active_pending  = pending_q;                                  │
│                                                                    │
│      unique case (inp_state_q)                                     │
│        COLLECT: begin                                              │
│          // Start a new collection round when no inputs are        │
│  pending.                                                          │
│          if (pending_q == all_zeros) begin                         │
│            active_pending = sel_i;                                 │
│          end                                                       │
│                                                                    │
│          // Allow all currently pending inputs to handshake        │
│  independently.                                                    │
│          ready_o = active_pending;                                 │
│                                                                    │
│          if (active_pending != all_zeros) begin                    │
│            pending_d = active_pending & ~valid_i;                  │
│            if ((active_pending & ~valid_i) == all_zeros) begin     │
│              inp_state_d = WAIT_OUT;                               │
│            end                                                     │
│          end else begin                                            │
│            pending_d = all_zeros;                                  │
│          end                                                       │
│        end                                                         │
│                                                                    │
│        WAIT_OUT: begin                                             │
│          valid_o = 1'b1;                                           │
│          if (ready_i) begin                                        │
│            pending_d   = all_zeros;                                │
│            inp_state_d = COLLECT;                                  │
│          end                                                       │
│        end                                                         │
│                                                                    │
│        default: begin                                              │
│          inp_state_d = COLLECT;                                    │
│          pending_d   = all_zeros;                                  │
│        end                                                         │
│      endcase                                                       │
│    end                                                             │
│                                                                    │
│    always_ff @(posedge clk_i, negedge rst_ni) begin                │
│      if (!rst_ni) begin                                            │
│        inp_state_q <= COLLECT;                                     │
│        pending_q   <= '0;                                          │
│      end else begin                                                │
│        inp_state_q <= inp_state_d;                                 │
│        pending_q   <= pending_d;                                   │
│      end                                                           │
│    end                                                             │
│                                                                    │
│    assign all_zeros = '0;                                          │
│                                                                    │
│  // pragma translate_off                                           │
│  `ifndef VERILATOR                                                 │
│    initial begin : p_assertions                                    │
│      assert (N_INP >= 1) else $fatal(1, "Number of inputs must be  │
│  at least 1!");                                                    │
│    end                                                             │
│  `endif                                                            │
│  // pragma translate_on                                            │
│                                                                    │
│  endmodule[/patched]                                               │
│                                                                    │
