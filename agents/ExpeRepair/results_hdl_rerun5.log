446         //  force uncacheable requests if the cache is disabled
447         if (!cfg_enable_i) begin
448             st1_req_pma.uncacheable = 1'b1;
449         end
450 
451         //  if either WB or WT is not supported, force write-policy
452         if (!HPDcacheCfg.u.wtEn) begin
453             st1_req_pma.wr_policy_hint = HPDCACHE_WR_POLICY_WB;
454         end
455         if (!HPDcacheCfg.u.wbEn) begin
456             st1_req_pma.wr_policy_hint = HPDCACHE_WR_POLICY_WT;
457         end
458     end
