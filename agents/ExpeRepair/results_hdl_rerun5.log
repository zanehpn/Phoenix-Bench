460     //         In case of replay or physically-indexed cache, the tag and PMA come
461     //         from stage 0. Otherwise, this information come directly from the
462     //         requester in stage 1
463     assign st1_req_tag = st1_req_q.phys_indexed ? st1_req_q.addr_tag : core_req_tag_i;
464 
465     assign st1_req.addr_offset     = st1_req_q.addr_offset;
466     assign st1_req.addr_tag        = st1_req_rtab_q ? st1_req_q.addr_tag : st1_req_tag;
467     assign st1_req.wdata           = st1_req_q.wdata;
468     assign st1_req.op              = st1_req_q.op;
469     assign st1_req.be              = st1_req_q.be;
470     assign st1_req.size            = st1_req_q.size;
471     assign st1_req.sid             = st1_req_q.sid;
472     assign st1_req.tid             = st1_req_q.tid;
473     assign st1_req.need_rsp        = st1_req_q.need_rsp;
474     assign st1_req.phys_indexed    = st1_req_q.phys_indexed;
475     assign st1_req.pma             = st1_req_rtab_q ? st1_req_q.pma : st1_req_pma;
476 
477     //         A requester can ask to abort a request it initiated on the
478     //         previous cycle (stage 0). Useful in case of TLB miss for example
479     assign st1_req_abort           = core_req_abort_i & ~st1_req.phys_indexed;
480 
481     assign st1_req_is_uncacheable  = ~cfg_enable_i | st1_req.pma.uncacheable;
482     assign st1_req_is_load         =         is_load(st1_req.op);
483     assign st1_req_is_store        =        is_store(st1_req.op);
484     assign st1_req_is_amo          =          is_amo(st1_req.op);
485     assign st1_req_is_amo_lr       =       is_amo_lr(st1_req.op);
486     assign st1_req_is_amo_sc       =       is_amo_sc(st1_req.op);
487     assign st1_req_is_amo_swap     =     is_amo_swap(st1_req.op);
488     assign st1_req_is_amo_add      =      is_amo_add(st1_req.op);
489     assign st1_req_is_amo_and      =      is_amo_and(st1_req.op);
490     assign st1_req_is_amo_or       =       is_amo_or(st1_req.op);
491     assign st1_req_is_amo_xor      =      is_amo_xor(st1_req.op);
492     assign st1_req_is_amo_max      =      is_amo_max(st1_req.op);
493     assign st1_req_is_amo_maxu     =     is_amo_maxu(st1_req.op);
494     assign st1_req_is_amo_min      =      is_amo_min(st1_req.op);
495     assign st1_req_is_amo_minu     =     is_amo_minu(st1_req.op);
496     assign st1_req_is_cmo_inval    =    is_cmo_inval(st1_req.op);
497     assign st1_req_is_cmo_flush    =    is_cmo_flush(st1_req.op);
498     assign st1_req_is_cmo_fence    =    is_cmo_fence(st1_req.op);
499     assign st1_req_is_cmo_prefetch = is_cmo_prefetch(st1_req.op);
500 
501     //  Decode write-policy hint
502     assign st1_req_wr_wt           = (st1_req.pma.wr_policy_hint == HPDCACHE_WR_POLICY_WT);
503     assign st1_req_wr_wb           = (st1_req.pma.wr_policy_hint == HPDCACHE_WR_POLICY_WB);
504     assign st1_req_wr_auto         = (st1_req.pma.wr_policy_hint == HPDCACHE_WR_POLICY_AUTO);
