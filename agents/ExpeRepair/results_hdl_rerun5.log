121   output logic                  perf_jump_o,             // we are executing a jump
122                                                          // instruction (j, jr, jal, jalr)
123   output logic                  perf_tbranch_o,          // we are executing a taken branch
124                                                          // instruction
125   input  logic                  instr_is_cheri_i,        // from decoder
126   input  logic                  cheri_ex_valid_i,        // from cheri EX
127   input  logic                  cheri_ex_err_i,
128   input  logic                  cheri_wb_err_i,
129   input  logic  [11:0]          cheri_ex_err_info_i,
130   input  logic  [15:0]          cheri_wb_err_info_i,
131   input  logic                  cheri_branch_req_i,
