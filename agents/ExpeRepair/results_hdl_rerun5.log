366   `ASSERT_IF(IbexExceptionPrioOnehot,
367              $onehot({instr_fetch_err_prio,
368                       illegal_insn_prio,
369                       ecall_insn_prio,
370                       ebrk_insn_prio,
371                       store_err_prio,
