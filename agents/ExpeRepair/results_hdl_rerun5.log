217 
218   ////////////////
219   // Exceptions //
220   ////////////////
221 
222   assign load_err_d  = load_err_i;
223   assign store_err_d = store_err_i;
224 
225   // Decoder doesn't take instr_valid into account, factor it in here.
226   assign ecall_insn      = ecall_insn_i      & instr_valid_i;
227   assign mret_insn       = mret_insn_i       & instr_valid_i;
228   assign dret_insn       = dret_insn_i       & instr_valid_i;
229   assign wfi_insn        = wfi_insn_i        & instr_valid_i;
230   assign ebrk_insn       = ebrk_insn_i       & instr_valid_i;
231   assign csr_pipe_flush  = csr_pipe_flush_i  & instr_valid_i;
232   assign instr_fetch_err = instr_fetch_err_i & instr_valid_i;
233   assign cheri_ex_err    = cheri_ex_err_i & instr_is_cheri_i & instr_valid_i;
234 
235   // "Executing DRET outside of Debug Mode causes an illegal instruction exception."
236   // [Debug Spec v0.13.2, p.41]
237   assign illegal_dret = dret_insn & ~debug_mode_q;
238 
239   // Some instructions can only be executed in M-Mode
240   assign illegal_umode = (priv_mode_i != PRIV_LVL_M) &
241                          // MRET must be in M-Mode. TW means trap WFI to M-Mode.
242                          (mret_insn | (csr_mstatus_tw_i & wfi_insn));
243 
244   assign mret_cheri_asr_err = CHERIoTEn & cheri_pmode_i & ~csr_pcc_perm_sr_i & mret_insn;
245   assign csr_cheri_asr_err  = CHERIoTEn & cheri_pmode_i & ~csr_pcc_perm_sr_i & instr_valid_i & 
246                               csr_access_i & ~illegal_insn_i & ~csr_cheri_always_ok_i;
247 
248   // This is recorded in the illegal_insn_q flop to help timing.  Specifically
249   // it is needed to break the path from ibex_cs_registers/illegal_csr_insn_o
250   // to pc_set_o.  Clear when controller is in FLUSH so it won't remain set
251   // once illegal instruction is handled.
252   // All terms in this expression are qualified by instr_valid_i
253   assign illegal_insn_d = illegal_insn_i | illegal_dret | illegal_umode;
254   assign cheri_ex_err_d = cheri_pmode_i & cheri_ex_err & (ctrl_fsm_cs != FLUSH);
255 
256   assign cheri_asr_err_d = (~illegal_insn_i & csr_cheri_asr_err) | mret_cheri_asr_err;
257 
258   // exception requests
259   // requests are flopped in exc_req_q.  This is cleared when controller is in
260   // the FLUSH state so the cycle following exc_req_q won't remain set for an
261   // exception request that has just been handled.
262   // All terms in this expression are qualified by instr_valid_i
263   assign exc_req_d = (ecall_insn | ebrk_insn | illegal_insn_d | instr_fetch_err | (cheri_pmode_i & cheri_ex_err) | 
264                       cheri_asr_err_d) & (ctrl_fsm_cs != FLUSH);
265   assign exc_req_nc = (ecall_insn | ebrk_insn | illegal_insn_d | instr_fetch_err | cheri_asr_err_d) &
266                       (ctrl_fsm_cs != FLUSH);
267 
268   // LSU exception requests
269   assign exc_req_lsu = store_err_i | load_err_i;
270   assign exc_req_wb  = exc_req_lsu | (cheri_pmode_i & cheri_wb_err_i);
271 
272   assign id_exception_o = exc_req_d;
273   assign id_exception_nc_o = exc_req_nc;
274 
275   // special requests: special instructions, pipeline flushes, exceptions...
276   // All terms in these expressions are qualified by instr_valid_i except exc_req_lsu which can come
277   // from the Writeback stage with no instr_valid_i from the ID stage
278 
279   // These special requests only cause a pipeline flush and in particular don't cause a PC change
280   // that is outside the normal execution flow
281   assign special_req_flush_only = wfi_insn | csr_pipe_flush;
282 
283   // These special requests cause a change in PC
284   assign special_req_pc_change = mret_insn | dret_insn | exc_req_d | exc_req_wb;
285 
286   // generic special request signal, applies to all instructions
287   assign special_req = special_req_pc_change | special_req_flush_only;
288 
289   // Is there an instruction in ID or WB that has yet to complete?
290   assign id_wb_pending = instr_valid_i | ~ready_wb_i;
291 
292   // Exception/fault prioritisation is taken from Table 3.7 of Priviledged Spec v1.11
293   if (WritebackStage) begin : g_wb_exceptions
294     always_comb begin
295       instr_fetch_err_prio = 0;
296       illegal_insn_prio    = 0;
297       ecall_insn_prio      = 0;
298       ebrk_insn_prio       = 0;
299       store_err_prio       = 0;
300       load_err_prio        = 0;
301       cheri_ex_err_prio    = 0;
302       cheri_wb_err_prio    = 0;
303       cheri_asr_err_prio   = 0;
304 
305       // Note that with the writeback stage store/load errors occur on the instruction in writeback,
306       // all other exception/faults occur on the instruction in ID/EX. The faults from writeback
307       // must take priority as that instruction is architecurally ordered before the one in ID/EX.
308       if (store_err_q) begin
309         store_err_prio = 1'b1;
310       end else if (load_err_q) begin
311         load_err_prio  = 1'b1;
312       end else if (cheri_pmode_i & cheri_wb_err_q) begin
313         cheri_wb_err_prio  = 1'b1;
314       end else if (instr_fetch_err) begin
315         instr_fetch_err_prio = 1'b1;
316       end else if (illegal_insn_q) begin
317         illegal_insn_prio = 1'b1;
318       end else if (ecall_insn) begin
319         ecall_insn_prio = 1'b1;
320       end else if (ebrk_insn) begin
321         ebrk_insn_prio = 1'b1;
322       end else if (cheri_pmode_i & cheri_ex_err_q) begin
323         cheri_ex_err_prio = 1'b1;
324       end else if (cheri_asr_err_q) begin
325         cheri_asr_err_prio = 1'b1;
326       end
327     end
328 
329     // Instruction in writeback is generating an exception so instruction in ID must not execute
330     assign wb_exception_o = load_err_q | store_err_q | load_err_i | store_err_i | (cheri_pmode_i & cheri_wb_err_i);
331   end else begin : g_no_wb_exceptions
332     always_comb begin
333       instr_fetch_err_prio = 0;
334       illegal_insn_prio    = 0;
335       ecall_insn_prio      = 0;
336       ebrk_insn_prio       = 0;
337       store_err_prio       = 0;
338       load_err_prio        = 0;
339       cheri_wb_err_prio    = 0;
340       cheri_ex_err_prio    = 0;
341       cheri_asr_err_prio   = 0;
342 
343       if (instr_fetch_err) begin
344         instr_fetch_err_prio = 1'b1;
345       end else if (illegal_insn_q) begin
346         illegal_insn_prio = 1'b1;
347       end else if (ecall_insn) begin
348         ecall_insn_prio = 1'b1;
349       end else if (ebrk_insn) begin
350         ebrk_insn_prio = 1'b1;
351       end else if (cheri_ex_err_q) begin
352         cheri_ex_err_prio  = 1'b1;
353       end else if (store_err_q) begin
354         store_err_prio = 1'b1;
355       end else if (load_err_q) begin
356         load_err_prio  = 1'b1;
357       end else if (cheri_wb_err_q) begin
358         cheri_wb_err_prio  = 1'b1;
359       end else if (cheri_asr_err_q) begin
360         cheri_asr_err_prio = 1'b1;
361       end
362     end
363     assign wb_exception_o = 1'b0;
364   end
