299   // -------------------------
300   // General helper functions
301   // -------------------------
302   function automatic int minimum(int a, int b);
303     return (a < b) ? a : b;
304   endfunction
305 
306   function automatic int maximum(int a, int b);
307     return (a > b) ? a : b;
308   endfunction
309 
310   // -------------------------------------------
311   // Helper functions for FP formats and values
312   // -------------------------------------------
313   // Returns the width of a FP format
314   function automatic int unsigned fp_width(fp_format_e fmt);
315     return FP_ENCODINGS[fmt].exp_bits + FP_ENCODINGS[fmt].man_bits + 1;
316   endfunction
317 
318   // Returns the widest FP format present
319   function automatic int unsigned max_fp_width(fmt_logic_t cfg);
320     automatic int unsigned res = 0;
321     for (int unsigned i = 0; i < NUM_FP_FORMATS; i++)
322       if (cfg[i])
323         res = unsigned'(maximum(res, fp_width(fp_format_e'(i))));
324     return res;
325   endfunction
326 
327   // Returns the narrowest FP format present
328   function automatic int unsigned min_fp_width(fmt_logic_t cfg);
329     automatic int unsigned res = max_fp_width(cfg);
330     for (int unsigned i = 0; i < NUM_FP_FORMATS; i++)
331       if (cfg[i])
332         res = unsigned'(minimum(res, fp_width(fp_format_e'(i))));
333     return res;
334   endfunction
335 
336   // Returns the number of expoent bits for a format
337   function automatic int unsigned exp_bits(fp_format_e fmt);
338     return FP_ENCODINGS[fmt].exp_bits;
339   endfunction
340 
341   // Returns the number of mantissa bits for a format
342   function automatic int unsigned man_bits(fp_format_e fmt);
343     return FP_ENCODINGS[fmt].man_bits;
344   endfunction
345 
346   // Returns the bias value for a given format (as per IEEE 754-2008)
347   function automatic int unsigned bias(fp_format_e fmt);
348     return unsigned'(2**(FP_ENCODINGS[fmt].exp_bits-1)-1); // symmetrical bias
349   endfunction
