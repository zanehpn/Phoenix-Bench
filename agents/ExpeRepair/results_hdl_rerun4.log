16 package fpnew_pkg;
17 
18   // ---------
19   // FP TYPES
20   // ---------
21   // | Enumerator | Format           | Width  | EXP_BITS | MAN_BITS
22   // |:----------:|------------------|-------:|:--------:|:--------:
23   // | FP32       | IEEE binary32    | 32 bit | 8        | 23
24   // | FP64       | IEEE binary64    | 64 bit | 11       | 52
25   // | FP16       | IEEE binary16    | 16 bit | 5        | 10
26   // | FP8        | binary8          |  8 bit | 5        | 2
27   // | FP16ALT    | binary16alt      | 16 bit | 8        | 7
28   // *NOTE:* Add new formats only at the end of the enumeration for backwards compatibilty!
29 
30   // Encoding for a format
31   typedef struct packed {
32     int unsigned exp_bits;
33     int unsigned man_bits;
34   } fp_encoding_t;
35 
36   localparam int unsigned NUM_FP_FORMATS = 5; // change me to add formats
37   localparam int unsigned FP_FORMAT_BITS = $clog2(NUM_FP_FORMATS);
38 
39   // FP formats
40   typedef enum logic [FP_FORMAT_BITS-1:0] {
41     FP32    = 'd0,
42     FP64    = 'd1,
43     FP16    = 'd2,
44     FP8     = 'd3,
45     FP16ALT = 'd4
46     // add new formats here
47   } fp_format_e;
48 
49   // Encodings for supported FP formats
50   localparam fp_encoding_t [0:NUM_FP_FORMATS-1] FP_ENCODINGS  = '{
51     '{8,  23}, // IEEE binary32 (single)
52     '{11, 52}, // IEEE binary64 (double)
53     '{5,  10}, // IEEE binary16 (half)
54     '{5,  2},  // custom binary8
55     '{8,  7}   // custom binary16alt
56     // add new formats here
57   };
58 
59   typedef logic [0:NUM_FP_FORMATS-1]       fmt_logic_t;    // Logic indexed by FP format (for masks)
60   typedef logic [0:NUM_FP_FORMATS-1][31:0] fmt_unsigned_t; // Unsigned indexed by FP format
61 
62   localparam fmt_logic_t CPK_FORMATS = 5'b11000; // FP32 and FP64 can provide CPK only
63 
64   // ---------
65   // INT TYPES
66   // ---------
67   // | Enumerator | Width  |
68   // |:----------:|-------:|
69   // | INT8       |  8 bit |
70   // | INT16      | 16 bit |
71   // | INT32      | 32 bit |
72   // | INT64      | 64 bit |
73   // *NOTE:* Add new formats only at the end of the enumeration for backwards compatibilty!
74 
75   localparam int unsigned NUM_INT_FORMATS = 4; // change me to add formats
76   localparam int unsigned INT_FORMAT_BITS = $clog2(NUM_INT_FORMATS);
77 
78   // Int formats
79   typedef enum logic [INT_FORMAT_BITS-1:0] {
80     INT8,
81     INT16,
82     INT32,
83     INT64
84     // add new formats here
85   } int_format_e;
86 
87   // Returns the width of an INT format by index
88   function automatic int unsigned int_width(int_format_e ifmt);
89     unique case (ifmt)
90       INT8:  return 8;
91       INT16: return 16;
92       INT32: return 32;
93       INT64: return 64;
94       default: begin
95         // pragma translate_off
96         $fatal(1, "Invalid INT format supplied");
97         // pragma translate_on
98         // just return any integer to avoid any latches
99         // hopefully this error is caught by simulation
100         return INT8;
101       end
102     endcase
103   endfunction
104 
105   typedef logic [0:NUM_INT_FORMATS-1] ifmt_logic_t; // Logic indexed by INT format (for masks)
106 
107   // --------------
108   // FP OPERATIONS
109   // --------------
110   localparam int unsigned NUM_OPGROUPS = 4;
111 
112   // Each FP operation belongs to an operation group
113   typedef enum logic [1:0] {
114     ADDMUL, DIVSQRT, NONCOMP, CONV
115   } opgroup_e;
116 
117   localparam int unsigned OP_BITS = 4;
118 
119   typedef enum logic [OP_BITS-1:0] {
120     FMADD, FNMSUB, ADD, MUL,     // ADDMUL operation group
121     DIV, SQRT,                   // DIVSQRT operation group
122     SGNJ, MINMAX, CMP, CLASSIFY, // NONCOMP operation group
123     F2F, F2I, I2F, CPKAB, CPKCD, // CONV operation group
