39 /// * The `rr_arb_tree` data multiplexing scales with Log(`NumIn`). This means that the input to output
40 ///   timing path of this module also scales scales with Log(`NumIn`).
41 /// This implies that in this module the input to output path is always longer than the input to
42 /// register path. As the output data usually also terminates in a register the parameter `FairArb`
43 /// only has implications on the area. When it is `1'b0` a static plus one adder is instantiated.
44 /// If it is `1'b1` two `lzc`, a masking logic stage and a two input multiplexer are instantiated.
45 /// However these are small in respect of the data multiplexers needed, as the width of the `req_i`
46 /// signal is usually less as than `DataWidth`.
47 module rr_arb_tree #(
48   /// Number of inputs to be arbitrated.
49   parameter int unsigned NumIn      = 64,
50   /// Data width of the payload in bits. Not needed if `DataType` is overwritten.
51   parameter int unsigned DataWidth  = 32,
52   /// Data type of the payload, can be overwritten with custom type. Only use of `DataWidth`.
53   parameter type         DataType   = logic [DataWidth-1:0],
54   /// The `ExtPrio` option allows to override the internal round robin counter via the
55   /// `rr_i` signal. This can be useful in case multiple arbiters need to have
56   /// rotating priorities that are operating in lock-step. If static priority arbitration
57   /// is needed, just connect `rr_i` to '0.
58   ///
59   /// Set to 1'b1 to enable.
60   parameter bit          ExtPrio    = 1'b0,
61   /// If `AxiVldRdy` is set, the req/gnt signals are compliant with the AXI style vld/rdy
62   /// handshake. Namely, upstream vld (req) must not depend on rdy (gnt), as it can be deasserted
63   /// again even though vld is asserted. Enabling `AxiVldRdy` leads to a reduction of arbiter
64   /// delay and area.
65   ///
66   /// Set to `1'b1` to treat req/gnt as vld/rdy.
67   parameter bit          AxiVldRdy  = 1'b0,
68   /// The `LockIn` option prevents the arbiter from changing the arbitration
69   /// decision when the arbiter is disabled. I.e., the index of the first request
70   /// that wins the arbitration will be locked in case the destination is not
71   /// able to grant the request in the same cycle.
72   ///
73   /// Set to `1'b1` to enable.
74   parameter bit          LockIn     = 1'b0,
75   /// When set, ensures that throughput gets distributed evenly between all inputs.
76   ///
77   /// Set to `1'b0` to disable.
78   parameter bit          FairArb    = 1'b1,
79   /// Dependent parameter, do **not** overwrite.
80   /// Width of the arbitration priority signal and the arbitrated index.
81   parameter int unsigned IdxWidth   = (NumIn > 32'd1) ? unsigned'($clog2(NumIn)) : 32'd1,
82   /// Dependent parameter, do **not** overwrite.
83   /// Type for defining the arbitration priority and arbitrated index signal.
84   parameter type         idx_t      = logic [IdxWidth-1:0]
</code>
