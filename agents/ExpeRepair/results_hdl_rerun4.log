362   assign mid_pipe_int_fmt_q[0]    = int_fmt_q;
363   assign mid_pipe_tag_q[0]        = inp_pipe_tag_q[NUM_INP_REGS];
364   assign mid_pipe_mask_q[0]       = inp_pipe_mask_q[NUM_INP_REGS];
365   assign mid_pipe_aux_q[0]        = inp_pipe_aux_q[NUM_INP_REGS];
366   assign mid_pipe_valid_q[0]      = inp_pipe_valid_q[NUM_INP_REGS];
367   // Input stage: Propagate pipeline ready signal to input pipe
368   assign inp_pipe_ready[NUM_INP_REGS] = mid_pipe_ready[0];
369 
370   // Generate the register stages
371   for (genvar i = 0; i < NUM_MID_REGS; i++) begin : gen_inside_pipeline
372     // Internal register enable for this stage
373     logic reg_ena;
374     // Determine the ready signal of the current stage - advance the pipeline:
375     // 1. if the next stage is ready for our data
376     // 2. if the next stage only holds a bubble (not valid) -> we can pop it
377     assign mid_pipe_ready[i] = mid_pipe_ready[i+1] | ~mid_pipe_valid_q[i+1];
378     // Valid: enabled by ready signal, synchronous clear with the flush signal
379     `FFLARNC(mid_pipe_valid_q[i+1], mid_pipe_valid_q[i], mid_pipe_ready[i], flush_i, 1'b0, clk_i, rst_ni)
380     // Enable register if pipleine ready and a valid data item is present
381     assign reg_ena = (mid_pipe_ready[i] & mid_pipe_valid_q[i]) | reg_ena_i[NUM_INP_REGS + i];
382     // Generate the pipeline registers within the stages, use enable-registers
383     `FFL(mid_pipe_input_sign_q[i+1], mid_pipe_input_sign_q[i], reg_ena, '0)
384     `FFL(mid_pipe_input_exp_q[i+1],  mid_pipe_input_exp_q[i],  reg_ena, '0)
385     `FFL(mid_pipe_input_mant_q[i+1], mid_pipe_input_mant_q[i], reg_ena, '0)
386     `FFL(mid_pipe_dest_exp_q[i+1],   mid_pipe_dest_exp_q[i],   reg_ena, '0)
387     `FFL(mid_pipe_src_is_int_q[i+1], mid_pipe_src_is_int_q[i], reg_ena, '0)
388     `FFL(mid_pipe_dst_is_int_q[i+1], mid_pipe_dst_is_int_q[i], reg_ena, '0)
389     `FFL(mid_pipe_info_q[i+1],       mid_pipe_info_q[i],       reg_ena, '0)
390     `FFL(mid_pipe_mant_zero_q[i+1],  mid_pipe_mant_zero_q[i],  reg_ena, '0)
391     `FFL(mid_pipe_op_mod_q[i+1],     mid_pipe_op_mod_q[i],     reg_ena, '0)
392     `FFL(mid_pipe_rnd_mode_q[i+1],   mid_pipe_rnd_mode_q[i],   reg_ena, fpnew_pkg::RNE)
393     `FFL(mid_pipe_src_fmt_q[i+1],    mid_pipe_src_fmt_q[i],    reg_ena, fpnew_pkg::fp_format_e'(0))
394     `FFL(mid_pipe_dst_fmt_q[i+1],    mid_pipe_dst_fmt_q[i],    reg_ena, fpnew_pkg::fp_format_e'(0))
395     `FFL(mid_pipe_int_fmt_q[i+1],    mid_pipe_int_fmt_q[i],    reg_ena, fpnew_pkg::int_format_e'(0))
396     `FFL(mid_pipe_tag_q[i+1],        mid_pipe_tag_q[i],        reg_ena, TagType'('0))
397     `FFL(mid_pipe_mask_q[i+1],       mid_pipe_mask_q[i],       reg_ena, '0)
398     `FFL(mid_pipe_aux_q[i+1],        mid_pipe_aux_q[i],        reg_ena, AuxType'('0))
399   end
400   // Output stage: assign selected pipe outputs to signals for later use
401   assign input_sign_q      = mid_pipe_input_sign_q[NUM_MID_REGS];
402   assign input_exp_q       = mid_pipe_input_exp_q[NUM_MID_REGS];
403   assign input_mant_q      = mid_pipe_input_mant_q[NUM_MID_REGS];
404   assign destination_exp_q = mid_pipe_dest_exp_q[NUM_MID_REGS];
405   assign src_is_int_q      = mid_pipe_src_is_int_q[NUM_MID_REGS];
406   assign dst_is_int_q      = mid_pipe_dst_is_int_q[NUM_MID_REGS];
407   assign info_q            = mid_pipe_info_q[NUM_MID_REGS];
408   assign mant_is_zero_q    = mid_pipe_mant_zero_q[NUM_MID_REGS];
409   assign op_mod_q2         = mid_pipe_op_mod_q[NUM_MID_REGS];
410   assign rnd_mode_q        = mid_pipe_rnd_mode_q[NUM_MID_REGS];
411   assign src_fmt_q2        = mid_pipe_src_fmt_q[NUM_MID_REGS];
412   assign dst_fmt_q2        = mid_pipe_dst_fmt_q[NUM_MID_REGS];
413   assign int_fmt_q2        = mid_pipe_int_fmt_q[NUM_MID_REGS];
414 
415   // --------
416   // Casting
417   // --------
418   logic [INT_EXP_WIDTH-1:0] final_exp;        // after eventual adjustments
419 
420   logic [2*INT_MAN_WIDTH:0]  preshift_mant;    // mantissa before final shift
421   logic [2*INT_MAN_WIDTH:0]  destination_mant; // mantissa from shifter, with rnd bit
422   logic [SUPER_MAN_BITS-1:0] final_mant;       // mantissa after adjustments
423   logic [MAX_INT_WIDTH-1:0]  final_int;        // integer shifted in position
424 
425   logic [$clog2(INT_MAN_WIDTH+1)-1:0] denorm_shamt; // shift amount for denormalization
426 
427   logic [1:0] fp_round_sticky_bits, int_round_sticky_bits, round_sticky_bits;
428   logic       of_before_round, uf_before_round;
429 
430 
431   // Perform adjustments to mantissa and exponent
432   always_comb begin : cast_value
433     // Default assignment
434     final_exp       = unsigned'(destination_exp_q); // take exponent as is, only look at lower bits
435     preshift_mant   = '0;  // initialize mantissa container with zeroes
436     denorm_shamt    = SUPER_MAN_BITS - fpnew_pkg::man_bits(dst_fmt_q2); // right of mantissa
437     of_before_round = 1'b0;
438     uf_before_round = 1'b0;
439 
440     // Place mantissa to the left of the shifter
441     preshift_mant = input_mant_q << (INT_MAN_WIDTH + 1);
442 
443     // Handle INT casts
444     if (dst_is_int_q) begin
445       // By default right shift mantissa to be an integer
446       denorm_shamt = unsigned'(MAX_INT_WIDTH - 1 - input_exp_q);
447       // overflow: when converting to unsigned the range is larger by one
448       if ((input_exp_q >= signed'(fpnew_pkg::int_width(int_fmt_q2) - 1 + op_mod_q2))    // Exponent larger than max int range,
449           && !(!op_mod_q2                                                               // unless cast to signed int
450                && input_sign_q                                                          // and input value is larges negative int value
451                && (input_exp_q == signed'(fpnew_pkg::int_width(int_fmt_q2) - 1))
452                && (input_mant_q == {1'b1, {INT_MAN_WIDTH-1{1'b0}}}))) begin
453         denorm_shamt    = '0; // prevent shifting
454         of_before_round = 1'b1;
455       // underflow
456       end else if (input_exp_q < -1) begin
457         denorm_shamt    = MAX_INT_WIDTH + 1; // all bits go to the sticky
458         uf_before_round = 1'b1;
459       end
460     // Handle FP over-/underflows
461     end else begin
462       // Infinities
463       if (~src_is_int_q && info_q.is_inf) begin
464         final_exp       = unsigned'(2**fpnew_pkg::exp_bits(dst_fmt_q2)-1); // largest exponent
465         preshift_mant   = '0;
466       // Overflow (for proper rounding)
467       end else if (destination_exp_q >= signed'(2**fpnew_pkg::exp_bits(dst_fmt_q2))-1) begin
468         final_exp       = unsigned'(2**fpnew_pkg::exp_bits(dst_fmt_q2)-2); // largest normal value
469         preshift_mant   = '1;                           // largest normal value and RS bits set
