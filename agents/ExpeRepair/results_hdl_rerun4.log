383     //  Decoding of the request in stage 0
384     //  {{{
385     always_comb
386     begin : st0_req_pma_comb
387         st0_req_pma = core_req_i.pma;
388 
389         //  force uncacheable requests if the cache is disabled
390         if (!cfg_enable_i) begin
391             st0_req_pma.uncacheable = 1'b1;
392         end
393 
394         //  if either WB or WT is not supported, force write-policy
395         if (!HPDcacheCfg.u.wtEn) begin
396             st0_req_pma.wr_policy_hint = HPDCACHE_WR_POLICY_WB;
397         end
398         if (!HPDcacheCfg.u.wbEn) begin
399             st0_req_pma.wr_policy_hint = HPDCACHE_WR_POLICY_WT;
400         end
401     end
402 
403     //     Select between request in the replay table or a new core requests
404     assign st0_req.addr_offset  = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.addr_offset
405                                                          : core_req_i.addr_offset;
406     assign st0_req.addr_tag     = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.addr_tag
407                                                          : core_req_i.addr_tag;
408     assign st0_req.wdata        = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.wdata
409                                                          : core_req_i.wdata;
410     assign st0_req.op           = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.op
411                                                          : core_req_i.op;
412     assign st0_req.be           = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.be
413                                                          : core_req_i.be;
414     assign st0_req.size         = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.size
415                                                          : core_req_i.size;
416     assign st0_req.sid          = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.sid
417                                                          : core_req_i.sid;
418     assign st0_req.tid          = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.tid
419                                                          : core_req_i.tid;
420     assign st0_req.need_rsp     = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.need_rsp
421                                                          : core_req_i.need_rsp;
422     assign st0_req.phys_indexed = st0_rtab_pop_try_valid ? 1'b1 :
423                                                            core_req_i.phys_indexed;
424     assign st0_req.pma          = st0_rtab_pop_try_valid ? st0_rtab_pop_try_req.req.pma
425                                                          : st0_req_pma;
426 
427     //     Check if the request from the RTAB has been tagged with an error
428     assign st0_req_is_error = st0_rtab_pop_try_valid & st0_rtab_pop_try_error;
429 
430     //     Decode operation in stage 0
431     assign st0_req_is_uncacheable  =     st0_req.pma.uncacheable;
432     assign st0_req_is_load         =         is_load(st0_req.op);
433     assign st0_req_is_store        =        is_store(st0_req.op);
434     assign st0_req_is_amo          =          is_amo(st0_req.op);
435     assign st0_req_is_cmo_fence    =    is_cmo_fence(st0_req.op);
436     assign st0_req_is_cmo_inval    =    is_cmo_inval(st0_req.op);
437     assign st0_req_is_cmo_prefetch = is_cmo_prefetch(st0_req.op);
438     //  }}}
439 
440     //  Decode operation in stage 1
441     //  {{{
442     always_comb
443     begin : st1_req_pma_comb
444         st1_req_pma = st1_req_q.phys_indexed ? st1_req_q.pma : core_req_pma_i;
445 
446         //  force uncacheable requests if the cache is disabled
447         if (!cfg_enable_i) begin
448             st1_req_pma.uncacheable = 1'b1;
449         end
450 
451         //  if either WB or WT is not supported, force write-policy
452         if (!HPDcacheCfg.u.wtEn) begin
453             st1_req_pma.wr_policy_hint = HPDCACHE_WR_POLICY_WB;
454         end
455         if (!HPDcacheCfg.u.wbEn) begin
456             st1_req_pma.wr_policy_hint = HPDCACHE_WR_POLICY_WT;
457         end
458     end
459 
460     //         In case of replay or physically-indexed cache, the tag and PMA come
461     //         from stage 0. Otherwise, this information come directly from the
462     //         requester in stage 1
463     assign st1_req_tag = st1_req_q.phys_indexed ? st1_req_q.addr_tag : core_req_tag_i;
464 
465     assign st1_req.addr_offset     = st1_req_q.addr_offset;
466     assign st1_req.addr_tag        = st1_req_rtab_q ? st1_req_q.addr_tag : st1_req_tag;
467     assign st1_req.wdata           = st1_req_q.wdata;
468     assign st1_req.op              = st1_req_q.op;
469     assign st1_req.be              = st1_req_q.be;
470     assign st1_req.size            = st1_req_q.size;
471     assign st1_req.sid             = st1_req_q.sid;
472     assign st1_req.tid             = st1_req_q.tid;
473     assign st1_req.need_rsp        = st1_req_q.need_rsp;
474     assign st1_req.phys_indexed    = st1_req_q.phys_indexed;
475     assign st1_req.pma             = st1_req_rtab_q ? st1_req_q.pma : st1_req_pma;
476 
477     //         A requester can ask to abort a request it initiated on the
478     //         previous cycle (stage 0). Useful in case of TLB miss for example
479     assign st1_req_abort           = core_req_abort_i & ~st1_req.phys_indexed;
480 
481     assign st1_req_is_uncacheable  = ~cfg_enable_i | st1_req.pma.uncacheable;
482     assign st1_req_is_load         =         is_load(st1_req.op);
483     assign st1_req_is_store        =        is_store(st1_req.op);
484     assign st1_req_is_amo          =          is_amo(st1_req.op);
485     assign st1_req_is_amo_lr       =       is_amo_lr(st1_req.op);
486     assign st1_req_is_amo_sc       =       is_amo_sc(st1_req.op);
487     assign st1_req_is_amo_swap     =     is_amo_swap(st1_req.op);
488     assign st1_req_is_amo_add      =      is_amo_add(st1_req.op);
489     assign st1_req_is_amo_and      =      is_amo_and(st1_req.op);
490     assign st1_req_is_amo_or       =       is_amo_or(st1_req.op);
491     assign st1_req_is_amo_xor      =      is_amo_xor(st1_req.op);
492     assign st1_req_is_amo_max      =      is_amo_max(st1_req.op);
493     assign st1_req_is_amo_maxu     =     is_amo_maxu(st1_req.op);
494     assign st1_req_is_amo_min      =      is_amo_min(st1_req.op);
495     assign st1_req_is_amo_minu     =     is_amo_minu(st1_req.op);
496     assign st1_req_is_cmo_inval    =    is_cmo_inval(st1_req.op);
497     assign st1_req_is_cmo_flush    =    is_cmo_flush(st1_req.op);
498     assign st1_req_is_cmo_fence    =    is_cmo_fence(st1_req.op);
499     assign st1_req_is_cmo_prefetch = is_cmo_prefetch(st1_req.op);
500 
501     //  Decode write-policy hint
502     assign st1_req_wr_wt           = (st1_req.pma.wr_policy_hint == HPDCACHE_WR_POLICY_WT);
503     assign st1_req_wr_wb           = (st1_req.pma.wr_policy_hint == HPDCACHE_WR_POLICY_WB);
504     assign st1_req_wr_auto         = (st1_req.pma.wr_policy_hint == HPDCACHE_WR_POLICY_AUTO);
505     //  }}}
