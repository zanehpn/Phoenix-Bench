18 ////////////////////////////////////////////////////////////////////////////////
19 //                                                                            //
20 // Authors:        Oivind Ekelund - oivind.ekelund@silabs.com                 //
21 //                                                                            //
22 // Description:    Assertions for RVFI                                        //
23 //                                                                            //
24 ////////////////////////////////////////////////////////////////////////////////
25 
26 module cv32e40s_rvfi_sva
27   import uvm_pkg::*;
28   import cv32e40s_pkg::*;
29   import cv32e40s_rvfi_pkg::*;
30   #(
31     parameter bit SMCLIC = 0
32 )
33 (
34    input logic             clk_i,
35    input logic             rst_ni,
36 
37    input logic             rvfi_valid,
38    input rvfi_intr_t       rvfi_intr,
39    input rvfi_trap_t       rvfi_trap,
40    input logic [2:0]       rvfi_dbg,
41 
42    input ctrl_fsm_t        ctrl_fsm_i,
43    input logic [31:0]      rvfi_csr_dcsr_rdata,
44    input logic [31:0]      rvfi_csr_mcause_rdata,
45    input logic [31:0]      rvfi_pc_rdata,
46    input logic [24:0]      mtvec_addr_i,
47    input logic [31:0]      rvfi_csr_mie_rdata,
48    input logic [31:0]      rvfi_csr_mip_rdata,
49    input logic             irq_ack,
50    input logic             dbg_ack,
51    input logic             ebreak_in_wb_i,
52    input rvfi_intr_t [3:0] in_trap,
53    input logic [3:0] [2:0] debug_cause,
54 
55    input logic             if_valid_i,
56    input logic             id_ready_i,
57    input logic [31:0]      pc_if_i,
58    input inst_resp_t       prefetch_instr_if_i,
59    input logic             prefetch_compressed_if_i,
60    input rvfi_obi_instr_t  obi_instr_if
61 );
62 
63 rvfi_trap_t rvfi_trap_q; // RVFI trap value of the previous valid rvfi instruction
64 
65 always_ff @(posedge clk_i, negedge rst_ni) begin
66   if (rst_ni == 1'b0) begin
67     rvfi_trap_q <= '0;
68   end else begin
69     if (rvfi_valid) begin
70       rvfi_trap_q <= rvfi_trap;
71     end
72   end
73 end
74 
75   // Check that irq_ack results in RVFI capturing a trap
76   // Ideally, we should assert that every irq_ack eventually leads to rvfi_intr,
77   // but since there can be an infinite delay between irq_ack and rvfi_intr (e.g. because of bus stalls), we're settling for asserting
78   // that irq_ack leads to RVFI capturing a trap (in_trap[IF_STAGE] = 1)
79 
80   // todo: for CLIC, the irq ack comes when the pointer fetch is initiated
81   // We should probably set in_trap.intr for the first intstruction of the handler, which comes after the second fetch.
82   if (!SMCLIC) begin
83     a_irq_ack_rvfi_capture :
84       assert property (@(posedge clk_i) disable iff (!rst_ni)
85                       (irq_ack |=> in_trap[STAGE_IF].intr))
86         else `uvm_error("rvfi", "irq_ack not captured by RVFI")
87   end
88 
89 
90   // Helper signal, indicating debug cause
91   // Special case for debug entry from debug mode caused by EBREAK as it is not captured by debug_cause_i
92   logic [2:0] debug_cause_int;
93   assign debug_cause_int = ebreak_in_wb_i ? 3'h1 : ctrl_fsm_i.debug_cause;
94 
95   // Check that dbg_ack results in RVFI capturing a debug_cause
96   // Ideally, we should assert that every dbg_ack eventually leads to rvfi_dbg,
97   // but since there can be an infinite delay between dbg_ack and rvfi_dbg (e.g. because of bus stalls), we're settling for asserting
98   // that dbg_ack leads to RVFI capturing the debug cause
99   a_dbg_ack_rvfi_capture :
100     assert property (@(posedge clk_i) disable iff (!rst_ni)
101                      (dbg_ack |=> (debug_cause[STAGE_IF] == $past(debug_cause_int))))
102             else `uvm_error("rvfi", "dbg_ack did not lead to rvfi_dbg != 0")
103 
104   // Helper signal, indicate that a debug entry was signaled on RVFI
105   logic  rvfi_dbg_ack;
106   assign rvfi_dbg_ack = |rvfi_dbg && rvfi_valid;
107 
108   // Helper signal, count outstanding dbg_ack
109   bit [1:0] dbg_ack_cnt;
110   always_ff @(posedge clk_i or negedge rst_ni) begin
111     if (!rst_ni) begin
112       dbg_ack_cnt <= '0;
113     end
114     else begin
115       if (dbg_ack && !rvfi_dbg_ack) begin
116         dbg_ack_cnt <= dbg_ack_cnt+2'd1;
117       end
118       else if (rvfi_dbg_ack && !dbg_ack) begin
119         dbg_ack_cnt <= dbg_ack_cnt-2'd1;
120       end
121     end
122   end
123   // Check that rvfi_dbg_ack is preceeded by dbg_ack
124   a_rvfi_dbg_dbg_ack :
125     assert property (@(posedge clk_i) disable iff (!rst_ni)
126                      (rvfi_dbg_ack |-> (dbg_ack_cnt != 0)))
127       else `uvm_error("rvfi", "rvfi_dbg not preceeded by dbg_ack")
128 
129 
130   // Sequence used to locate rvfi_valid following rvfi_valid with prereq set
131   sequence s_goto_next_rvfi_valid(prereq);
132     (prereq && rvfi_valid) ##1 rvfi_valid[->1];
133   endsequence
134 
135   logic no_debug;
136 
137   // Indicate debug mode, or single stepping
138   assign no_debug = !(rvfi_csr_dcsr_rdata[2] || ctrl_fsm_i.debug_mode);
139 
140   // rvfi_trap should always be followed by rvfi_intr (as long as we're not in debug mode)
141   a_rvfi_trap_intr :
142     assert property (@(posedge clk_i) disable iff (!rst_ni)
143                      no_debug throughout s_goto_next_rvfi_valid(|rvfi_trap) |->
144                      rvfi_intr.intr)
145       else `uvm_error("rvfi", "rvfi_trap not followed by rvfi_intr")
146 
147   // rvfi_trap[2] should always be followed by rvfi_dbg
148   a_rvfi_trap_dbg :
149     assert property (@(posedge clk_i) disable iff (!rst_ni)
150                      s_goto_next_rvfi_valid(rvfi_trap.debug) |->
151                      rvfi_dbg != '0)
152       else `uvm_error("rvfi", "rvfi_trap.debug not followed by rvfi_dbg")
153 
154   // Exception code in rvfi_trap.exception_cause should align with mcause exception cause in the following retired instruction
155   // This is exempt if we have an NMI, because NMI will result in mcause being updated in between retired instructions.
156   // Also, in debug mode, mcause is not updated.
157   a_rvfi_trap_mcause_align:
158     assert property (@(posedge clk_i) disable iff (!rst_ni)
159                     (no_debug && !ctrl_fsm_i.pending_nmi) throughout s_goto_next_rvfi_valid(|rvfi_trap) |->
160                      rvfi_intr.intr && (rvfi_csr_mcause_rdata[5:0] == rvfi_trap_q.exception_cause))
161       else `uvm_error("rvfi", "rvfi_trap.exception_cause not consistent with mcause[5:0] in following retired instruction")
162 
163   // Exception code in rvfi_trap[11:9] should align with rvfi_dbg the following retired instruction
164   a_rvfi_trap_rvfi_dbg_align:
165     assert property (@(posedge clk_i) disable iff (!rst_ni)
166                      s_goto_next_rvfi_valid(rvfi_trap.debug) |->
167                      rvfi_dbg == rvfi_trap_q.debug_cause)
168      else `uvm_error("rvfi", "rvfi_trap.debug_cause not consistent with rvfi_dbg in following retired instruction")
169
</code>
