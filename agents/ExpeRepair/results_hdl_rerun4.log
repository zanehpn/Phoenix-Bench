841               end
842             end
843             cheri_asr_err_prio: begin
844               exc_cause_o = EXC_CAUSE_CHERI_FAULT;
845               //csr_mtval_o = instr_is_compressed_i ? {16'b0, instr_compressed_i} : instr_i;
846               csr_mtval_o = {21'b0, 1'b1, 5'h0, 5'h18};  // S=1, cap_idx=0 (pcc), err=0x18
847             end
848 
849             default: ;
850           endcase
851         end else begin
852           // special instructions and pipeline flushes
853           if (mret_insn) begin
854             pc_mux_o              = PC_ERET;
855             pc_set_o              = 1'b1;
856             csr_restore_mret_id_o = 1'b1;
857             if (nmi_mode_q) begin
858               nmi_mode_d          = 1'b0; // exit NMI mode
859             end
860           end else if (dret_insn) begin
861             pc_mux_o              = PC_DRET;
862             pc_set_o              = 1'b1;
863             debug_mode_d          = 1'b0;
864             csr_restore_dret_id_o = 1'b1;
865           end else if (wfi_insn) begin
866             ctrl_fsm_ns           = WAIT_SLEEP;
867           end else if (csr_pipe_flush && handle_irq) begin
868             // start handling IRQs when doing CSR-related pipeline flushes
869             ctrl_fsm_ns           = IRQ_TAKEN;
870           end
871         end // exc_req_q
872 
873         // Entering debug mode due to either single step or debug_req. Ensure
874         // registers are set for exception but then enter debug handler rather
875         // than exception handler [Debug Spec v0.13.2, p.44]
876         // Leave all other signals as is to ensure CSRs and PC get set as if
877         // core was entering exception handler, entry to debug mode will then
878         // see the appropriate state and setup dpc correctly.
879         // If an EBREAK instruction is causing us to enter debug mode on the
880         // same cycle as a debug_req or single step, honor the EBREAK and
881         // proceed to DBG_TAKEN_ID.
882         if (enter_debug_mode_prio_q && !(ebrk_insn_prio && ebreak_into_debug)) begin
883           ctrl_fsm_ns = DBG_TAKEN_IF;
884         end
885       end // FLUSH
886 
887       default: begin
888         instr_req_o = 1'b0;
889         ctrl_fsm_ns = RESET;
890       end
891     endcase
892   end
893 
894   assign flush_id_o = flush_id;
895 
896   // signal to CSR when in debug mode
897   assign debug_mode_o = debug_mode_q;
898 
899   // signal to CSR when in an NMI handler (for nested exception handling)
900   assign nmi_mode_o = nmi_mode_q;
901 
902   ///////////////////
903   // Stall control //
904   ///////////////////
905 
906   // If high current instruction cannot complete this cycle. Either because it needs more cycles to
907   // finish (stall_id_i) or because the writeback stage cannot accept it yet (stall_wb_i). If there
908   // is no writeback stage stall_wb_i is a constant 0.
909   assign stall = stall_id_i | stall_wb_i;
