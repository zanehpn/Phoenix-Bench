1118         .priv_lvl_i           ( priv_lvl           ),
1119 
1120         // To/from with cs_registers
1121         .mip_o                ( mip                )
1122       );
1123 
1124       // Tie off unused irq_id_ctrl bits
1125       assign irq_id_ctrl[9:5] = 5'b00000;
1126 
1127       // CLIC shv not used in basic mode
1128       assign irq_clic_shv = 1'b0;
1129       assign irq_clic_level = 8'h00;
1130       assign irq_clic_priv = 2'b0;
1131 
