104   logic [LineSizeECC-1:0]                 data_rdata_ic1 [IC_NUM_WAYS];
105   logic [LineSizeECC-1:0]                 hit_data_ecc_ic1;
106   logic [IC_LINE_SIZE-1:0]                hit_data_ic1;
107   logic                                   lookup_valid_ic1;
108   logic [ADDR_W-1:IC_INDEX_HI+1]          lookup_addr_ic1;
109   logic [IC_NUM_WAYS-1:0]                 tag_match_ic1;
