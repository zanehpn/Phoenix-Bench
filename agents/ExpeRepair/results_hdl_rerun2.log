586     dcsr_d       = dcsr_q;
587     depc_d       = {csr_wdata_int[31:1], 1'b0};
588     depc_en      = 1'b0;
589     dscratch0_en = 1'b0;
590     dscratch1_en = 1'b0;
591 
592     mstack_en      = 1'b0;
593     mstack_d.mpie  = mstatus_q.mpie;
594     mstack_d.mpp   = mstatus_q.mpp;
595     mstack_epc_d   = mepc_q;
596     mstack_cause_d = mcause_q;
