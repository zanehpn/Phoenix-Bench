640     ibex_branch_predict branch_predict_i (
641       .clk_i        (clk_i),
642       .rst_ni       (rst_ni),
643       .fetch_rdata_i(fetch_rdata),
644       .fetch_pc_i   (fetch_addr),
645       .fetch_valid_i(fetch_valid),
