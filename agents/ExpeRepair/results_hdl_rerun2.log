424   /////////////////////////////////////////////////////////////////////////////////////////////
425   // Big Endian Byte Swapper
426   //  hart works little-endian internally
427   //  swap the bytes when read from big-endian memory
428   /////////////////////////////////////////////////////////////////////////////////////////////
429 
430   if (P.BIGENDIAN_SUPPORTED) begin:endian
431     endianswap #(P.LLEN) storeswap(.BigEndianM, .a(LittleEndianWriteDataM), .y(LSUWriteDataM));
432     endianswap #(P.LLEN) loadswap(.BigEndianM, .a(ReadDataWordMuxM), .y(LittleEndianReadDataWordM));
433   end else begin
434     assign LSUWriteDataM = LittleEndianWriteDataM;
435     assign LittleEndianReadDataWordM = ReadDataWordMuxM;
436   end
</code>
