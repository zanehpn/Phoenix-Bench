291   /////////////
292   // LSU Mux //
293   /////////////
294 
295   // Misaligned loads/stores result in two aligned loads/stores, compute second address
296   assign alu_op_a_mux_sel = lsu_addr_incr_req_i ? OP_A_FWD        : alu_op_a_mux_sel_dec;
297   assign alu_op_b_mux_sel = lsu_addr_incr_req_i ? OP_B_IMM        : alu_op_b_mux_sel_dec;
298   assign imm_b_mux_sel    = lsu_addr_incr_req_i ? IMM_B_INCR_ADDR : imm_b_mux_sel_dec;
299 
300   ///////////////////
301   // Operand MUXES //
302   ///////////////////
303 
304   // Main ALU immediate MUX for Operand A
305   assign imm_a = (imm_a_mux_sel == IMM_A_Z) ? zimm_rs1_type : '0;
306 
307   // Main ALU MUX for Operand A
308   always_comb begin : alu_operand_a_mux
309     unique case (alu_op_a_mux_sel)
310       OP_A_REG_A:  alu_operand_a = rf_rdata_a_fwd;
311       OP_A_FWD:    alu_operand_a = lsu_addr_last_i;
312       OP_A_CURRPC: alu_operand_a = pc_id_i;
313       OP_A_IMM:    alu_operand_a = imm_a;
314       default:     alu_operand_a = pc_id_i;
315     endcase
316   end
317 
318   if (BranchTargetALU) begin : g_btalu_muxes
319     // Branch target ALU operand A mux
320     always_comb begin : bt_operand_a_mux
321       unique case (bt_a_mux_sel)
322         OP_A_REG_A:  bt_a_operand_o = rf_rdata_a_fwd;
323         OP_A_CURRPC: bt_a_operand_o = pc_id_i;
324         default:     bt_a_operand_o = pc_id_i;
325       endcase
326     end
327 
328     // Branch target ALU operand B mux
329     always_comb begin : bt_immediate_b_mux
330       unique case (bt_b_mux_sel)
331         IMM_B_I:         bt_b_operand_o = imm_i_type;
332         IMM_B_B:         bt_b_operand_o = imm_b_type;
333         IMM_B_J:         bt_b_operand_o = imm_j_type;
334         IMM_B_INCR_PC:   bt_b_operand_o = instr_is_compressed_i ? 32'h2 : 32'h4;
335         default:         bt_b_operand_o = instr_is_compressed_i ? 32'h2 : 32'h4;
336       endcase
337     end
338 
339     // Reduced main ALU immediate MUX for Operand B
340     always_comb begin : immediate_b_mux
341       unique case (imm_b_mux_sel)
342         IMM_B_I:         imm_b = imm_i_type;
343         IMM_B_S:         imm_b = imm_s_type;
344         IMM_B_U:         imm_b = imm_u_type;
345         IMM_B_INCR_PC:   imm_b = instr_is_compressed_i ? 32'h2 : 32'h4;
346         IMM_B_INCR_ADDR: imm_b = 32'h4;
347         default:         imm_b = 32'h4;
348       endcase
349     end
