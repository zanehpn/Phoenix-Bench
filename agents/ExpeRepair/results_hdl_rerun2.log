268   /////////////////////////////////////////////////////////////////////////////////////////////
269   // Memory System (options)
270   // 1. DTIM
271   // 2. DTIM and bus
272   // 3. Bus
273   // 4. Cache and bus
274   /////////////////////////////////////////////////////////////////////////////////////////////
275 
276   // Pause IEU memory request if TLB miss.  After TLB fill, replay request.
277   // Discard memory request on pipeline flush
278   assign LSUFlushW = HPTWFlushW | FlushW;
279 
280   if (P.DTIM_SUPPORTED) begin : dtim
281     logic [P.PA_BITS-1:0] DTIMAdr;
282     logic [1:0]           DTIMMemRWM;
283 
284     // The DTIM uses untranslated addresses, so it is not compatible with virtual memory.
285     mux2 #(P.PA_BITS) DTIMAdrMux(IEUAdrExtE[P.PA_BITS-1:0], IEUAdrExtM[P.PA_BITS-1:0], MemRWM[0], DTIMAdr);
286     assign DTIMMemRWM = SelDTIM ? LSURWM : 0;
287     dtim #(P) dtim(.clk, .reset, .ce(~GatedStallW),
288               .MemRWM(DTIMMemRWM),
289               .DTIMAdr, .FlushW(LSUFlushW), .WriteDataM(LSUWriteDataM),
290               .ReadDataWordM(DTIMReadDataWordM[P.LLEN-1:0]), .ByteMaskM(ByteMaskM));
291   end else
292     assign DTIMReadDataWordM = '0;
293   if (P.BUS_SUPPORTED) begin : bus
294     if(P.DCACHE_SUPPORTED) begin : dcache
295       localparam   LLENWORDSPERLINE = P.DCACHE_LINELENINBITS/P.LLEN;             // Number of LLEN words in cacheline
296       localparam   LLENLOGBWPL = $clog2(LLENWORDSPERLINE);                       // Log2 of ^
297       localparam   BEATSPERLINE = P.DCACHE_LINELENINBITS/P.AHBW;                 // Number of AHBW words (beats) in cacheline
298       localparam   AHBWLOGBWPL = $clog2(BEATSPERLINE);                           // Log2 of ^
299       localparam   LINELEN = P.DCACHE_LINELENINBITS;                             // Number of bits in cacheline
300       localparam   LLENPOVERAHBW = P.LLEN / P.AHBW;                              // Number of AHB beats in a LLEN word. AHBW cannot be larger than LLEN. (implementation limitation)
301       localparam   CACHEWORDLEN = P.ZICCLSM_SUPPORTED ? 2*P.LLEN : P.LLEN;       // Width of the cache's input and output data buses.  Misaligned doubles width for fast access
302 
303       logic [LINELEN-1:0]      FetchBuffer;                                      // Temporary buffer to hold partially fetched cacheline
304       logic [P.PA_BITS-1:0]    DCacheBusAdr;                                     // Cacheline address to fetch or writeback.
305       logic [AHBWLOGBWPL-1:0]  BeatCount;                                        // Position within a cacheline.  ahbcacheinterface to cache
306       logic                    DCacheBusAck;                                     // ahbcacheinterface completed fetch or writeback
307       logic                    SelBusBeat;                                       // ahbcacheinterface selects position in cacheline with BeatCount
308       logic [1:0]              CacheBusRW;                                       // Cache sends request to ahbcacheinterface
309       logic [1:0]              BusRW;                                            // Uncached bus memory access
310       logic                    CacheableOrFlushCacheM;                           // Memory address is cacheable or operation is a cache flush
311       logic [1:0]              CacheRWM;                                         // Cache read (10), write (01), AMO (11)
312       logic                    FlushDCache;                                      // Suppress d cache flush if there is an ITLB miss.
313       logic                    BusCMOZero;
314       logic [3:0]              CacheCMOpM;
315       logic                    BusAtomic;
316 
317       if(P.ZICBOZ_SUPPORTED) begin
318         assign BusCMOZero = LSUCMOpM[3] & ~CacheableM;
319         assign CacheCMOpM = (CacheableM & ~SelHPTW) ? CMOpM : '0;
320         assign BusAtomic = AtomicM[1] & ~CacheableM;
321       end else begin
322         assign BusCMOZero = 1'b0;
323         assign CacheCMOpM = '0;
324         assign BusAtomic = 1'b0;
325       end
326       assign BusRW = (~CacheableM & ~SelDTIM )? LSURWM : '0;
327       assign CacheableOrFlushCacheM = CacheableM | FlushDCacheM;
328       assign CacheRWM = (CacheableM & ~SelDTIM) ? LSURWM : '0;
329       assign FlushDCache = FlushDCacheM & ~(SelHPTW);
330 
331       cache #(.P(P), .PA_BITS(P.PA_BITS), .LINELEN(P.DCACHE_LINELENINBITS), .NUMSETS(P.DCACHE_WAYSIZEINBYTES*8/LINELEN),
332               .NUMWAYS(P.DCACHE_NUMWAYS), .LOGBWPL(LLENLOGBWPL), .WORDLEN(CACHEWORDLEN), .MUXINTERVAL(P.LLEN), .READ_ONLY_CACHE(0)) dcache(
333         .clk, .reset, .Stall(GatedStallW & ~SelSpillE), .SelBusBeat, .FlushStage(LSUFlushW),
334         .CacheRW(CacheRWM),
335         .FlushCache(FlushDCache), .NextSet(IEUAdrExtE[11:0]), .PAdr(PAdrM),
336         .ByteMask(ByteMaskSpillM), .BeatCount(BeatCount[AHBWLOGBWPL-1:AHBWLOGBWPL-LLENLOGBWPL]),
337         .WriteData(LSUWriteDataSpillM), .SelHPTW,
338         .CacheStall(DCacheStallM), .CacheMiss(DCacheMiss), .CacheAccess(DCacheAccess),
339         .CacheCommitted(DCacheCommittedM),
340         .CacheBusAdr(DCacheBusAdr), .ReadDataWord(DCacheReadDataWordM),
341         .FetchBuffer, .CacheBusRW(CacheBusRW),
342         .CacheBusAck(DCacheBusAck), .InvalidateCache(1'b0), .CMOpM(CacheCMOpM));
343 
344       ahbcacheinterface #(.P(P), .BEATSPERLINE(BEATSPERLINE), .AHBWLOGBWPL(AHBWLOGBWPL), .LINELEN(LINELEN),  .LLENPOVERAHBW(LLENPOVERAHBW), .READ_ONLY_CACHE(0)) ahbcacheinterface(
345         .HCLK(clk), .HRESETn(~reset), .Flush(LSUFlushW),
346         .HRDATA, .HWDATA(LSUHWDATA), .HWSTRB(LSUHWSTRB),
347         .HSIZE(LSUHSIZE), .HBURST(LSUHBURST), .HTRANS(LSUHTRANS), .HWRITE(LSUHWRITE), .HREADY(LSUHREADY),
348         .BeatCount, .SelBusBeat, .CacheReadDataWordM(DCacheReadDataWordM[P.LLEN-1:0]), .WriteDataM(LSUWriteDataM),
349         .Funct3(LSUFunct3M), .HADDR(LSUHADDR), .CacheBusAdr(DCacheBusAdr), .CacheBusRW, .BusAtomic, .BusCMOZero, .CacheableOrFlushCacheM,
350         .CacheBusAck(DCacheBusAck), .FetchBuffer, .PAdr(PAdrM),
351         .Cacheable(CacheableOrFlushCacheM), .BusRW, .Stall(GatedStallW),
352         .BusStall(LSUBusStallM), .BusCommitted(BusCommittedM));
353 
354       mux3 #(P.LLEN) UnCachedDataMux(.d0(DCacheReadDataWordSpillM), .d1({LLENPOVERAHBW{FetchBuffer[P.XLEN-1:0]}}),
355                                     .d2({{P.LLEN-P.XLEN{1'b0}}, DTIMReadDataWordM[P.XLEN-1:0]}),
356                                     .s({SelDTIM, ~(CacheableOrFlushCacheM)}), .y(ReadDataWordMuxM));
357     end else begin : passthrough // No Cache, use simple ahbinterface instead of ahbcacheinterface
358       logic [1:0] BusRW;                    // Non-DTIM memory access, ignore cacheableM
359       logic [P.XLEN-1:0] FetchBuffer;
360       assign BusRW = ~SelDTIM ? LSURWM : 0;
361 
362       assign LSUHADDR = PAdrM;
363       assign LSUHSIZE = LSUFunct3M;
364 
365       ahbinterface #(P.XLEN, 1'b1) ahbinterface(.HCLK(clk), .HRESETn(~reset), .Flush(LSUFlushW), .HREADY(LSUHREADY),
366         .HRDATA(HRDATA), .HTRANS(LSUHTRANS), .HWRITE(LSUHWRITE), .HWDATA(LSUHWDATA),
367         .HWSTRB(LSUHWSTRB), .BusRW, .BusAtomic(AtomicM[1]), .ByteMask(ByteMaskM[P.XLEN/8-1:0]), .WriteData(LSUWriteDataM[P.XLEN-1:0]),
368         .Stall(GatedStallW), .BusStall(LSUBusStallM), .BusCommitted(BusCommittedM), .FetchBuffer(FetchBuffer));
369 
370     // Mux between the 2 sources of read data, 0: Bus, 1: DTIM
371       if(P.DTIM_SUPPORTED) mux2 #(P.XLEN) ReadDataMux2(FetchBuffer, DTIMReadDataWordM[P.XLEN-1:0], SelDTIM, ReadDataWordMuxM[P.XLEN-1:0]);
372       else assign ReadDataWordMuxM[P.XLEN-1:0] = FetchBuffer[P.XLEN-1:0];
373       assign LSUHBURST = 3'b0;
374       assign {DCacheStallM, DCacheCommittedM, DCacheMiss, DCacheAccess, DCacheReadDataWordM} = '0;
375     end
376   end else begin: nobus // block: bus, only DTIM
377     assign {LSUHWDATA, LSUHADDR, LSUHWRITE, LSUHSIZE, LSUHBURST, LSUHTRANS, LSUHWSTRB} = '0;
378     assign DCacheReadDataWordM = '0;
379     assign ReadDataWordMuxM = DTIMReadDataWordM;
380     assign {LSUBusStallM, BusCommittedM} = '0;
381     assign {DCacheMiss, DCacheAccess} = '0;
382     assign {DCacheStallM, DCacheCommittedM} = '0;
383   end
