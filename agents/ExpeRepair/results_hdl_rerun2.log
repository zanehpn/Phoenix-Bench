672         CSR_DSCRATCH0: dscratch0_en = 1'b1;
673         CSR_DSCRATCH1: dscratch1_en = 1'b1;
674 
675         // machine counter/timers
676         CSR_MCOUNTINHIBIT: mcountinhibit_we = 1'b1;
