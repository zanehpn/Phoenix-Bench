751             ebrk_insn_prio: begin
752               if (debug_mode_q | ebreak_into_debug) begin
753                 // EBREAK enters debug mode when dcsr.ebreakm or dcsr.ebreaku is set and we're in
754                 // M or U mode respectively. If we're already in debug mode we re-enter debug mode.
755 
756                 pc_set_o         = 1'b0;
757                 csr_save_id_o    = 1'b0;
758                 csr_save_cause_o = 1'b0;
759                 ctrl_fsm_ns      = DBG_TAKEN_ID;
760                 flush_id         = 1'b0;
761               end else begin
762                 // If EBREAK won't enter debug mode (dcsr.ebreakm/u not set) then raise a breakpoint
763                 // exception.
764                 exc_cause_o      = ExcCauseBreakpoint;
765               end
766             end
767             store_err_prio: begin
768               exc_cause_o = ExcCauseStoreAccessFault;
769               csr_mtval_o = lsu_addr_last_i;
770             end
771             load_err_prio: begin
772               exc_cause_o = ExcCauseLoadAccessFault;
773               csr_mtval_o = lsu_addr_last_i;
774             end
775             default: ;
776           endcase
777         end else begin
778           // special instructions and pipeline flushes
779           if (mret_insn) begin
780             pc_mux_o              = PC_ERET;
781             pc_set_o              = 1'b1;
782             csr_restore_mret_id_o = 1'b1;
783             if (nmi_mode_q) begin
784               nmi_mode_d          = 1'b0; // exit NMI mode
785             end
786           end else if (dret_insn) begin
787             pc_mux_o              = PC_DRET;
788             pc_set_o              = 1'b1;
789             debug_mode_d          = 1'b0;
790             csr_restore_dret_id_o = 1'b1;
791           end else if (wfi_insn) begin
792             ctrl_fsm_ns           = WAIT_SLEEP;
793           end else if (csr_pipe_flush && handle_irq) begin
794             // start handling IRQs when doing CSR-related pipeline flushes
795             ctrl_fsm_ns           = IRQ_TAKEN;
796           end
797         end // exc_req_q
798 
799         // Entering debug mode due to either single step or debug_req. Ensure
800         // registers are set for exception but then enter debug handler rather
801         // than exception handler
802         // Leave all other signals as is to ensure CSRs and PC get set as if
803         // core was entering exception handler, entry to debug mode will then
804         // see the appropriate state and setup dpc correctly.
805 
806         // If an EBREAK instruction is causing us to enter debug mode on the
807         // same cycle as a debug_req or single step, honor the EBREAK and
808         // proceed to DBG_TAKEN_ID, as it has the highest priority.
809         //
810         // cause==EBREAK    -> prio 3 (highest)
811         // cause==debug_req -> prio 2
812         // cause==step      -> prio 1 (lowest)
813         if (enter_debug_mode_prio_q && !(ebrk_insn_prio && ebreak_into_debug)) begin
814           ctrl_fsm_ns = DBG_TAKEN_IF;
815         end
816       end // FLUSH
817 
818       default: begin
819         instr_req_o = 1'b0;
820         ctrl_fsm_ns = RESET;
821       end
822     endcase
823   end
824 
825   assign flush_id_o = flush_id;
826 
827   // signal to CSR when in debug mode
828   assign debug_mode_o = debug_mode_q;
829 
830   // signal to CSR when in an NMI handler (for nested exception handling)
831   assign nmi_mode_o = nmi_mode_q;
832 
833   ///////////////////
834   // Stall control //
835   ///////////////////
836 
837   // If high current instruction cannot complete this cycle. Either because it needs more cycles to
838   // finish (stall_id_i) or because the writeback stage cannot accept it yet (stall_wb_i). If there
839   // is no writeback stage stall_wb_i is a constant 0.
840   assign stall = stall_id_i | stall_wb_i;
841 
842   // signal to IF stage that ID stage is ready for next instr
843   assign id_in_ready_o = ~stall & ~halt_if & ~retain_id;
844 
845   // kill instr in IF-ID pipeline reg that are done, or if a
846   // multicycle instr causes an exception for example
847   // retain_id is another kind of stall, where the instr_valid bit must remain
848   // set (unless flush_id is set also). It cannot be factored directly into
849   // stall as this causes a combinational loop.
850   assign instr_valid_clear_o = ~(stall | retain_id) | flush_id;
851 
852   // update registers
853   always_ff @(posedge clk_i or negedge rst_ni) begin : update_regs
854     if (!rst_ni) begin
855       ctrl_fsm_cs             <= RESET;
856       nmi_mode_q              <= 1'b0;
857       do_single_step_q        <= 1'b0;
858       debug_mode_q            <= 1'b0;
859       enter_debug_mode_prio_q <= 1'b0;
860       load_err_q              <= 1'b0;
861       store_err_q             <= 1'b0;
