28     input  logic        WEN_scm0,
29     input  logic        WEN_scm1,
30 
31     input  logic  [3:0] BEN,
32     input  logic  [3:0] BEN_scm0,
33 
34     input  logic [12:0] A,
35     input  logic [10:0] A_scm0,
36     input  logic [10:0] A_scm1,
37 
