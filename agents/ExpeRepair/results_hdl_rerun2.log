1355   // Where the writeback stage is present instruction in ID observing value of minstret must take
1356   // into account any instruction in the writeback stage. If one is present the incremented value of
1357   // minstret is used. A speculative version of the signal is used to aid timing. When the writeback
1358   // stage sees an exception (so the speculative signal is incorrect) the ID stage will be flushed
1359   // so the incorrect value doesn't matter. A similar behaviour is required for the compressed
1360   // instruction retired counter below. When the writeback stage isn't present the speculative
1361   // signals are always 0.
1362   assign mhpmcounter[2] = instr_ret_spec_i & ~mcountinhibit[2] ? minstret_next : minstret_raw;
1363 
1364   // reserved:
1365   assign mhpmcounter[1]            = '0;
1366   assign unused_mhpmcounter_we_1   = mhpmcounter_we[1];
1367   assign unused_mhpmcounterh_we_1  = mhpmcounterh_we[1];
1368   assign unused_mhpmcounter_incr_1 = mhpmcounter_incr[1];
1369 
1370   // Iterate through optionally included counters (MHPMCounterNum controls how many are included)
1371   for (genvar i = 0; i < 29; i++) begin : gen_cntrs
1372     localparam int Cnt = i + 3;
1373 
1374     if (i < MHPMCounterNum) begin : gen_imp
1375       logic [63:0] mhpmcounter_raw, mhpmcounter_next;
1376 
1377       ibex_counter #(
1378         .CounterWidth(MHPMCounterWidth),
1379         .ProvideValUpd(Cnt == 10)
1380       ) mcounters_variable_i (
1381         .clk_i(clk_i),
1382         .rst_ni(rst_ni),
1383         .counter_inc_i(mhpmcounter_incr[Cnt] & ~mcountinhibit[Cnt]),
1384         .counterh_we_i(mhpmcounterh_we[Cnt]),
1385         .counter_we_i(mhpmcounter_we[Cnt]),
1386         .counter_val_i(csr_wdata_int),
1387         .counter_val_o(mhpmcounter_raw),
1388         .counter_val_upd_o(mhpmcounter_next)
1389       );
1390 
1391       if (Cnt == 10) begin : gen_compressed_instr_cnt
1392         // Special behaviour for reading compressed instruction retired counter, see comment on
1393         // `mhpmcounter[2]` above for further information.
1394         assign mhpmcounter[Cnt] =
1395           instr_ret_compressed_spec_i & ~mcountinhibit[Cnt] ? mhpmcounter_next:
1396                                                               mhpmcounter_raw;
1397       end else begin : gen_other_cnts
1398         logic [63:0] unused_mhpmcounter_next;
1399         // All other counters just see the raw counter value directly.
1400         assign mhpmcounter[Cnt] = mhpmcounter_raw;
1401         assign unused_mhpmcounter_next = mhpmcounter_next;
1402       end
1403     end else begin : gen_unimp
1404       assign mhpmcounter[Cnt] = '0;
1405 
1406       if (Cnt == 10) begin : gen_no_compressed_instr_cnt
1407         logic unused_instr_ret_compressed_spec_i;
1408         assign unused_instr_ret_compressed_spec_i = instr_ret_compressed_spec_i;
1409       end
1410     end
1411   end
1412 
1413   if (MHPMCounterNum < 29) begin : g_mcountinhibit_reduced
1414     logic [29-MHPMCounterNum-1:0] unused_mhphcounter_we;
1415     logic [29-MHPMCounterNum-1:0] unused_mhphcounterh_we;
1416     logic [29-MHPMCounterNum-1:0] unused_mhphcounter_incr;
1417 
1418     assign mcountinhibit = {{29 - MHPMCounterNum{1'b0}}, mcountinhibit_q};
