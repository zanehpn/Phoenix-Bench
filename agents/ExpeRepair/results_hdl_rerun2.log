1340   // minstret
1341   ibex_counter #(
1342     .CounterWidth(64),
1343     .ProvideValUpd(1)
1344   ) minstret_counter_i (
1345     .clk_i(clk_i),
1346     .rst_ni(rst_ni),
1347     .counter_inc_i(mhpmcounter_incr[2] & ~mcountinhibit[2]),
1348     .counterh_we_i(mhpmcounterh_we[2]),
1349     .counter_we_i(mhpmcounter_we[2]),
1350     .counter_val_i(csr_wdata_int),
1351     .counter_val_o(minstret_raw),
1352     .counter_val_upd_o(minstret_next)
1353   );
