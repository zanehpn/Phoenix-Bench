386   // Atomic operations
387   /////////////////////////////////////////////////////////////////////////////////////////////
388 
389   if (P.ZAAMO_SUPPORTED | P.ZALRSC_SUPPORTED) begin:atomic
390     atomic #(P) atomic(.clk, .reset, .StallW, .ReadDataM(ReadDataM[P.XLEN-1:0]), .IHWriteDataM, .PAdrM,
391       .LSUFunct7M, .LSUFunct3M, .LSUAtomicM, .PreLSURWM, .LSUFlushW,
392       .IMAWriteDataM, .SquashSCW, .LSURWM);
393   end else begin:lrsc
394     assign SquashSCW = 1'b0;
395     assign LSURWM = PreLSURWM;
396     assign IMAWriteDataM = IHWriteDataM;
397   end
398 
399   if (P.F_SUPPORTED)
400     if (P.FLEN >= P.XLEN)
401       mux2 #(P.LLEN) datamux({{{P.LLEN-P.XLEN}{1'b0}}, IMAWriteDataM}, FWriteDataM, FpLoadStoreM, IMAFWriteDataM);
402     else
403       mux2 #(P.LLEN) datamux(IMAWriteDataM, {{{P.XLEN-P.FLEN}{1'b0}}, FWriteDataM}, FpLoadStoreM, IMAFWriteDataM);
404 
405   else assign IMAFWriteDataM = IMAWriteDataM;
