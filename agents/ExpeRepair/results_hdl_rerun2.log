852             end
853             alu_multicycle_dec: begin
854               stall_alu     = 1'b1;
855               id_fsm_d      = MULTI_CYCLE;
856               rf_we_raw     = 1'b0;
857             end
858             default: begin
859               id_fsm_d      = FIRST_CYCLE;
860             end
861           endcase
862         end
