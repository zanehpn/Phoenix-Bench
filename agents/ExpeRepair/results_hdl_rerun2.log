323       STATE_RESET_MEMORIES:                       NextState = STATE_RESET_MEMORIES2;
324       STATE_RESET_MEMORIES2:                      NextState = STATE_LOAD_MEMORIES;  // Give the reset enough time to ensure the bus is reset before loading the memories.
