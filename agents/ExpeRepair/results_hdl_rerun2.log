19 module dmi_jtag #(
20   parameter logic [31:0] IdcodeValue = 32'h00000001
21 ) (
22   input  logic         clk_i,      // DMI Clock
23   input  logic         rst_ni,     // Asynchronous reset active low
24   input  logic         testmode_i,
25 
26   output logic         dmi_rst_no, // hard reset
27   output dm::dmi_req_t dmi_req_o,
28   output logic         dmi_req_valid_o,
29   input  logic         dmi_req_ready_i,
30 
31   input dm::dmi_resp_t dmi_resp_i,
32   output logic         dmi_resp_ready_o,
33   input  logic         dmi_resp_valid_i,
34 
35   input  logic         tck_i,    // JTAG test clock pad
36   input  logic         tms_i,    // JTAG test mode select pad
37   input  logic         trst_ni,  // JTAG test reset pad
38   input  logic         td_i,     // JTAG test data input pad
39   output logic         td_o,     // JTAG test data output pad
40   output logic         tdo_oe_o  // Data out output enable
41 );
42 
43   typedef enum logic [1:0] {
44     DMINoError = 2'h0, DMIReservedError = 2'h1,
45     DMIOPFailed = 2'h2, DMIBusy = 2'h3
46   } dmi_error_e;
47   dmi_error_e error_d, error_q;
48 
49   logic tck;
50   logic trst_n;
51   logic update;
52   logic capture;
53   logic shift;
54   logic tdi;
55 
56   // -------------------------------
57   // Debug Module Control and Status
58   // -------------------------------
59   logic dtmcs_select;
60 
61   dm::dtmcs_t dtmcs_d, dtmcs_q;
62 
63   always_comb begin
64     dtmcs_d  = dtmcs_q;
65 
66     if (capture) begin
67       if (dtmcs_select) begin
68         dtmcs_d  = '{
69                       zero1        : '0,
70                       dmihardreset : 1'b0,
71                       dmireset     : 1'b0,
72                       zero0        : '0,
73                       idle         : 3'd1, // 1: Enter Run-Test/Idle and leave it immediately
74                       dmistat      : error_q, // 0: No error, 2: Op failed, 3: too fast
75                       abits        : 6'd7, // The size of address in dmi
76                       version      : 4'd1  // Version described in spec version 0.13 (and later?)
77                     };
78       end
79     end
80 
81     if (shift) begin
82       if (dtmcs_select) dtmcs_d  = {tdi, 31'(dtmcs_q >> 1)};
83     end
84   end
85 
86   always_ff @(posedge tck or negedge trst_n) begin
87     if (!trst_n) begin
88       dtmcs_q <= '0;
89     end else begin
90       dtmcs_q <= dtmcs_d;
91     end
92   end
93 
94   // ----------------------------
95   // DMI (Debug Module Interface)
96   // ----------------------------
97   // TODO(zarubaf): Might need to be connected to the `dtmcs_q.dmihardreset`
98   // signal.
99   assign dmi_rst_no = rst_ni;
100 
101   logic        dmi_select;
102   logic        dmi_tdo;
103 
104   dm::dmi_req_t  dmi_req;
105   logic          dmi_req_ready;
106   logic          dmi_req_valid;
107 
108   dm::dmi_resp_t dmi_resp;
109   logic          dmi_resp_valid;
110   logic          dmi_resp_ready;
111 
112   typedef struct packed {
113     logic [6:0]  address;
114     logic [31:0] data;
115     logic [1:0]  op;
116   } dmi_t;
117 
118   typedef enum logic [2:0] { Idle, Read, WaitReadValid, Write, WaitWriteValid } state_e;
119   state_e state_d, state_q;
120 
121   logic [$bits(dmi_t)-1:0] dr_d, dr_q;
122   logic [6:0] address_d, address_q;
123   logic [31:0] data_d, data_q;
124 
125   dmi_t  dmi;
126   assign dmi          = dmi_t'(dr_q);
127   assign dmi_req.addr = address_q;
128   assign dmi_req.data = data_q;
129   assign dmi_req.op   = (state_q == Write) ? dm::DTM_WRITE : dm::DTM_READ;
130   // We will always be ready to accept the data we requested.
131   assign dmi_resp_ready = 1'b1;
132 
133   logic error_dmi_busy;
134 
135   always_comb begin : p_fsm
136     error_dmi_busy = 1'b0;
137     // default assignments
138     state_d   = state_q;
139     address_d = address_q;
140     data_d    = data_q;
141     error_d   = error_q;
142 
143     dmi_req_valid = 1'b0;
144 
145     unique case (state_q)
146       Idle: begin
147         // make sure that no error is sticky
148         if (dmi_select && update && (error_q == DMINoError)) begin
149           // save address and value
150           address_d = dmi.address;
151           data_d = dmi.data;
152           if (dm::dtm_op_e'(dmi.op) == dm::DTM_READ) begin
153             state_d = Read;
154           end else if (dm::dtm_op_e'(dmi.op) == dm::DTM_WRITE) begin
155             state_d = Write;
156           end
157           // else this is a nop and we can stay here
158         end
159       end
160 
161       Read: begin
162         dmi_req_valid = 1'b1;
163         if (dmi_req_ready) begin
164           state_d = WaitReadValid;
165         end
166       end
167 
168       WaitReadValid: begin
169         // load data into register and shift out
170         if (dmi_resp_valid) begin
171           data_d = dmi_resp.data;
172           state_d = Idle;
173         end
174       end
175 
176       Write: begin
177         dmi_req_valid = 1'b1;
178         // request sent, wait for response before going back to idle
179         if (dmi_req_ready) begin
180           state_d = WaitWriteValid;
181         end
182       end
183 
184       WaitWriteValid: begin
185         // got a valid answer go back to idle
186         if (dmi_resp_valid) begin
187           state_d = Idle;
188         end
189       end
190 
191       default: begin
192         // just wait for idle here
193         if (dmi_resp_valid) begin
194           state_d = Idle;
195         end
196       end
197     endcase
198 
199     // update means we got another request but we didn't finish
200     // the one in progress, this state is sticky
201     if (update && state_q != Idle) begin
202       error_dmi_busy = 1'b1;
203     end
204 
205     // if capture goes high while we are in the read state
206     // or in the corresponding wait state we are not giving back a valid word
207     // -> throw an error
208     if (capture && state_q inside {Read, WaitReadValid}) begin
209       error_dmi_busy = 1'b1;
210     end
211 
212     if (error_dmi_busy) begin
213       error_d = DMIBusy;
214     end
215     // clear sticky error flag
216     if (update && dtmcs_q.dmireset && dtmcs_select) begin
217       error_d = DMINoError;
218     end
219   end
220 
221   // shift register
222   assign dmi_tdo = dr_q[0];
223 
224   always_comb begin : p_shift
225     dr_d    = dr_q;
226 
227     if (capture) begin
228       if (dmi_select) begin
229         if (error_q == DMINoError && !error_dmi_busy) begin
230           dr_d = {address_q, data_q, DMINoError};
231         // DMI was busy, report an error
232         end else if (error_q == DMIBusy || error_dmi_busy) begin
233           dr_d = {address_q, data_q, DMIBusy};
234         end
235       end
236     end
237 
238     if (shift) begin
239       if (dmi_select) begin
240         dr_d = {tdi, dr_q[$bits(dr_q)-1:1]};
241       end
242     end
243   end
244 
245   always_ff @(posedge tck or negedge trst_n) begin
246     if (!trst_n) begin
247       dr_q      <= '0;
248       state_q   <= Idle;
249       address_q <= '0;
250       data_q    <= '0;
251       error_q   <= DMINoError;
252     end else begin
253       dr_q      <= dr_d;
254       state_q   <= state_d;
255       address_q <= address_d;
256       data_q    <= data_d;
257       error_q   <= error_d;
258     end
259   end
260 
261   // ---------
262   // TAP
263   // ---------
264   dmi_jtag_tap #(
265     .IrLength (5),
266     .IdcodeValue(IdcodeValue)
267   ) i_dmi_jtag_tap (
268     .tck_i,
269     .tms_i,
270     .trst_ni,
271     .td_i,
272     .td_o,
273     .tdo_oe_o,
274     .testmode_i,
275     .tck_o          ( tck              ),
276     .trst_no        ( trst_n           ),
277     .update_o       ( update           ),
278     .capture_o      ( capture          ),
279     .shift_o        ( shift            ),
280     .tdi_o          ( tdi              ),
281     .dtmcs_select_o ( dtmcs_select     ),
282     .dtmcs_tdo_i    ( dtmcs_q[0]       ),
283     .dmi_select_o   ( dmi_select       ),
284     .dmi_tdo_i      ( dmi_tdo          )
285   );
286 
287   // ---------
288   // CDC
289   // ---------
290   dmi_cdc i_dmi_cdc (
291     // JTAG side (master side)
292     .tck_i             ( tck              ),
293     .trst_ni           ( trst_n           ),
294     .jtag_dmi_req_i    ( dmi_req          ),
295     .jtag_dmi_ready_o  ( dmi_req_ready    ),
296     .jtag_dmi_valid_i  ( dmi_req_valid    ),
297     .jtag_dmi_resp_o   ( dmi_resp         ),
298     .jtag_dmi_valid_o  ( dmi_resp_valid   ),
299     .jtag_dmi_ready_i  ( dmi_resp_ready   ),
300     // core side
301     .clk_i,
302     .rst_ni,
303     .core_dmi_req_o    ( dmi_req_o        ),
304     .core_dmi_valid_o  ( dmi_req_valid_o  ),
305     .core_dmi_ready_i  ( dmi_req_ready_i  ),
306     .core_dmi_resp_i   ( dmi_resp_i       ),
307     .core_dmi_ready_o  ( dmi_resp_ready_o ),
308     .core_dmi_valid_i  ( dmi_resp_valid_i )
309   );
</code>
