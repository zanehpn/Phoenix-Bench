39     input  logic [31:0] D_scm0,
40 
41     output logic [31:0] Q,
42     output logic [31:0] Q_scm0,
43     output logic [31:0] Q_scm1
44 );
45         localparam CUT0_ADDRW = 12;
46         localparam CUT1_ADDRW = 11;
47         localparam SCM0_ADDRW = 11;
48 
49 
50          logic CEN_int[2:0];
51          logic [2:0][31:0] Q_int;
52 
53          logic [1:0]  muxsel;
54          logic [31:0] BE_BW;
55 
56          logic [3:0]   BE;
57          logic [3:0]   BE_scm0;
58          logic read_enA,read_enB,read_enC;
59          logic write_enA,write_enB;
60 
61 
62          assign BE      = ~BEN;
63          assign BE_scm0 = ~BEN_scm0;
64 
65          assign BE_BW      = { {8{BE[3]}}, {8{BE[2]}}, {8{BE[1]}}, {8{BE[0]}} };
66 
67          assign CEN_int[2] = CEN |   ~A[12] | ~A[11]; //scm
68          assign CEN_int[1] = CEN |   ~A[12] | A[11];
