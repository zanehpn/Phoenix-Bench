80       // Special-case shared regions where R = 0, W = 1
81       unique case ({csr_pmp_cfg.lock, csr_pmp_cfg.exec})
82         // Read/write in M, read only in S/U
83         2'b00: result =
84             (pmp_req_type == PMP_ACC_READ) |
85             ((pmp_req_type == PMP_ACC_WRITE) & (priv_mode == PRIV_LVL_M));
86         // Read/write in M/S/U
87         2'b01: result =
88             (pmp_req_type == PMP_ACC_READ) | (pmp_req_type == PMP_ACC_WRITE);
89         // Execute only on M/S/U
90         2'b10: result = (pmp_req_type == PMP_ACC_EXEC);
91         // Read/execute in M, execute only on S/U
92         2'b11: result =
93             (pmp_req_type == PMP_ACC_EXEC) |
94             ((pmp_req_type == PMP_ACC_READ) & (priv_mode == PRIV_LVL_M));
95         default: ;
96       endcase
97     end else begin
98       if (csr_pmp_cfg.read & csr_pmp_cfg.write & csr_pmp_cfg.exec & csr_pmp_cfg.lock) begin
99         // Special-case shared read only region when R = 1, W = 1, X = 1, L = 1
100         result = pmp_req_type == PMP_ACC_READ;
101       end else begin
102         // Otherwise use basic permission check. Permission is always denied if in S/U mode and
103         // L is set or if in M mode and L is unset.
104         result = permission_check &
105                  (priv_mode == PRIV_LVL_M ? csr_pmp_cfg.lock : ~csr_pmp_cfg.lock);
106       end
107     end
108     return result;
109   endfunction
110 
111   // Compute permissions checks that apply when MSECCFG.MML is unset. This is the original PMP
112   // behaviour before Smepmp was added.
113   function automatic logic orig_perm_check(logic                pmp_cfg_lock,
114                                            ibex_pkg::priv_lvl_e priv_mode,
115                                            logic                permission_check);
116       return (priv_mode == PRIV_LVL_M) ?
117           // For M-mode, any region which matches with the L-bit clear, or with sufficient
118           // access permissions will be allowed
119           (~pmp_cfg_lock | permission_check) :
120           // For other modes, the lock bit doesn't matter
121           permission_check;
122   endfunction
123 
124   // Access fault determination / prioritization
125   function automatic logic access_fault_check (logic                     csr_pmp_mseccfg_mmwp,
126                                                logic                     csr_pmp_mseccfg_mml,
127                                                ibex_pkg::pmp_req_e       pmp_req_type,
128                                                logic [PMPNumRegions-1:0] match_all,
129                                                ibex_pkg::priv_lvl_e      priv_mode,
130                                                logic [PMPNumRegions-1:0] final_perm_check);
131 
132 
133     // When MSECCFG.MMWP is set default deny always, otherwise allow for M-mode, deny for other
134     // modes. Also deny unmatched for M-mode whe MSECCFG.MML is set and request type is EXEC.
135     logic access_fail = csr_pmp_mseccfg_mmwp | (priv_mode != PRIV_LVL_M) |
136                         (csr_pmp_mseccfg_mml && (pmp_req_type == PMP_ACC_EXEC));
137 
138     // PMP entries are statically prioritized, from 0 to N-1
139     // The lowest-numbered PMP entry which matches an address determines accessibility
140     for (int r = 0; r < PMPNumRegions; r++) begin
141       if (match_all[r]) begin
142         access_fail = ~final_perm_check[r];
143         break;
144       end
145     end
146     return access_fail;
147   endfunction
148 
149   // ---------------
150   // Access checking
151   // ---------------
152 
153   for (genvar r = 0; r < PMPNumRegions; r++) begin : g_addr_exp
154     // Start address for TOR matching
155     if (r == 0) begin : g_entry0
156       assign region_start_addr[r] = (csr_pmp_cfg_i[r].mode == PMP_MODE_TOR) ? 34'h000000000 :
157                                                                               csr_pmp_addr_i[r];
158     end else begin : g_oth
159       assign region_start_addr[r] = (csr_pmp_cfg_i[r].mode == PMP_MODE_TOR) ? csr_pmp_addr_i[r-1] :
160                                                                               csr_pmp_addr_i[r];
161     end
162     // Address mask for NA matching
163     for (genvar b = PMPGranularity + 2; b < 34; b++) begin : g_bitmask
164       if (b == 2) begin : g_bit0
165         // Always mask bit 2 for NAPOT
166         assign region_addr_mask[r][b] = (csr_pmp_cfg_i[r].mode != PMP_MODE_NAPOT);
167       end else begin : g_others
168         // We will mask this bit if it is within the programmed granule
169         // i.e. addr = yyyy 0111
170         //                  ^
171         //                  | This bit pos is the top of the mask, all lower bits set
172         // thus mask = 1111 0000
173         if (PMPGranularity == 0) begin : g_region_addr_mask_zero_granularity
174           assign region_addr_mask[r][b] = (csr_pmp_cfg_i[r].mode != PMP_MODE_NAPOT) |
175                                           ~&csr_pmp_addr_i[r][b-1:2];
176         end else begin : g_region_addr_mask_other_granularity
177           assign region_addr_mask[r][b] = (csr_pmp_cfg_i[r].mode != PMP_MODE_NAPOT) |
178                                           ~&csr_pmp_addr_i[r][b-1:PMPGranularity+1];
179         end
