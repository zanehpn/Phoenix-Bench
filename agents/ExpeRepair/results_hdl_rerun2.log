1439   if (DbgTriggerEn) begin : gen_trigger_regs
1440     localparam int unsigned DbgHwNumLen = DbgHwBreakNum > 1 ? $clog2(DbgHwBreakNum) : 1;
1441     localparam int unsigned MaxTselect = DbgHwBreakNum - 1;
1442 
1443     // Register values
1444     logic [DbgHwNumLen-1:0]   tselect_d, tselect_q;
1445     logic                     tmatch_control_d;
1446     logic [DbgHwBreakNum-1:0] tmatch_control_q;
1447     logic [31:0]              tmatch_value_d;
1448     logic [31:0]              tmatch_value_q[DbgHwBreakNum];
1449     logic                     selected_tmatch_control;
1450     logic [31:0]              selected_tmatch_value;
1451 
1452     // Write enables
1453     logic                     tselect_we;
1454     logic [DbgHwBreakNum-1:0] tmatch_control_we;
1455     logic [DbgHwBreakNum-1:0] tmatch_value_we;
1456     // Trigger comparison result
1457     logic [DbgHwBreakNum-1:0] trigger_match;
1458 
1459     // Write select
1460     assign tselect_we = csr_we_int & debug_mode_i & (csr_addr_i == CSR_TSELECT);
1461     for (genvar i = 0; i < DbgHwBreakNum; i++) begin : g_dbg_tmatch_we
1462       assign tmatch_control_we[i] = (i[DbgHwNumLen-1:0] == tselect_q) & csr_we_int & debug_mode_i &
1463                                     (csr_addr_i == CSR_TDATA1);
1464       assign tmatch_value_we[i]   = (i[DbgHwNumLen-1:0] == tselect_q) & csr_we_int & debug_mode_i &
1465                                     (csr_addr_i == CSR_TDATA2);
1466     end
1467 
1468     // Debug interface tests the available number of triggers by writing and reading the trigger
1469     // select register. Only allow changes to the register if it is within the supported region.
1470     assign tselect_d = (csr_wdata_int < DbgHwBreakNum) ? csr_wdata_int[DbgHwNumLen-1:0] :
1471                                                          MaxTselect[DbgHwNumLen-1:0];
1472 
1473     // tmatch_control is enabled when the execute bit is set
1474     assign tmatch_control_d = csr_wdata_int[2];
1475     assign tmatch_value_d   = csr_wdata_int[31:0];
1476 
1477     // Registers
1478     ibex_csr #(
1479       .Width     (DbgHwNumLen),
1480       .ShadowCopy(1'b0),
1481       .ResetValue('0)
1482     ) u_tselect_csr (
1483       .clk_i     (clk_i),
1484       .rst_ni    (rst_ni),
1485       .wr_data_i (tselect_d),
1486       .wr_en_i   (tselect_we),
1487       .rd_data_o (tselect_q),
1488       .rd_error_o()
1489     );
1490 
1491     for (genvar i = 0; i < DbgHwBreakNum; i++) begin : g_dbg_tmatch_reg
1492       ibex_csr #(
1493         .Width     (1),
1494         .ShadowCopy(1'b0),
1495         .ResetValue('0)
1496       ) u_tmatch_control_csr (
1497         .clk_i     (clk_i),
1498         .rst_ni    (rst_ni),
1499         .wr_data_i (tmatch_control_d),
1500         .wr_en_i   (tmatch_control_we[i]),
1501         .rd_data_o (tmatch_control_q[i]),
1502         .rd_error_o()
1503       );
1504 
1505       ibex_csr #(
1506         .Width     (32),
1507         .ShadowCopy(1'b0),
1508         .ResetValue('0)
1509       ) u_tmatch_value_csr (
1510         .clk_i     (clk_i),
1511         .rst_ni    (rst_ni),
1512         .wr_data_i (tmatch_value_d),
1513         .wr_en_i   (tmatch_value_we[i]),
1514         .rd_data_o (tmatch_value_q[i]),
1515         .rd_error_o()
1516       );
1517     end
1518 
1519     // Assign read data
1520     // TSELECT - number of supported triggers defined by parameter DbgHwBreakNum
1521     localparam int unsigned TSelectRdataPadlen = DbgHwNumLen >= 32 ? 0 : (32 - DbgHwNumLen);
1522     assign tselect_rdata = {{TSelectRdataPadlen{1'b0}}, tselect_q};
1523 
1524     if (DbgHwBreakNum > 1) begin : g_dbg_tmatch_multiple_select
1525       assign selected_tmatch_control = tmatch_control_q[tselect_q];
1526       assign selected_tmatch_value   = tmatch_value_q[tselect_q];
1527     end else begin : g_dbg_tmatch_single_select
1528       assign selected_tmatch_control = tmatch_control_q[0];
1529       assign selected_tmatch_value   = tmatch_value_q[0];
1530     end
1531 
1532     // TDATA0 - only support simple address matching
1533     assign tmatch_control_rdata = {4'h2,                    // type    : address/data match
1534                                    1'b1,                    // dmode   : access from D mode only
1535                                    6'h00,                   // maskmax : exact match only
1536                                    1'b0,                    // hit     : not supported
1537                                    1'b0,                    // select  : address match only
1538                                    1'b0,                    // timing  : match before execution
1539                                    2'b00,                   // sizelo  : match any access
1540                                    4'h1,                    // action  : enter debug mode
1541                                    1'b0,                    // chain   : not supported
1542                                    4'h0,                    // match   : simple match
1543                                    1'b1,                    // m       : match in m-mode
1544                                    1'b0,                    // 0       : zero
1545                                    1'b0,                    // s       : not supported
1546                                    1'b1,                    // u       : match in u-mode
1547                                    selected_tmatch_control, // execute : match instruction address
1548                                    1'b0,                    // store   : not supported
1549                                    1'b0};                   // load    : not supported
1550 
1551     // TDATA1 - address match value only
1552     assign tmatch_value_rdata = selected_tmatch_value;
1553 
1554     // Breakpoint matching
1555     // We match against the next address, as the breakpoint must be taken before execution
1556     for (genvar i = 0; i < DbgHwBreakNum; i++) begin : g_dbg_trigger_match
1557       assign trigger_match[i] = tmatch_control_q[i] & (pc_if_i[31:0] == tmatch_value_q[i]);
1558     end
1559     assign trigger_match_o = |trigger_match;
1560 
1561   end else begin : gen_no_trigger_regs
1562     assign tselect_rdata        = 'b0;
1563     assign tmatch_control_rdata = 'b0;
1564     assign tmatch_value_rdata   = 'b0;
1565     assign trigger_match_o      = 'b0;
1566   end
