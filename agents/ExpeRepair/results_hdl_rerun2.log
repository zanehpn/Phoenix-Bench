658     assign if_instr_rdata   = instr_skid_valid_q ? instr_skid_data_q : fetch_rdata;
659     assign if_instr_addr    = instr_skid_valid_q ? instr_skid_addr_q : fetch_addr;
660 
661     // Don't branch predict on instruction error so only instructions without errors end up in the
662     // skid buffer.
663     assign if_instr_bus_err = ~instr_skid_valid_q & fetch_err;
664     assign instr_bp_taken_d = instr_skid_valid_q ? instr_skid_bp_taken_q : predict_branch_taken;
665 
666     assign fetch_ready = id_in_ready_i & ~stall_dummy_instr & ~instr_skid_valid_q;
667 
668     assign instr_bp_taken_o = instr_bp_taken_q;
