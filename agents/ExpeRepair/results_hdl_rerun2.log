184   assign unused_irq_bit = irq_id[5];   // MSB distinguishes interrupts from exceptions
185 
186   // exception PC selection mux
187   always_comb begin : exc_pc_mux
188     unique case (exc_pc_mux_i)
189       EXC_PC_EXC:     exc_pc = (csr_mtvec_i[0] | ~cheri_pmode_i)? { csr_mtvec_i[31:8], 8'h00 } : {csr_mtvec_i[31:2], 2'b00};
190       EXC_PC_IRQ:     exc_pc = (csr_mtvec_i[0] | ~cheri_pmode_i) ? { csr_mtvec_i[31:8], 1'b0, irq_id[4:0], 2'b00 } : {csr_mtvec_i[31:2], 2'b00};
191       EXC_PC_DBD:     exc_pc = DmHaltAddr;
192       EXC_PC_DBG_EXC: exc_pc = DmExceptionAddr;
193       default:        exc_pc = { csr_mtvec_i[31:8], 8'h00                    };
194     endcase
195   end
196 
197   // The Branch predictor can provide a new PC which is internal to if_stage. Only override the mux
198   // select to choose this if the core isn't already trying to set a PC.
199   assign pc_mux_internal =
200     (BranchPredictor && predict_branch_taken && !pc_set_i) ? PC_BP : pc_mux_i;
201 
202   // fetch address selection mux
203   always_comb begin : fetch_addr_mux
204     unique case (pc_mux_internal)
205       PC_BOOT: fetch_addr_n = { boot_addr_i[31:8], 8'h80 };
206       PC_JUMP: fetch_addr_n = branch_target_ex_i;
207       PC_EXC:  fetch_addr_n = exc_pc;                       // set PC to exception handler
208       PC_ERET: fetch_addr_n = csr_mepc_i;                   // restore PC when returning from EXC
209       PC_DRET: fetch_addr_n = csr_depc_i;
210       // Without branch predictor will never get pc_mux_internal == PC_BP. We still handle no branch
211       // predictor case here to ensure redundant mux logic isn't synthesised.
212       PC_BP:   fetch_addr_n = BranchPredictor ? predict_branch_pc : { boot_addr_i[31:8], 8'h80 };
