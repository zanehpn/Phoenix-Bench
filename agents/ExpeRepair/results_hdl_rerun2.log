518       CSR_TDATA3: begin
519         csr_rdata_int = '0;
520         illegal_csr   = ~DbgTriggerEn;
521       end
522       CSR_MCONTEXT: begin
523         csr_rdata_int = '0;
524         illegal_csr   = ~DbgTriggerEn;
525       end
526       CSR_SCONTEXT: begin
527         csr_rdata_int = '0;
528         illegal_csr   = ~DbgTriggerEn;
529       end
530       CSR_MSCONTEXT: begin
531         csr_rdata_int = '0;
532         illegal_csr   = ~DbgTriggerEn;
