1325   // mcycle
1326   ibex_counter #(
1327     .CounterWidth(64)
1328   ) mcycle_counter_i (
1329     .clk_i(clk_i),
1330     .rst_ni(rst_ni),
1331     .counter_inc_i(mhpmcounter_incr[0] & ~mcountinhibit[0]),
1332     .counterh_we_i(mhpmcounterh_we[0]),
1333     .counter_we_i(mhpmcounter_we[0]),
