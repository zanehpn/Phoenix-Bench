808         FIRST_CYCLE: begin
809           unique case (1'b1)
810             lsu_req_dec: begin
811               if (!WritebackStage) begin
812                 // LSU operation
813                 id_fsm_d    = MULTI_CYCLE;
814               end else begin
815                 if(~lsu_req_done_i) begin
816                   id_fsm_d  = MULTI_CYCLE;
817                 end
818               end
819             end
820             multdiv_en_dec: begin
