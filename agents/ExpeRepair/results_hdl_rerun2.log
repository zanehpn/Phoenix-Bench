492       SLEEP: begin
493         // instruction in IF stage is already valid
494         // we begin execution when an interrupt has arrived
495         instr_req_o   = 1'b0;
496         halt_if       = 1'b1;
497         flush_id      = 1'b1;
498 
499         // normal execution flow
500         // in debug mode or single step mode we leave immediately (wfi=nop)
501         if (irq_nm || irq_pending_i || debug_req_i || debug_mode_q || debug_single_step_i) begin
502           ctrl_fsm_ns = FIRST_FETCH;
503         end else begin
504           // Make sure clock remains disabled.
505           ctrl_busy_o = 1'b0;
506         end
507       end
508 
509       FIRST_FETCH: begin
510         // Stall because of IF miss
511         if (id_in_ready_o) begin
512           ctrl_fsm_ns = DECODE;
513         end
514 
515         // handle interrupts
516         if (handle_irq) begin
517           // We are handling an interrupt. Set halt_if to tell IF not to give
518           // us any more instructions before it redirects to the handler, but
519           // don't set flush_id: we must allow this instruction to complete
520           // (since it might have outstanding loads or stores).
521           ctrl_fsm_ns = IRQ_TAKEN;
522           halt_if     = 1'b1;
523         end
524 
525         // enter debug mode
526         if (enter_debug_mode) begin
527           ctrl_fsm_ns = DBG_TAKEN_IF;
528           // Halt IF only for now, ID will be flushed in DBG_TAKEN_IF as the
529           // ID state is needed for correct debug mode entry
530           halt_if     = 1'b1;
531         end
532       end
533 
534       DECODE: begin
535         // normal operating mode of the ID stage, in case of debug and interrupt requests,
536         // priorities are as follows (lower number == higher priority)
537         // 1. currently running (multicycle) instructions and exceptions caused by these
538         // 2. debug requests
539         // 3. interrupt requests
540 
541         controller_run_o = 1'b1;
542 
543         // Set PC mux for branch and jump here to ease timing. Value is only relevant if pc_set_o is
544         // also set. Setting the mux value here avoids factoring in special_req and instr_valid_i
545         // which helps timing.
546         pc_mux_o = PC_JUMP;
547 
548 
549         // Get ready for special instructions, exceptions, pipeline flushes
550         if (special_req) begin
551           // Halt IF but don't flush ID. This leaves a valid instruction in
552           // ID so controller can determine appropriate action in the
553           // FLUSH state.
554           retain_id = 1'b1;
555 
556           // Wait for the writeback stage to either be ready for a new instruction or raise its own
557           // exception before going to FLUSH. If the instruction in writeback raises an exception it
558           // must take priority over any exception from an instruction in ID/EX. Only once the
559           // writeback stage is ready can we be certain that won't happen. Without a writeback
560           // stage ready_wb_i == 1 so the FSM will always go directly to FLUSH.
561 
562           if (ready_wb_i | wb_exception_o) begin
563             ctrl_fsm_ns = FLUSH;
564           end
565         end
566 
567         if (branch_set_i || jump_set_i) begin
568           // Only set the PC if the branch predictor hasn't already done the branch for us
569           pc_set_o       = BranchPredictor ? ~instr_bp_taken_i : 1'b1;
570 
571           perf_tbranch_o = branch_set_i;
572           perf_jump_o    = jump_set_i;
573         end
574 
575         if (BranchPredictor) begin
576           if (instr_bp_taken_i & branch_not_set_i) begin
577             // If the instruction is a branch that was predicted to be taken but was not taken
578             // signal a mispredict.
579             nt_branch_mispredict_o = 1'b1;
580           end
581         end
582 
583         // If entering debug mode or handling an IRQ the core needs to wait until any instruction in
584         // ID or WB has finished executing. Stall IF during that time.
585         if ((enter_debug_mode || handle_irq) && (stall || id_wb_pending)) begin
586           halt_if = 1'b1;
587         end
588 
589         if (!stall && !special_req && !id_wb_pending) begin
590           if (enter_debug_mode) begin
591             // enter debug mode
592             ctrl_fsm_ns = DBG_TAKEN_IF;
593             // Halt IF only for now, ID will be flushed in DBG_TAKEN_IF as the
594             // ID state is needed for correct debug mode entry
595             halt_if     = 1'b1;
596           end else if (handle_irq) begin
597             // handle interrupt (not in debug mode)
598             ctrl_fsm_ns = IRQ_TAKEN;
599             // We are handling an interrupt (not in debug mode). Set halt_if to
600             // tell IF not to give us any more instructions before it redirects
601             // to the handler, but don't set flush_id: we must allow this
602             // instruction to complete (since it might have outstanding loads
603             // or stores).
604             halt_if     = 1'b1;
605           end
606         end
607 
608       end // DECODE
609 
610       IRQ_TAKEN: begin
611         pc_mux_o     = PC_EXC;
612         exc_pc_mux_o = EXC_PC_IRQ;
613 
614         if (handle_irq) begin
615           pc_set_o         = 1'b1;
616 
617           csr_save_if_o    = 1'b1;
618           csr_save_cause_o = 1'b1;
619 
620           // Prioritise interrupts as required by the architecture
621           if (irq_nm && !nmi_mode_q) begin
622             exc_cause_o =
623               irq_nm_ext_i ? ExcCauseIrqNm :
624                              '{irq_ext: 1'b0, irq_int: 1'b1, lower_cause: irq_nm_int_cause};
625 
626             if (irq_nm_int & !irq_nm_ext_i) begin
627               csr_mtval_o = irq_nm_int_mtval;
628             end
629 
630             nmi_mode_d  = 1'b1; // enter NMI mode
631           end else if (irqs_i.irq_fast != 15'b0) begin
632             // generate exception cause ID from fast interrupt ID:
633             // - first bit distinguishes interrupts from exceptions,
634             // - second bit adds 16 to fast interrupt ID
635             // for example ExcCauseIrqFast0 = {1'b1, 5'd16}
636             exc_cause_o = '{irq_ext: 1'b1, irq_int: 1'b0, lower_cause: {1'b1, mfip_id}};
637           end else if (irqs_i.irq_external) begin
638             exc_cause_o = ExcCauseIrqExternalM;
639           end else if (irqs_i.irq_software) begin
640             exc_cause_o = ExcCauseIrqSoftwareM;
641           end else begin // irqs_i.irq_timer
642             exc_cause_o = ExcCauseIrqTimerM;
643           end
644         end
645 
646         ctrl_fsm_ns = DECODE;
647       end
648 
649       DBG_TAKEN_IF: begin
650         pc_mux_o     = PC_EXC;
651         exc_pc_mux_o = EXC_PC_DBD;
652 
653         // enter debug mode and save PC in IF to dpc
654         // jump to debug exception handler in debug memory
655         flush_id         = 1'b1;
656         pc_set_o         = 1'b1;
657 
658         csr_save_if_o    = 1'b1;
659         debug_csr_save_o = 1'b1;
660 
661         csr_save_cause_o = 1'b1;
662         if (trigger_match_i) begin
663           debug_cause_o = DBG_CAUSE_TRIGGER;     // (priority 4)
664         end else if (debug_req_i) begin
665           debug_cause_o = DBG_CAUSE_HALTREQ;     // (priority 1)
666         end else begin
667           debug_cause_o = DBG_CAUSE_STEP;        // (priority 0, lowest)
668         end
669 
670         // enter debug mode
671         debug_mode_d          = 1'b1;
672         debug_mode_entering_o = 1'b1;
673 
674         ctrl_fsm_ns  = DECODE;
675       end
676 
677       DBG_TAKEN_ID: begin
678         // enter debug mode and save PC in ID to dpc, used when encountering
679         // 1. EBREAK during debug mode
680         // 2. EBREAK with forced entry into debug mode (ebreakm or ebreaku set).
681         // regular ebreak's go through FLUSH.
682         //
683         // for 1. do not update dcsr and dpc, for 2. do so
684         // jump to debug exception handler in debug memory
685         flush_id      = 1'b1;
686         pc_mux_o      = PC_EXC;
687         pc_set_o      = 1'b1;
688         exc_pc_mux_o  = EXC_PC_DBD;
689 
690         // update dcsr and dpc
691         if (ebreak_into_debug && !debug_mode_q) begin // ebreak with forced entry
692 
693           // dpc (set to the address of the EBREAK, i.e. set to PC in ID stage)
694           csr_save_cause_o = 1'b1;
695           csr_save_id_o    = 1'b1;
696 
697           // dcsr
698           debug_csr_save_o = 1'b1;
699           debug_cause_o    = DBG_CAUSE_EBREAK;
700         end
701 
702         // enter debug mode
703         debug_mode_d          = 1'b1;
704         debug_mode_entering_o = 1'b1;
705 
706         ctrl_fsm_ns  = DECODE;
707       end
708 
709       FLUSH: begin
710         // flush the pipeline
711         halt_if     = 1'b1;
712         flush_id    = 1'b1;
713         ctrl_fsm_ns = DECODE;
714 
715         // As pc_mux and exc_pc_mux can take various values in this state they aren't set early
716         // here.
717 
718         // exceptions: set exception PC, save PC and exception cause
719         // exc_req_lsu is high for one clock cycle only (in DECODE)
720         if (exc_req_q || store_err_q || load_err_q) begin
721           pc_set_o         = 1'b1;
722           pc_mux_o         = PC_EXC;
723           exc_pc_mux_o     = debug_mode_q ? EXC_PC_DBG_EXC : EXC_PC_EXC;
724 
725           if (WritebackStage) begin : g_writeback_mepc_save
726             // With the writeback stage present whether an instruction accessing memory will cause
727             // an exception is only known when it is in writeback. So when taking such an exception
728             // epc must come from writeback.
729             csr_save_id_o  = ~(store_err_q | load_err_q);
730             csr_save_wb_o  = store_err_q | load_err_q;
731           end else begin : g_no_writeback_mepc_save
732             csr_save_id_o  = 1'b0;
733           end
734 
735           csr_save_cause_o = 1'b1;
736 
737           // Exception/fault prioritisation logic will have set exactly 1 X_prio signal
738           unique case (1'b1)
739             instr_fetch_err_prio: begin
740               exc_cause_o = ExcCauseInstrAccessFault;
741               csr_mtval_o = instr_fetch_err_plus2_i ? (pc_id_i + 32'd2) : pc_id_i;
742             end
743             illegal_insn_prio: begin
744               exc_cause_o = ExcCauseIllegalInsn;
745               csr_mtval_o = instr_is_compressed_i ? {16'b0, instr_compressed_i} : instr_i;
746             end
747             ecall_insn_prio: begin
748               exc_cause_o = (priv_mode_i == PRIV_LVL_M) ? ExcCauseEcallMMode :
749                                                           ExcCauseEcallUMode;
750             end
751             ebrk_insn_prio: begin
752               if (debug_mode_q | ebreak_into_debug) begin
753                 // EBREAK enters debug mode when dcsr.ebreakm or dcsr.ebreaku is set and we're in
754                 // M or U mode respectively. If we're already in debug mode we re-enter debug mode.
755 
756                 pc_set_o         = 1'b0;
757                 csr_save_id_o    = 1'b0;
758                 csr_save_cause_o = 1'b0;
759                 ctrl_fsm_ns      = DBG_TAKEN_ID;
760                 flush_id         = 1'b0;
761               end else begin
762                 // If EBREAK won't enter debug mode (dcsr.ebreakm/u not set) then raise a breakpoint
763                 // exception.
764                 exc_cause_o      = ExcCauseBreakpoint;
765               end
766             end
767             store_err_prio: begin
768               exc_cause_o = ExcCauseStoreAccessFault;
769               csr_mtval_o = lsu_addr_last_i;
