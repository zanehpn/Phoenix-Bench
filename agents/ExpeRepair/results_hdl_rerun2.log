691   if (BranchPredictor) begin : g_branch_predictor_asserts
692     `ASSERT_IF(IbexPcMuxValid, pc_mux_internal inside {
693         PC_BOOT,
694         PC_JUMP,
695         PC_EXC,
696         PC_ERET,
697         PC_DRET,
698         PC_BP},
