96   logic [TagSizeECC-1:0]                  tag_wdata_ic0;
97   logic                                   data_req_ic0;
98   logic [IC_INDEX_W-1:0]                  data_index_ic0;
99   logic [IC_NUM_WAYS-1:0]                 data_banks_ic0;
100   logic                                   data_write_ic0;
101   logic [LineSizeECC-1:0]                 data_wdata_ic0;
102   // Cache pipelipe IC1 signals
103   logic [TagSizeECC-1:0]                  tag_rdata_ic1  [IC_NUM_WAYS];
