670     `ASSERT(NoPredictSkid, instr_skid_valid_q |-> ~predict_branch_taken)
671     `ASSERT(NoPredictIllegal, predict_branch_taken |-> ~illegal_c_insn)
672   end else begin : g_no_branch_predictor
673     assign instr_bp_taken_o     = 1'b0;
674     assign predict_branch_taken = 1'b0;
675     assign predict_branch_pc    = 32'b0;
676 
677     assign if_instr_valid = fetch_valid;
678     assign if_instr_rdata = fetch_rdata;
