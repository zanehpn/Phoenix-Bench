1420     assign unused_mhphcounter_we   = mhpmcounter_we[31:MHPMCounterNum+3];
1421     assign unused_mhphcounterh_we  = mhpmcounterh_we[31:MHPMCounterNum+3];
1422     assign unused_mhphcounter_incr = mhpmcounter_incr[31:MHPMCounterNum+3];
