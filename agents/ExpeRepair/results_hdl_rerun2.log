535       // Custom CSR for controlling CPU features and reporting CPU status
536       CSR_CPUCTRLSTS: begin
537         csr_rdata_int = {{32 - $bits(cpu_ctrl_sts_part_t) - 1 {1'b0}},
538                          cpuctrlsts_ic_scr_key_valid_q,
539                          cpuctrlsts_part_q};
540       end
541 
542       // Custom CSR for LFSR re-seeding (cannot be read)
543       CSR_SECURESEED: begin
544         csr_rdata_int = '0;
545       end
546 
547       default: begin
548         illegal_csr = 1'b1;
