692     // Branch set flopped without branch target ALU, or in fixed time execution mode
693     // (condition pass/fail used next cycle where branch target is calculated)
694     logic branch_set_raw_q;
695 
696     always_ff @(posedge clk_i or negedge rst_ni) begin
697       if (!rst_ni) begin
698         branch_set_raw_q <= 1'b0;
699       end else begin
700         branch_set_raw_q <= branch_set_raw_d;
701       end
702     end
703 
704     // Branches always take two cycles in fixed time execution mode, with or without the branch
705     // target ALU (to avoid a path from the branch decision into the branch target ALU operand
706     // muxing).
707     assign branch_set_raw      = (BranchTargetALU && !data_ind_timing_i) ? branch_set_raw_d :
708                                                                            branch_set_raw_q;
709 
710   end
711 
712   // Track whether the current instruction in ID/EX has done a branch or jump set.
713   assign branch_jump_set_done_d = (branch_set_raw | jump_set_raw | branch_jump_set_done_q) &
714     ~instr_valid_clear_o;
715 
716   always_ff @(posedge clk_i or negedge rst_ni) begin
717     if (!rst_ni) begin
718       branch_jump_set_done_q <= 1'b0;
719     end else begin
720       branch_jump_set_done_q <= branch_jump_set_done_d;
721     end
722   end
723 
724   // the _raw signals from the state machine may be asserted for multiple cycles when
725   // instr_executing_spec is asserted and instr_executing is not asserted. This may occur where
726   // a memory error is seen or a there are outstanding memory accesses (indicate a load or store is
727   // in the WB stage). The branch or jump speculatively begins the fetch but is held back from
728   // completing until it is certain the outstanding access hasn't seen a memory error. This logic
729   // ensures only the first cycle of a branch or jump set is sent to the controller to prevent
730   // needless extra IF flushes and fetches.
731   assign jump_set        = jump_set_raw        & ~branch_jump_set_done_q;
732   assign branch_set      = branch_set_raw      & ~branch_jump_set_done_q;
