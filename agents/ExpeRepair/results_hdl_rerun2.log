713     // exception controller gets priority over other writes
714     unique case (1'b1)
715 
716       csr_save_cause_i: begin
717         unique case (1'b1)
718           csr_save_if_i: begin
719             exception_pc = pc_if_i;
720           end
721           csr_save_id_i: begin
722             exception_pc = pc_id_i;
723           end
724           csr_save_wb_i: begin
725             exception_pc = pc_wb_i;
726           end
727           default:;
728         endcase
