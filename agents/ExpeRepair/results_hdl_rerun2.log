730         // Any exception, including debug mode, causes a switch to M-mode
731         priv_lvl_d = PRIV_LVL_M;
732 
733         if (debug_csr_save_i) begin
734           // all interrupts are masked
735           // do not update cause, epc, tval, epc and status
736           dcsr_d.prv   = priv_lvl_q;
737           dcsr_d.cause = debug_cause_i;
