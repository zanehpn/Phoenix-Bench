+
+// Stream join dynamic: Mirror of `stream_fork_dynamic`.
+// Joins a dynamically selected subset of input streams to one output stream.
+// Selected inputs may handshake independently; one output handshake occurs once all selected inputs
+// have handshaked exactly once.
+module stream_join_dynamic #(
+    parameter int unsigned N_INP = 0    // Synopsys DC requires a default value for parameters.
+) (
+    input  logic                clk_i,
+    input  logic                rst_ni,
+    input  logic [N_INP-1:0]    valid_i,
+    output logic [N_INP-1:0]    ready_o,
+    input  logic [N_INP-1:0]    sel_i,
+    output logic                valid_o,
+    input  logic                ready_i
+);
+
+    // This module is the handshake-dual ("specular") of stream_fork_dynamic.
+    stream_fork_dynamic #(
+        .N_OUP ( N_INP )
+    ) i_stream_fork_dynamic (
+        .clk_i   ( clk_i   ),
+        .rst_ni  ( rst_ni  ),
+        .valid_i ( ready_i ),
+        .ready_o ( valid_o ),
+        .valid_o ( ready_o ),
+        .ready_i ( valid_i ),
+        .sel_i   ( sel_i   )
+    );
+
+// pragma translate_off
+`ifndef VERILATOR
+    initial begin: p_assertions
+        assert (N_INP >= 1) else $fatal(1, "Number of inputs must be at least 1!");
+    end
+`endif
+// pragma translate_on
 
 endmodule
