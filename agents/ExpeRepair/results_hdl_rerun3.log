250             MISS_REQ_SEND: begin
251                 mem_req_valid_o = 1'b1;
252                 if (mem_req_ready_i) begin
253                     miss_req_fsm_d = MISS_REQ_IDLE;
254                 end else begin
255                     miss_req_fsm_d = MISS_REQ_SEND;
256                 end
257             end
258         endcase
259     end
260 
261     localparam hpdcache_uint REFILL_REQ_SIZE = $clog2(HPDcacheCfg.u.memDataWidth / 8);
262     localparam hpdcache_uint REFILL_REQ_LEN = HPDcacheCfg.clWidth / HPDcacheCfg.u.memDataWidth;
263 
264     assign mem_req_o.mem_req_addr = {mshr_alloc_nline_q, {HPDcacheCfg.clOffsetWidth{1'b0}} };
265     assign mem_req_o.mem_req_len = hpdcache_mem_len_t'(REFILL_REQ_LEN-1);
266     assign mem_req_o.mem_req_size = hpdcache_mem_size_t'(REFILL_REQ_SIZE);
267     assign mem_req_o.mem_req_command = HPDCACHE_MEM_READ;
268     assign mem_req_o.mem_req_atomic = HPDCACHE_MEM_ATOMIC_ADD;
269     assign mem_req_o.mem_req_cacheable = 1'b1;
270 
271     if ((HPDcacheCfg.u.mshrSets > 1) && (HPDcacheCfg.u.mshrWays > 1))
272     begin : gen_mem_id_mshr_sets_and_ways_gt_1
273         assign mem_req_o.mem_req_id = hpdcache_mem_id_t'({
274                 mshr_alloc_way_q, mshr_alloc_nline_q[0 +: HPDcacheCfg.mshrSetWidth]});
275     end else if (HPDcacheCfg.u.mshrSets > 1) begin : gen_mem_id_mshr_sets_gt_1
276         assign mem_req_o.mem_req_id = hpdcache_mem_id_t'(
277                 mshr_alloc_nline_q[0 +: HPDcacheCfg.mshrSetWidth]);
278     end else if (HPDcacheCfg.u.mshrWays > 1) begin : gen_mem_id_mshr_ways_gt_1
279         assign mem_req_o.mem_req_id = hpdcache_mem_id_t'(mshr_alloc_way_q);
280     end else begin : gen_mem_id_mshr_sets_and_ways_eq_1
281         assign mem_req_o.mem_req_id = '0;
282     end
283 
284     always_ff @(posedge clk_i)
285     begin : miss_req_fsm_internal_ff
286         if (mshr_alloc) begin
287             mshr_alloc_way_q <= mshr_alloc_way_d;
288             mshr_alloc_nline_q <= mshr_alloc_nline_i;
289         end
290     end
291 
292     always_ff @(posedge clk_i or negedge rst_ni)
293     begin : miss_req_fsm_ff
294         if (!rst_ni) begin
295             miss_req_fsm_q <= MISS_REQ_IDLE;
296         end else begin
297             miss_req_fsm_q <= miss_req_fsm_d;
298         end
299     end
300     //  }}}
301 
302     //  Refill FSM
303     //  {{{
304 
305     //      ask permission to the refill arbiter if there is a pending refill
306     assign refill_req_valid_o  = refill_fsm_q == REFILL_IDLE ? refill_fifo_resp_meta_rok : 1'b0;
307 
308     always_comb
309     begin : miss_resp_fsm_comb
310         refill_updt_sel_victim_o = 1'b0;
311         refill_set_o            = '0;
312         refill_way              = '0;
313         refill_write_dir_o      = 1'b0;
314         refill_write_data_o     = 1'b0;
315         refill_updt_rtab_o      = 1'b0;
316         refill_cnt_d            = refill_cnt_q;
317 
318         inval_check_dir_o       = 1'b0;
319         inval_write_dir_o       = 1'b0;
320 
321         refill_core_rsp_valid   = 1'b0;
322         refill_core_rsp_sid     = '0;
323         refill_core_rsp_tid     = '0;
324         refill_core_rsp_error   = 1'b0;
325         refill_core_rsp_word    = 0;
326 
327         refill_fifo_resp_meta_r = 1'b0;
328         refill_fifo_resp_data_r = 1'b0;
329 
330         mshr_ack_cs             = 1'b0;
331         mshr_ack                = 1'b0;
332 
333         refill_fsm_d            = refill_fsm_q;
334 
335         case (refill_fsm_q)
336             //  Wait for refill responses
337             //  {{{
338             REFILL_IDLE: begin
339                 if (refill_fifo_resp_meta_rok) begin
340                     //  anticipate the activation of the MSHR independently of the grant signal from
341                     //  the refill arbiter. This is to avoid the introduction of unnecessary timing
342                     //  paths (however there could be a minor augmentation of the power consumption)
343                     mshr_ack_cs = ~refill_fifo_resp_meta_rdata.is_inval;
344 
345                     //  if the permission is granted, start refilling
346                     if (refill_req_ready_i) begin
347                         refill_set_o = mshr_ack_cache_set;
348 
349                         if (refill_fifo_resp_meta_rdata.is_inval) begin
350                             //  check for a match with the line being invalidated in the cache dir
351                             inval_check_dir_o = 1'b1;
352 
353                             refill_fsm_d = REFILL_INVAL;
354                         end else begin
355                             //  read the MSHR and reset the valid bit for the corresponding entry
356                             mshr_ack = ~refill_fifo_resp_meta_rdata.is_inval;
357 
358                             //  initialize the counter for refill words
359                             refill_cnt_d = 0;
360                             refill_fsm_d = REFILL_WRITE;
361                         end
362                     end
363                 end
364             end
365             //  }}}
366 
367             //  Write refill data into the cache
368             //  {{{
369             REFILL_WRITE: begin
370                 automatic logic is_prefetch;
371                 automatic hpdcache_uint core_rsp_word;
372 
373                 //  Respond to the core (when needed)
374                 if (refill_cnt_q == 0) begin
375                     core_rsp_word = hpdcache_uint'(mshr_ack_word)/HPDcacheCfg.u.accessWords;
376 
377                     if (mshr_ack_need_rsp) begin
378                         refill_core_rsp_valid = (hpdcache_uint'(core_rsp_word) == 0);
379                     end
380 
381                     refill_core_rsp_sid = mshr_ack_src_id;
382                     refill_core_rsp_tid = mshr_ack_req_id;
383                     refill_core_rsp_error = refill_is_error_o;
384                     refill_core_rsp_word = hpdcache_word_t'(
385                         hpdcache_uint'(mshr_ack_word)/HPDcacheCfg.u.reqWords);
386                 end else begin
387                     core_rsp_word = hpdcache_uint'(refill_core_rsp_word_q)/
388                                                    HPDcacheCfg.u.accessWords;
389 
390                     if (refill_need_rsp_q) begin
391                         automatic hpdcache_uint refill_cnt;
392                         refill_cnt = hpdcache_uint'(refill_cnt_q)/HPDcacheCfg.u.accessWords;
393                         refill_core_rsp_valid = (core_rsp_word == refill_cnt);
394                     end
395 
396                     refill_core_rsp_sid = refill_sid_q;
397                     refill_core_rsp_tid = refill_tid_q;
398                     refill_core_rsp_error = refill_is_error_o;
399                     refill_core_rsp_word = hpdcache_word_t'(
400                         hpdcache_uint'(refill_core_rsp_word_q)/HPDcacheCfg.u.reqWords);
401                 end
402 
403                 //  Write the the data in the cache data array
404                 if (refill_cnt_q == 0) begin
405                     refill_set_o = mshr_ack_cache_set;
406                     refill_way = mshr_ack_cache_way;
407                     is_prefetch = mshr_ack_is_prefetch;
408                 end else begin
409                     refill_set_o = refill_set_q;
410                     refill_way = refill_way_q;
411                     is_prefetch = refill_is_prefetch_q;
412                 end
413                 refill_write_data_o = ~refill_is_error_o;
414 
415                 //  Consume chunk of data from the FIFO buffer in the memory interface
416                 refill_fifo_resp_data_r = 1'b1;
417 
418                 //  Update directory on the last chunk of data
419                 refill_cnt_d = refill_cnt_q + hpdcache_word_t'(HPDcacheCfg.u.accessWords);
420 
421                 if (hpdcache_uint'(refill_cnt_q) == REFILL_LAST_CHUNK_WORD) begin
422                     if (REFILL_LAST_CHUNK_WORD == 0) begin
423                         //  Special case: if the cache-line data can be written in a single cycle,
424                         //  wait an additional cycle to write the directory. This allows to prevent
425                         //  a RAM-to-RAM timing path between the MSHR and the DIR.
426                         refill_fsm_d = REFILL_WRITE_DIR;
427                     end else begin
428                         //  Write the new entry in the cache directory
429                         refill_write_dir_o = 1'b1;
430 
431                         //  Update the victim selection. Only in the following cases:
432                         //  - There is no error in response AND
433                         //  - It is a prefetch and the cfg_prefetch_updt_sel_victim_i is set OR
434                         //  - It is a read miss.
435                         refill_updt_sel_victim_o  =  ~refill_is_error_o &
436                                                     (~is_prefetch | cfg_prefetch_updt_sel_victim_i);
437 
438                         //  Update dependency flags in the retry table
439                         refill_updt_rtab_o  = 1'b1;
440 
441                         //  consume the response from the network
442                         refill_fifo_resp_meta_r = 1'b1;
443 
444                         refill_fsm_d = REFILL_IDLE;
445                     end
446                 end
447             end
448             //  }}}
449 
450             //  Write cache directory (this state is only visited when ACCESS_WORDS == CL_WORDS,
451             //  this is when the entire cache-line can be written in a single cycle)
452             //  {{{
453             REFILL_WRITE_DIR: begin
454                 //  Select the target set and way
455                 refill_set_o = refill_set_q;
456                 refill_way = refill_way_q;
457 
458                 //  Write the new entry in the cache directory
459                 refill_write_dir_o  = 1'b1;
460 
461                 //  Update the victim selection. Only in the following cases:
462                 //  - There is no error in response AND
463                 //  - It is a prefetch and the cfg_prefetch_updt_sel_victim_i is set OR
464                 //  - It is a read miss.
465                 refill_updt_sel_victim_o  = ~refill_is_error_o &
466                                            (~refill_is_prefetch_q | cfg_prefetch_updt_sel_victim_i);
467 
468                 //  Update dependency flags in the retry table
469                 refill_updt_rtab_o = 1'b1;
470 
471                 //  consume the response from the network
472                 refill_fifo_resp_meta_r = 1'b1;
473 
474                 refill_fsm_d = REFILL_IDLE;
475             end
476             //  }}}
477 
478             //  Invalidate the target cacheline (if it matches a valid cacheline)
479             //  {{{
480             REFILL_INVAL: begin
481                 //  Invalidate if there is a match
482                 inval_write_dir_o = inval_hit_i;
483 
484                 //  consume the invalidation from the network
485                 refill_fifo_resp_meta_r = 1'b1;
486 
487                 refill_fsm_d = REFILL_IDLE;
488             end
489 
490             default: begin
491 `ifndef HPDCACHE_ASSERT_OFF
492                 assert (1) $error("miss_handler: illegal state");
493 `endif
494             end
495         endcase
496     end
497 
498     assign refill_is_error_o = (refill_fifo_resp_meta_rdata.r_error == HPDCACHE_MEM_RESP_NOK);
499 
500     assign refill_busy_o  = (refill_fsm_q != REFILL_IDLE);
501     assign refill_nline_o = {refill_tag_q, refill_set_q};
502     assign refill_word_o  = refill_cnt_q;
503 
504     assign inval_nline_o = refill_fifo_resp_meta_rdata.inval_nline;
505 
506     assign mshr_check_tag = mshr_check_nline_i[HPDcacheCfg.setWidth +: HPDcacheCfg.tagWidth];
507     assign mshr_check_set = mshr_check_offset_i[HPDcacheCfg.clOffsetWidth +: HPDcacheCfg.setWidth];
508 
509     if (HPDcacheCfg.u.mshrSets > 1) begin : gen_mshr_set_gt_1
510         //  MSHR ack set and way
511         assign mshr_ack_set = refill_fifo_resp_meta_rdata.r_id[0 +: HPDcacheCfg.mshrSetWidth];
512         if (HPDcacheCfg.u.mshrWays > 1) begin : gen_mshr_ack_way_gt_1
513             assign mshr_ack_way = refill_fifo_resp_meta_rdata.r_id[HPDcacheCfg.mshrSetWidth +:
514                                                                    HPDcacheCfg.mshrWayWidth];
515         end else begin : gen_mshr_ack_way_eq_1
516             assign mshr_ack_way = '0;
517         end
518     end else begin : gen_mshr_set_eq_1
519         //  MSHR ack set and way
520         assign mshr_ack_set = '0;
521         if (HPDcacheCfg.u.mshrWays > 1) begin : gen_mshr_ack_way_gt_1
522             assign mshr_ack_way = refill_fifo_resp_meta_rdata.r_id[0 +: HPDcacheCfg.mshrWayWidth];
523         end else begin : gen_mshr_ack_way_eq_1
524             assign mshr_ack_way = '0;
525         end
526     end
527 
528     //  Write the new entry in the cache directory
529     //  In case of error in the refill response, invalidate pre-allocated cache directory entry
</code>
