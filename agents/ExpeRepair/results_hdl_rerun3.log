228   assign dret_insn       = dret_insn_i       & instr_valid_i;
229   assign wfi_insn        = wfi_insn_i        & instr_valid_i;
230   assign ebrk_insn       = ebrk_insn_i       & instr_valid_i;
231   assign csr_pipe_flush  = csr_pipe_flush_i  & instr_valid_i;
232   assign instr_fetch_err = instr_fetch_err_i & instr_valid_i;
233   assign cheri_ex_err    = cheri_ex_err_i & instr_is_cheri_i & instr_valid_i;
