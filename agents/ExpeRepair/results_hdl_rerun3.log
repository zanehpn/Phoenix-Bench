530   assign lsu_req         = instr_executing ? data_req_allowed & lsu_req_dec  : 1'b0;
531   assign mult_en_id      = instr_executing ? mult_en_dec                     : 1'b0;
532   assign div_en_id       = instr_executing ? div_en_dec                      : 1'b0;
