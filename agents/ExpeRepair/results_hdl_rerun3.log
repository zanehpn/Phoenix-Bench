235   // "Executing DRET outside of Debug Mode causes an illegal instruction exception."
236   // [Debug Spec v0.13.2, p.41]
237   assign illegal_dret = dret_insn & ~debug_mode_q;
238 
239   // Some instructions can only be executed in M-Mode
240   assign illegal_umode = (priv_mode_i != PRIV_LVL_M) &
241                          // MRET must be in M-Mode. TW means trap WFI to M-Mode.
242                          (mret_insn | (csr_mstatus_tw_i & wfi_insn));
243 
244   assign mret_cheri_asr_err = CHERIoTEn & cheri_pmode_i & ~csr_pcc_perm_sr_i & mret_insn;
245   assign csr_cheri_asr_err  = CHERIoTEn & cheri_pmode_i & ~csr_pcc_perm_sr_i & instr_valid_i & 
