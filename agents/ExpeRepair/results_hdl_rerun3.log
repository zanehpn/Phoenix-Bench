202     hpdcache_req_tid_t       refill_core_rsp_tid;
203     logic                    refill_core_rsp_error;
204     hpdcache_word_t          refill_core_rsp_word;
205     hpdcache_rsp_t           refill_core_rsp;
206 
207     hpdcache_set_t           mshr_check_set;
208     hpdcache_tag_t           mshr_check_tag;
209     logic                    mshr_alloc;
210     logic                    mshr_alloc_cs;
211     hpdcache_way_t           mshr_alloc_victim_way;
212     logic                    mshr_ack;
213     logic                    mshr_ack_cs;
214     mshr_set_t               mshr_ack_set;
215     mshr_way_t               mshr_ack_way;
216     hpdcache_set_t           mshr_ack_cache_set;
217     hpdcache_way_t           mshr_ack_cache_way;
218     hpdcache_tag_t           mshr_ack_cache_tag;
219     hpdcache_req_sid_t       mshr_ack_src_id;
220     hpdcache_req_tid_t       mshr_ack_req_id;
221     hpdcache_word_t          mshr_ack_word;
222     logic                    mshr_ack_need_rsp;
223     logic                    mshr_ack_is_prefetch;
224     logic                    mshr_ack_wback;
225     logic                    mshr_empty;
