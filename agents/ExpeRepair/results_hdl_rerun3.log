557   ////////////////////////
558   // Branch set control //
559   ////////////////////////
560 
561   // SEC_CM: CORE.DATA_REG_SW.SCA
562   // Branch set flopped without branch target ALU, or in fixed time execution mode
563   // (condition pass/fail used next cycle where branch target is calculated)
564   logic branch_set_raw_q;
565 
566   always_ff @(posedge clk_i or negedge rst_ni) begin
567     if (!rst_ni) begin
568       branch_set_raw_q <= 1'b0;
569     end else begin
570       branch_set_raw_q <= branch_set_raw_d;
571     end
572   end
573 
574   // Branches always take two cycles in fixed time execution mode, with or without the branch
575   // target ALU (to avoid a path from the branch decision into the branch target ALU operand
576   // muxing).
577   assign branch_set_raw      = branch_set_raw_q;
578 
579 
580   // Track whether the current instruction in ID/EX has done a branch or jump set.
581   assign branch_jump_set_done_d = (branch_set_raw | jump_set_raw | branch_jump_set_done_q) &
582     ~instr_valid_clear_o;
583 
584   always_ff @(posedge clk_i or negedge rst_ni) begin
585     if (!rst_ni) begin
586       branch_jump_set_done_q <= 1'b0;
587     end else begin
588       branch_jump_set_done_q <= branch_jump_set_done_d;
589     end
590   end
591 
592   // the _raw signals from the state machine may be asserted for multiple cycles when
593   // instr_executing_spec is asserted and instr_executing is not asserted. This may occur where
594   // a memory error is seen or a there are outstanding memory accesses (indicate a load or store is
595   // in the WB stage). The branch or jump speculatively begins the fetch but is held back from
596   // completing until it is certain the outstanding access hasn't seen a memory error. This logic
597   // ensures only the first cycle of a branch or jump set is sent to the controller to prevent
598   // needless extra IF flushes and fetches.
599   assign jump_set        = jump_set_raw        & ~branch_jump_set_done_q;
600   assign branch_set      = branch_set_raw      & ~branch_jump_set_done_q;
601 
602   ///////////////
603   // ID-EX FSM //
604   ///////////////
605 
606   typedef enum logic { FIRST_CYCLE, MULTI_CYCLE } id_fsm_e;
607   id_fsm_e id_fsm_q, id_fsm_d;
608 
609   always_ff @(posedge clk_i or negedge rst_ni) begin : id_pipeline_reg
610     if (!rst_ni) begin
611       id_fsm_q <= FIRST_CYCLE;
612     end else if (instr_executing) begin
613       id_fsm_q <= id_fsm_d;
614     end
615   end
616 
617   // ID/EX stage can be in two states, FIRST_CYCLE and MULTI_CYCLE. An instruction enters
618   // MULTI_CYCLE if it requires multiple cycles to complete regardless of stalls and other
619   // considerations. An instruction may be held in FIRST_CYCLE if it's unable to begin executing
620   // (this is controlled by instr_executing).
621 
622   always_comb begin
623     id_fsm_d                = id_fsm_q;
624     rf_we_raw               = rf_we_dec;
625     stall_multdiv           = 1'b0;
626     stall_jump              = 1'b0;
627     stall_branch            = 1'b0;
628     stall_alu               = 1'b0;
629     branch_set_raw_d        = 1'b0;
630     jump_set_raw            = 1'b0;
631     perf_branch_o           = 1'b0;
632 
633     if (instr_executing_spec) begin
634       unique case (id_fsm_q)
635         FIRST_CYCLE: begin
636           unique case (1'b1)
637             lsu_req_dec: begin
638               begin
639                 // LSU operation
640                 id_fsm_d    = MULTI_CYCLE;
641               end
642             end
643             multdiv_en_dec: begin
644               // MUL or DIV operation
645               if (~ex_valid_i) begin
646                 // When single-cycle multiply is configured mul can finish in the first cycle so
647                 // only enter MULTI_CYCLE state if a result isn't immediately available
648                 id_fsm_d      = MULTI_CYCLE;
649                 rf_we_raw     = 1'b0;
650                 stall_multdiv = 1'b1;
651               end
652             end
653             branch_in_dec: begin
654               // cond branch operation
655               // All branches take two cycles in fixed time execution mode, regardless of branch
656               // condition.
657               // SEC_CM: CORE.DATA_REG_SW.SCA
658               id_fsm_d         = (branch_decision_i) ?
659                                      MULTI_CYCLE : FIRST_CYCLE;
660               stall_branch     = branch_decision_i;
661               branch_set_raw_d = branch_decision_i;
662 
663               perf_branch_o = 1'b1;
664             end
665             jump_in_dec: begin
666               // uncond branch operation
667               id_fsm_d      = MULTI_CYCLE;
668               stall_jump    = 1'b1;
669               jump_set_raw  = jump_set_dec;
670             end
671             alu_multicycle_dec: begin
672               stall_alu     = 1'b1;
673               id_fsm_d      = MULTI_CYCLE;
674               rf_we_raw     = 1'b0;
675             end
676             default: begin
677               id_fsm_d      = FIRST_CYCLE;
678             end
679           endcase
680         end
681 
682         MULTI_CYCLE: begin
683           if(multdiv_en_dec) begin
684             rf_we_raw       = rf_we_dec & ex_valid_i;
685           end
686 
687           if (multicycle_done) begin
688             id_fsm_d        = FIRST_CYCLE;
689           end else begin
690             stall_multdiv   = multdiv_en_dec;
691             stall_branch    = branch_in_dec;
692             stall_jump      = jump_in_dec;
693           end
694         end
695 
696         default: begin
697           id_fsm_d          = FIRST_CYCLE;
698         end
699       endcase
700     end
701   end
702 
703   `ASSERT(StallIDIfMulticycle, (id_fsm_q == FIRST_CYCLE) & (id_fsm_d == MULTI_CYCLE) |-> stall_id)
704 
705 
706   // Stall ID/EX stage for reason that relates to instruction in ID/EX, update assertion below if
707   // modifying this.
708   assign stall_id = stall_mem | stall_multdiv | stall_jump | stall_branch |
709                       stall_alu;
710 
711   // Generally illegal instructions have no reason to stall, however they must still stall waiting
712   // for outstanding memory requests so exceptions related to them take priority over the illegal
713   // instruction exception.
714   `ASSERT(IllegalInsnStallMustBeMemStall, illegal_insn_o & stall_id |-> stall_mem &
715     ~(stall_multdiv | stall_jump | stall_branch | stall_alu))
716 
717   assign instr_done = ~stall_id & ~flush_id & instr_executing;
718 
719   // Signal instruction in ID is in it's first cycle. It can remain in its
720   // first cycle if it is stalled.
721   assign instr_first_cycle      = instr_valid_i & (id_fsm_q == FIRST_CYCLE);
722   // Used by RVFI to know when to capture register read data
723   // Used by ALU to access RS3 if ternary instruction.
724   assign instr_first_cycle_id_o = instr_first_cycle;
725 
726     assign multicycle_done = lsu_req_dec ? lsu_resp_valid_i : ex_valid_i;
727 
728     assign data_req_allowed = instr_first_cycle;
729 
730     // Without Writeback Stage always stall the first cycle of a load/store.
731     // Then stall until it is complete
732     assign stall_mem = instr_valid_i & (lsu_req_dec & (~lsu_resp_valid_i | instr_first_cycle));
733 
734     // Without writeback stage any valid instruction that hasn't seen an error will execute
735     assign instr_executing_spec = instr_valid_i & ~instr_fetch_err_i & controller_run;
736     assign instr_executing = instr_executing_spec;
737 
738     `ASSERT(IbexStallIfValidInstrNotExecuting,
739       instr_valid_i & ~instr_fetch_err_i & ~instr_executing & controller_run |-> stall_id)
740 
741     // No data forwarding without writeback stage so always take source register data direct from
742     // register file
743     assign rf_rdata_a_fwd = rf_rdata_a_i;
744     assign rf_rdata_b_fwd = rf_rdata_b_i;
745 
746     // Unused Writeback stage only IO & wiring
747     // Assign inputs and internal wiring to unused signals to satisfy lint checks
748     // Tie-off outputs to constant values
749     logic unused_data_req_done_ex;
750 
751     assign perf_dside_wait_o = instr_executing & lsu_req_dec & ~lsu_resp_valid_i;
752 
753     assign instr_id_done_o = instr_done;
754 
755   // Signal which instructions to count as retired in minstret, all traps along with ebrk and
756   // ecall instructions are not counted.
757   assign instr_perf_count_id_o = ~ebrk_insn & ~ecall_insn_dec & ~illegal_insn_dec &
758       ~illegal_csr_insn_i & ~instr_fetch_err_i;
759 
760   // An instruction is ready to move to the writeback
761   assign en_wb_o = instr_done;
762 
763   assign perf_wfi_wait_o = wfi_insn_dec;
764   assign perf_div_wait_o = stall_multdiv & div_en_dec;
765 
766   //////////
767   // FCOV //
768   //////////
769
