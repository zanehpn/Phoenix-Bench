829   logic        rvfi_stage_intr      [RVFI_STAGES];
830   logic [ 1:0] rvfi_stage_mode      [RVFI_STAGES];
831   logic [ 1:0] rvfi_stage_ixl       [RVFI_STAGES];
832   logic [ 4:0] rvfi_stage_rs1_addr  [RVFI_STAGES];
833   logic [ 4:0] rvfi_stage_rs2_addr  [RVFI_STAGES];
834   logic [ 4:0] rvfi_stage_rs3_addr  [RVFI_STAGES];
835   logic [31:0] rvfi_stage_rs1_rdata [RVFI_STAGES];
836   logic [31:0] rvfi_stage_rs2_rdata [RVFI_STAGES];
837   logic [31:0] rvfi_stage_rs3_rdata [RVFI_STAGES];
838   logic [ 4:0] rvfi_stage_rd_addr   [RVFI_STAGES];
839   logic [31:0] rvfi_stage_rd_wdata  [RVFI_STAGES];
840   logic [31:0] rvfi_stage_pc_rdata  [RVFI_STAGES];
841   logic [31:0] rvfi_stage_pc_wdata  [RVFI_STAGES];
842   logic [31:0] rvfi_stage_mem_addr  [RVFI_STAGES];
