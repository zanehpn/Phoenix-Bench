528   generate
529     if (ZC_EXT) begin : gen_seq
530       cv32e40s_sequencer
531       sequencer_i
532       (
533         .clk                ( clk                     ),
534         .rst_n              ( rst_n                   ),
535 
536         .instr_i            ( prefetch_instr          ),
537         .instr_is_ptr_i     ( ptr_in_if_o             ),
538 
539         .valid_i            ( seq_instr_valid         ),
540         .ready_i            ( seq_pop                 ),
541         .halt_i             ( ctrl_fsm_i.halt_if      ),
542         .kill_i             ( ctrl_fsm_i.kill_if      ),
543 
544 
545         .instr_o            ( seq_instr               ),
546         .valid_o            ( seq_valid               ),
547         .ready_o            ( seq_ready               ),
548         .seq_first_o        ( seq_first               ),
549         .seq_last_o         ( seq_last                )
550       );
551     end else begin : gen_no_seq
552       assign seq_valid = 1'b0;
553       assign seq_last  = 1'b0;
554       assign seq_instr = '0;
555       assign seq_ready = 1'b1;
556       assign seq_first = 1'b1; // Tie high to enable default first_op when ZC_EXT=0
557     end
558   endgenerate
559 
560 
561   // tbljmp below is used in calculating 'last_op_o'. If we have a faulted fetch, the instruction word may be anything
562   // (not cleared on faulted fetches). A faulted fetch should not be decoded to anything and thus tbljmp is cleared.
563   // One could instead set the instruction word itself to all zeros or another illegal instruction on known fetch faults,
564   // but this may impact timing more than suppressing control bits.
565   // Also clear tbljmp for dummy instructions, as this signal is used to calculate last_op.
566   assign tbljmp = (instr_decompressed.bus_resp.err || (instr_decompressed.mpu_status != MPU_OK)) ? 1'b0 :
567                   dummy_insert ? 1'b0 :
568                   trigger_match_i ? 1'b0 : tbljmp_raw;
569
