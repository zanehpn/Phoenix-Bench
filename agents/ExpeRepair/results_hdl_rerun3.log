725     // 3. Select incoming instr_rdata_i
726     assign fill_data_rvd[fb]   = fill_busy_q[fb] & fill_rvd_arb[fb] & ~fill_hit_q[fb] &
727                                  ~fill_hit_ic1[fb] & ~fill_stale_q[fb] & ~fill_out_done[fb] &
728     //                           The incoming data lines up with the output count
729                                  (fill_rvd_beat[fb] == fill_out_cnt_q[fb]) & fill_data_sel[fb];
730 
731 
732     ///////////////////////////
733     // Fill buffer registers //
734     ///////////////////////////
735 
736     // Fill buffer general enable
737     assign fill_entry_en[fb]   = fill_alloc[fb] | fill_busy_q[fb];
738 
739     always_ff @(posedge clk_i or negedge rst_ni) begin
740       if (!rst_ni) begin
741         fill_busy_q[fb]     <= 1'b0;
742         fill_older_q[fb]    <= '0;
743         fill_stale_q[fb]    <= 1'b0;
744         fill_cache_q[fb]    <= 1'b0;
745         fill_hit_q[fb]      <= 1'b0;
746         fill_ext_cnt_q[fb]  <= '0;
747         fill_ext_hold_q[fb] <= 1'b0;
748         fill_ext_done_q[fb] <= 1'b0;
749         fill_rvd_cnt_q[fb]  <= '0;
750         fill_ram_done_q[fb] <= 1'b0;
751         fill_out_cnt_q[fb]  <= '0;
752       end else if (fill_entry_en[fb]) begin
753         fill_busy_q[fb]     <= fill_busy_d[fb];
754         fill_older_q[fb]    <= fill_older_d[fb];
755         fill_stale_q[fb]    <= fill_stale_d[fb];
756         fill_cache_q[fb]    <= fill_cache_d[fb];
757         fill_hit_q[fb]      <= fill_hit_d[fb];
758         fill_ext_cnt_q[fb]  <= fill_ext_cnt_d[fb];
759         fill_ext_hold_q[fb] <= fill_ext_hold_d[fb];
760         fill_ext_done_q[fb] <= fill_ext_done_d[fb];
761         fill_rvd_cnt_q[fb]  <= fill_rvd_cnt_d[fb];
762         fill_ram_done_q[fb] <= fill_ram_done_d[fb];
763         fill_out_cnt_q[fb]  <= fill_out_cnt_d[fb];
764       end
765     end
766 
767     ////////////////////////////////////////
768     // Fill buffer address / data storage //
769     ////////////////////////////////////////
770 
771     assign fill_addr_en[fb]    = fill_alloc[fb];
772     assign fill_way_en[fb]     = (lookup_valid_ic1 & fill_in_ic1[fb]);
773 
774     if (ResetAll) begin : g_fill_addr_ra
775       always_ff @(posedge clk_i or negedge rst_ni) begin
776         if (!rst_ni) begin
777           fill_addr_q[fb] <= '0;
778         end else if (fill_addr_en[fb]) begin
779           fill_addr_q[fb] <= lookup_addr_ic0;
780         end
781       end
782     end else begin : g_fill_addr_nr
783       always_ff @(posedge clk_i) begin
784         if (fill_addr_en[fb]) begin
785           fill_addr_q[fb] <= lookup_addr_ic0;
786         end
787       end
788     end
789 
790     always_ff @(posedge clk_i or negedge rst_ni) begin
791       if (!rst_ni) begin
792         fill_way_q[fb]  <= '0;
793       end else if (fill_way_en[fb]) begin
794         fill_way_q[fb]  <= sel_way_ic1;
795       end
796     end
797 
798     // Data either comes from the cache or the bus. If there was an ECC error, we must take
799     // the incoming bus data since the cache hit data is corrupted.
800     assign fill_data_d[fb] = fill_hit_ic1[fb] ? hit_data_ic1 :
801                                                 {IC_LINE_BEATS{instr_rdata_i}};
802 
803     for (genvar b = 0; b < IC_LINE_BEATS; b++) begin : gen_data_buf
804       // Error tracking (per beat)
805       assign fill_err_d[fb][b]   = (fill_rvd_arb[fb] & instr_err_i &
806                                     (fill_rvd_off[fb] == b[IC_LINE_BEATS_W-1:0])) |
807       //                           Hold the error once recorded
808                                    (fill_busy_q[fb] & fill_err_q[fb][b]);
809 
810       always_ff @(posedge clk_i or negedge rst_ni) begin
811         if (!rst_ni) begin
812           fill_err_q[fb][b] <= '0;
813         end else if (fill_entry_en[fb]) begin
814           fill_err_q[fb][b] <= fill_err_d[fb][b];
815         end
816       end
817 
818       // Enable the relevant part of the data register (or all for cache hits)
819       // Ignore incoming rvalid data when we already have cache hit data
820       assign fill_data_en[fb][b] = fill_hit_ic1[fb] |
821                                    (fill_rvd_arb[fb] & ~fill_hit_q[fb] &
822                                     (fill_rvd_off[fb] == b[IC_LINE_BEATS_W-1:0]));
823 
824       if (ResetAll) begin : g_fill_data_ra
825         always_ff @(posedge clk_i or negedge rst_ni) begin
826           if (!rst_ni) begin
827             fill_data_q[fb][b*BUS_SIZE+:BUS_SIZE] <= '0;
828           end else if (fill_data_en[fb][b]) begin
829             fill_data_q[fb][b*BUS_SIZE+:BUS_SIZE] <= fill_data_d[fb][b*BUS_SIZE+:BUS_SIZE];
830           end
831         end
832       end else begin : g_fill_data_nr
833         always_ff @(posedge clk_i) begin
834           if (fill_data_en[fb][b]) begin
835             fill_data_q[fb][b*BUS_SIZE+:BUS_SIZE] <= fill_data_d[fb][b*BUS_SIZE+:BUS_SIZE];
836           end
837         end
838       end
839 
840     end
841   end
842 
843   ////////////////////////////////
844   // Fill buffer one-hot muxing //
845   ////////////////////////////////
846 
847   // External req info
848   always_comb begin
849     fill_ext_req_addr = '0;
850     for (int i = 0; i < NUM_FB; i++) begin
851       if (fill_ext_arb[i]) begin
852         fill_ext_req_addr |= {fill_addr_q[i][ADDR_W-1:IC_LINE_W], fill_ext_off[i]};
853       end
854     end
855   end
856 
857   // Cache req info
858   always_comb begin
859     fill_ram_req_addr = '0;
860     fill_ram_req_way  = '0;
861     fill_ram_req_data = '0;
862     for (int i = 0; i < NUM_FB; i++) begin
863       if (fill_ram_arb[i]) begin
864         fill_ram_req_addr |= fill_addr_q[i];
865         fill_ram_req_way  |= fill_way_q[i];
866         fill_ram_req_data |= fill_data_q[i];
867       end
868     end
869   end
870 
871   // IF stage output data
872   always_comb begin
873     fill_out_data = '0;
874     fill_out_err  = '0;
875     for (int i = 0; i < NUM_FB; i++) begin
876       if (fill_data_reg[i]) begin
877         fill_out_data |= fill_data_q[i];
878         // Ignore any speculative errors accumulated on cache hits
879         fill_out_err  |= (fill_err_q[i] & ~{IC_LINE_BEATS{fill_hit_q[i]}});
880       end
881     end
882   end
883 
884   ///////////////////////
885   // External requests //
886   ///////////////////////
887 
888   assign instr_req  = ((~icache_enable_i | branch_or_mispredict) & lookup_grant_ic0) |
889                       (|fill_ext_req);
890 
891   assign instr_addr = |fill_ext_req ? fill_ext_req_addr :
892                                       lookup_addr_ic0[ADDR_W-1:BUS_W];
893 
894   assign instr_req_o  = instr_req;
895   assign instr_addr_o = {instr_addr[ADDR_W-1:BUS_W],{BUS_W{1'b0}}};
896 
897   ////////////////////////
898   // Output data muxing //
899   ////////////////////////
900 
901   // Mux between line-width data sources
902   assign line_data = |fill_data_hit ? hit_data_ic1 : fill_out_data;
903   assign line_err  = |fill_data_hit ? {IC_LINE_BEATS{1'b0}} : fill_out_err;
904 
905   // Mux the relevant beat of line data, based on the output address
906   always_comb begin
907     line_data_muxed = '0;
908     line_err_muxed  = 1'b0;
909     for (int unsigned i = 0; i < IC_LINE_BEATS; i++) begin
910       // When data has been skidded, the output address is behind by one
911       if ((output_addr_q[IC_LINE_W-1:BUS_W] + {{IC_LINE_BEATS_W-1{1'b0}},skid_valid_q}) ==
912           i[IC_LINE_BEATS_W-1:0]) begin
913         line_data_muxed |= line_data[i*32+:32];
914         line_err_muxed  |= line_err[i];
915       end
916     end
917   end
918 
919   // Mux between incoming rdata and the muxed line data
920   assign output_data = |fill_data_rvd ? instr_rdata_i : line_data_muxed;
921   assign output_err  = |fill_data_rvd ? instr_err_i   : line_err_muxed;
922 
923   // Output data is valid (from any of the three possible sources). Note that fill_out_arb
924   // must be used here rather than fill_out_req because data can become valid out of order
925   // (e.g. cache hit data can become available ahead of an older outstanding miss).
926   assign data_valid = |fill_out_arb;
927 
928   // Skid buffer data
929   assign skid_data_d = output_data[31:16];
</code>
