<code>
510           end else if (irqs_i.irq_software) begin
511             exc_cause_o = EXC_CAUSE_IRQ_SOFTWARE_M;
512           end else begin // irqs_i.irq_timer
513             exc_cause_o = EXC_CAUSE_IRQ_TIMER_M;
514           end
515         end
516 
517         ctrl_fsm_ns = DECODE;
518       end
519 
520       DBG_TAKEN_IF: begin
521         pc_mux_o     = PC_EXC;
522         exc_pc_mux_o = EXC_PC_DBD;
523 
524         // enter debug mode and save PC in IF to dpc
525         // jump to debug exception handler in debug memory
526         flush_id         = 1'b1;
527         pc_set_o         = 1'b1;
528 
529         csr_save_if_o    = 1'b1;
530         debug_csr_save_o = 1'b1;
531 
532         csr_save_cause_o = 1'b1;
533         if (trigger_match_i) begin
534           debug_cause_o = DBG_CAUSE_TRIGGER;     // (priority 4)
535         end else if (debug_req_i) begin
536           debug_cause_o = DBG_CAUSE_HALTREQ;     // (priority 1)
537         end else begin
538           debug_cause_o = DBG_CAUSE_STEP;        // (priority 0, lowest)
539         end
540 
541         // enter debug mode
542         debug_mode_d = 1'b1;
543 
544         ctrl_fsm_ns  = DECODE;
545       end
546 
547       DBG_TAKEN_ID: begin
548         // enter debug mode and save PC in ID to dpc, used when encountering
549         // 1. EBREAK during debug mode
550         // 2. EBREAK with forced entry into debug mode (ebreakm or ebreaku set).
551         // regular ebreak's go through FLUSH.
552         //
553         // for 1. do not update dcsr and dpc, for 2. do so [Debug Spec v0.13.2, p.39]
554         // jump to debug exception handler in debug memory
555         flush_id      = 1'b1;
556         pc_mux_o      = PC_EXC;
557         pc_set_o      = 1'b1;
558         exc_pc_mux_o  = EXC_PC_DBD;
559 
560         // update dcsr and dpc
561         if (ebreak_into_debug && !debug_mode_q) begin // ebreak with forced entry
562 
563           // dpc (set to the address of the EBREAK, i.e. set to PC in ID stage)
564           csr_save_cause_o = 1'b1;
565           csr_save_id_o    = 1'b1;
566 
567           // dcsr
568           debug_csr_save_o = 1'b1;
569           debug_cause_o    = DBG_CAUSE_EBREAK;
570         end
571 
572         // enter debug mode
573         debug_mode_d = 1'b1;
574 
575         ctrl_fsm_ns  = DECODE;
576       end
577 
578       FLUSH: begin
579         // flush the pipeline
580         halt_if     = 1'b1;
581         flush_id    = 1'b1;
582         ctrl_fsm_ns = DECODE;
583 
584         // As pc_mux and exc_pc_mux can take various values in this state they aren't set early
585         // here.
586 
587         // exceptions: set exception PC, save PC and exception cause
588         // exc_req_lsu is high for one clock cycle only (in DECODE)
589         if (exc_req_q || store_err_q || load_err_q) begin
590           pc_set_o         = 1'b1;
591           pc_mux_o         = PC_EXC;
592           exc_pc_mux_o     = debug_mode_q ? EXC_PC_DBG_EXC : EXC_PC_EXC;
593 
594           begin : g_no_writeback_mepc_save
595             csr_save_id_o  = 1'b0;
596           end
597 
598           csr_save_cause_o = 1'b1;
599 
600           // Exception/fault prioritisation logic will have set exactly 1 X_prio signal
601           unique case (1'b1)
602             instr_fetch_err_prio: begin
603               exc_cause_o = EXC_CAUSE_INSTR_ACCESS_FAULT;
604               csr_mtval_o = instr_fetch_err_plus2_i ? (pc_id_i + 32'd2) : pc_id_i;
605             end
606             illegal_insn_prio: begin
607               exc_cause_o = EXC_CAUSE_ILLEGAL_INSN;
608               csr_mtval_o = instr_is_compressed_i ? {16'b0, instr_compressed_i} : instr_i;
609             end
610             ecall_insn_prio: begin
611               exc_cause_o = (priv_mode_i == PRIV_LVL_M) ? EXC_CAUSE_ECALL_MMODE :
612                                                           EXC_CAUSE_ECALL_UMODE;
613             end
614             ebrk_insn_prio: begin
615               if (debug_mode_q | ebreak_into_debug) begin
616                 /*
617                  * EBREAK in debug mode re-enters debug mode
618                  *
619                  * "The only exception is EBREAK. When that is executed in Debug
620                  * Mode, it halts the hart again but without updating dpc or
621                  * dcsr." [Debug Spec v0.13.2, p.39]
622                  */
623 
624                 /*
625                  * dcsr.ebreakm == 1:
626                  * "EBREAK instructions in M-mode enter Debug Mode."
627                  * [Debug Spec v0.13.2, p.42]
628                  */
629                 pc_set_o         = 1'b0;
630                 csr_save_id_o    = 1'b0;
631                 csr_save_cause_o = 1'b0;
632                 ctrl_fsm_ns      = DBG_TAKEN_ID;
633                 flush_id         = 1'b0;
634               end else begin
635                 /*
636                  * "The EBREAK instruction is used by debuggers to cause control
637                  * to be transferred back to a debugging environment. It
638                  * generates a breakpoint exception and performs no other
639                  * operation. [...] ECALL and EBREAK cause the receiving
640                  * privilege mode's epc register to be set to the address of the
641                  * ECALL or EBREAK instruction itself, not the address of the
642                  * following instruction." [Privileged Spec v1.11, p.40]
643                  */
644                 exc_cause_o      = EXC_CAUSE_BREAKPOINT;
645               end
646             end
647             store_err_prio: begin
648               exc_cause_o = EXC_CAUSE_STORE_ACCESS_FAULT;
649               csr_mtval_o = lsu_addr_last_i;
650             end
651             load_err_prio: begin
652               exc_cause_o = EXC_CAUSE_LOAD_ACCESS_FAULT;
653               csr_mtval_o = lsu_addr_last_i;
654             end
655             default: ;
656           endcase
657         end else begin
658           // special instructions and pipeline flushes
659           if (mret_insn) begin
660             pc_mux_o              = PC_ERET;
661             pc_set_o              = 1'b1;
662             csr_restore_mret_id_o = 1'b1;
663             if (nmi_mode_q) begin
664               nmi_mode_d          = 1'b0; // exit NMI mode
665             end
666           end else if (dret_insn) begin
667             pc_mux_o              = PC_DRET;
668             pc_set_o              = 1'b1;
669             debug_mode_d          = 1'b0;
670             csr_restore_dret_id_o = 1'b1;
671           end else if (wfi_insn) begin
672             ctrl_fsm_ns           = WAIT_SLEEP;
673           end
674         end // exc_req_q
675 
676         // Entering debug mode due to either single step or debug_req. Ensure
677         // registers are set for exception but then enter debug handler rather
678         // than exception handler [Debug Spec v0.13.2, p.44]
679         // Leave all other signals as is to ensure CSRs and PC get set as if
680         // core was entering exception handler, entry to debug mode will then
681         // see the appropriate state and setup dpc correctly.
682 
683         // If an EBREAK instruction is causing us to enter debug mode on the
684         // same cycle as a debug_req or single step, honor the EBREAK and
685         // proceed to DBG_TAKEN_ID, as it has the highest priority.
686         // [Debug Spec v1.0.0-STABLE, p.53]
687         // cause==EBREAK    -> prio 3 (highest)
688         // cause==debug_req -> prio 2
689         // cause==step      -> prio 1 (lowest)
690         if (enter_debug_mode_prio_q && !(ebrk_insn_prio && ebreak_into_debug)) begin
691           ctrl_fsm_ns = DBG_TAKEN_IF;
692         end
693       end // FLUSH
694 
695       default: begin
696         instr_req_o = 1'b0;
697         ctrl_fsm_ns = RESET;
698       end
699     endcase
700   end
701 
702   assign flush_id_o = flush_id;
703 
704   // signal to CSR when in debug mode
705   assign debug_mode_o = debug_mode_q;
706 
707   // signal to CSR when in an NMI handler (for nested exception handling)
708   assign nmi_mode_o = nmi_mode_q;
709 
710   ///////////////////
711   // Stall control //
712   ///////////////////
713 
714   // If high current instruction cannot complete this cycle. Either because it needs more cycles to
715   // finish (stall_id_i)
716   assign stall = stall_id_i;
717 
718   // signal to IF stage that ID stage is ready for next instr
719   assign id_in_ready_o = ~stall & ~halt_if & ~retain_id;
720 
721   // kill instr in IF-ID pipeline reg that are done, or if a
722   // multicycle instr causes an exception for example
723   // retain_id is another kind of stall, where the instr_valid bit must remain
724   // set (unless flush_id is set also). It cannot be factored directly into
725   // stall as this causes a combinational loop.
726   assign instr_valid_clear_o = ~(stall | retain_id) | flush_id;
727 
728   // update registers
729   always_ff @(posedge clk_i or negedge rst_ni) begin : update_regs
730     if (!rst_ni) begin
731       ctrl_fsm_cs             <= RESET;
732       nmi_mode_q              <= 1'b0;
733       do_single_step_q        <= 1'b0;
734       debug_mode_q            <= 1'b0;
735       enter_debug_mode_prio_q <= 1'b0;
736       load_err_q              <= 1'b0;
737       store_err_q             <= 1'b0;
738       exc_req_q               <= 1'b0;
739       illegal_insn_q          <= 1'b0;
740     end else begin
741       ctrl_fsm_cs             <= ctrl_fsm_ns;
742       nmi_mode_q              <= nmi_mode_d;
743       do_single_step_q        <= do_single_step_d;
744       debug_mode_q            <= debug_mode_d;
745       enter_debug_mode_prio_q <= enter_debug_mode_prio_d;
746       load_err_q              <= load_err_d;
747       store_err_q             <= store_err_d;
748       exc_req_q               <= exc_req_d;
749       illegal_insn_q          <= illegal_insn_d;
750     end
751   end
752 
753   //////////
754   // FCOV //
755   //////////
756 
757   `DV_FCOV_SIGNAL(logic, interrupt_taken, (ctrl_fsm_cs != IRQ_TAKEN) & (ctrl_fsm_ns == IRQ_TAKEN))
758   `DV_FCOV_SIGNAL(logic, debug_entry_if,
759       (ctrl_fsm_cs != DBG_TAKEN_IF) & (ctrl_fsm_ns == DBG_TAKEN_IF))
760   `DV_FCOV_SIGNAL(logic, debug_entry_id,
761       (ctrl_fsm_cs != DBG_TAKEN_ID) & (ctrl_fsm_ns == DBG_TAKEN_ID))
762   `DV_FCOV_SIGNAL(logic, pipe_flush, (ctrl_fsm_cs != FLUSH) & (ctrl_fsm_ns == FLUSH))
763   `DV_FCOV_SIGNAL(logic, debug_req, debug_req_i & ~debug_mode_q)
764 
765   ////////////////
766   // Assertions //
767   ////////////////
768 
769   // Selectors must be known/valid.
</code>
