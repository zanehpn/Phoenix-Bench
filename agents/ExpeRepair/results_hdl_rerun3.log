269   end else begin : gen_prefetch_buffer
270 
271     // prefetch buffer, caches a fixed number of instructions
272     ibex_prefetch_buffer #(
273       .ResetAll        (ResetAll)
274     ) prefetch_buffer_i (
275         .clk_i               ( clk_i                      ),
276         .rst_ni              ( rst_ni                     ),
277 
278         .req_i               ( req_i                      ),
279 
280         .branch_i            ( branch_req                 ),
281         .branch_mispredict_i ( nt_branch_mispredict_i     ),
282         .mispredict_addr_i   ( nt_branch_addr_i           ),
283         .addr_i              ( {fetch_addr_n[31:1], 1'b0} ),
284 
285         .ready_i             ( fetch_ready                ),
286         .valid_o             ( fetch_valid                ),
287         .rdata_o             ( fetch_rdata                ),
288         .addr_o              ( fetch_addr                 ),
289         .err_o               ( fetch_err                  ),
290         .err_plus2_o         ( fetch_err_plus2            ),
291 
292         .cheri_force_uc_i    ( cheri_force_uc            ),
293 
294         .instr_req_o         ( instr_req_o                ),
295         .instr_addr_o        ( instr_addr_o               ),
296         .instr_gnt_i         ( instr_gnt_i                ),
297         .instr_rvalid_i      ( instr_rvalid_i             ),
298         .instr_rdata_i       ( instr_rdata_i              ),
299         .instr_err_i         ( instr_err_i                ),
300 
301         .busy_o              ( prefetch_busy              )
302     );
303 
304     // ICache tieoffs
305     logic                   unused_icen, unused_icinv, unused_scr_key_valid;
306     logic [TagSizeECC-1:0]  unused_tag_ram_input [IC_NUM_WAYS];
307     logic [LineSizeECC-1:0] unused_data_ram_input [IC_NUM_WAYS];
308     assign unused_icen           = icache_enable_i;
309     assign unused_icinv          = icache_inval_i;
310     assign unused_tag_ram_input  = ic_tag_rdata_i;
311     assign unused_data_ram_input = ic_data_rdata_i;
312     assign unused_scr_key_valid  = ic_scr_key_valid_i;
313     assign ic_tag_req_o          = 'b0;
314     assign ic_tag_write_o        = 'b0;
315     assign ic_tag_addr_o         = 'b0;
316     assign ic_tag_wdata_o        = 'b0;
317     assign ic_data_req_o         = 'b0;
318     assign ic_data_write_o       = 'b0;
319     assign ic_data_addr_o        = 'b0;
320     assign ic_data_wdata_o       = 'b0;
321 
322 `ifndef SYNTHESIS
323     // If we don't instantiate an icache and this is a simulation then we have a problem because the
324     // simulator might discard the icache module entirely, including some DPI exports that it
325     // implies. This then causes problems for linking against C++ testbench code that expected them.
326     // As a slightly ugly hack, let's define the DPI functions here (the real versions are defined
327     // in prim_util_get_scramble_params.svh)
328     export "DPI-C" function simutil_get_scramble_key;
329     export "DPI-C" function simutil_get_scramble_nonce;
330     function automatic int simutil_get_scramble_key(output bit [127:0] val);
331       return 0;
332     endfunction
333     function automatic int simutil_get_scramble_nonce(output bit [319:0] nonce);
334       return 0;
335     endfunction
336 `endif
337   end
338 
339   assign unused_fetch_addr_n0 = fetch_addr_n[0];
340 
341   assign branch_req  = pc_set_i | predict_branch_taken;
342 
343   assign pc_if_o     = if_instr_addr;
344   assign if_busy_o   = prefetch_busy;
345 
346   // PMP errors
347   // An error can come from the instruction address, or the next instruction address for unaligned,
348   // uncompressed instructions.
349   assign if_instr_pmp_err = pmp_err_if_i |
350                             (if_instr_addr[1] & ~instr_is_compressed & pmp_err_if_plus2_i);
351 
352   // Combine bus errors and pmp errors
353   assign if_instr_err = if_instr_bus_err | if_instr_pmp_err | cheri_acc_vio | cheri_bound_vio;
354 
355   // Capture the second half of the address for errors on the second part of an instruction
356   // LEC_NOT_COMPATIBLE
357   assign if_instr_err_plus2 = ((if_instr_addr[1] & ~instr_is_compressed & pmp_err_if_plus2_i) |
358                                fetch_err_plus2) & ~pmp_err_if_i;
359 
360   // pre-calculate headroom to improve memory read timing
361   logic [33:0] instr_hdrm;
362   logic        hdrm_ge4, hdrm_ge2, hdrm_ok, base_ok;
363   logic        allow_all;
364 
365   // allow_all is used to permit the pc wraparound case (pc = 0xffff_fffe, uncompressed instruction)
366   // - in this case fetch should be allowed if pcc bounds is specified as the entire 32-bit space. 
367   // - If we don't treat this as a specail case the fetch would be erred since headroom < 4
368   assign allow_all  = (pcc_cap_i.base32==0) & (pcc_cap_i.top33==33'h1_0000_0000);
369 
370   assign instr_hdrm = {1'b0, pcc_cap_i.top33} - {2'b00, if_instr_addr};
371   assign hdrm_ge4   = (|instr_hdrm[32:2]) & ~instr_hdrm[33];     // >= 4
372   assign hdrm_ge2   = (|instr_hdrm[32:1]) & ~instr_hdrm[33];     // >= 2
373   assign hdrm_ok    = allow_all || (instr_is_compressed ? hdrm_ge2 : hdrm_ge4);
374   assign base_ok    = ~(if_instr_addr < pcc_cap_i.base32);
375 
376   // only issue cheri_acc_vio on valid fetches
377   assign cheri_bound_vio = CHERIoTEn & cheri_pmode_i & ~debug_mode_i & (~base_ok  || ~hdrm_ok);
378 
379   // In order to have constant timing (avoid side-channel leakage due to data-dependent behavior), 
380   // if base vio or headroom < 4 (we are only authorized to fetch 2 bytes), force the fetch_fifo
381   // to treat the current rdata as a unaligned compressed instruction if pc[1]=1, and push it to 
382   // ID stage without waiting for the 2nd part of 32-bit instruciton. 
383   // 
384   assign cheri_force_uc = CHERIoTEn & cheri_pmode_i & ~allow_all & (~base_ok | ~hdrm_ge4);
385 
386   // we still check seal/perm here to be safe, however by ISA those can't happen at fetch time 
387   // since they are check elsewhere already
388   assign cheri_acc_vio = CHERIoTEn & cheri_pmode_i & ~debug_mode_i & 
389                          (~pcc_cap_i.perms[PERM_EX] || ~pcc_cap_i.valid || (pcc_cap_i.otype!=0));
390 
391   // compressed instruction decoding, or more precisely compressed instruction
392   // expander
393   //
394   // since it does not matter where we decompress instructions, we do it here
395   // to ease timing closure
396   ibex_compressed_decoder #(
397     .CHERIoTEn (CHERIoTEn)
398   ) compressed_decoder_i (
399     .clk_i          (clk_i),
400     .rst_ni         (rst_ni),
401     .valid_i        (fetch_valid & ~fetch_err),
402     .instr_i        (if_instr_rdata),
403     .cheri_pmode_i  (cheri_pmode_i),
404     .instr_o        (instr_decompressed),
405     .is_compressed_o(instr_is_compressed),
406     .illegal_instr_o(illegal_c_insn)
407   );
408 
409   // Dummy instruction insertion
410   if (DummyInstructions) begin : gen_dummy_instr
411     logic        insert_dummy_instr;
412     logic [31:0] dummy_instr_data;
413 
414     ibex_dummy_instr #(
415       .RndCnstLfsrSeed (RndCnstLfsrSeed),
416       .RndCnstLfsrPerm (RndCnstLfsrPerm)
417     ) dummy_instr_i (
418       .clk_i                (clk_i),
419       .rst_ni               (rst_ni),
420       .dummy_instr_en_i     (dummy_instr_en_i),
421       .dummy_instr_mask_i   (dummy_instr_mask_i),
422       .dummy_instr_seed_en_i(dummy_instr_seed_en_i),
423       .dummy_instr_seed_i   (dummy_instr_seed_i),
424       .fetch_valid_i        (fetch_valid),
425       .id_in_ready_i        (id_in_ready_i),
426       .insert_dummy_instr_o (insert_dummy_instr),
427       .dummy_instr_data_o   (dummy_instr_data)
428     );
429 
430     // Mux between actual instructions and dummy instructions
431     assign instr_out               = insert_dummy_instr ? dummy_instr_data : instr_decompressed;
432     assign instr_is_compressed_out = insert_dummy_instr ? 1'b0 : instr_is_compressed;
433     assign illegal_c_instr_out     = insert_dummy_instr ? 1'b0 : illegal_c_insn;
434     assign instr_err_out           = insert_dummy_instr ? 1'b0 : if_instr_err;
435 
436     // Stall the IF stage if we insert a dummy instruction. The dummy will execute between whatever
437     // is currently in the ID stage and whatever is valid from the prefetch buffer this cycle. The
438     // PC of the dummy instruction will match whatever is next from the prefetch buffer.
439     assign stall_dummy_instr = insert_dummy_instr;
