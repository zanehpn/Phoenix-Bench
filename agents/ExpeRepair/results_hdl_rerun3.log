518             {7'b000_0001, 3'b010}: begin // mulhsu
519               multdiv_operator_o    = MD_OP_MULH;
520               multdiv_signed_mode_o = 2'b01;
521               illegal_insn          = (RV32M == RV32MNone) ? 1'b1 : 1'b0;
522             end
523             {7'b000_0001, 3'b011}: begin // mulhu
524               multdiv_operator_o    = MD_OP_MULH;
