154     //  Cache Directory entry definition
155     //  {{{
156     typedef struct packed {
157         //  Cacheline state
158         //  Encoding: {valid, wb, dirty, fetch}
159         //            {0,X,X,0}: Invalid
160         //            {0,X,X,1}: Invalid and Fetching
161         //            {1,X,X,1}: Valid and Fetching (cacheline being replaced is accessible)
162         //            {1,0,0,0}: Write-through
163         //            {1,1,0,0}: Write-back (clean)
164         //            {1,1,1,0}: Write-back (dirty)
165         //  {{{
166         logic valid; //  valid cacheline
167         logic wback; //  cacheline in write-back mode
168         logic dirty; //  cacheline is locally modified (memory is obsolete)
169         logic fetch; //  cacheline is reserved for a new cacheline being fetched
170         //  }}}
171 
172         //  Cacheline address tag
173         //  {{{
174         hpdcache_tag_t tag;
175         //  }}}
176     } hpdcache_dir_entry_t;
177     //  }}}
