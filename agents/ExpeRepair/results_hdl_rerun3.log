964   // -----------------
965   // PMP registers
966   // -----------------
967 
968   if (PMPEnable) begin : g_pmp_registers
969     // PMP reset values
970     `ifdef CVE2_CUSTOM_PMP_RESET_VALUES
971       `include "cve2_pmp_reset.svh"
972     `else
973       `include "cve2_pmp_reset_default.svh"
974     `endif
975 
976     pmp_mseccfg_t                pmp_mseccfg_q, pmp_mseccfg_d;
977     logic                        pmp_mseccfg_we;
978     logic                        pmp_mseccfg_err;
979     pmp_cfg_t                    pmp_cfg         [PMPNumRegions];
980     logic [PMPNumRegions-1:0]    pmp_cfg_locked;
981     pmp_cfg_t                    pmp_cfg_wdata   [PMPNumRegions];
982     logic [PMPAddrWidth-1:0]     pmp_addr        [PMPNumRegions];
983     logic [PMPNumRegions-1:0]    pmp_cfg_we;
984     logic [PMPNumRegions-1:0]    pmp_cfg_err;
985     logic [PMPNumRegions-1:0]    pmp_addr_we;
986     logic [PMPNumRegions-1:0]    pmp_addr_err;
987     logic                        any_pmp_entry_locked;
988 
989     // Expanded / qualified register read data
990     for (genvar i = 0; i < PMP_MAX_REGIONS; i++) begin : g_exp_rd_data
991       if (i < PMPNumRegions) begin : g_implemented_regions
992         // Add in zero padding for reserved fields
993         assign pmp_cfg_rdata[i] = {pmp_cfg[i].lock, 2'b00, pmp_cfg[i].mode,
994                                    pmp_cfg[i].exec, pmp_cfg[i].write, pmp_cfg[i].read};
995 
996         // Address field read data depends on the current programmed mode and the granularity
997         // See RISC-V Privileged Specification, version 1.11, Section 3.6.1
998         if (PMPGranularity == 0) begin : g_pmp_g0
999           // If G == 0, read data is unmodified
1000           assign pmp_addr_rdata[i] = pmp_addr[i];
1001 
1002         end else if (PMPGranularity == 1) begin : g_pmp_g1
1003           // If G == 1, bit [G-1] reads as zero in TOR or OFF mode
1004           always_comb begin
1005             pmp_addr_rdata[i] = pmp_addr[i];
1006             if ((pmp_cfg[i].mode == PMP_MODE_OFF) || (pmp_cfg[i].mode == PMP_MODE_TOR)) begin
1007               pmp_addr_rdata[i][PMPGranularity-1:0] = '0;
1008             end
1009           end
1010 
1011         end else begin : g_pmp_g2
1012           // For G >= 2, bits are masked to one or zero depending on the mode
1013           always_comb begin
1014             // In NAPOT mode, bits [G-2:0] must read as one
1015             pmp_addr_rdata[i] = {pmp_addr[i], {PMPGranularity - 1{1'b1}}};
1016 
1017             if ((pmp_cfg[i].mode == PMP_MODE_OFF) || (pmp_cfg[i].mode == PMP_MODE_TOR)) begin
1018               // In TOR or OFF mode, bits [G-1:0] must read as zero
1019               pmp_addr_rdata[i][PMPGranularity-1:0] = '0;
1020             end
1021           end
1022         end
1023 
1024       end else begin : g_other_regions
1025         // Non-implemented regions read as zero
1026         assign pmp_cfg_rdata[i]  = '0;
1027         assign pmp_addr_rdata[i] = '0;
1028       end
1029     end
1030 
1031     // Write data calculation
1032     for (genvar i = 0; i < PMPNumRegions; i++) begin : g_pmp_csrs
1033       // -------------------------
1034       // Instantiate cfg registers
1035       // -------------------------
1036       assign pmp_cfg_we[i] = csr_we_int & ~pmp_cfg_locked[i] &
1037                              (csr_addr == (CSR_OFF_PMP_CFG + (i[11:0] >> 2)));
1038 
1039       // Select the correct WDATA (each CSR contains 4 CFG fields, each with 2 RES bits)
1040       assign pmp_cfg_wdata[i].lock  = csr_wdata_int[(i%4)*PMP_CFG_W+7];
1041       // NA4 mode is not selectable when G > 0, mode is treated as OFF
1042       always_comb begin
1043         unique case (csr_wdata_int[(i%4)*PMP_CFG_W+3+:2])
1044           2'b00   : pmp_cfg_wdata[i].mode = PMP_MODE_OFF;
1045           2'b01   : pmp_cfg_wdata[i].mode = PMP_MODE_TOR;
1046           2'b10   : pmp_cfg_wdata[i].mode = (PMPGranularity == 0) ? PMP_MODE_NA4:
1047                                                                     PMP_MODE_OFF;
1048           2'b11   : pmp_cfg_wdata[i].mode = PMP_MODE_NAPOT;
1049           default : pmp_cfg_wdata[i].mode = PMP_MODE_OFF;
1050         endcase
1051       end
1052       assign pmp_cfg_wdata[i].exec  = csr_wdata_int[(i%4)*PMP_CFG_W+2];
1053       // When MSECCFG.MML is unset, W = 1, R = 0 is a reserved combination, so force W to 0 if R ==
1054       // 0. Otherwise allow all possible values to be written.
1055       assign pmp_cfg_wdata[i].write = pmp_mseccfg_q.mml ? csr_wdata_int[(i%4)*PMP_CFG_W+1] :
1056                                                           &csr_wdata_int[(i%4)*PMP_CFG_W+:2];
1057       assign pmp_cfg_wdata[i].read  = csr_wdata_int[(i%4)*PMP_CFG_W];
1058 
1059       cve2_csr #(
1060         .Width     ($bits(pmp_cfg_t)),
1061         .ResetValue(pmp_cfg_rst[i])
1062       ) u_pmp_cfg_csr (
1063         .clk_i     (clk_i),
1064         .rst_ni    (rst_ni),
1065         .wr_data_i ({pmp_cfg_wdata[i]}),
1066         .wr_en_i   (pmp_cfg_we[i]),
1067         .rd_data_o (pmp_cfg[i]),
1068         .rd_error_o(pmp_cfg_err[i])
1069       );
1070 
1071       // MSECCFG.RLB allows the lock bit to be bypassed (allowing cfg writes when MSECCFG.RLB is
1072       // set).
1073       assign pmp_cfg_locked[i] = pmp_cfg[i].lock & ~pmp_mseccfg_q.rlb;
1074 
1075       // --------------------------
1076       // Instantiate addr registers
1077       // --------------------------
1078       if (i < PMPNumRegions - 1) begin : g_lower
1079         assign pmp_addr_we[i] = csr_we_int & ~pmp_cfg_locked[i] &
1080                                 (~pmp_cfg_locked[i+1] | (pmp_cfg[i+1].mode != PMP_MODE_TOR)) &
1081                                 (csr_addr == (CSR_OFF_PMP_ADDR + i[11:0]));
1082       end else begin : g_upper
1083         assign pmp_addr_we[i] = csr_we_int & ~pmp_cfg_locked[i] &
1084                                 (csr_addr == (CSR_OFF_PMP_ADDR + i[11:0]));
1085       end
1086 
1087       cve2_csr #(
1088         .Width     (PMPAddrWidth),
1089         .ResetValue(pmp_addr_rst[i][33-:PMPAddrWidth])
