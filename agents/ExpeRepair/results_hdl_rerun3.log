26 package hpdcache_pkg;
27     //  Utility definitions
28     //  {{{
29     typedef logic unsigned [7:0]  hpdcache_uint8;
30     typedef logic signed   [7:0]  hpdcache_int8;
31     typedef logic unsigned [31:0] hpdcache_uint32;
32     typedef logic signed   [31:0] hpdcache_int32;
33     typedef logic unsigned [63:0] hpdcache_uint64;
34     typedef logic signed   [63:0] hpdcache_int64;
35     typedef hpdcache_uint32       hpdcache_uint;
36     typedef hpdcache_int32        hpdcache_int;
37     //  }}}
38 
39     //  Definition of constants and types for HPDcache directory memory
40     //  {{{
41     //      Victim selection policy
42     typedef enum logic {
43         HPDCACHE_VICTIM_RANDOM = 1'b0,
44         HPDCACHE_VICTIM_PLRU   = 1'b1
45     } hpdcache_victim_sel_policy_t;
46     //  }}}
47 
48     //  Definition of interface with requesters
49     //  {{{
50     typedef logic [2:0] hpdcache_req_size_t;
51 
52     //      Definition of operation codes
53     //      {{{
54     typedef enum logic [4:0] {
55         HPDCACHE_REQ_LOAD                  = 5'h00,
56         HPDCACHE_REQ_STORE                 = 5'h01,
57         // RESERVED                        = 5'h02,
58         // RESERVED                        = 5'h03,
59         HPDCACHE_REQ_AMO_LR                = 5'h04,
60         HPDCACHE_REQ_AMO_SC                = 5'h05,
61         HPDCACHE_REQ_AMO_SWAP              = 5'h06,
62         HPDCACHE_REQ_AMO_ADD               = 5'h07,
63         HPDCACHE_REQ_AMO_AND               = 5'h08,
64         HPDCACHE_REQ_AMO_OR                = 5'h09,
65         HPDCACHE_REQ_AMO_XOR               = 5'h0a,
66         HPDCACHE_REQ_AMO_MAX               = 5'h0b,
67         HPDCACHE_REQ_AMO_MAXU              = 5'h0c,
68         HPDCACHE_REQ_AMO_MIN               = 5'h0d,
69         HPDCACHE_REQ_AMO_MINU              = 5'h0e,
70         // RESERVED                        = 5'h0f,
71         HPDCACHE_REQ_CMO_FENCE             = 5'h10,
72         HPDCACHE_REQ_CMO_PREFETCH          = 5'h11,
73         HPDCACHE_REQ_CMO_INVAL_NLINE       = 5'h12,
74         HPDCACHE_REQ_CMO_INVAL_ALL         = 5'h13,
75         HPDCACHE_REQ_CMO_FLUSH_NLINE       = 5'h14,
76         HPDCACHE_REQ_CMO_FLUSH_ALL         = 5'h15,
77         HPDCACHE_REQ_CMO_FLUSH_INVAL_NLINE = 5'h16,
78         HPDCACHE_REQ_CMO_FLUSH_INVAL_ALL   = 5'h17
79     } hpdcache_req_op_t;
80     //      }}}
81 
82     //      Definition of Write Policy Hint
83     //      {{{
84     typedef enum logic[2:0] {
85         HPDCACHE_WR_POLICY_AUTO = 3'b001,
86         HPDCACHE_WR_POLICY_WB   = 3'b010,
87         HPDCACHE_WR_POLICY_WT   = 3'b100
88     } hpdcache_wr_policy_hint_t;
89     //      }}}
90 
91     //      Definition of PMA flags
92     //      {{{
93     typedef struct packed
94     {
95         logic uncacheable;
96         logic io; //  FIXME: for future use
97 
98         //  Write Policy Hint
99         hpdcache_wr_policy_hint_t wr_policy_hint;
100     } hpdcache_pma_t;
101     //      }}}
102 
103     //      Definition of functions
104     //      {{{
105     function automatic int unsigned hpdcache_max(int unsigned x, int unsigned y);
106         return (x < y) ? y : x;
107     endfunction
108 
109     function automatic int unsigned hpdcache_min(int unsigned x, int unsigned y);
110         return (x < y) ? x : y;
111     endfunction
112 
113     function automatic logic is_load(input hpdcache_req_op_t op);
114         case (op)
115             HPDCACHE_REQ_LOAD: return 1'b1;
116             default:           return 1'b0;
117         endcase
118     endfunction
119 
120     function automatic logic is_store(input hpdcache_req_op_t op);
121         case (op)
122             HPDCACHE_REQ_STORE: return 1'b1;
123             default:            return 1'b0;
124         endcase
125     endfunction
126 
127     function automatic logic is_amo(input hpdcache_req_op_t op);
128         case (op)
129             HPDCACHE_REQ_AMO_LR,
130             HPDCACHE_REQ_AMO_SC,
131             HPDCACHE_REQ_AMO_SWAP,
132             HPDCACHE_REQ_AMO_ADD,
133             HPDCACHE_REQ_AMO_AND,
134             HPDCACHE_REQ_AMO_OR,
135             HPDCACHE_REQ_AMO_XOR,
136             HPDCACHE_REQ_AMO_MAX,
137             HPDCACHE_REQ_AMO_MAXU,
138             HPDCACHE_REQ_AMO_MIN,
139             HPDCACHE_REQ_AMO_MINU:
140                 return 1'b1;
141             default:
142                 return 1'b0;
143         endcase
144     endfunction
145 
146     function automatic logic is_amo_lr(input hpdcache_req_op_t op);
147         case (op)
148             HPDCACHE_REQ_AMO_LR: return 1'b1;
149             default:             return 1'b0;
150         endcase
151     endfunction
152 
153     function automatic logic is_amo_sc(input hpdcache_req_op_t op);
154         case (op)
155             HPDCACHE_REQ_AMO_SC: return 1'b1;
156             default:             return 1'b0;
157         endcase
158     endfunction
159 
160     function automatic logic is_amo_swap(input hpdcache_req_op_t op);
161         case (op)
162             HPDCACHE_REQ_AMO_SWAP: return 1'b1;
163             default:               return 1'b0;
164         endcase
165     endfunction
166 
167     function automatic logic is_amo_add(input hpdcache_req_op_t op);
168         case (op)
169             HPDCACHE_REQ_AMO_ADD: return 1'b1;
170             default:              return 1'b0;
171         endcase
172     endfunction
173 
174     function automatic logic is_amo_and(input hpdcache_req_op_t op);
175         case (op)
176             HPDCACHE_REQ_AMO_AND: return 1'b1;
177             default:              return 1'b0;
178         endcase
179     endfunction
180 
181     function automatic logic is_amo_or(input hpdcache_req_op_t op);
182         case (op)
183             HPDCACHE_REQ_AMO_OR:  return 1'b1;
184             default:              return 1'b0;
185         endcase
186     endfunction
187 
188     function automatic logic is_amo_xor(input hpdcache_req_op_t op);
189         case (op)
190             HPDCACHE_REQ_AMO_XOR: return 1'b1;
191             default:              return 1'b0;
192         endcase
193     endfunction
194 
195     function automatic logic is_amo_max(input hpdcache_req_op_t op);
196         case (op)
197             HPDCACHE_REQ_AMO_MAX: return 1'b1;
198             default:              return 1'b0;
199         endcase
200     endfunction
201 
202     function automatic logic is_amo_maxu(input hpdcache_req_op_t op);
203         case (op)
204             HPDCACHE_REQ_AMO_MAXU: return 1'b1;
205             default:               return 1'b0;
206         endcase
207     endfunction
208 
209     function automatic logic is_amo_min(input hpdcache_req_op_t op);
210         case (op)
211             HPDCACHE_REQ_AMO_MIN: return 1'b1;
212             default:              return 1'b0;
213         endcase
214     endfunction
215 
216     function automatic logic is_amo_minu(input hpdcache_req_op_t op);
217         case (op)
218             HPDCACHE_REQ_AMO_MINU: return 1'b1;
219             default:               return 1'b0;
220         endcase
221     endfunction
222 
223     function automatic logic is_cmo_inval(input hpdcache_req_op_t op);
224         return (op inside {HPDCACHE_REQ_CMO_INVAL_NLINE, HPDCACHE_REQ_CMO_INVAL_ALL});
225     endfunction
226 
227     function automatic logic is_cmo_flush(input hpdcache_req_op_t op);
228         return (op inside {HPDCACHE_REQ_CMO_FLUSH_NLINE,
229                            HPDCACHE_REQ_CMO_FLUSH_ALL,
230                            HPDCACHE_REQ_CMO_FLUSH_INVAL_NLINE,
231                            HPDCACHE_REQ_CMO_FLUSH_INVAL_ALL});
232     endfunction
233 
234     function automatic logic is_cmo_fence(input hpdcache_req_op_t op);
235         return (op == HPDCACHE_REQ_CMO_FENCE);
236     endfunction
237 
238     function automatic logic is_cmo_prefetch(input hpdcache_req_op_t op);
239         return (op == HPDCACHE_REQ_CMO_PREFETCH);
240     endfunction
241 
242     function automatic logic is_cmo_inval_by_nline(input hpdcache_req_op_t op);
