250              $onehot({instr_fetch_err_prio,
251                       illegal_insn_prio,
252                       ecall_insn_prio,
253                       ebrk_insn_prio,
254                       store_err_prio,
255                       load_err_prio}),
256              (ctrl_fsm_cs == FLUSH) & exc_req_q)
257 
258   ////////////////
259   // Interrupts //
260   ////////////////
261 
262   // Enter debug mode due to an external debug_req_i or because the core is in
263   // single step mode (dcsr.step == 1). Single step must be qualified with
264   // instruction valid otherwise the core will immediately enter debug mode
265   // due to a recently flushed IF (or a delay in an instruction returning from
266   // memory) before it has had anything to single step.
267   // Also enter debug mode on a trigger match (hardware breakpoint)
268 
269   // Set `do_single_step_q` when a valid instruction is seen outside of debug mode and core is in
270   // single step mode. The first valid instruction on debug mode entry will clear it. Hold its value
271   // when there is no valid instruction so `do_single_step_d` remains asserted until debug mode is
272   // entered.
273   assign do_single_step_d = instr_valid_i ? ~debug_mode_q & debug_single_step_i : do_single_step_q;
274   // Enter debug mode due to:
275   // * external `debug_req_i`
276   // * core in single step mode (dcsr.step == 1).
277   // * trigger match (hardware breakpoint)
278   //
279   // `debug_req_i` and `do_single_step_d` request debug mode with priority. This results in a debug
280   // mode entry even if the controller goes to `FLUSH` in preparation for handling an exception or
281   // interrupt. `trigger_match_i` is not a priority entry into debug mode as it must be ignored
282   // where control flow changes such that the instruction causing the trigger is no longer being
283   // executed.
284   assign enter_debug_mode_prio_d = (debug_req_i | do_single_step_d) & ~debug_mode_q;
285   assign enter_debug_mode = enter_debug_mode_prio_d | (trigger_match_i & ~debug_mode_q);
286 
287   // Set when an ebreak should enter debug mode rather than jump to exception
288   // handler
289   assign ebreak_into_debug = priv_mode_i == PRIV_LVL_M ? debug_ebreakm_i :
290                              priv_mode_i == PRIV_LVL_U ? debug_ebreaku_i :
291                                                          1'b0;
292 
293   // Interrupts including NMI are ignored,
294   // - while in debug mode [Debug Spec v0.13.2, p.39],
295   // - while in NMI mode (nested NMIs are not supported, NMI has highest priority and
296   //   cannot be interrupted by regular interrupts).
297   // - while single stepping.
298   assign handle_irq = ~debug_mode_q & ~nmi_mode_q &
299       (irq_nm_i | (irq_pending_i & csr_mstatus_mie_i));
300 
301   // generate ID of fast interrupts, highest priority to lowest ID
302   always_comb begin : gen_mfip_id
303     mfip_id = 4'd0;
304 
305     for (int i = 15; i >= 0; i--) begin
306       if (irqs_i.irq_fast[i]) begin
307         mfip_id = i[3:0];
308       end
309     end
310   end
311 
312   assign unused_irq_timer = irqs_i.irq_timer;
313 
314   /////////////////////
315   // Core controller //
316   /////////////////////
317 
318   always_comb begin
319     // Default values
320     instr_req_o           = 1'b1;
321 
322     csr_save_if_o         = 1'b0;
323     csr_save_id_o         = 1'b0;
324     csr_restore_mret_id_o = 1'b0;
325     csr_restore_dret_id_o = 1'b0;
326     csr_save_cause_o      = 1'b0;
327     csr_mtval_o           = '0;
328 
329     // The values of pc_mux and exc_pc_mux are only relevant if pc_set is set. Some of the states
330     // below always set pc_mux and exc_pc_mux but only set pc_set if certain conditions are met.
331     // This avoid having to factor those conditions into the pc_mux and exc_pc_mux select signals
332     // helping timing.
333     pc_mux_o               = PC_BOOT;
334     pc_set_o               = 1'b0;
335 
336     exc_pc_mux_o           = EXC_PC_IRQ;
337     exc_cause_o            = EXC_CAUSE_INSN_ADDR_MISA; // = 6'h00
338 
339     ctrl_fsm_ns            = ctrl_fsm_cs;
340 
341     ctrl_busy_o            = 1'b1;
342 
343     halt_if                = 1'b0;
344     retain_id              = 1'b0;
345     flush_id               = 1'b0;
346 
347     debug_csr_save_o       = 1'b0;
348     debug_cause_o          = DBG_CAUSE_EBREAK;
349     debug_mode_d           = debug_mode_q;
350     nmi_mode_d             = nmi_mode_q;
351 
352     perf_tbranch_o         = 1'b0;
353     perf_jump_o            = 1'b0;
354 
355     controller_run_o       = 1'b0;
356 
357     unique case (ctrl_fsm_cs)
358       RESET: begin
359         instr_req_o   = 1'b0;
360         pc_mux_o      = PC_BOOT;
361         pc_set_o      = 1'b1;
362         if (fetch_enable_i == 1'b1)
363         begin
364           ctrl_fsm_ns = BOOT_SET;
365         end
366       end
367       BOOT_SET: begin
368         // copy boot address to instr fetch address
369         instr_req_o   = 1'b1;
370         pc_mux_o      = PC_BOOT;
371         pc_set_o      = 1'b1;
372 
373         ctrl_fsm_ns = FIRST_FETCH;
374       end
375 
376       WAIT_SLEEP: begin
377         ctrl_busy_o   = 1'b0;
378         instr_req_o   = 1'b0;
379         halt_if       = 1'b1;
380         flush_id      = 1'b1;
381         ctrl_fsm_ns   = SLEEP;
382       end
383 
384       SLEEP: begin
385         // instruction in IF stage is already valid
386         // we begin execution when an interrupt has arrived
387         instr_req_o   = 1'b0;
388         halt_if       = 1'b1;
389         flush_id      = 1'b1;
390 
391         // normal execution flow
392         // in debug mode or single step mode we leave immediately (wfi=nop)
393         if (irq_nm_i || irq_pending_i || debug_req_i || debug_mode_q || debug_single_step_i) begin
394           ctrl_fsm_ns = FIRST_FETCH;
395         end else begin
396           // Make sure clock remains disabled.
397           ctrl_busy_o = 1'b0;
398         end
399       end
400 
401       FIRST_FETCH: begin
402         // Stall because of IF miss
403         if (id_in_ready_o) begin
404           ctrl_fsm_ns = DECODE;
405         end
406 
407         // handle interrupts
408         if (handle_irq) begin
409           // We are handling an interrupt. Set halt_if to tell IF not to give
410           // us any more instructions before it redirects to the handler, but
411           // don't set flush_id: we must allow this instruction to complete
412           // (since it might have outstanding loads or stores).
413           ctrl_fsm_ns = IRQ_TAKEN;
414           halt_if     = 1'b1;
415         end
416 
417         // enter debug mode
418         if (enter_debug_mode) begin
419           ctrl_fsm_ns = DBG_TAKEN_IF;
420           // Halt IF only for now, ID will be flushed in DBG_TAKEN_IF as the
421           // ID state is needed for correct debug mode entry
422           halt_if     = 1'b1;
423         end
424       end
425 
426       DECODE: begin
427         // normal operating mode of the ID stage, in case of debug and interrupt requests,
428         // priorities are as follows (lower number == higher priority)
429         // 1. currently running (multicycle) instructions and exceptions caused by these
430         // 2. debug requests
431         // 3. interrupt requests
432 
433         controller_run_o = 1'b1;
434 
435         // Set PC mux for branch and jump here to ease timing. Value is only relevant if pc_set_o is
436         // also set. Setting the mux value here avoids factoring in special_req and instr_valid_i
437         // which helps timing.
438         pc_mux_o = PC_JUMP;
439 
440 
441         // Get ready for special instructions, exceptions, pipeline flushes
442         if (special_req) begin
443           // Halt IF but don't flush ID. This leaves a valid instruction in
444           // ID so controller can determine appropriate action in the
445           // FLUSH state.
446           retain_id = 1'b1;
447 
448           // The FSM will always go directly to FLUSH.
449 
450           ctrl_fsm_ns = FLUSH;
451         end
452 
453         if (branch_set_i || jump_set_i) begin
454           pc_set_o       = 1'b1;
455 
456           perf_tbranch_o = branch_set_i;
457           perf_jump_o    = jump_set_i;
458         end
459 
460         // If entering debug mode or handling an IRQ the core needs to wait until any instruction in
461         // ID has finished executing. Stall IF during that time.
462         if ((enter_debug_mode || handle_irq) && (stall || instr_valid_i)) begin
463           halt_if = 1'b1;
464         end
465 
466         if (!stall && !special_req && !instr_valid_i) begin
467           if (enter_debug_mode) begin
468             // enter debug mode
469             ctrl_fsm_ns = DBG_TAKEN_IF;
470             // Halt IF only for now, ID will be flushed in DBG_TAKEN_IF as the
471             // ID state is needed for correct debug mode entry
472             halt_if     = 1'b1;
473           end else if (handle_irq) begin
474             // handle interrupt (not in debug mode)
475             ctrl_fsm_ns = IRQ_TAKEN;
476             // We are handling an interrupt (not in debug mode). Set halt_if to
477             // tell IF not to give us any more instructions before it redirects
478             // to the handler, but don't set flush_id: we must allow this
479             // instruction to complete (since it might have outstanding loads
480             // or stores).
481             halt_if     = 1'b1;
482           end
483         end
484 
485       end // DECODE
486 
487       IRQ_TAKEN: begin
488         pc_mux_o     = PC_EXC;
489         exc_pc_mux_o = EXC_PC_IRQ;
490 
491         if (handle_irq) begin
492           pc_set_o         = 1'b1;
493 
494           csr_save_if_o    = 1'b1;
495           csr_save_cause_o = 1'b1;
496 
497           // interrupt priorities according to Privileged Spec v1.11 p.31
498           if (irq_nm_i && !nmi_mode_q) begin
499             exc_cause_o = EXC_CAUSE_IRQ_NM;
500             nmi_mode_d  = 1'b1; // enter NMI mode
501           end else if (irqs_i.irq_fast != 16'b0) begin
502             // generate exception cause ID from fast interrupt ID:
503             // - first bit distinguishes interrupts from exceptions,
504             // - third bit adds 16 to fast interrupt ID so that the interrup 0 becomes 16 and the interrupt 15 becomes 31 (hence 5bits)
505             // - second bit is always 0 as the FAST interrupts are represented in the first 5bits, the 6th is always 0 cause is used by the NMI (in that case is 1 as represented by the number 32)
506             // for example EXC_CAUSE_IRQ_FAST_0 = {1'b1, 6'd16}
507             exc_cause_o = exc_cause_e'({3'b101, mfip_id});
508           end else if (irqs_i.irq_external) begin
509             exc_cause_o = EXC_CAUSE_IRQ_EXTERNAL_M;
510           end else if (irqs_i.irq_software) begin
511             exc_cause_o = EXC_CAUSE_IRQ_SOFTWARE_M;
512           end else begin // irqs_i.irq_timer
513             exc_cause_o = EXC_CAUSE_IRQ_TIMER_M;
514           end
515         end
516 
517         ctrl_fsm_ns = DECODE;
518       end
519 
520       DBG_TAKEN_IF: begin
521         pc_mux_o     = PC_EXC;
522         exc_pc_mux_o = EXC_PC_DBD;
523 
524         // enter debug mode and save PC in IF to dpc
525         // jump to debug exception handler in debug memory
526         flush_id         = 1'b1;
527         pc_set_o         = 1'b1;
528 
529         csr_save_if_o    = 1'b1;
</code>
