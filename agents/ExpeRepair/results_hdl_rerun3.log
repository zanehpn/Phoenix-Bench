133       // ---------------
134       // Rule checking
135       // ---------------
136 
137       // Check specific required permissions
138       assign region_basic_perm_check[r_c] = ((pmp_req_type_i == PMP_ACC_EXEC)  && csr_pmp_i.cfg[r_c].exec)  ||
139                                             ((pmp_req_type_i == PMP_ACC_WRITE) && csr_pmp_i.cfg[r_c].write) ||
140                                             ((pmp_req_type_i == PMP_ACC_READ)  && csr_pmp_i.cfg[r_c].read);
141       
142       // Compute permission checks that apply when MSECCFG.MML is set.
143       always_comb begin
144         region_mml_perm_check[r_c] = 1'b0;
145         
146         if (!csr_pmp_i.cfg[r_c].read && csr_pmp_i.cfg[r_c].write) begin
147           // Special-case shared regions where R = 0, W = 1
148           unique case ({csr_pmp_i.cfg[r_c].lock, csr_pmp_i.cfg[r_c].exec})
149             // Read/write in M, read only in S/U
150             2'b00: region_mml_perm_check[r_c] = (pmp_req_type_i == PMP_ACC_READ) ||
151                                                 ((pmp_req_type_i == PMP_ACC_WRITE) && (priv_lvl_i == PRIV_LVL_M));
152             // Read/write in M/S/U
153             2'b01: region_mml_perm_check[r_c] = (pmp_req_type_i == PMP_ACC_READ) || (pmp_req_type_i == PMP_ACC_WRITE);
154             // Execute only on M/S/U
155             2'b10: region_mml_perm_check[r_c] = (pmp_req_type_i == PMP_ACC_EXEC);
156             // Read/execute in M, execute only on S/U
157             2'b11: region_mml_perm_check[r_c] = (pmp_req_type_i == PMP_ACC_EXEC) ||
158                                                 ((pmp_req_type_i == PMP_ACC_READ) && (priv_lvl_i == PRIV_LVL_M));
159             default: ;
160           endcase
161         end else begin
162           if (csr_pmp_i.cfg[r_c].read && csr_pmp_i.cfg[r_c].write & csr_pmp_i.cfg[r_c].exec
163               && csr_pmp_i.cfg[r_c].lock) begin
164             // Special-case shared read only region when R = 1, W = 1, X = 1, L = 1
165             region_mml_perm_check[r_c] = pmp_req_type_i == PMP_ACC_READ;
166           end else begin
167             // Otherwise use basic permission check. Permission is always denied if in S/U mode and
168             // L is set or if in M mode and L is unset.
169             region_mml_perm_check[r_c] = priv_lvl_i == PRIV_LVL_M ?
170                                          csr_pmp_i.cfg[r_c].lock && region_basic_perm_check[r_c] :
171                                          !csr_pmp_i.cfg[r_c].lock && region_basic_perm_check[r_c];
172           end
173         end
174       end
175 
176       // Access fault determination
177       always_comb begin
178 
179         if (csr_pmp_i.mseccfg.mml) begin
180           // When MSECCFG.MML is set use MML specific permission check
181           access_fault_all[r_c] = !region_mml_perm_check[r_c];
182         end else begin
183           // Otherwise use original PMP behaviour
184           access_fault_all[r_c] = (priv_lvl_i == PRIV_LVL_M) ?
185                                   // For M-mode, any region which matches with the L-bit clear, or with sufficient
186                                   // access permissions will be allowed
187                                   (csr_pmp_i.cfg[r_c].lock && !region_basic_perm_check[r_c]) :
188                                   // For other modes, the lock bit doesn't matter
189                                   !region_basic_perm_check[r_c];
190         end
191       end
192 
193 
194     end // block: check_rules
195   endgenerate
196 
197 
198   // Access fault prioritization
199   always_comb begin
200     // When MSECCFG.MMWP is set default deny always, otherwise allow for M-mode, deny for other
201     // modes
202     access_fault = csr_pmp_i.mseccfg.mmwp || (priv_lvl_i != PRIV_LVL_M);
203 
204     // PMP entries are statically prioritized, from 0 to N-1
205     // The lowest-numbered PMP entry which matches an address determines accessability
206     for (int i_r = PMP_NUM_REGIONS-1; i_r >= 0; i_r--) begin
207       if (region_match_all[i_r]) begin
208         access_fault = access_fault_all[i_r];
209       end
210     end
211   end
212 
213   // Tie low when PMP is deconfigured
214   assign pmp_req_err_o = (PMP_NUM_REGIONS == 0) ? 1'b0 : access_fault;
215   
216   // RLB, rule locking bypass, is only relevant to cv32e40s_cs_registers which controls writes to the
217   // PMP CSRs. Tie to unused signal here to prevent lint warnings.
218   logic unused_csr_pmp_mseccfg_rlb;
219   assign unused_csr_pmp_mseccfg_rlb = csr_pmp_i.mseccfg.rlb;
</code>
