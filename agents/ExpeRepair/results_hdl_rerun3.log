417 // Clocking and reset strategy
418 // We have three clock sources that are multiplexed to 6 domains. The default assignment after
419 // hard reset is:
420 // periph (periph_clk_i) and accelerators (alt_clk_i)
421 //
422 // The host is statically always assigned to host_clk_i.
423 //
424 // Furthermore we have six reset domains:
425 // host             (contained in host clock domain, POR only, no SW reset)
426 // periph           (sw reset 0)
427 // safety           (sw reset 1)
428 // security         (sw reset 2)
429 // pulp_cluster     (sw reset 3)
430 // spatz_cluster    (sw reset 4)
431 // shared_l2_memory (sw reset 5)
432 
433 logic    periph_rst_n;
434 logic    safety_rst_n;
435 logic    security_rst_n;
436 logic    pulp_rst_n;
437 logic    spatz_rst_n;
438 logic    l2_rst_n;
439 
440 logic    host_pwr_on_rst_n;
441 logic    periph_pwr_on_rst_n;
442 logic    safety_pwr_on_rst_n;
443 logic    security_pwr_on_rst_n;
444 logic    pulp_pwr_on_rst_n;
445 logic    spatz_pwr_on_rst_n;
446 logic    l2_pwr_on_rst_n;
447 
448 logic  periph_clk;
449 logic  safety_clk;
450 logic  security_clk;
451 logic  pulp_clk;
452 logic  spatz_clk;
453 logic  l2_clk;
454 
455 
456 
457 // Clock Multiplexing for each sub block
458   localparam int unsigned DomainClkDivValueWidth = 24;
459   typedef logic [DomainClkDivValueWidth-1:0] domain_clk_div_value_t;
460   logic [NumDomains-1:0] domain_clk;
461   logic [NumDomains-1:0] domain_clk_en;
462   logic [NumDomains-1:0] domain_clk_gated;
463   logic [NumDomains-1:0][1:0] domain_clk_sel;
464 
465   logic [NumDomains-1:0] domain_clk_div_changed;
466   logic [NumDomains-1:0] domain_clk_div_decoupled_valid, domain_clk_div_decoupled_ready;
467   domain_clk_div_value_t [NumDomains-1:0] domain_clk_div_value;
468   domain_clk_div_value_t [NumDomains-1:0] domain_clk_div_value_decoupled;
469   logic [NumDomains-1:0] domain_clk_div_valid_synced, domain_clk_div_ready_synced;
470   domain_clk_div_value_t [NumDomains-1:0] domain_clk_div_value_synced;
471 
472   // Note that each accelerator has two resets: One for the combined
473   // software/power-on reset and a power-on reset only
474   logic [NumDomains-1:0] pwr_on_rsts_n;
475   logic [NumDomains-1:0] rsts_n;
476 
477 
478   // Each of the 5 clock gateable domains (periph, safety island, security island, spatz and pulp
479   // cluster) have the following clock distribution scheme:
480   // 1. For each domain the user selects one of 3 different clock sources (host clock, alt clock and
481   //    per clock). Each of these main clocks are either supplied externally, by a dedicated PLL per
482   //    clock source or by a single PLL that supplies all three clock sources. The configuration of
483   //    the clock source is handled by the external PLL wrapper configuration registers.
484   // 2. The selected clock source for the domain is fed into a default-bypassed arbitrary integer
485   //    clock divider with 50% duty cycle. This allows to use different integer clock divisions for
486   //    every target domain to use different clock frequencies.
487   // 3. The internal clock gate of the clock divider is used to provide clock gating for the domain.
488 
489 for (genvar i = 0; i < NumDomains; i++) begin : gen_domain_clock_mux
490   clk_mux_glitch_free #(
491     .NUM_INPUTS(3)
492   ) i_clk_mux (
493     .clks_i       ( {periph_clk_i, alt_clk_i, host_clk_i} ),
494     .test_clk_i   ( 1'b0                                  ),
495     .test_en_i    ( 1'b0                                  ),
496     .async_rstn_i ( host_pwr_on_rst_n                     ),
497     .async_sel_i  ( domain_clk_sel[i]                     ),
498     .clk_o        ( domain_clk[i]                         )
499   );
500 
501   // The register file does not support back pressure directly. I.e the hardware side cannot tell
502   // the regfile that a reg value cannot be written at the moment. This is a problem since the clk
503   // divider input of the clk_int_div module will stall the transaction until it is safe to change
504   // the clock division factor. The stream_deposit module converts between these two protocols
505   // (write-pulse only protocol <-> ready-valid protocol). See the documentation in the header of
506   // the module for more details.
507   lossy_valid_to_stream #(
508     .T(domain_clk_div_value_t)
509   ) i_decouple (
510     .clk_i   ( host_clk_i                        ), // Connected to host clock since the soc_ctr
511                                                     // regs are clocked with it
512     .rst_ni  ( host_pwr_on_rst_n                 ), // See above
513     .valid_i ( domain_clk_div_changed[i]         ),
514     .data_i  ( domain_clk_div_value[i]           ),
515     .valid_o ( domain_clk_div_decoupled_valid[i] ),
516     .ready_i ( domain_clk_div_decoupled_ready[i] ),
517     .data_o  ( domain_clk_div_value_decoupled[i] )
518   );
519 
520   // We have to synchronize the division value into the clock domain of the undivided source clock.
521   cdc_4phase #(
522     .T(domain_clk_div_value_t)
523   ) i_cdc (
524     .src_rst_ni  ( host_pwr_on_rst_n                 ),
525     .src_clk_i   ( host_clk_i                        ),
526     .src_data_i  ( domain_clk_div_value_decoupled[i] ),
527     .src_valid_i ( domain_clk_div_decoupled_valid[i] ),
528     .src_ready_o ( domain_clk_div_decoupled_ready[i] ),
529     .dst_rst_ni  ( pwr_on_rsts_n[i]                  ), // Use POR-only on both sides. Partial reset
530                                                         // problem for SW-reset is thus not
531                                                         // possible.
532     .dst_clk_i   ( domain_clk[i]                     ),
533     .dst_data_o  ( domain_clk_div_value_synced[i]    ),
534     .dst_valid_o ( domain_clk_div_valid_synced[i]    ),
535     .dst_ready_i ( domain_clk_div_ready_synced[i]    )
536   );
537 
538   clk_int_div #(
539     .DIV_VALUE_WIDTH(DomainClkDivValueWidth),
540     .DEFAULT_DIV_VALUE(1),
541     .ENABLE_CLOCK_IN_RESET(1)
542   ) i_clk_div (
543     .clk_i          ( domain_clk[i]                  ),
544     .rst_ni         ( pwr_on_rsts_n[i]               ), // Only reset during power-on. Software
545                                                         // resets will not affect it.
546     .en_i           ( domain_clk_en[i]               ),
547     .test_mode_en_i ( test_mode_i                    ),
548     .div_i          ( domain_clk_div_value_synced[i] ),
549     .div_valid_i    ( domain_clk_div_valid_synced[i] ),
550     .div_ready_o    ( domain_clk_div_ready_synced[i] ),
551     .clk_o          ( domain_clk_gated[i]            ),
552     .cycl_count_o  (                                ) // Not needed
553   );
554 end
555 
556 
557 
558 // Reset generation for power-on reset for host domain. For the other domain we
559 // get this from carfield_rstgen
560 rstgen i_host_rstgen (
561   .clk_i  (host_clk_i),
562   .rst_ni (pwr_on_rst_ni),
563   .test_mode_i,
564   .rst_no (host_pwr_on_rst_n),
565   .init_no () // TODO: connect ?
566 );
567 
568 
569 // Reset generation combining software and power-on reset. These are software
570 // controllable resets. The matching of clock and reset domain is according to
571 // the description above
572 
573 carfield_rstgen #(
574   .NumRstDomains (NumDomains)
575 ) i_carfield_rstgen (
576   .clks_i(domain_clk),
577   .pwr_on_rst_ni,
578   .sw_rsts_ni(~{car_regs_reg2hw.periph_rst.q,
579                 car_regs_reg2hw.safety_island_rst.q,
580                 car_regs_reg2hw.security_island_rst.q,
581                 car_regs_reg2hw.pulp_cluster_rst.q,
582                 car_regs_reg2hw.spatz_cluster_rst.q,
583                 car_regs_reg2hw.l2_rst.q}),
584   .test_mode_i,
585   .rsts_no(rsts_n),
586   .pwr_on_rsts_no(pwr_on_rsts_n),
587   .inits_no() // TODO: connect ?
588 );
