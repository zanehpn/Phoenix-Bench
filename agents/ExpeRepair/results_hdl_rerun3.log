430     // Mux between actual instructions and dummy instructions
431     assign instr_out               = insert_dummy_instr ? dummy_instr_data : instr_decompressed;
432     assign instr_is_compressed_out = insert_dummy_instr ? 1'b0 : instr_is_compressed;
433     assign illegal_c_instr_out     = insert_dummy_instr ? 1'b0 : illegal_c_insn;
434     assign instr_err_out           = insert_dummy_instr ? 1'b0 : if_instr_err;
435 
436     // Stall the IF stage if we insert a dummy instruction. The dummy will execute between whatever
437     // is currently in the ID stage and whatever is valid from the prefetch buffer this cycle. The
438     // PC of the dummy instruction will match whatever is next from the prefetch buffer.
439     assign stall_dummy_instr = insert_dummy_instr;
440 
441     // Register the dummy instruction indication into the ID stage
442     always_ff @(posedge clk_i or negedge rst_ni) begin
443       if (!rst_ni) begin
444         dummy_instr_id_o <= 1'b0;
445       end else if (if_id_pipe_reg_we) begin
446         dummy_instr_id_o <= insert_dummy_instr;
447       end
448     end
449 
450   end else begin : gen_no_dummy_instr
451     logic        unused_dummy_en;
452     logic [2:0]  unused_dummy_mask;
453     logic        unused_dummy_seed_en;
454     logic [31:0] unused_dummy_seed;
455 
456     assign unused_dummy_en         = dummy_instr_en_i;
457     assign unused_dummy_mask       = dummy_instr_mask_i;
458     assign unused_dummy_seed_en    = dummy_instr_seed_en_i;
459     assign unused_dummy_seed       = dummy_instr_seed_i;
460     assign instr_out               = instr_decompressed;
461     assign instr_is_compressed_out = instr_is_compressed;
462     assign illegal_c_instr_out     = illegal_c_insn;
463     assign instr_err_out           = if_instr_err;
464     assign stall_dummy_instr       = 1'b0;
465     assign dummy_instr_id_o        = 1'b0;
466   end
467 
468   // The ID stage becomes valid as soon as any instruction is registered in the ID stage flops.
469   // Note that the current instruction is squashed by the incoming pc_set_i signal.
470   // Valid is held until it is explicitly cleared (due to an instruction completing or an exception)
471   assign instr_valid_id_d = (if_instr_valid & id_in_ready_i & ~pc_set_i) |
472                             (instr_valid_id_q & ~instr_valid_clear_i);
473   assign instr_new_id_d   = if_instr_valid & id_in_ready_i;
474 
475   always_ff @(posedge clk_i or negedge rst_ni) begin
476     if (!rst_ni) begin
477       instr_valid_id_q <= 1'b0;
478       instr_new_id_q   <= 1'b0;
479     end else begin
480       instr_valid_id_q <= instr_valid_id_d;
481       instr_new_id_q   <= instr_new_id_d;
482     end
483   end
484 
485   assign instr_valid_id_o = instr_valid_id_q;
486   // Signal when a new instruction enters the ID stage (only used for RVFI signalling).
487   assign instr_new_id_o   = instr_new_id_q;
488 
489   // IF-ID pipeline registers, frozen when the ID stage is stalled
490   assign if_id_pipe_reg_we = instr_new_id_d;
491 
492   if (ResetAll) begin : g_instr_rdata_ra
493     always_ff @(posedge clk_i or negedge rst_ni) begin
494       if (!rst_ni) begin
495         instr_rdata_id_o         <= '0;
496         instr_rdata_alu_id_o     <= '0;
497         instr_fetch_err_o        <= '0;
498         instr_fetch_err_plus2_o  <= '0;
499         instr_rdata_c_id_o       <= '0;
500         instr_is_compressed_id_o <= '0;
501         illegal_c_insn_id_o      <= '0;
502         pc_id_o                  <= '0;
503         instr_fetch_cheri_acc_vio_o   <= '0;
504         instr_fetch_cheri_bound_vio_o <= '0;
505       end else if (if_id_pipe_reg_we) begin
506         instr_rdata_id_o         <= instr_out;
507         // To reduce fan-out and help timing from the instr_rdata_id flops they are replicated.
508         instr_rdata_alu_id_o     <= instr_out;
509         instr_fetch_err_o        <= instr_err_out;
510         instr_fetch_err_plus2_o  <= if_instr_err_plus2;
511         instr_rdata_c_id_o       <= if_instr_rdata[15:0];
512         instr_is_compressed_id_o <= instr_is_compressed_out;
513         illegal_c_insn_id_o      <= illegal_c_instr_out;
514         pc_id_o                  <= pc_if_o;
515         instr_fetch_cheri_acc_vio_o    <= cheri_acc_vio; 
516         instr_fetch_cheri_bound_vio_o  <= cheri_bound_vio; 
517       end
518     end
519   end else begin : g_instr_rdata_nr
520     always_ff @(posedge clk_i) begin
521       if (if_id_pipe_reg_we) begin
522         instr_rdata_id_o         <= instr_out;
523         // To reduce fan-out and help timing from the instr_rdata_id flops they are replicated.
524         instr_rdata_alu_id_o     <= instr_out;
525         instr_fetch_err_o        <= instr_err_out;
526         instr_fetch_err_plus2_o  <= if_instr_err_plus2;
527         instr_rdata_c_id_o       <= if_instr_rdata[15:0];
528         instr_is_compressed_id_o <= instr_is_compressed_out;
529         illegal_c_insn_id_o      <= illegal_c_instr_out;
530         pc_id_o                  <= pc_if_o;
531         instr_fetch_cheri_acc_vio_o    <= cheri_acc_vio; 
532         instr_fetch_cheri_bound_vio_o  <= cheri_bound_vio; 
533       end
534     end
535   end
536 
537   // Check for expected increments of the PC when security hardening enabled
538   if (PCIncrCheck) begin : g_secure_pc
539     logic [31:0] prev_instr_addr_incr, prev_instr_addr_incr_buf;
540     logic        prev_instr_seq_q, prev_instr_seq_d;
541 
542     // Do not check for sequential increase after a branch, jump, exception, interrupt or debug
543     // request, all of which will set branch_req. Also do not check after reset or for dummys.
544     assign prev_instr_seq_d = (prev_instr_seq_q | instr_new_id_d) &
545         ~branch_req & ~if_instr_err & ~stall_dummy_instr;
546 
547     always_ff @(posedge clk_i or negedge rst_ni) begin
548       if (!rst_ni) begin
549         prev_instr_seq_q <= 1'b0;
550       end else begin
551         prev_instr_seq_q <= prev_instr_seq_d;
552       end
553     end
554 
555     assign prev_instr_addr_incr = pc_id_o + (instr_is_compressed_id_o ? 32'd2 : 32'd4);
556 
557     `ifdef FPGA
558     // Buffer anticipated next PC address to ensure optimiser cannot remove the check.
559     prim_buf #(.Width(32)) u_prev_instr_addr_incr_buf (
560       .in_i (prev_instr_addr_incr),
561       .out_o(prev_instr_addr_incr_buf)
562     );
563     `else
564       assign prev_instr_addr_incr_buf = prev_instr_addr_incr;
565     `endif
566 
567     // Check that the address equals the previous address +2/+4
568     assign pc_mismatch_alert_o = prev_instr_seq_q & (pc_if_o != prev_instr_addr_incr_buf);
569 
570   end else begin : g_no_secure_pc
571     assign pc_mismatch_alert_o = 1'b0;
572   end
573 
574   if (BranchPredictor) begin : g_branch_predictor
575     logic [31:0] instr_skid_data_q;
576     logic [31:0] instr_skid_addr_q;
577     logic        instr_skid_bp_taken_q;
578     logic        instr_skid_valid_q, instr_skid_valid_d;
579     logic        instr_skid_en;
580     logic        instr_bp_taken_q, instr_bp_taken_d;
581 
582     logic        predict_branch_taken_raw;
583 
584     // ID stages needs to know if branch was predicted taken so it can signal mispredicts
585     if (ResetAll) begin : g_bp_taken_ra
586       always_ff @(posedge clk_i or negedge rst_ni) begin
587         if (!rst_ni) begin
588           instr_bp_taken_q <= '0;
589         end else if (if_id_pipe_reg_we) begin
590           instr_bp_taken_q <= instr_bp_taken_d;
591         end
592       end
593     end else begin : g_bp_taken_nr
594       always_ff @(posedge clk_i) begin
595         if (if_id_pipe_reg_we) begin
596           instr_bp_taken_q <= instr_bp_taken_d;
597         end
598       end
599     end
600 
601     // When branch prediction is enabled a skid buffer between the IF and ID/EX stage is introduced.
602     // If an instruction in IF is predicted to be a taken branch and ID/EX is not ready the
603     // instruction in IF is moved to the skid buffer which becomes the output of the IF stage until
604     // the ID/EX stage accepts the instruction. The skid buffer is required as otherwise the ID/EX
605     // ready signal is coupled to the instr_req_o output which produces a feedthrough path from
606     // data_gnt_i -> instr_req_o (which needs to be avoided as for some interconnects this will
607     // result in a combinational loop).
608 
609     assign instr_skid_en = predict_branch_taken & ~pc_set_i & ~id_in_ready_i & ~instr_skid_valid_q;
610 
611     assign instr_skid_valid_d = (instr_skid_valid_q & ~id_in_ready_i & ~stall_dummy_instr) |
612                                 instr_skid_en;
613 
614     always_ff @(posedge clk_i or negedge rst_ni) begin
615       if (!rst_ni) begin
616         instr_skid_valid_q <= 1'b0;
617       end else begin
618         instr_skid_valid_q <= instr_skid_valid_d;
619       end
620     end
621 
622     if (ResetAll) begin : g_instr_skid_ra
623       always_ff @(posedge clk_i or negedge rst_ni) begin
624         if (!rst_ni) begin
625           instr_skid_bp_taken_q <= '0;
626           instr_skid_data_q     <= '0;
627           instr_skid_addr_q     <= '0;
628         end else if (instr_skid_en) begin
629           instr_skid_bp_taken_q <= predict_branch_taken;
630           instr_skid_data_q     <= fetch_rdata;
631           instr_skid_addr_q     <= fetch_addr;
632         end
633       end
634     end else begin : g_instr_skid_nr
635       always_ff @(posedge clk_i) begin
636         if (instr_skid_en) begin
637           instr_skid_bp_taken_q <= predict_branch_taken;
638           instr_skid_data_q     <= fetch_rdata;
639           instr_skid_addr_q     <= fetch_addr;
640         end
641       end
642     end
643 
644     ibex_branch_predict branch_predict_i (
645       .clk_i        (clk_i),
646       .rst_ni       (rst_ni),
647       .fetch_rdata_i(fetch_rdata),
648       .fetch_pc_i   (fetch_addr),
649       .fetch_valid_i(fetch_valid),
650 
651       .predict_branch_taken_o(predict_branch_taken_raw),
652       .predict_branch_pc_o   (predict_branch_pc)
653     );
654 
655     // If there is an instruction in the skid buffer there must be no branch prediction.
656     // Instructions are only placed in the skid after they have been predicted to be a taken branch
657     // so with the skid valid any prediction has already occurred.
658     // Do not branch predict on instruction errors.
659     assign predict_branch_taken = predict_branch_taken_raw & ~instr_skid_valid_q & ~fetch_err;
660 
661     assign if_instr_valid   = fetch_valid | (instr_skid_valid_q & ~nt_branch_mispredict_i);
662     assign if_instr_rdata   = instr_skid_valid_q ? instr_skid_data_q : fetch_rdata;
663     assign if_instr_addr    = instr_skid_valid_q ? instr_skid_addr_q : fetch_addr;
664 
665     // Don't branch predict on instruction error so only instructions without errors end up in the
666     // skid buffer.
667     assign if_instr_bus_err = ~instr_skid_valid_q & fetch_err;
668     assign instr_bp_taken_d = instr_skid_valid_q ? instr_skid_bp_taken_q : predict_branch_taken;
669 
670     assign fetch_ready = id_in_ready_i & ~stall_dummy_instr & ~instr_skid_valid_q;
671 
672     assign instr_bp_taken_o = instr_bp_taken_q;
673 
674     `ASSERT(NoPredictSkid, instr_skid_valid_q |-> ~predict_branch_taken)
675     `ASSERT(NoPredictIllegal, predict_branch_taken |-> ~illegal_c_insn)
676   end else begin : g_no_branch_predictor
677     assign instr_bp_taken_o     = 1'b0;
678     assign predict_branch_taken = 1'b0;
679     assign predict_branch_pc    = 32'b0;
680 
681     assign if_instr_valid = fetch_valid;
682     assign if_instr_rdata = fetch_rdata;
683     assign if_instr_addr  = fetch_addr;
684     assign if_instr_bus_err = fetch_err;
685     assign fetch_ready = id_in_ready_i & ~stall_dummy_instr;
686   end
687 
688   ////////////////
689   // Assertions //
690   ////////////////
691 
692   // Selectors must be known/valid.
693   `ASSERT_KNOWN(IbexExcPcMuxKnown, exc_pc_mux_i)
694 
695   if (BranchPredictor) begin : g_branch_predictor_asserts
696     `ASSERT_IF(IbexPcMuxValid, pc_mux_internal inside {
697         PC_BOOT,
698         PC_JUMP,
699         PC_EXC,
700         PC_ERET,
701         PC_DRET,
702         PC_BP},
703       pc_set_i)
704 
705 `ifdef INC_ASSERT
706     /**
707      * Checks for branch prediction interface to fetch_fifo/icache
708      *
709      * The interface has two signals:
710      * - predicted_branch_i: When set with a branch (branch_i) indicates the branch is a predicted
711      *   one, it should be ignored when a branch_i isn't set.
712      * - branch_mispredict_i: Indicates the previously predicted branch was mis-predicted and
713      *   execution should resume with the not-taken side of the branch (i.e. continue with the PC
714      *   that followed the predicted branch). This must be raised before the instruction that is
715      *   made available following a predicted branch is accepted (Following a cycle with branch_i
716      *   & predicted_branch_i, branch_mispredict_i can only be asserted before or on the same cycle
717      *   as seeing fetch_valid & fetch_ready). When branch_mispredict_i is asserted, fetch_valid may
718      *   be asserted in response. If fetch_valid is asserted on the same cycle as
719      *   branch_mispredict_i this indicates the fetch_fifo/icache has the not-taken side of the
720      *   branch immediately ready for use
721      */
722     logic        predicted_branch_live_q, predicted_branch_live_d;
723     logic [31:0] predicted_branch_nt_pc_q, predicted_branch_nt_pc_d;
724     logic [31:0] awaiting_instr_after_mispredict_q, awaiting_instr_after_mispredict_d;
725     logic [31:0] next_pc;
726 
727     logic mispredicted, mispredicted_d, mispredicted_q;
728 
729     assign next_pc = fetch_addr + (instr_is_compressed_out ? 32'd2 : 32'd4);
730 
731     logic predicted_branch;
732 
733     // pc_set_i takes precendence over branch prediction
734     assign predicted_branch = predict_branch_taken & ~pc_set_i;
735 
736     always_comb begin
737       predicted_branch_live_d = predicted_branch_live_q;
738       mispredicted_d          = mispredicted_q;
739 
740       if (branch_req & predicted_branch) begin
741         predicted_branch_live_d = 1'b1;
742         mispredicted_d          = 1'b0;
743       end else if (predicted_branch_live_q) begin
744         if (fetch_valid & fetch_ready) begin
745           predicted_branch_live_d = 1'b0;
746         end else if (nt_branch_mispredict_i) begin
747           mispredicted_d = 1'b1;
748         end
749       end
750     end
751 
752     always @(posedge clk_i or negedge rst_ni) begin
753       if (!rst_ni) begin
754         predicted_branch_live_q <= 1'b0;
755         mispredicted_q          <= 1'b0;
756       end else begin
757         predicted_branch_live_q <= predicted_branch_live_d;
758         mispredicted_q          <= mispredicted_d;
759       end
760     end
761 
762     always @(posedge clk_i) begin
763       if (branch_req & predicted_branch) begin
764         predicted_branch_nt_pc_q <= next_pc;
765       end
766     end
767 
768     // Must only see mispredict after we've performed a predicted branch but before we've accepted
769     // any instruction (with fetch_ready & fetch_valid) that follows that predicted branch.
</code>
