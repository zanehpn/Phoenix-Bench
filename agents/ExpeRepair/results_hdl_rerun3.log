10 /**
11  * Instruction Fetch Stage
12  *
13  * Instruction fetch unit: Selection of the next PC, and buffering (sampling) of
14  * the read instruction.
15  */
16 
17 `include "prim_assert.sv"
18 
19 module ibex_if_stage import ibex_pkg::*; import cheri_pkg::*; #(
20   parameter int unsigned DmHaltAddr        = 32'h1A110800,
21   parameter int unsigned DmExceptionAddr   = 32'h1A110808,
22   parameter bit          DummyInstructions = 1'b0,
23   parameter bit          ICache            = 1'b0,
24   parameter bit          ICacheECC         = 1'b0,
25   parameter int unsigned BusSizeECC        = BUS_SIZE,
26   parameter int unsigned TagSizeECC        = IC_TAG_SIZE,
27   parameter int unsigned LineSizeECC       = IC_LINE_SIZE,
28   parameter bit          PCIncrCheck       = 1'b0,
29   parameter bit          ResetAll          = 1'b0,
30   parameter lfsr_seed_t  RndCnstLfsrSeed   = RndCnstLfsrSeedDefault,
31   parameter lfsr_perm_t  RndCnstLfsrPerm   = RndCnstLfsrPermDefault,
32   parameter bit          BranchPredictor   = 1'b0,
33   parameter bit          CHERIoTEn         = 1'b1
34 ) (
35   input  logic                         clk_i,
36   input  logic                         rst_ni,
37 
38   input  logic                         cheri_pmode_i,
39   input  logic [31:0]                  boot_addr_i,              // also used for mtvec
40   input  logic                         req_i,                    // instruction request control
41   input  logic                         debug_mode_i,
42 
43   // instruction cache interface
44   output logic                        instr_req_o,
45   output logic [31:0]                 instr_addr_o,
46   input  logic                        instr_gnt_i,
47   input  logic                        instr_rvalid_i,
48   input  logic [31:0]                 instr_rdata_i,
49   input  logic                        instr_err_i,
50 
51   // ICache RAM IO
52   output logic [IC_NUM_WAYS-1:0]      ic_tag_req_o,
53   output logic                        ic_tag_write_o,
54   output logic [IC_INDEX_W-1:0]       ic_tag_addr_o,
55   output logic [TagSizeECC-1:0]       ic_tag_wdata_o,
56   input  logic [TagSizeECC-1:0]       ic_tag_rdata_i [IC_NUM_WAYS],
57   output logic [IC_NUM_WAYS-1:0]      ic_data_req_o,
58   output logic                        ic_data_write_o,
59   output logic [IC_INDEX_W-1:0]       ic_data_addr_o,
60   output logic [LineSizeECC-1:0]      ic_data_wdata_o,
61   input  logic [LineSizeECC-1:0]      ic_data_rdata_i [IC_NUM_WAYS],
62   input  logic                        ic_scr_key_valid_i,
63 
64   // output of ID stage
65   output logic                        instr_valid_id_o,         // instr in IF-ID is valid
66   output logic                        instr_new_id_o,           // instr in IF-ID is new
67   output logic [31:0]                 instr_rdata_id_o,         // instr for ID stage
68   output logic [31:0]                 instr_rdata_alu_id_o,     // replicated instr for ID stage
69                                                                 // to reduce fan-out
70   output logic [15:0]                 instr_rdata_c_id_o,       // compressed instr for ID stage
71                                                                 // (mtval), meaningful only if
72                                                                 // instr_is_compressed_id_o = 1'b1
73   output logic                        instr_is_compressed_id_o, // compressed decoder thinks this
74                                                                 // is a compressed instr
75   output logic                        instr_bp_taken_o,         // instruction was predicted to be
76                                                                 // a taken branch
77   output logic                        instr_fetch_err_o,        // bus error on fetch
78   output logic                        instr_fetch_err_plus2_o,  // bus error misaligned
79   output logic                        illegal_c_insn_id_o,      // compressed decoder thinks this
80                                                                 // is an invalid instr
81   output logic                        instr_fetch_cheri_acc_vio_o,         
82   output logic                        instr_fetch_cheri_bound_vio_o,         
83   output logic                        dummy_instr_id_o,         // Instruction is a dummy
84   output logic [31:0]                 pc_if_o,
85   output logic [31:0]                 pc_id_o,
86   input  logic                        pmp_err_if_i,
87   input  logic                        pmp_err_if_plus2_i,
88 
89   // control signals
90   input  logic                        instr_valid_clear_i,      // clear instr valid bit in IF-ID
91   input  logic                        pc_set_i,                 // set the PC to a new value
92   input  pc_sel_e                     pc_mux_i,                 // selector for PC multiplexer
93   input  logic                        nt_branch_mispredict_i,   // Not-taken branch in ID/EX was
94                                                                 // mispredicted (predicted taken)
95   input  logic [31:0]                 nt_branch_addr_i,         // Not-taken branch address in ID/EX
96   input  exc_pc_sel_e                 exc_pc_mux_i,             // selects ISR address
97   input  exc_cause_e                  exc_cause,                // selects ISR address for
98                                                                 // vectorized interrupt lines
99   input logic                         dummy_instr_en_i,
100   input logic [2:0]                   dummy_instr_mask_i,
101   input logic                         dummy_instr_seed_en_i,
102   input logic [31:0]                  dummy_instr_seed_i,
103   input logic                         icache_enable_i,
104   input logic                         icache_inval_i,
105 
106   // jump and branch target
107   input  logic [31:0]                 branch_target_ex_i,       // branch/jump target address
108 
109   // CSRs
110   input  logic [31:0]                 csr_mepc_i,               // PC to restore after handling
111                                                                 // the interrupt/exception
112   input  logic [31:0]                 csr_depc_i,               // PC to restore after handling
113                                                                 // the debug request
114   input  logic [31:0]                 csr_mtvec_i,              // base PC to jump to on exception
115   output logic                        csr_mtvec_init_o,         // tell CS regfile to init mtvec
116 
117   // pipeline stall
118   input  logic                        id_in_ready_i,            // ID stage is ready for new instr
119 
120   // misc signals
121   output logic                        pc_mismatch_alert_o,
122   output logic                        if_busy_o,                // IF stage is busy fetching instr
123   input  pcc_cap_t                    pcc_cap_i
124 );
125 
126   logic              instr_valid_id_d, instr_valid_id_q;
127   logic              instr_new_id_d, instr_new_id_q;
128 
129   // prefetch buffer related signals
130   logic              prefetch_busy;
131   logic              branch_req;
132   logic       [31:0] fetch_addr_n;
133   logic              unused_fetch_addr_n0;
134 
135   logic              fetch_valid;
136   logic              fetch_ready;
137   logic       [31:0] fetch_rdata;
138   logic       [31:0] fetch_addr;
139   logic              fetch_err;
140   logic              fetch_err_plus2;
141 
142   logic [31:0]       instr_decompressed;
143   logic              illegal_c_insn;
144   logic              instr_is_compressed;
145 
146   logic              if_instr_valid;
147   logic       [31:0] if_instr_rdata;
148   logic       [31:0] if_instr_addr;
149   logic              if_instr_bus_err;
