│  // Stream join dynamic: Joins a dynamically selected subset of    │
│  `N_INP` input stream handshakes into a                            │
│  // single output handshake. Selected input streams can handshake  │
│  independently across multiple cycles.                             │
│  // One output handshake is generated after all selected input     │
│  streams have handshaked exactly once.                             │
│  module stream_join_dynamic #(                                     │
│      parameter int unsigned N_INP = 0    // Synopsys DC requires   │
│  default value for parameters.                                     │
│  ) (                                                               │
│      input  logic                clk_i,                            │
│      input  logic                rst_ni,                           │
│      input  logic [N_INP-1:0]    valid_i,                          │
│      output logic [N_INP-1:0]    ready_o,                          │
│      input  logic [N_INP-1:0]    sel_i,                            │
│      output logic                valid_o,                          │
│      input  logic                ready_i                           │
│  );                                                                │
│                                                                    │
│      logic [N_INP-1:0] pending_d, pending_q;                       │
│      logic [N_INP-1:0] pending_start, pending_next;                │
│      logic             active_d, active_q;                         │
│                                                                    │
│      always_comb begin                                             │
│          active_d     = active_q;                                  │
│          pending_start = pending_q;                                │
│                                                                    │
│          // Start a new transaction when idle and sample the       │
│  current selection mask.                                           │
│          if (!active_q) begin                                      │
│              active_d      = 1'b1;                                 │
│              pending_start = sel_i;                                │
│          end                                                       │
│                                                                    │
│          // Default: no input is ready unless it is still pending  │
│          pending_next = pending_start;                             │
│          ready_o      = '0;                                        │
│                                                                    │
│          // Independently accept all selected, still-pending       │
│  inputs.                                                           │
│          for (int unsigned i = 0; i < N_INP; i++) begin            │
│              ready_o[i] = active_d & pending_start[i];             │
│              if (valid_i[i] && ready_o[i]) begin                   │
│                  pending_next[i] = 1'b0;                           │
│              end                                                   │
│          end                                                       │
│                                                                    │
│          // Output becomes valid once all selected inputs have be  │
│  accepted.                                                         │
│          valid_o = active_d & (pending_next == '0);                │
│                                                                    │
│          // Output handshake completes the current transaction.    │
│          if (valid_o && ready_i) begin                             │
│              active_d  = 1'b0;                                     │
│              pending_d = '0;                                       │
│          end else begin                                            │
│              pending_d = pending_next;                             │
│          end                                                       │
│      end                                                           │
│                                                                    │
│      always_ff @(posedge clk_i, negedge rst_ni) begin              │
│          if (!rst_ni) begin                                        │
│              active_q  <= 1'b0;                                    │
│              pending_q <= '0;                                      │
│          end else begin                                            │
│              active_q  <= active_d;                                │
│              pending_q <= pending_d;                               │
│          end                                                       │
│      end                                                           │
│                                                                    │
