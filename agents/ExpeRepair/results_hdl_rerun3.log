537             end
538             {7'b000_0001, 3'b110}: begin // rem
539               multdiv_operator_o    = MD_OP_REM;
540               multdiv_signed_mode_o = 2'b11;
541               illegal_insn          = (RV32M == RV32MNone) ? 1'b1 : 1'b0;
542             end
543             {7'b000_0001, 3'b111}: begin // remu
