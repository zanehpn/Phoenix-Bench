63 parameter ALU_OP_WIDTH = 6;
64 
65   // TODO:low Could a smarter encoding be used here?
66 
67 // Note: Certain bits in alu_opcode_e are referred to directly in the ALU:
68 //
69 // - Bit 2: Right shift?
70 //          Used for ALU_SLL, ALU_B_ROL,  ALU_B_ROR, ALU_B_BCLR,
71 //          ALU_B_BSET, ALU_B_BINV, ALU_SRL, ALU_SRA, ALU_B_BEXT.
72 // - Bit 3: Should B operand of adder be negated?
73 //          Used for ALU_ADD, ALU_SUB.
74 // - Bit 3: Are operands signed?
75 //          Used for ALU_SLT, ALU_SLTU, ALU_LT, ALU_GE, ALU_LTU, ALU_GEU,
76 //          ALU_B_MIN, ALU_B_MINU, ALU_B_MAX, ALU_B_MAXU
77 // - Bit 5: Is the operator a B extension operation?
78 
79 typedef enum logic [ALU_OP_WIDTH-1:0]
80 {
81  ALU_ADD      = 6'b000000, // funct3 = 000, negate_b(3)
82  ALU_SUB      = 6'b001000, // funct3 = 000, negate_b(3)
83 
84  ALU_XOR      = 6'b000100, // funct3 = 100
85  ALU_OR       = 6'b000110, // funct3 = 110
86  ALU_AND      = 6'b000111, // funct3 = 111
87 
88  ALU_B_XNOR   = 6'b101100, // funct3 = 100, zbb
89  ALU_B_ORN    = 6'b101110, // funct3 = 110, zbb
90  ALU_B_ANDN   = 6'b101111, // funct3 = 111, zbb
91 
92  // Comparisons // todo: comparator operators do not need to be part of ALU operators
93  ALU_EQ       = 6'b010000, // funct3 = 000
94  ALU_NE       = 6'b010001, // funct3 = 001
95  ALU_SLT      = 6'b011010, // funct3 = 010, signed(3)
96  ALU_SLTU     = 6'b010011, // funct3 = 011, unsigned(3)
97  ALU_LT       = 6'b011100, // funct3 = 100, signed(3)
98  ALU_GE       = 6'b011101, // funct3 = 101, signed(3)
99  ALU_LTU      = 6'b010110, // funct3 = 110, unsigned(3)
100  ALU_GEU      = 6'b010111, // funct3 = 111, unsigned(3)
101 
102  ALU_B_MIN    = 6'b111100, // funct3 = 100, signed(3), minimum(1)
103  ALU_B_MINU   = 6'b110101, // funct3 = 101, unsigned(3), minimum(1)
104  ALU_B_MAX    = 6'b111110, // funct3 = 110, signed(3), maximum(1)
105  ALU_B_MAXU   = 6'b110111, // funct3 = 111, unsigned(3), maximum(1)
106 
107  ALU_SLL      = 6'b000001, // funct3 = 001, left(2)
108  ALU_B_ROL    = 6'b100001, // funct3 = 001, left(2)
109  ALU_B_ROR    = 6'b100101, // funct3 = 101, right(2)
110  ALU_B_BCLR   = 6'b101001, // funct3 = 001, Zbs, left(2)
111  ALU_B_BSET   = 6'b110001, // funct3 = 001, Zbs, left(2)
112  ALU_B_BINV   = 6'b111001, // funct3 = 001, Zbs, left(2)
113  ALU_SRL      = 6'b000101, // funct3 = 101, right(2)
114  ALU_SRA      = 6'b001101, // funct3 = 101, right(2)
115  ALU_B_BEXT   = 6'b111101, // funct3 = 101, Zbs, right(2)
116 
117  // B, Zba
118  ALU_B_SH1ADD = 6'b100010, // funct3 = 010
119  ALU_B_SH2ADD = 6'b100100, // funct3 = 100
120  ALU_B_SH3ADD = 6'b100110, // funct3 = 110
121 
122  // B, Zbb
123  ALU_B_CLZ    = 6'b100000, // (funct3 = 001)
124  ALU_B_CTZ    = 6'b101000, // (funct3 = 001)
125  ALU_B_CPOP   = 6'b100011, // (funct3 = 001)
126 
127  // The following three alu opcodes are shared between B and ZC.
128  // Setting bit5==0 allows synth to optimize away most B logic
129  // in the ALU in case only ZC_EXT is enabled.
130  ALU_B_SEXT_B = 6'b010010,
131  ALU_B_SEXT_H = 6'b010100,
132  ALU_B_ZEXT_H = 6'b010101,
133 
134  ALU_B_REV8   = 6'b110100, // (funct3 = 101)
135  ALU_B_ORC_B  = 6'b110010, // (funct3 = 101)
136 
137  // B, Zbc
138  ALU_B_CLMUL  = 6'b100111, // (funct3 = 001)
139  ALU_B_CLMULH = 6'b101011, // funct3 = 011
140  ALU_B_CLMULR = 6'b101010  // funct3 = 010
141 
142  // Free encodings with bit 5 set (for B_EXT):
143  // 6'b101101
144  // 6'b110110
145  // 6'b111010
146  // 6'b111011
147  // 6'b111111
148 
149 } alu_opcode_e;
