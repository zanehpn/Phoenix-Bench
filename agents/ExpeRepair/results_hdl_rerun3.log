353   // Local instr_valid when we have valid output from prefetcher or we are inserting a dummy instruction
354   // and IF is not halted or killed
355   assign instr_valid = (prefetch_valid || dummy_insert) && !ctrl_fsm_i.kill_if && !ctrl_fsm_i.halt_if;
356 
357   // if_stage ready when killed, otherwise when not halted or if a dummy instruction is inserted.
358   assign if_ready = ctrl_fsm_i.kill_if || (seq_ready && predec_ready && !dummy_insert && !ctrl_fsm_i.halt_if);// todo: !dummy_insert should not be needed here if factored into seq_ready, predec_ready already as would be logical
359 
360 
361 
362   // if stage valid when local instr_valid=1
363   // Ideally this should be the following:
364   //
365   // assign if_valid_o = (seq_en    && seq_valid    ) ||
366   //                     (predec_en && predec_valid ) && instr_valid;
367   //
368   // The predecoder is purely combinatorial module, and will produce a valid output for any valid input (instr_valid)
369   // The Sequencer will output valid=1 for any instruction it can decode while not halted or killed
370   //   when its valid_i (prefetch_valid) is high.
371 
372   assign if_valid_o = instr_valid;
373 
374   assign if_busy_o = prefetch_busy;
375 
376   // Ensures one shift of lfsr0 for each instruction inserted in IF
377   assign lfsr_shift_o = if_valid_o && id_ready_i && dummy_insert;
378 
379   assign ptr_in_if_o = prefetch_is_clic_ptr || prefetch_is_tbljmp_ptr;
380 
381   // Acknowledge prefetcher when IF stage is ready. This factors in seq_ready to avoid ack'ing the
382   // prefetcher in the middle of a Zc sequence.
383   // No need to ack the prefetcher when tbljmp==1, as this is will generate a pc_set and kill_if when
384   // the table jump is taken in ID and the pointer fetch is initiated (or the table jump is killed).
385   assign prefetch_ready = if_ready && !tbljmp;
386 
387   // Last operation of table jumps are set when the pointer is fed to ID stage
388   // tbljmp (first operation) is set when a cm.jt or cm.jalt is decoded in the compressed decoder.
389   // Trigger matches will get all write enables deasserted in ID, and debug entered before retiring
390   // any operations once the first operation reaches WB. A trigger match is a last_op by definition.
391   // todo: Factor CLIC pointers?
392   assign last_op_o = trigger_match_i ? 1'b1 :
393                      tbljmp          ? 1'b0 :  // tbljmps are the first half
394                      dummy_insert    ? 1'b1 :  // Dummies are always single operation // todo: also first_op_o = 1?
395 // todo: provide list of IF 'submodules' and explanation on their relative priorities and exclusivity. Also ordering of tbljmp and dummy_insert is misleading here
396                      seq_valid       ? seq_last : 1'b1; // Any other regular instructions are single operation.
397 
398   // Flag first operation of a sequence.
399   // Sequencer will set seq_first=1 when not in use - any other instruction handled by the compressed decoder (except table jumps)
400   // will always have first_op=1 and may thus use seq_first.
401   // Would ideally be something like "seq_valid ? : seq_first : 1'b1", but that causes combinatorial loops
402   // through the controllers sequence_interruptible, via kill_ex and seq_valid and then into the first_op_o again.
403   // Trigger matches will have all write enables deasserted in ID, and once the first operation reaches WB the debug entry will be made.
404   // Marking as first (and last above) since we know it will not be a true sequence. Sequencer will keep sequencing, but will get killed
405   // upon debug entry and no side effect will occur.
406   // Dummy instructions are only allowed when first_op_o = 1. Using 'dummy_insert ? ' below would cause combinatorial loops through the controller FSM.
407   // todo: factor in CLIC pointers?
408   assign first_op_o = prefetch_is_tbljmp_ptr ? 1'b0 :
409                       trigger_match_i        ? 1'b1 : seq_first;
410 
411 
412 
413   // Populate instruction meta data
414   // Fields 'compressed' and 'tbljmp' keep their old value by default.
415   //   - In case of a table jump we need the fields to stay as 'compressed=1' and 'tbljmp=1'
416   //     even when the pointer is sent to ID (operation 2/2)
417   //   - For all cases except table jump pointer we update the values to the current values from predecoding.
418   instr_meta_t instr_meta_n;
419   always_comb begin
420     instr_meta_n = '0;
421     instr_meta_n.dummy         = dummy_insert;
422     instr_meta_n.compressed    = if_id_pipe_o.instr_meta.compressed;
423     instr_meta_n.clic_ptr      = prefetch_is_clic_ptr;
424     instr_meta_n.tbljmp        = if_id_pipe_o.instr_meta.tbljmp;
425   end
426 
427   // IF-ID pipeline registers, frozen when the ID stage is stalled
428   // Todo: E40S: We will probably need to prevent dummy instructions between pointer fetcher and the pointer target fetch
429   always_ff @(posedge clk, negedge rst_n)
430   begin : IF_ID_PIPE_REGISTERS
431     if (rst_n == 1'b0) begin
432       if_id_pipe_o.instr_valid      <= 1'b0;
433       if_id_pipe_o.instr            <= INST_RESP_RESET_VAL;
434       if_id_pipe_o.instr_meta       <= '0;
435       if_id_pipe_o.pc               <= '0;
436       if_id_pipe_o.illegal_c_insn   <= 1'b0;
437       if_id_pipe_o.compressed_instr <= '0;
438       if_id_pipe_o.priv_lvl         <= PRIV_LVL_M;
439       if_id_pipe_o.trigger_match    <= 1'b0;
440       if_id_pipe_o.xif_id           <= '0;
441       if_id_pipe_o.ptr              <= '0;
442       if_id_pipe_o.last_op          <= 1'b0;
443       if_id_pipe_o.first_op         <= 1'b0;
444     end else begin
445       // Valid pipeline output if we are valid AND the
446       // alignment buffer has a valid instruction
447       if (if_valid_o && id_ready_i) begin
448         if_id_pipe_o.instr_valid      <= 1'b1;
449         if_id_pipe_o.instr_meta       <= instr_meta_n;
450         // seq_valid implies no illegal instruction, sequencer successfully decoded an instruction.
451         // compressed decoder will still raise illegal_c_insn as it doesn't (currently) recognize Zc push/pop/dmove
452         if_id_pipe_o.illegal_c_insn   <= (seq_valid || dummy_insert) ? 1'b0 : illegal_c_insn;
453 
454 
455         if_id_pipe_o.priv_lvl         <= prefetch_priv_lvl;
456         if_id_pipe_o.trigger_match    <= dummy_insert ? 1'b0 : trigger_match_i;
457         if_id_pipe_o.xif_id           <= xif_id;
458         if_id_pipe_o.last_op          <= last_op_o;
459         if_id_pipe_o.first_op         <= first_op_o;
460 
461         // No PC update for tablejump pointer, PC of instruction itself is needed later.
462         // No update to the meta compressed, as this is used in calculating the link address.
463         //   Any pointer could change instr_compressed and cause a wrong link address.
464         // No update to tbljmp flag, we want flag to be high for both operations.
465         if (!prefetch_is_tbljmp_ptr) begin
466           if_id_pipe_o.pc                    <= pc_if_o;
467           // todo: push/pop*/doublemoves are compressed, how (if at all) should we signal that when we emit uncompressed sequences?
468           if_id_pipe_o.instr_meta.compressed <= dummy_insert ? 1'b0 : instr_compressed;
469           if_id_pipe_o.instr_meta.tbljmp     <= tbljmp;
470 
471           // Only update compressed_instr for compressed instructions
472           if (instr_compressed) begin
473             if_id_pipe_o.compressed_instr      <= prefetch_instr.bus_resp.rdata[15:0];
474           end
475         end
476 
477         // For pointers, we want to update the if_id_pipe.ptr field, but also any associated error conditions from bus or MPU.
478         if (ptr_in_if_o) begin
479           // Update pointer value
480           if_id_pipe_o.ptr                <= instr_decompressed.bus_resp.rdata;
481 
482           // Need to update bus error status and mpu status, but may omit the 32-bit instruction word
483           if_id_pipe_o.instr.bus_resp.err <= instr_decompressed.bus_resp.err;
484           if_id_pipe_o.instr.mpu_status   <= instr_decompressed.mpu_status;
485         end else begin
486           // Regular instruction, update the whole instr field
487           if_id_pipe_o.instr          <= dummy_insert ? dummy_instr :
488                                         seq_valid     ? seq_instr   : instr_decompressed;
489         end
490       end else if (id_ready_i) begin
491         if_id_pipe_o.instr_valid      <= 1'b0;
492       end
493     end
494   end
495 
496   cv32e40s_compressed_decoder
497   #(
498       .ZC_EXT ( ZC_EXT ),
499       .B_EXT  ( B_EXT  ),
500       .M_EXT  ( M_EXT  )
501   )
502   compressed_decoder_i
503   (
504     .instr_i            ( prefetch_instr          ),
505     .instr_is_ptr_i     ( ptr_in_if_o             ),
506     .mstateen0_i        ( mstateen0_i             ),
507     .priv_lvl_i         ( prefetch_priv_lvl       ),
508     .instr_o            ( instr_decompressed      ),
509     .is_compressed_o    ( instr_compressed        ),
510     .illegal_instr_o    ( illegal_c_insn          ),
511     .tbljmp_o           ( tbljmp_raw              )
512   );
513 
514   // Setting predec_ready to id_ready_i here instead of passing it through the predecoder.
515   // Predecoder is purely combinatorial and is always ready for new inputs
516   assign predec_ready = id_ready_i; // todo: && !dummy_insert
517 
518   // Dummies are allowed when first_op_o == 1
519   // If the first operation of a sequence is ready, we allow dummies
520   // but must not advance the sequencer.
521   assign seq_pop = id_ready_i && !dummy_insert; // todo: seq_pop not declared and name unclear. Rename to id_ready_no_dummy
522 
523   // Do not signal valid to the sequencer in case of a trigger match.
524   // No need for the sequencer to start a sequence, the instruction will cause
525   // debug entry on the first operation with no side effects done.
526   assign seq_instr_valid = prefetch_valid && !trigger_match_i;
