610   // Multi-bit fetch enable used when SecureIbex == 1. When SecureIbex == 0 only use the bottom-bit
611   // of fetch_enable_i. Ensure the multi-bit encoding has the bottom bit set for on and unset for
612   // off so FetchEnableOn/FetchEnableOff can be used without needing to know the value of
613   // SecureIbex.
614   `ASSERT_INIT(FetchEnableSecureOnBottomBitSet,    FetchEnableOn[0] == 1'b1)
615   `ASSERT_INIT(FetchEnableSecureOffBottomBitClear, FetchEnableOff[0] == 1'b0)
616 
617   // fetch_enable_i can be used to stop the core fetching new instructions
618   if (SecureIbex) begin : g_instr_req_gated_secure
619     // For secure Ibex fetch_enable_i must be a specific multi-bit pattern to enable instruction
620     // fetch
621     assign instr_req_gated = instr_req_int & (fetch_enable_i == FetchEnableOn);
622   end else begin : g_instr_req_gated_non_secure
623     // For non secure Ibex only the bottom bit of fetch enable is considered
624     logic unused_fetch_enable;
625     assign unused_fetch_enable = ^fetch_enable_i[$bits(fetch_enable_t)-1:1];
626 
627     assign instr_req_gated = instr_req_int & fetch_enable_i[0];
628   end
