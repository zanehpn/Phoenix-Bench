  /******************************************************************************************
   Module          	: DFFR_X1
   Cell Description	: Pos.edge D-Flip-Flop with active low reset, and drive strength X1
  *******************************************************************************************/

  cell (DFFR_X1) {

	drive_strength     	: 1;

	ff ("IQ" , "IQN") {
		next_state         	: "D";
		clocked_on         	: "CK";
		clear              	: "!RN";
	}

	area               	: 5.320000;
	pg_pin(VDD) {
		voltage_name : VDD;
		pg_type      : primary_power;
	}
	pg_pin(VSS) {
		voltage_name : VSS;
		pg_type      : primary_ground;
	}


	cell_leakage_power 	: 18.971246;

	leakage_power () {
		when           : "!CK & !D & !RN & !Q & QN";
		value          : 15.329770;
	}
	leakage_power () {
		when           : "!CK & !D & RN & !Q & QN";
		value          : 18.480673;
	}
