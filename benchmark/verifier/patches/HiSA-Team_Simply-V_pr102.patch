+++ b/hw/xilinx/rtl/peripheral_bus.sv
@@ -7,7 +7,7 @@
 //      _________________            _______________                  _____________             _______
 //     |                 |  AXI4    |   AXI Prot    |   AXI Lite     |             |           |       |
 // --->| Clock Converter |--------->|   Converter   |--------------->|             |---------->| UART  |
-//     |_________________|          |_______________|                | Pheripheral |           |_______|
+//     |_________________|          |_______________|                | Peripheral  |           |_______|
 //                                                                   |    XBAR     |
 //                                                                   |  (axilite)  |            ___________
 //                                                                   |             |           |           |  Interrupts

From 68922d3df2f71833bb992d1a784455dd013ea794 Mon Sep 17 00:00:00 2001
From: Manuel <manuelmaddaluno5@gmail.com>
Date: Mon, 12 May 2025 17:53:01 +0200
Subject: [PATCH 3/4] [bugfix] add MACRO_LIST in sw/SoC/common/Makefile

---
 sw/SoC/common/Makefile              | 11 ++++++++++-
 sw/SoC/examples/interrupts/Makefile |  9 ---------
 2 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/sw/SoC/common/Makefile b/sw/SoC/common/Makefile
index b57b1294..daea26e4 100644
--- a/sw/SoC/common/Makefile
+++ b/sw/SoC/common/Makefile
@@ -16,6 +16,15 @@ OBJS	 = $(addprefix $(OBJ_DIR)/, $(notdir $(SRCS:.c=.o)))
 RM	  = rm -rf					 # Remove recursively command
 MKDIR   = @mkdir -p $(@D)			 # Creates folders if not present
 
+##########
+# MACROS #
+##########
+
+MACRO_LIST =
+ifeq ($(SOC_CONFIG), embedded)
+MACRO_LIST += -DIS_EMBEDDED
+endif
+
 ###############################################################################
 
 ###########
@@ -27,7 +36,7 @@ all: bin/$(PROGRAM_NAME).bin
 $(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
 	@echo "\n[OBJ] Creating OBJs from src"
 	$(MKDIR)
-	$(CC) -o $@ $^ -I$(INC_DIR) $(LIB_INC_LIST) $(CFLAGS)
+	$(CC) -o $@ $^ -I$(INC_DIR) $(LIB_INC_LIST) $(CFLAGS) $(MACRO_LIST)
 
 obj/startup.o:
 	@echo "\n[OBJ] Creating OBJs from $(STARTUP_DIR)/startup.s"
diff --git a/sw/SoC/examples/interrupts/Makefile b/sw/SoC/examples/interrupts/Makefile
index 56a2dd3d..39242960 100755
--- a/sw/SoC/examples/interrupts/Makefile
+++ b/sw/SoC/examples/interrupts/Makefile
@@ -37,15 +37,6 @@ LIB_INC_TINYIO    = -I$(LIB_DIR)/tinyio/inc
 LIB_OBJ_LIST     = $(LIB_OBJ_TINYIO)
 LIB_INC_LIST     = $(LIB_INC_TINYIO)
 
-##########
-# MACROS #
-##########
-
-MACRO_LIST =
-ifeq ($(SOC_CONFIG), embedded)
-MACRO_LIST += -DIS_EMBEDDED
-endif
-
 
 #############
 # Toolchain #

From f9e7092bf3735a749c1622d6e8957e3637ec5e5d Mon Sep 17 00:00:00 2001
From: Vincenzo Maisto <vincenzo.maisto2@unina.it>
Date: Tue, 13 May 2025 19:11:56 +0200
Subject: [PATCH 4/4] Add killall virtual_uart

---
 hw/xilinx/make/utils.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/hw/xilinx/make/utils.mk b/hw/xilinx/make/utils.mk
index 10839d03..e68e80ab 100644
--- a/hw/xilinx/make/utils.mk
+++ b/hw/xilinx/make/utils.mk
@@ -58,9 +58,14 @@ program_bitstream_embedded:
 # Program bitstream for HPC profile
 PCIE_DEV ?= 01:00.0 # TODO: remove this and find the dev automatically in the script
 program_bitstream_hpc:
+#	Kill pending virtual_uart instances (if any)
+#	TODO: This might be overkill, as only that one instance should cause problems 
+	killall virtual_uart 
+#	Program
 	${XILINX_VIVADO} \
 		-source ${XILINX_SCRIPTS_UTILS_ROOT}/open_hw_manager.tcl \
 		-source ${XILINX_SCRIPTS_UTILS_ROOT}/program_bitstream.tcl
+#	Rescan PCIe device
 	sudo ${XILINX_SCRIPTS_UTILS_ROOT}/pcie_hot_reset.sh ${PCIE_DEV}
 
 # PHONIES
