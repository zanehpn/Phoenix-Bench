From b49106ff70583a13d99d514506788bb76a5afcd8 Mon Sep 17 00:00:00 2001
From: Pawel Karpinski <pawelka@gmail.com>
Date: Mon, 15 Sep 2025 22:35:32 -0700
Subject: [PATCH] add support for second usb joy and added mouse
 disabling/enabling when joystick/mouse button is click. Add support to select
 to which port USB JOY0 and USB JOY1 are mapped

---
 src/build.sh             |    4 +
 src/misc/atarist.xml     |    4 +
 src/misc/atarist_xml.hex | 1725 +++++++++++++++++++-------------------
 src/misc/sysctrl.v       |    4 +
 src/misterynano.sv       |   44 +-
 5 files changed, 923 insertions(+), 858 deletions(-)

diff --git a/src/build.sh b/src/build.sh
index b0048c4..90e4c3b 100755
--- a/src/build.sh
+++ b/src/build.sh
@@ -4,5 +4,9 @@ if [ "$#" -eq 1 ]; then
     EXT=_$1
 fi
 
+echo "Convert misc/atarist.xml to misc/atarist_xml.hex"
+cat misc/atarist.xml | gzip | xxd -p -c1 | unix2dos > misc/atarist_xml.hex
+
+
 # run through grc to highlight NOTEs, WARNings and ERRORs
 grc --config=gw_sh.grc gw_sh ./build${EXT}.tcl
diff --git a/src/misc/atarist.xml b/src/misc/atarist.xml
index f21a092..9ff670f 100644
--- a/src/misc/atarist.xml
+++ b/src/misc/atarist.xml
@@ -73,6 +73,10 @@
 	<listentry label="Atari ST" value="1"/>
 	<listentry label="Amiga" value="2"/>
       </list>
+      <list label="USB Joy:" id="U" default="1">
+	<listentry label="Port0/Port1" value="0"/>
+	<listentry label="Port1/Port0" value="1"/>
+      </list>
       <list label="TOS Slot:" id="T" default="0">
 	<listentry label="Primary" value="0"/>
 	<listentry label="Secondary" value="1"/>
