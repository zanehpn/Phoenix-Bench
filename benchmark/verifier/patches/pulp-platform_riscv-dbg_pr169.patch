From d7b8670482b353afea4cf6f7dbe4aae1ca7d4fbc Mon Sep 17 00:00:00 2001
From: bluew <bluewww@users.noreply.github.com>
Date: Mon, 8 Jul 2024 14:49:01 +0200
Subject: [PATCH] src: Fix wrong reset state for TAP after trst_ni

This problem was didn't become visible as most/all drivers always run
the software reset sequence as trst_ni is an optional signal.
---
 src/dmi_jtag_tap.sv | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/dmi_jtag_tap.sv b/src/dmi_jtag_tap.sv
index 53f0fa9..d627cef 100644
--- a/src/dmi_jtag_tap.sv
+++ b/src/dmi_jtag_tap.sv
@@ -303,7 +303,7 @@ module dmi_jtag_tap #(
 
   always_ff @(posedge tck_i or negedge trst_ni) begin : p_regs
     if (!trst_ni) begin
-      tap_state_q <= RunTestIdle;
+      tap_state_q <= TestLogicReset;
       idcode_q    <= IdcodeValue;
       bypass_q    <= 1'b0;
     end else begin
