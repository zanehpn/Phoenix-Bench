-			KEY_HID_J:                ps2_pre <= KEY_PS2_J;
-			KEY_HID_K:                ps2_pre <= KEY_PS2_K;
-			KEY_HID_L:                ps2_pre <= KEY_PS2_L;
-			KEY_HID_M:                ps2_pre <= KEY_PS2_M;
-			KEY_HID_N:                ps2_pre <= KEY_PS2_N;
