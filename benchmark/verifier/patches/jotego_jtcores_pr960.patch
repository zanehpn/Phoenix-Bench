index 000000000..45604e062
--- /dev/null
+++ b/modules/jtframe/ver/serializer/gather.f
@@ -0,0 +1,2 @@
+$JTFRAME/hdl/jtframe_serializer.v
+$JTFRAME/hdl/keyboard/ps2_intf_v.v
diff --git a/modules/jtframe/ver/serializer/test.v b/modules/jtframe/ver/serializer/test.v
new file mode 100644
index 000000000..ba8976930
--- /dev/null
+++ b/modules/jtframe/ver/serializer/test.v
@@ -0,0 +1,74 @@
+module test;
+
+localparam DW=8;
+
+reg clk, rst;
+
+reg  [   7:0] cen_cnt=1;
+wire [DW-1:0] data_in;
+wire [DW-1:0] data_out;
+reg        load;
+wire       sd, valid, oddpar, sclk, cen;
+integer    value=0;
+
+
+initial begin
+    $dumpfile("test.lxt");
+    $dumpvars;
+    $dumpon;
+    #2000000
+    $display("FAIL");
+    $finish;
+end
+
+
+initial begin
+    clk=0;
+    forever #10 clk=~clk;
+end
+
+always @(posedge clk) cen_cnt <= {cen_cnt[0],cen_cnt[7:1]};
+
+assign cen     = cen_cnt[0];
+assign oddpar  = ^value[7:0] ^1'b1;
+assign data_in = {oddpar,value[0+:DW]};
+
+initial begin
+    rst    = 1;
+    load   = 0;
+    repeat (20) @(posedge clk);
+    rst  = 0;
+    repeat (20) @(posedge clk);
+    repeat (100) begin
+        value  = $random;
+        wait ( cen==1 && !sclk );
+        load    = 1;
+        repeat (8) @(posedge clk);
+        load    = 0;
+        wait ( valid && data_in == data_out );
+    end
+    repeat (10) @(posedge clk);
+    $display("PASS");
+    $finish;
+end
+
+jtframe_serializer#(.DW(DW)) uut (
+    .clk       ( clk      ),
+    .rst       ( rst      ),
+    .cen       ( cen      ),
+    .din       ( data_in  ),
+    .load      ( load     ),
+    .sdout     ( sd       ),
+    .sclk      ( sclk     )
+);
+
+ps2_intf_v uut_s (
+    .CLK      ( clk      ),
+    .nRESET   ( ~rst     ),
+    .PS2_CLK  ( sclk     ),
+    .PS2_DATA ( sd       ),
+    .DATA     ( data_out ),
+    .VALID    ( valid    ),
+    .ERROR    (          )
+);
+endmodule
\ No newline at end of file

