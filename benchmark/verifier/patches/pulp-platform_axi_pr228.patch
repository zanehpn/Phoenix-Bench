From 1dc3dc56703d6406806c15699b531ad6d67f39e7 Mon Sep 17 00:00:00 2001
From: Andreas Kurth <akurth@iis.ee.ethz.ch>
Date: Wed, 13 Apr 2022 16:13:34 +0200
Subject: [PATCH] axi_lite_mux_intf: Fix type of interface ports

This fixes issue #227.
---
 CHANGELOG.md        |  2 ++
 src/axi_lite_mux.sv | 10 +++++-----
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index a755a3c02..04430cf99 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -12,6 +12,8 @@ and this project adheres to [Semantic Versioning](http://semver.org/spec/v2.0.0.
 ### Changed
 
 ### Fixed
+- `axi_lite_mux_intf`: Fix type of `slv` and `mst` interface ports; they were `AXI_BUS` instead of
+  `AXI_LITE`.
 
 
 ## 0.35.1 - 2022-03-31
diff --git a/src/axi_lite_mux.sv b/src/axi_lite_mux.sv
index 7aba411ac..75a9a256c 100644
--- a/src/axi_lite_mux.sv
+++ b/src/axi_lite_mux.sv
@@ -470,11 +470,11 @@ module axi_lite_mux_intf #(
   parameter bit          SpillAr       = 1'b1,
   parameter bit          SpillR        = 1'b0
 ) (
-  input  logic   clk_i,                // Clock
-  input  logic   rst_ni,               // Asynchronous reset active low
-  input  logic   test_i,               // Testmode enable
-  AXI_BUS.Slave  slv [NoSlvPorts-1:0], // slave ports
-  AXI_BUS.Master mst                   // master port
+  input  logic    clk_i,                // Clock
+  input  logic    rst_ni,               // Asynchronous reset active low
+  input  logic    test_i,               // Testmode enable
+  AXI_LITE.Slave  slv [NoSlvPorts-1:0], // slave ports
+  AXI_LITE.Master mst                   // master port
 );
 
   typedef logic [AxiAddrWidth-1:0]   addr_t;
