From 4689e1aa32a3660df3853b1898e6dd2504e3cc0e Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Thu, 27 Nov 2025 16:49:19 +0100
Subject: [PATCH] kiwi: drtoppel uses 13 bits for code. Fixes #1276

---
 cores/kiwi/cfg/mame2mra.toml    | 5 +++--
 cores/kiwi/hdl/jtkiwi_game.v    | 5 +++--
 cores/kiwi/hdl/jtkiwi_gfx.v     | 2 ++
 cores/kiwi/hdl/jtkiwi_tilemap.v | 2 ++
 cores/kiwi/hdl/jtkiwi_video.v   | 2 ++
 5 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/cores/kiwi/cfg/mame2mra.toml b/cores/kiwi/cfg/mame2mra.toml
index c1ab8ee1c..c98d289da 100644
--- a/cores/kiwi/cfg/mame2mra.toml
+++ b/cores/kiwi/cfg/mame2mra.toml
@@ -41,12 +41,13 @@ info="""bit 0 = MCU
              bit 0 = service XOR
              bit 1 = button aid
              bit 2 = 3 MHz for FM module
-             bit 3 = Kabuki Z with different memory map  """
+             bit 3 = Kabuki Z with different memory map
+             bit 4 = 13 bits tilemap code"""
 data=[
     { setnames=["tnzso","tnzsjo","tnzsoa","tnzsop","tnzsuo"], data="B1 04" }, # HB dly, Banked RAM, MCU, 3MHz FM
     { machines=["chukatai"], data="41" }, # MCU
     { machines=["insectx"],  data="40" }, # dip_flip inversion
-    { machines=["drtoppel"], data="03" },
+    { machines=["drtoppel"], data="03 10" },
     { machines=["extrmatn","plumppop" ], data="03" }, # MCU - Color PROM
     { machines=["arknoid2"], data="03 03" }, # MCU - Color PROM, Service XOR, Button aid
     { machine="kabukiz",  data="14 04" }, # Kabuki Z sound subsystem, Banked RAM, 3MHz FM
diff --git a/cores/kiwi/hdl/jtkiwi_game.v b/cores/kiwi/hdl/jtkiwi_game.v
index f49d7413c..0dc070ee3 100644
--- a/cores/kiwi/hdl/jtkiwi_game.v
+++ b/cores/kiwi/hdl/jtkiwi_game.v
@@ -34,7 +34,7 @@ wire        cpu_rnw, vctrl_cs, vflag_cs,
 reg         hb_dly=0, dip_flip_xor=0,
             coin_xor=0, banked_ram=0,
             kageki=0, kabuki=0, kabuki_mod = 0, service_xor=0,
-            colprom_en=0, mcu_en=0, aid_en, fast_fm=0;
+            colprom_en=0, mcu_en=0, aid_en, fast_fm=0, drtoppel=0;
 
 assign dip_flip   = ~flip ^ dip_flip_xor;
 assign debug_view = st_addr[7:6]==0 ? { hb_dly, dip_flip_xor, coin_xor, banked_ram,
@@ -60,7 +60,7 @@ always @(posedge clk) begin
             { hb_dly, dip_flip_xor, coin_xor, banked_ram,
               kageki, kabuki, colprom_en, mcu_en } <= prog_data;
         else if( prog_addr==1 )
-            { kabuki_mod, fast_fm, aid_en, service_xor } <= prog_data[3:0];
+            { drtoppel, kabuki_mod, fast_fm, aid_en, service_xor } <= prog_data[4:0];
     end
 end
 
@@ -126,6 +126,7 @@ jtkiwi_video u_video(
     .VS             ( VS            ),
     .flip           ( flip          ),
     .hdump          ( hdump         ),
+    .drtoppel       ( drtoppel      ),
     // PROMs
     .prom_we        ( colprom_we    ),
     .prog_addr      ( prog_addr[9:0]),
diff --git a/cores/kiwi/hdl/jtkiwi_gfx.v b/cores/kiwi/hdl/jtkiwi_gfx.v
index a08a89e04..dd0c2ac39 100644
--- a/cores/kiwi/hdl/jtkiwi_gfx.v
+++ b/cores/kiwi/hdl/jtkiwi_gfx.v
@@ -33,6 +33,7 @@ module jtkiwi_gfx(
     input               hs,
     input               vs,
     output              flip,
+    input               drtoppel,
 
     input      [ 8:0]   vdump,
     input      [ 8:0]   vrender,
@@ -166,6 +167,7 @@ jtkiwi_tilemap u_tilemap(
     .hs         ( hs        ),
     .flip       ( flip      ),
     .page       ( tm_page   ),
+    .drtoppel   ( drtoppel  ),
 
     .col_xmsb   ( col_xmsb  ),
     .col_cfg    ( col_cfg   ),
diff --git a/cores/kiwi/hdl/jtkiwi_tilemap.v b/cores/kiwi/hdl/jtkiwi_tilemap.v
index 57287f254..57652d578 100644
--- a/cores/kiwi/hdl/jtkiwi_tilemap.v
+++ b/cores/kiwi/hdl/jtkiwi_tilemap.v
@@ -29,6 +29,7 @@ module jtkiwi_tilemap(
     input               hs,
     input               flip,
     input               page,
+    input               drtoppel,
     input      [15:0]   col_xmsb,
     input      [ 3:0]   col_cfg,
     input      [ 1:0]   col0,
@@ -109,6 +110,7 @@ always @(posedge clk, posedge rst) begin
                 2: begin
                     { hflip, vflip } <= tm_data[15:14];
                     code <= tm_data[13:0];
+                    if(drtoppel) code <= {1'b0, tm_data[12:0]};
                 end
                 3: begin
                     if( !dr_busy )  begin
diff --git a/cores/kiwi/hdl/jtkiwi_video.v b/cores/kiwi/hdl/jtkiwi_video.v
index be2be03c1..4ab1960b7 100644
--- a/cores/kiwi/hdl/jtkiwi_video.v
+++ b/cores/kiwi/hdl/jtkiwi_video.v
@@ -23,6 +23,7 @@ module jtkiwi_video(
     input               pxl2_cen,
     input               pxl_cen,
     input               hb_dly,
+    input               drtoppel,
 
     output              LHBL,
     output              LVBL,
@@ -119,6 +120,7 @@ jtkiwi_gfx u_gfx(
     // .prom_we    ( prom_we        ),
     // Screen
     .flip       ( flip           ),
+    .drtoppel   ( drtoppel       ),
     .LHBL       ( LHBL           ),
     .LVBL       ( LVBL           ),
     .vs         ( VS             ),
