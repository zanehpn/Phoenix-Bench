From c724a52ed88914a67cf2be123bd70e524b90f8f4 Mon Sep 17 00:00:00 2001
From: Michael Norris <michnorris@microsoft.com>
Date: Thu, 20 Nov 2025 09:34:39 -0800
Subject: [PATCH 1/3] fixes bug 1130/1129 Remove the else term so that the
 secondary flop will receive the updated value when manuf or prod debug unlock
 is granted current implementation assumed a pulse at reset to sample the
 first flop with debug unlock, the signal is static so the else condition is
 never reached

---
 src/integration/rtl/caliptra_top.sv | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/src/integration/rtl/caliptra_top.sv b/src/integration/rtl/caliptra_top.sv
index 6711e6b47..27eb1e277 100755
--- a/src/integration/rtl/caliptra_top.sv
+++ b/src/integration/rtl/caliptra_top.sv
@@ -733,9 +733,7 @@ el2_veer_wrapper rvtop (
         else if (unlock_caliptra_security_state) begin 
             cptra_security_state_Latched_d <= security_state;
         end 
-        else begin
-            cptra_security_state_Latched_f <= cptra_security_state_Latched_d;
-        end
+        cptra_security_state_Latched_f <= cptra_security_state_Latched_d;
     end
 
     always_ff @(posedge clk or negedge cptra_pwrgood) begin

From 9e92dc5976954b7f2152cb534727fb739c44bde4 Mon Sep 17 00:00:00 2001
From: Michael Norris <michnorris@microsoft.com>
Date: Thu, 20 Nov 2025 10:28:26 -0800
Subject: [PATCH 2/3] fix security state capturing flops for lint removing the
 else directly caused the reset term to not be observed correctly

---
 src/integration/rtl/caliptra_top.sv | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/src/integration/rtl/caliptra_top.sv b/src/integration/rtl/caliptra_top.sv
index 27eb1e277..2bd118369 100755
--- a/src/integration/rtl/caliptra_top.sv
+++ b/src/integration/rtl/caliptra_top.sv
@@ -726,14 +726,17 @@ el2_veer_wrapper rvtop (
     end
 
     always_ff @(posedge clk or negedge cptra_noncore_rst_b) begin
-        if (~cptra_noncore_rst_b) begin
-            cptra_security_state_Latched_d <= '{device_lifecycle: DEVICE_PRODUCTION, debug_locked: 1'b1}; //Setting the default value to be debug locked and in production mode
+        if (~cptra_noncore_rst_b) begin //Setting the default value to be debug locked and in production mode
+            cptra_security_state_Latched_d <= '{device_lifecycle: DEVICE_PRODUCTION, debug_locked: 1'b1}; 
             cptra_security_state_Latched_f <= '{device_lifecycle: DEVICE_PRODUCTION, debug_locked: 1'b1};
         end
-        else if (unlock_caliptra_security_state) begin 
+        else if (unlock_caliptra_security_state) begin //capture the new value at reset or when unlocked
             cptra_security_state_Latched_d <= security_state;
-        end 
-        cptra_security_state_Latched_f <= cptra_security_state_Latched_d;
+            cptra_security_state_Latched_f <= cptra_security_state_Latched_d;
+        end else begin //hold the previous value when locked
+            cptra_security_state_Latched_d <= cptra_security_state_Latched_d;
+            cptra_security_state_Latched_f <= cptra_security_state_Latched_d;
+        end
     end
 
     always_ff @(posedge clk or negedge cptra_pwrgood) begin

