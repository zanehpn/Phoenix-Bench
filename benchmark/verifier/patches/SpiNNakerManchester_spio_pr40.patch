From cd0e0ff1c9cc064041b2de99cfa8a3c223e06676 Mon Sep 17 00:00:00 2001
From: "Luis A. Plana" <luis.plana@manchester.ac.uk>
Date: Fri, 4 Dec 2020 16:37:10 +0000
Subject: [PATCH] - br and bpkt_seq are updated in the same clock cycle -
 version change for bug fix.

---
 modules/hss_multiplexer/spio_hss_multiplexer_pkt_store.v | 2 +-
 version.h                                                | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/modules/hss_multiplexer/spio_hss_multiplexer_pkt_store.v b/modules/hss_multiplexer/spio_hss_multiplexer_pkt_store.v
index ace7b30..1e028a9 100644
--- a/modules/hss_multiplexer/spio_hss_multiplexer_pkt_store.v
+++ b/modules/hss_multiplexer/spio_hss_multiplexer_pkt_store.v
@@ -177,7 +177,7 @@ module spio_hss_multiplexer_pkt_store
       br <= nxt_br;
 
   always @ (*)
-    casex ({vld_nak, reading})
+    casex ({vld_nak, bpkt_gt})
         2'b1x:   nxt_br = seq_to_reg;  // nack'd frame
         2'b01:   nxt_br = br + 1;      // next in sequence
         default: nxt_br = br;          // no change!
diff --git a/version.h b/version.h
index af86b47..c37f3bf 100644
--- a/version.h
+++ b/version.h
@@ -22,7 +22,7 @@
 `ifndef SPIO_VERSION_H
 `define SPIO_VERSION_H
 
-`define SPIO_VER_STR      "1.0.1"
-`define SPIO_VER_NUM      32'h00010001  // 32'h00MMmmpp
+`define SPIO_VER_STR      "1.0.2"
+`define SPIO_VER_NUM      32'h00010002  // 32'h00MMmmpp
 
 `endif
