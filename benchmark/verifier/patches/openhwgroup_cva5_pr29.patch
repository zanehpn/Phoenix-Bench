new file mode 100644
index 00000000..46bc0513
--- /dev/null
+++ b/core/common_components/ram/tdp_ram.sv
@@ -0,0 +1,119 @@
+/*
+ * Copyright © 2024 Chris Keilbart, Lesley Shannon
+ *
