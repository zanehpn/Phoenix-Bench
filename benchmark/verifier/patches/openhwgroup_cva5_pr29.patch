-        always_ff @(posedge clk) begin
-            if (rst)
-                count <= '0;
-            else
-                count <= count - count_t'(write_sent) + count_t'(count_decr);
+    //Write outstanding check
+    logic[NUM_CORES-1:0][MAX_OUTSTANDING-1:0] outstanding_is_core;
+    always_comb begin
+        write_outstanding = '0;
+        for (int i = 0; i < NUM_CORES; i++) begin
