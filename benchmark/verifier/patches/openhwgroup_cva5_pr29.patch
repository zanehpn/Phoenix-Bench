-        tb->ddr_axi_rvalid = 1;
-    }
-    else{
-        tb->ddr_axi_rid = rand();
-        tb->ddr_axi_rdata = rand();
-        tb->ddr_axi_rresp = rand();
-        tb->ddr_axi_rlast = 0;
-        //tb->ddr_axi_ruser = rand();
-        tb->ddr_axi_rvalid = 0;
-    }
-    }
