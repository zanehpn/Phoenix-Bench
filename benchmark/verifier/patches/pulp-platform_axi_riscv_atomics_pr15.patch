From 9d3328136d2fccf8cb9dbec73c79d4cd8d9dab6b Mon Sep 17 00:00:00 2001
From: Samuel Riedel <sriedel@iis.ee.ethz.ch>
Date: Wed, 9 Mar 2022 15:20:47 +0100
Subject: [PATCH 39/43] golden_memory: Delay writes to be consistent with
 `axi_sim_mem`

The `axi_sim_mem` can read and write in the same cycle, in this case
the read returns the old value. This change ensures the golden memory
behaves the same.
---
 test/golden_memory.sv | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/test/golden_memory.sv b/test/golden_memory.sv
index 2182ef2..9878acd 100644
--- a/test/golden_memory.sv
+++ b/test/golden_memory.sv
@@ -170,7 +170,7 @@ package golden_model_pkg;
         function void set_memory(logic [MEM_ADDR_WIDTH-1:0] addr, logic [MEM_DATA_WIDTH-1:0] data, logic [2:0] size);
             int unsigned num_bytes = 2**size;
             for (int i = 0; i < num_bytes; i++) begin
-                memory[addr+i] = data[i*8 +: 8];
+                memory[addr+i] <= #(ACQ_DELAY) data[i*8 +: 8];
             end
         endfunction : set_memory
 

