     golden_model_pkg::golden_memory #(
-        .MEM_ADDR_WIDTH( GOLD_MEM_WIDTH ),
+        .MEM_ADDR_WIDTH( AXI_ADDR_WIDTH ),
         .MEM_DATA_WIDTH( SYS_DATA_WIDTH ),
