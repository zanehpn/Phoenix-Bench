+        w_cnt_d    = w_cnt_q;
+        aw_trans_d = aw_trans_q;
         if (mst_aw_valid_o && mst_aw_ready_i) begin
-            w_cnt_d += 1;
+            w_cnt_d    += 1;
+            aw_trans_d += 1;
         end
         if (mst_w_valid_o && mst_w_ready_i && mst_w_last_o) begin
-            w_cnt_d -= 1;
+            w_cnt_d    -= 1;
+        end
+        if (mst_b_valid_i && mst_b_ready_o) begin
+            aw_trans_d -= 1;
         end
     end
 
@@ -648,6 +658,7 @@ module axi_riscv_amos #(
