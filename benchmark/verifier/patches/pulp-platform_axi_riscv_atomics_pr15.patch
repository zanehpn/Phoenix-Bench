     typedef logic [1:0]                 axi_resp_t;
@@ -208,6 +209,20 @@ module axi_riscv_lrsc #(
         AW_IDLE, AW_WAIT
     } aw_state_t;
 
+    typedef struct packed {
+        axi_addr_t  addr;
+        logic [2:0] prot;
+        logic [3:0] region;
+        logic [5:0] atop;
+        logic [7:0] len;
+        logic [2:0] size;
+        logic [1:0] burst;
+        logic [3:0] cache;
+        logic [3:0] qos;
+        axi_id_t    id;
+        axi_user_t  user;
+    } aw_chan_t;
+
     typedef enum logic {
         B_NORMAL, B_FORWARD
     } b_state_t;
@@ -286,6 +301,10 @@ module axi_riscv_lrsc #(
 
     b_state_t       b_state_d,                  b_state_q;
 
+    aw_chan_t       slv_aw,                     mst_aw;
+
+    logic           mst_aw_valid,               mst_aw_ready;
+
     // AR and R Channel
 
     // IQ Queue to track in-flight reads
@@ -502,7 +521,7 @@ module axi_riscv_lrsc #(
         .rst_ni             (rst_ni),
         .inp_id_i           (mst_aw_id_o),
         .inp_data_i         ({mst_aw_addr_o[AXI_ADDR_WIDTH-1:2], slv_aw_lock_i}),
-        .inp_req_i          (mst_aw_valid_o && mst_aw_ready_i),
+        .inp_req_i          (mst_aw_valid && mst_aw_ready),
         .inp_gnt_o          (wifq_inp_gnt),
