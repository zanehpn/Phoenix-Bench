@@ -1,4 +1,5 @@
 Property,Value
 CORE_SELECTOR,CORE_CV32E40P
 VIO_RESETN_DEFAULT,1
-XLEN,32
\ No newline at end of file
+XLEN,64
+PHYSICAL_ADDR_WIDTH,39
\ No newline at end of file
