+++ b/test_regress/t/t_dfg_bin_to_one_hot.py
@@ -16,6 +16,6 @@
 test.execute()
 
 test.file_grep(test.stats, r'Optimizations, DFG pre inline BinToOneHot, decoders created\s+(\d+)',
-               3)
+               4)
 
 test.passes()
