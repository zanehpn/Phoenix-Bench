    reg [6:0] cntA = 0;
    reg [6:0] cntB = 0;
    reg [6:0] cntC = 0;
+   reg [6:0] cntD = 0;
 
    always @ (posedge clk) begin
       cyc <= cyc + 1;
       if (cyc[0])  cntA <= cntA + 7'd1;
       if (cntA[0]) cntB <= cntB + 7'd1;
       if (cntB[0]) cntC <= cntC + 7'd1;
+      if (cntC[0]) cntD <= cntD + 7'd1;
 
       if (cyc == 99) begin
          $write("*-* All Finished *-*\n");
@@ -538,6 +540,139 @@ module t (/*AUTOARG*/
