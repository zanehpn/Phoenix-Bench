From 87837ee546d5b5d340e7c31f8007c397f8af2300 Mon Sep 17 00:00:00 2001
From: Cesar Fuguet <cesar.fuguet@protonmail.com>
Date: Fri, 18 Oct 2024 11:17:22 +0200
Subject: [PATCH] fix: prefetch requests should update PLRU on cache hit

This shall be the case when cfg_prefetch_updt_plru is set to 1
---
 rtl/src/hpdcache.sv         | 1 +
 rtl/src/hpdcache_ctrl.sv    | 2 ++
 rtl/src/hpdcache_ctrl_pe.sv | 5 ++++-
 3 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/rtl/src/hpdcache.sv b/rtl/src/hpdcache.sv
index 4374f6db..4e3606c4 100644
--- a/rtl/src/hpdcache.sv
+++ b/rtl/src/hpdcache.sv
@@ -605,6 +605,7 @@ import hpdcache_pkg::*;
         .ctrl_empty_o                       (ctrl_empty),
 
         .cfg_enable_i,
+        .cfg_prefetch_updt_plru_i,
         .cfg_rtab_single_entry_i,
         .cfg_default_wb_i                   (cfg_default_wb),
 
diff --git a/rtl/src/hpdcache_ctrl.sv b/rtl/src/hpdcache_ctrl.sv
index eb19186f..317b4691 100644
--- a/rtl/src/hpdcache_ctrl.sv
+++ b/rtl/src/hpdcache_ctrl.sv
@@ -223,6 +223,7 @@ import hpdcache_pkg::*;
 
     //   Configuration signals
     input  logic                  cfg_enable_i,
+    input  logic                  cfg_prefetch_updt_plru_i,
     input  logic                  cfg_rtab_single_entry_i,
     input  logic                  cfg_default_wb_i,
 
@@ -627,6 +628,7 @@ import hpdcache_pkg::*;
         .cmo_wait_i,
         .cmo_req_valid_o,
 
+        .cfg_prefetch_updt_plru_i,
         .cfg_default_wb_i,
 
         .evt_cache_write_miss_o,
diff --git a/rtl/src/hpdcache_ctrl_pe.sv b/rtl/src/hpdcache_ctrl_pe.sv
index efbf1a5c..ed3efd31 100644
--- a/rtl/src/hpdcache_ctrl_pe.sv
+++ b/rtl/src/hpdcache_ctrl_pe.sv
@@ -181,6 +181,7 @@ module hpdcache_ctrl_pe
 
     //   Configuration
     //   {{{
+    input  logic                   cfg_prefetch_updt_plru_i,
     input  logic                   cfg_default_wb_i,
     //   }}}
 
@@ -607,7 +608,9 @@ module hpdcache_ctrl_pe
                                 st1_nop = st1_req_rtab_i & ~rtab_req_valid_i;
 
                                 //  Update victim selection for the accessed set
-                                st1_req_cachedir_updt_sel_victim_o = st1_req_is_load_i;
+                                st1_req_cachedir_updt_sel_victim_o =
+                                    ~st1_req_is_cmo_prefetch_i |
+                                     cfg_prefetch_updt_plru_i;
 
                                 //  Respond to the core (if needed)
                                 st1_rsp_valid_o = st1_req_need_rsp_i;
