From c3c1dea7b72cec48e705e1ac5c35d716ab9fc192 Mon Sep 17 00:00:00 2001
From: marwannismail <marwan.ismail2004@gmail.com>
Date: Sun, 26 Oct 2025 15:56:15 -0400
Subject: [PATCH 2/4] Adapted RF extraction to latest commits from main,
 passing in RISCOF

---
 src/Instruction_Decode/Instruction_Decode.v | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/Instruction_Decode/Instruction_Decode.v b/src/Instruction_Decode/Instruction_Decode.v
index 45160ad..7f1d93f 100644
--- a/src/Instruction_Decode/Instruction_Decode.v
+++ b/src/Instruction_Decode/Instruction_Decode.v
@@ -7,6 +7,7 @@ module Instruction_Decode(
   	output opcode_t opcode,
 	output wire [3:0] ALUControl,
  	output imm_t imm_ext,
+	output reg [2:0] funct3,
 	output reg [4:0] rd,
 	output reg [4:0] rs1, 
 	output reg [4:0] rs2
@@ -114,7 +115,7 @@ module Instruction_Decode(
 	end
 
