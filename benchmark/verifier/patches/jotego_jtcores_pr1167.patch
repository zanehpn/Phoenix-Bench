diff --git a/cores/riders/hdl/jt053244.sv b/cores/riders/hdl/jt053244.sv
index a34401e94..98c5b1ef5 100644
--- a/cores/riders/hdl/jt053244.sv
+++ b/cores/riders/hdl/jt053244.sv
@@ -53,7 +53,7 @@ module jt053244(    // sprite logic
     input      [ 8:0] vdump,    // generated internally.
                                 // Hdump goes from 20 to 19F, 384 pixels
                                 // Vdump goes from F8 to 1FF, 264 lines
-    input             vs,
+    input             lvbl,
     input             hs,
 
     // shadow
@@ -133,7 +133,7 @@ jt053246_dma u_dma(
     .simson     ( 1'b0      ),
 
     .hs         ( hs        ),
-    .vs         ( vs        ),
+    .lvbl       ( lvbl      ),
 
     // External RAM
     .dma_addr   ( dma_addr  ), // up to 16 kB
diff --git a/cores/riders/hdl/jt053244_scan.sv b/cores/riders/hdl/jt053244_scan.sv
index 0ae235cbd..f42761019 100644
--- a/cores/riders/hdl/jt053244_scan.sv
+++ b/cores/riders/hdl/jt053244_scan.sv
@@ -36,7 +36,6 @@
     input      [ 8:0] vdump,    // generated internally.
                                 // Hdump goes from 20 to 19F, 384 pixels
                                 // Vdump goes from F8 to 1FF, 264 lines
-    // input             vs,
     input             hs,
 
     input      [15:0] scan_even,
@@ -180,7 +179,6 @@ always @(posedge clk, posedge rst) begin
         shd      <= 0;
     end else if( cen2 ) begin
         hs_l <= hs;
-        // vs_l <= vs;
         dr_start <= 0;
         if( hs && !hs_l && vdump>9'h10D && vdump<9'h1f1) begin
             done     <= 0;
diff --git a/cores/riders/hdl/jtriders_obj.v b/cores/riders/hdl/jtriders_obj.v
index aaad5b097..d0a3c5139 100644
--- a/cores/riders/hdl/jtriders_obj.v
+++ b/cores/riders/hdl/jtriders_obj.v
@@ -30,7 +30,6 @@ module jtriders_obj #(parameter
     input      [ 8:0] hdump,
     input      [ 8:0] vdump,
     input             hs,
-    input             vs,
     input             lvbl,
     input             lgtnfght,
 
@@ -156,7 +155,7 @@ jt053244 #(.HFLIP_OFFSET(HFLIP_OFFSET)
     // control
     .hdump      ( hdump     ),
     .vdump      ( vdump     ),
-    .vs         ( lvbl      ), // this board uses VB here, instead of VS
+    .lvbl       ( lvbl      ),
     .hs         ( hs        ),
 
     // shadow
diff --git a/cores/riders/hdl/jtriders_video.v b/cores/riders/hdl/jtriders_video.v
