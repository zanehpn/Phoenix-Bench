+        expect_string(br'ERROR: \[0\]\[dut_ut\]: fail_unless: beam == 1 \(at .*dut_unit_test.sv line:73\)', 'run.log')
         expect_string(br'INFO:  \[0\]\[dut_ut\]: third_test::FAILED', 'run.log')
