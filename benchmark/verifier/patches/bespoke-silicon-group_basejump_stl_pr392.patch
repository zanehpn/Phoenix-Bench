From b2f743494aa192b6f6d49040d30d5cc3da8cef9c Mon Sep 17 00:00:00 2001
From: Dan Petrisko <petrisko@cs.washington.edu>
Date: Sun, 31 Jan 2021 23:14:30 -0800
Subject: [PATCH] Enabling 1-bit bsg_tag_client

---
 bsg_tag/bsg_tag_client.v | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/bsg_tag/bsg_tag_client.v b/bsg_tag/bsg_tag_client.v
index 41bdb0c68..4dbc19e30 100644
--- a/bsg_tag/bsg_tag_client.v
+++ b/bsg_tag/bsg_tag_client.v
@@ -91,7 +91,14 @@ module bsg_tag_client
    logic               tag_toggle_r;
 
    // shift in new state
-   assign tag_data_shift = { param_r, tag_data_r[width_p-1:1] };
+   if (width_p == 1)
+     begin : sb
+       assign tag_data_shift = { param_r };
+     end
+   else
+     begin : mb
+       assign tag_data_shift = { param_r, tag_data_r[width_p-1:1] };
+     end
 
    bsg_mux2_gatestack #(.width_p(width_p),.harden_p(harden_p)) tag_data_mux
      (.i0 (tag_data_r            ) // sel=0
