+  // MSHA: // Variable: axi4_master_coverage
+  // MSHA: // Decalring a handle for axi4_master_coverage
+   axi4_master_coverage axi4_master_cov_h;
+  //-------------------------------------------------------
+  // Externally defined Tasks and Functions
