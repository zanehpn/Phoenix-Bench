From f37470efa6aec2120dc4e4f4ac8b94dc1fffa543 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Tue, 8 Jul 2025 17:35:36 +0200
Subject: [PATCH 1/6] Correction in cart_size assignment

---
 cores/ngp/hdl/jtngp_game.v | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/cores/ngp/hdl/jtngp_game.v b/cores/ngp/hdl/jtngp_game.v
index e41db7cb6..718efc71c 100644
--- a/cores/ngp/hdl/jtngp_game.v
+++ b/cores/ngp/hdl/jtngp_game.v
@@ -50,9 +50,9 @@ assign f1g_dout = cart_size[2] ? flash1_dout : 16'd0;
 always @(posedge clk) begin
     if( ioctl_cart && !cart_l ) cart_size <= 0;
     if( prog_ba==1 && !ioctl_ram && ioctl_wr ) begin
-        if( ioctl_addr[19] && cart_size<3'd1 ) cart_size <= 3'b001;
-        if( ioctl_addr[20] && cart_size<3'd2 ) cart_size <= 3'b010;
-        if( ioctl_addr[21] && cart_size<3'd4 ) cart_size <= 3'b100;
+        if( prog_addr[18] && cart_size<3'd1 ) cart_size <= 3'b001;
+        if( prog_addr[19] && cart_size<3'd2 ) cart_size <= 3'b010;
+        if( prog_addr[20] && cart_size<3'd4 ) cart_size <= 3'b100;
     end
 end
 

From a44bf9d4c9b6a81d7508e711f984283e9a2325f8 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Wed, 9 Jul 2025 15:29:18 +0200
Subject: [PATCH 2/6] sim.sh -sysname is not a jtsim input anymore

