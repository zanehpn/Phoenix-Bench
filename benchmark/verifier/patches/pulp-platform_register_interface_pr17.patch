From f30fc7fb916ccb6ba21c614c754c70a9dbddd656 Mon Sep 17 00:00:00 2001
From: Axel Vanoni <axvanoni@student.ethz.ch>
Date: Thu, 24 Mar 2022 14:45:40 +0100
Subject: [PATCH] src/reg_mux.sv: Delete duplicated assignment

The valid signal was being assigned to twice, which causes errors in
compilation. Take the one from the stream arbiter valid port over the
payload.
---
 src/reg_mux.sv | 1 -
 1 file changed, 1 deletion(-)

diff --git a/src/reg_mux.sv b/src/reg_mux.sv
index 7d5f483..74f9806 100644
--- a/src/reg_mux.sv
+++ b/src/reg_mux.sv
@@ -66,6 +66,5 @@ module reg_mux #(
   assign out_req_o.write = out_payload.write;
   assign out_req_o.wdata = out_payload.wdata;
   assign out_req_o.wstrb = out_payload.wstrb;
-  assign out_req_o.valid = out_payload.valid;
 
 endmodule
