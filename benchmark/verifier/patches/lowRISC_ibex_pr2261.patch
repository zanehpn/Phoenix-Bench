From f92d61c77c4ccaf4bb224f61751f1b0c5db15f5a Mon Sep 17 00:00:00 2001
From: Hao <58808837+ha0lyu@users.noreply.github.com>
Date: Wed, 26 Mar 2025 09:32:24 +0800
Subject: [PATCH] fix: Illegal instruction display message

When encountering certain illegal compressed instructions, incorrect instruction information was displayed. Now, illegal instructions can be printed correctly.
---
 rtl/ibex_controller.sv | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/rtl/ibex_controller.sv b/rtl/ibex_controller.sv
index 157d05a6e9..1b2666c0bc 100644
--- a/rtl/ibex_controller.sv
+++ b/rtl/ibex_controller.sv
@@ -175,7 +175,7 @@ module ibex_controller #(
     // print warning in case of decoding errors
     if ((ctrl_fsm_cs == DECODE) && instr_valid_i && !instr_fetch_err_i && illegal_insn_d) begin
       $display("%t: Illegal instruction (hart %0x) at PC 0x%h: 0x%h", $time, u_ibex_core.hart_id_i,
-               pc_id_i, id_stage_i.instr_rdata_i);
+               pc_id_i, instr_is_compressed_i ? {16'b0, instr_compressed_i} : instr_i );
     end
   end
   // synopsys translate_on
