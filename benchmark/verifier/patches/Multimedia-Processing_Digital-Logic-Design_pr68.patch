+//changing 
+//	if(!rst)		resume_req_r <= 1'b0;
+//to the prefered high reset
+	if(rst)		resume_req_r <= 1'b0;
+	else
+	if(suspend_clr_wr)	resume_req_r <= 1'b0;
+	else
+	if(resume_req)		resume_req_r <= 1'b1;
