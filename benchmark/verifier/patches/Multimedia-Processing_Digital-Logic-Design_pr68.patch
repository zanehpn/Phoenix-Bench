+//////////////////////////////////////////////////////////////////////
+//
+// CVS Revision History
+//
+// $Log: or1200_qmem_top.v,v $
+// Revision 1.1  2008/05/07 22:43:22  daughtry
+// Initial Demo RTL check-in
+//
+// Revision 1.3  2004/06/08 18:17:36  lampret
+// Non-functional changes. Coding style fixes.
+//
+// Revision 1.2  2004/04/05 08:40:26  lampret
+// Merged branch_qmem into main tree.
+//
+// Revision 1.1.2.4  2004/01/11 22:45:46  andreje
+// Separate instruction and data QMEM decoders, QMEM acknowledge and byte-select added
+//
+// Revision 1.1.2.3  2003/12/17 13:36:58  simons
+// Qmem mbist signals fixed.
+//
+// Revision 1.1.2.2  2003/12/09 11:46:48  simons
+// Mbist nameing changed, Artisan ram instance signal names fixed, some synthesis waning fixed.
+//
+// Revision 1.1.2.1  2003/07/08 15:45:26  lampret
+// Added embedded memory QMEM.
+//
+//
+
+// synopsys translate_off
+`include "timescale.v"
+// synopsys translate_on
+`include "or1200_defines.v"
+
+`define OR1200_QMEMFSM_IDLE	3'd0
+`define OR1200_QMEMFSM_STORE	3'd1
+`define OR1200_QMEMFSM_LOAD	3'd2
+`define OR1200_QMEMFSM_FETCH	3'd3
+
+//
+// Embedded memory
+//
+module or1200_qmem_top(
+	// Rst, clk and clock control
+	clk, rst,
+
+`ifdef OR1200_BIST
+	// RAM BIST
+	mbist_si_i, mbist_so_o, mbist_ctrl_i,
+`endif
+
+	// QMEM and CPU/IMMU
+	qmemimmu_adr_i,
+	qmemimmu_cycstb_i,
+	qmemimmu_ci_i,
+	qmemicpu_sel_i, 
+	qmemicpu_tag_i, 
+	qmemicpu_dat_o,
+	qmemicpu_ack_o,
+	qmemimmu_rty_o,
+	qmemimmu_err_o,
+	qmemimmu_tag_o,
+
+	// QMEM and IC
+	icqmem_adr_o,
+	icqmem_cycstb_o,
+	icqmem_ci_o,  
+	icqmem_sel_o,
+	icqmem_tag_o,
+	icqmem_dat_i,
+	icqmem_ack_i,
+	icqmem_rty_i,
+	icqmem_err_i,
+	icqmem_tag_i,
+
+	// QMEM and CPU/DMMU
+	qmemdmmu_adr_i,
+	qmemdmmu_cycstb_i,
+	qmemdmmu_ci_i,
+	qmemdcpu_we_i,   
+	qmemdcpu_sel_i, 
+	qmemdcpu_tag_i, 
+	qmemdcpu_dat_i, 
+	qmemdcpu_dat_o,
+	qmemdcpu_ack_o,
+	qmemdcpu_rty_o,
+	qmemdmmu_err_o,
+	qmemdmmu_tag_o,
+
+	// QMEM and DC
+	dcqmem_adr_o, dcqmem_cycstb_o, dcqmem_ci_o,
+	dcqmem_we_o, dcqmem_sel_o, dcqmem_tag_o, dcqmem_dat_o,
+	dcqmem_dat_i, dcqmem_ack_i, dcqmem_rty_i, dcqmem_err_i, dcqmem_tag_i
+
+);
+
+parameter dw = `OR1200_OPERAND_WIDTH;
+
+//
+// I/O
+//
+
+//
+// Clock and reset
+//
+input				clk;
+input				rst;
+
+`ifdef OR1200_BIST
+//
+// RAM BIST
+//
+input mbist_si_i;
+input [`OR1200_MBIST_CTRL_WIDTH - 1:0] mbist_ctrl_i;
+output mbist_so_o;
+`endif
+
+//
+// QMEM and CPU/IMMU
+//
+input	[31:0]			qmemimmu_adr_i;
+input				qmemimmu_cycstb_i;
+input				qmemimmu_ci_i;
+input	[3:0]			qmemicpu_sel_i; 
+input	[3:0]			qmemicpu_tag_i; 
+output	[31:0]			qmemicpu_dat_o;
+output				qmemicpu_ack_o;
+output				qmemimmu_rty_o;
+output				qmemimmu_err_o;
+output	[3:0]			qmemimmu_tag_o;
+
+//
+// QMEM and IC
+//
+output	[31:0]			icqmem_adr_o;
+output				icqmem_cycstb_o;
+output				icqmem_ci_o;
+output	[3:0]			icqmem_sel_o;
+output	[3:0]			icqmem_tag_o;
+input	[31:0]			icqmem_dat_i;
+input				icqmem_ack_i;
+input				icqmem_rty_i;
+input				icqmem_err_i;
+input	[3:0]			icqmem_tag_i;
+
+//
+// QMEM and CPU/DMMU
+//
+input	[31:0]			qmemdmmu_adr_i;
+input				qmemdmmu_cycstb_i;
+input				qmemdmmu_ci_i;
+input				qmemdcpu_we_i;
+input	[3:0]			qmemdcpu_sel_i; 
+input	[3:0]			qmemdcpu_tag_i; 
+input	[31:0]			qmemdcpu_dat_i; 
+output	[31:0]			qmemdcpu_dat_o;
+output				qmemdcpu_ack_o;
+output				qmemdcpu_rty_o;
+output				qmemdmmu_err_o;
+output	[3:0]			qmemdmmu_tag_o;
+
+//
+// QMEM and DC
+//
+output	[31:0]			dcqmem_adr_o;
+output				dcqmem_cycstb_o;
+output				dcqmem_ci_o;
+output				dcqmem_we_o;
+output	[3:0]			dcqmem_sel_o;
+output	[3:0]			dcqmem_tag_o;
+output	[dw-1:0]		dcqmem_dat_o;
+input	[dw-1:0]		dcqmem_dat_i;
+input				dcqmem_ack_i;
+input				dcqmem_rty_i;
+input				dcqmem_err_i;
+input	[3:0]			dcqmem_tag_i;
+
+
+//XLNX_MODIFIED hack code to have registered outputs
+//need to add in the dcqmem signals....
+
+`ifdef XLNX_MODIFIED
+wire [31:0]			qmemicpu_dat_o_temp;
+reg [31:0]			qmemicpu_dat_o;
+
+wire qmemicpu_ack_o_temp;
+reg qmemicpu_ack_o;
+
+wire qmemimmu_rty_o_temp;
+reg qmemimmu_rty_o;
+
+wire qmemimmu_err_o_temp;
+reg qmemimmu_err_o;
+
+wire [3:0]			qmemimmu_tag_o_temp;
+reg [3:0]			qmemimmu_tag_o;
+
+wire [31:0]	qmemdcpu_dat_o_temp;
+reg [31:0]			qmemdcpu_dat_o;
+
+wire qmemdcpu_ack_o_temp;
+reg qmemdcpu_ack_o;
+
+wire qmemdmmu_err_o_temp;
+reg qmemdmmu_err_o;
+
+wire qmemdcpu_rty_o_temp;
+reg qmemdcpu_rty_o;
+
+wire [3:0]			qmemdmmu_tag_o_temp;
+reg [3:0]			qmemdmmu_tag_o;
+
+wire [31:0]			icqmem_adr_o_temp;
+reg [31:0]			icqmem_adr_o;
+
+wire icqmem_cycstb_o_temp;
+reg icqmem_cycstb_o;
+
+wire icqmem_ci_o_temp;
+reg icqmem_ci_o;
+
+wire [3:0]			icqmem_sel_o_temp;
+reg [3:0]			icqmem_sel_o;
+
+wire [3:0]			icqmem_tag_o_temp;
+reg [3:0]			icqmem_tag_o;
+
+//new
+wire [31:0]			dcqmem_adr_o_temp;
+reg [31:0]			dcqmem_adr_o;
+
+wire dcqmem_cycstb_o_temp;
+reg dcqmem_cycstb_o;
+
+wire 	dcqmem_ci_o_temp;
+reg 	dcqmem_ci_o;
+
+wire 	dcqmem_we_o_temp;
+reg dcqmem_we_o;
+
+wire 	[3:0]			dcqmem_sel_o_temp;
+reg 	[3:0]			dcqmem_sel_o;
+
+wire 	[3:0]			dcqmem_tag_o_temp;
+reg 	[3:0]			dcqmem_tag_o;
+
+wire	[dw-1:0]		dcqmem_dat_o_temp;
+reg	[dw-1:0]		dcqmem_dat_o;
+
+
+
+`endif
+
+`ifdef OR1200_QMEM_IMPLEMENTED
+
+//
+// Internal regs and wires
+//
+wire				iaddr_qmem_hit;
+wire				daddr_qmem_hit;
+reg	[2:0]			state;
+reg				qmem_dack;
+reg				qmem_iack;
+wire	[31:0]			qmem_di;
+wire	[31:0]			qmem_do;
+wire				qmem_en;
+`ifdef XLNX_MODIFIED
+wire	[3:0]		qmem_we;
+`else
+wire			qmem_we;
+`endif
+
+`ifdef OR1200_QMEM_BSEL
+wire  [3:0]       qmem_sel;
+`endif
+wire	[31:0]			qmem_addr;
+`ifdef OR1200_QMEM_ACK
+wire              qmem_ack;
+`else
+wire              qmem_ack = 1'b1;
+`endif
+
+//
+// QMEM and CPU/IMMU
+//
+
+
+//XLNX_MODIFIED have to register outputs
+`ifdef XLNX_MODIFIED
+assign qmemicpu_dat_o_temp = qmem_iack ? qmem_do : icqmem_dat_i;
+always @(posedge clk)
+     qmemicpu_dat_o <= qmemicpu_dat_o_temp;
+`else
+assign qmemicpu_dat_o = qmem_iack ? qmem_do : icqmem_dat_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign qmemicpu_ack_o_temp = qmem_iack ? 1'b1 : icqmem_ack_i;
+always @(posedge clk)
+    qmemicpu_ack_o <= qmemicpu_ack_o_temp;
+`else
+assign qmemicpu_ack_o = qmem_iack ? 1'b1 : icqmem_ack_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign qmemimmu_rty_o_temp = qmem_iack ? 1'b0 : icqmem_rty_i;
+always @(posedge clk)
+    qmemimmu_rty_o <= qmemimmu_rty_o_temp;
+`else
+assign qmemimmu_rty_o = qmem_iack ? 1'b0 : icqmem_rty_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign qmemimmu_err_o_temp = qmem_iack ? 1'b0 : icqmem_err_i;
+always @(posedge clk)
+     qmemimmu_err_o <= qmemimmu_err_o_temp;
+`else
+assign qmemimmu_err_o = qmem_iack ? 1'b0 : icqmem_err_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign qmemimmu_tag_o_temp = qmem_iack ? 4'h0 : icqmem_tag_i;
+always @(posedge clk)
+     qmemimmu_tag_o <= qmemimmu_tag_o_temp;
+`else
+assign qmemimmu_tag_o = qmem_iack ? 4'h0 : icqmem_tag_i;
+`endif
+
+
+//
+// QMEM and IC
+//
+//XLNX_MODIFIED hack to register outputs
+`ifdef XLNX_MODIFIED
+assign icqmem_adr_o_temp = iaddr_qmem_hit ? 32'h0000_0000 : qmemimmu_adr_i;
+always @(posedge clk)
+     icqmem_adr_o <= icqmem_adr_o_temp;
+`else
+assign icqmem_adr_o = iaddr_qmem_hit ? 32'h0000_0000 : qmemimmu_adr_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign icqmem_cycstb_o_temp = iaddr_qmem_hit ? 1'b0 : qmemimmu_cycstb_i;
+always @(posedge clk)
+     icqmem_cycstb_o <= icqmem_cycstb_o_temp;
+`else
+assign icqmem_cycstb_o = iaddr_qmem_hit ? 1'b0 : qmemimmu_cycstb_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign icqmem_ci_o_temp = iaddr_qmem_hit ? 1'b0 : qmemimmu_ci_i;
+always @(posedge clk)
+     icqmem_ci_o <= icqmem_ci_o_temp;
+`else
+assign icqmem_ci_o = iaddr_qmem_hit ? 1'b0 : qmemimmu_ci_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign icqmem_sel_o_temp = iaddr_qmem_hit ? 4'h0 : qmemicpu_sel_i;
+always @(posedge clk)
+    icqmem_sel_o <= icqmem_sel_o_temp;
+`else
+assign icqmem_sel_o = iaddr_qmem_hit ? 4'h0 : qmemicpu_sel_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign icqmem_tag_o_temp = iaddr_qmem_hit ? 4'h0 : qmemicpu_tag_i;
+always @(posedge clk)
+     icqmem_tag_o <= icqmem_tag_o_temp;
+`else
+assign icqmem_tag_o = iaddr_qmem_hit ? 4'h0 : qmemicpu_tag_i;
+`endif
+
+//
+// QMEM and CPU/DMMU
+//
+//XLNX_MODIFIED add in registers
+`ifdef XLNX_MODIFIED
+assign qmemdcpu_dat_o_temp = daddr_qmem_hit ? qmem_do : dcqmem_dat_i;
+always @(posedge clk)
+     qmemdcpu_dat_o <= qmemdcpu_dat_o_temp;
+`else
+assign qmemdcpu_dat_o = daddr_qmem_hit ? qmem_do : dcqmem_dat_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign qmemdcpu_ack_o_temp = daddr_qmem_hit ? qmem_dack : dcqmem_ack_i;
+always @(posedge clk)
+     qmemdcpu_ack_o <=qmemdcpu_ack_o_temp ;
+`else
+assign qmemdcpu_ack_o = daddr_qmem_hit ? qmem_dack : dcqmem_ack_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign qmemdcpu_rty_o_temp = daddr_qmem_hit ? ~qmem_dack : dcqmem_rty_i;
+always @(posedge clk)
+     qmemdcpu_rty_o <= qmemdcpu_rty_o_temp;
+`else
+assign qmemdcpu_rty_o = daddr_qmem_hit ? ~qmem_dack : dcqmem_rty_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign qmemdmmu_err_o_temp = daddr_qmem_hit ? 1'b0 : dcqmem_err_i;
+always @(posedge clk)
+     qmemdmmu_err_o <= qmemdmmu_err_o_temp;
+`else
+assign qmemdmmu_err_o = daddr_qmem_hit ? 1'b0 : dcqmem_err_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign qmemdmmu_tag_o_temp = daddr_qmem_hit ? 4'h0 : dcqmem_tag_i;
+always @(posedge clk)
+     qmemdmmu_tag_o <= qmemdmmu_tag_o_temp;
+`else
+assign qmemdmmu_tag_o = daddr_qmem_hit ? 4'h0 : dcqmem_tag_i;
+`endif
+	  
+//
+// QMEM and DC
+//
+
+`ifdef XLNX_MODIFIED
+assign dcqmem_adr_o_temp = daddr_qmem_hit ? 32'h0000_0000 : qmemdmmu_adr_i;
+always @(posedge clk)
+     dcqmem_adr_o <= dcqmem_adr_o_temp;
+`else
+assign dcqmem_adr_o = daddr_qmem_hit ? 32'h0000_0000 : qmemdmmu_adr_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign dcqmem_cycstb_o_temp = daddr_qmem_hit ? 1'b0 : qmemdmmu_cycstb_i;
+always @(posedge clk)
+      dcqmem_cycstb_o <= dcqmem_cycstb_o_temp;
+`else
+assign dcqmem_cycstb_o = daddr_qmem_hit ? 1'b0 : qmemdmmu_cycstb_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign dcqmem_ci_o_temp = daddr_qmem_hit ? 1'b0 : qmemdmmu_ci_i;
+always @(posedge clk)
+      dcqmem_ci_o <= dcqmem_ci_o_temp;
+`else
+assign dcqmem_ci_o = daddr_qmem_hit ? 1'b0 : qmemdmmu_ci_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign dcqmem_we_o_temp = daddr_qmem_hit ? 1'b0 : qmemdcpu_we_i;
+always @(posedge clk)
+      dcqmem_we_o <= dcqmem_we_o_temp;
+`else
+assign dcqmem_we_o = daddr_qmem_hit ? 1'b0 : qmemdcpu_we_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign dcqmem_sel_o_temp = daddr_qmem_hit ? 4'h0 : qmemdcpu_sel_i;
+always @(posedge clk)
+      dcqmem_sel_o <= dcqmem_sel_o_temp;
+`else
+assign dcqmem_sel_o = daddr_qmem_hit ? 4'h0 : qmemdcpu_sel_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign dcqmem_tag_o_temp = daddr_qmem_hit ? 4'h0 : qmemdcpu_tag_i;
+always @(posedge clk)
+     dcqmem_tag_o <= dcqmem_tag_o_temp;
+`else
+assign dcqmem_tag_o = daddr_qmem_hit ? 4'h0 : qmemdcpu_tag_i;
+`endif
+
+`ifdef XLNX_MODIFIED
+assign dcqmem_dat_o_temp = daddr_qmem_hit ? 32'h0000_0000 : qmemdcpu_dat_i;
+always @(posedge clk)
+     dcqmem_dat_o <= dcqmem_dat_o_temp;
+`else
+assign dcqmem_dat_o = daddr_qmem_hit ? 32'h0000_0000 : qmemdcpu_dat_i;
+`endif
+
+//
+// Address comparison whether QMEM was hit
+//
+`ifdef OR1200_QMEM_IADDR
+assign iaddr_qmem_hit = (qmemimmu_adr_i & `OR1200_QMEM_IMASK) == `OR1200_QMEM_IADDR;
+`else
+assign iaddr_qmem_hit = 1'b0;
+`endif
+
+`ifdef OR1200_QMEM_DADDR
+assign daddr_qmem_hit = (qmemdmmu_adr_i & `OR1200_QMEM_DMASK) == `OR1200_QMEM_DADDR;
+`else
+assign daddr_qmem_hit = 1'b0;
+`endif
+
+//
+//
+//
+assign qmem_en = iaddr_qmem_hit & qmemimmu_cycstb_i | daddr_qmem_hit & qmemdmmu_cycstb_i;
+
+`ifdef XLNX_MODIFIED
+assign qmem_we[0] = qmem_sel[0] & qmemdmmu_cycstb_i & daddr_qmem_hit & qmemdcpu_we_i;
+assign qmem_we[1] = qmem_sel[1] & qmemdmmu_cycstb_i & daddr_qmem_hit & qmemdcpu_we_i;
+assign qmem_we[2] = qmem_sel[2] & qmemdmmu_cycstb_i & daddr_qmem_hit & qmemdcpu_we_i;
+assign qmem_we[3] = qmem_sel[3] & qmemdmmu_cycstb_i & daddr_qmem_hit & qmemdcpu_we_i;
+`else
+assign qmem_we = qmemdmmu_cycstb_i & daddr_qmem_hit & qmemdcpu_we_i;
+`endif
+
+`ifdef OR1200_QMEM_BSEL
+assign qmem_sel = (qmemdmmu_cycstb_i & daddr_qmem_hit) ? qmemdcpu_sel_i : qmemicpu_sel_i;
+`endif
+assign qmem_di = qmemdcpu_dat_i;
+assign qmem_addr = (qmemdmmu_cycstb_i & daddr_qmem_hit) ? qmemdmmu_adr_i : qmemimmu_adr_i;
+
+//
+// QMEM control FSM
+//
+always @(posedge rst or posedge clk)
+	if (rst) begin
+		state <= #1 `OR1200_QMEMFSM_IDLE;
+		qmem_dack <= #1 1'b0;
+		qmem_iack <= #1 1'b0;
+	end
+	else case (state)	// synopsys parallel_case
+		`OR1200_QMEMFSM_IDLE: begin
+			if (qmemdmmu_cycstb_i & daddr_qmem_hit & qmemdcpu_we_i & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_STORE;
+				qmem_dack <= #1 1'b1;
+				qmem_iack <= #1 1'b0;
+			end
+			else if (qmemdmmu_cycstb_i & daddr_qmem_hit & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_LOAD;
+				qmem_dack <= #1 1'b1;
+				qmem_iack <= #1 1'b0;
+			end
+			else if (qmemimmu_cycstb_i & iaddr_qmem_hit & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_FETCH;
+				qmem_iack <= #1 1'b1;
+				qmem_dack <= #1 1'b0;
+			end
+		end
+		`OR1200_QMEMFSM_STORE: begin
+			if (qmemdmmu_cycstb_i & daddr_qmem_hit & qmemdcpu_we_i & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_STORE;
+				qmem_dack <= #1 1'b1;
+				qmem_iack <= #1 1'b0;
+			end
+			else if (qmemdmmu_cycstb_i & daddr_qmem_hit & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_LOAD;
+				qmem_dack <= #1 1'b1;
+				qmem_iack <= #1 1'b0;
+			end
+			else if (qmemimmu_cycstb_i & iaddr_qmem_hit & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_FETCH;
+				qmem_iack <= #1 1'b1;
+				qmem_dack <= #1 1'b0;
+			end
+			else begin
+				state <= #1 `OR1200_QMEMFSM_IDLE;
+				qmem_dack <= #1 1'b0;
+				qmem_iack <= #1 1'b0;
+			end
+		end
+		`OR1200_QMEMFSM_LOAD: begin
+			if (qmemdmmu_cycstb_i & daddr_qmem_hit & qmemdcpu_we_i & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_STORE;
+				qmem_dack <= #1 1'b1;
+				qmem_iack <= #1 1'b0;
+			end
+			else if (qmemdmmu_cycstb_i & daddr_qmem_hit & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_LOAD;
+				qmem_dack <= #1 1'b1;
+				qmem_iack <= #1 1'b0;
+			end
+			else if (qmemimmu_cycstb_i & iaddr_qmem_hit & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_FETCH;
+				qmem_iack <= #1 1'b1;
+				qmem_dack <= #1 1'b0;
+			end
+			else begin
+				state <= #1 `OR1200_QMEMFSM_IDLE;
+				qmem_dack <= #1 1'b0;
+				qmem_iack <= #1 1'b0;
+			end
+		end
+		`OR1200_QMEMFSM_FETCH: begin
+			if (qmemdmmu_cycstb_i & daddr_qmem_hit & qmemdcpu_we_i & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_STORE;
+				qmem_dack <= #1 1'b1;
+				qmem_iack <= #1 1'b0;
+			end
+			else if (qmemdmmu_cycstb_i & daddr_qmem_hit & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_LOAD;
+				qmem_dack <= #1 1'b1;
+				qmem_iack <= #1 1'b0;
+			end
+			else if (qmemimmu_cycstb_i & iaddr_qmem_hit & qmem_ack) begin
+				state <= #1 `OR1200_QMEMFSM_FETCH;
+				qmem_iack <= #1 1'b1;
+				qmem_dack <= #1 1'b0;
+			end
+			else begin
+				state <= #1 `OR1200_QMEMFSM_IDLE;
+				qmem_dack <= #1 1'b0;
+				qmem_iack <= #1 1'b0;
+			end
+		end
+		default: begin
+			state <= #1 `OR1200_QMEMFSM_IDLE;
+			qmem_dack <= #1 1'b0;
+			qmem_iack <= #1 1'b0;
+		end
+	endcase
+
+//
+// Instantiation of embedded memory
+//
+
+//XLNX_MODIFIED changed to or1200_spram_2048x32_bw from or1200_spram_2048x32
+or1200_spram_2048x32_bw or1200_qmem_ram(
+	.clk(clk),
+	.rst(rst),
+`ifdef OR1200_BIST
+	// RAM BIST
+	.mbist_si_i(mbist_si_i),
+	.mbist_so_o(mbist_so_o),
+	.mbist_ctrl_i(mbist_ctrl_i),
+`endif
+	.addr(qmem_addr[12:2]),
+
+`ifdef OR1200_QMEM_BSEL
+`ifdef XLNX_MODIFIED
+`else
+    .sel(qmem_sel),
+`endif    
+`endif
+`ifdef OR1200_QMEM_ACK
+  .ack(qmem_ack),
+`endif
+  .ce(qmem_en),
+	.we(qmem_we),
+	.oe(1'b1),
+	.di(qmem_di),
+	.doq(qmem_do)
+);
+
+`else  // OR1200_QMEM_IMPLEMENTED
+
+//
+// QMEM and CPU/IMMU
+//
+assign qmemicpu_dat_o = icqmem_dat_i;
+assign qmemicpu_ack_o = icqmem_ack_i;
+assign qmemimmu_rty_o = icqmem_rty_i;
+assign qmemimmu_err_o = icqmem_err_i;
+assign qmemimmu_tag_o = icqmem_tag_i;
+
+//
+// QMEM and IC
+//
+assign icqmem_adr_o = qmemimmu_adr_i;
+assign icqmem_cycstb_o = qmemimmu_cycstb_i;
+assign icqmem_ci_o = qmemimmu_ci_i;
+assign icqmem_sel_o = qmemicpu_sel_i;
+assign icqmem_tag_o = qmemicpu_tag_i;
+
+//
+// QMEM and CPU/DMMU
+//
+assign qmemdcpu_dat_o = dcqmem_dat_i;
+assign qmemdcpu_ack_o = dcqmem_ack_i;
+assign qmemdcpu_rty_o = dcqmem_rty_i;
+assign qmemdmmu_err_o = dcqmem_err_i;
+assign qmemdmmu_tag_o = dcqmem_tag_i;
+
+//
+// QMEM and DC
+//
+assign dcqmem_adr_o = qmemdmmu_adr_i;
+assign dcqmem_cycstb_o = qmemdmmu_cycstb_i;
+assign dcqmem_ci_o = qmemdmmu_ci_i;
+assign dcqmem_we_o = qmemdcpu_we_i;
+assign dcqmem_sel_o = qmemdcpu_sel_i;
+assign dcqmem_tag_o = qmemdcpu_tag_i;
+assign dcqmem_dat_o = qmemdcpu_dat_i;
+
+`ifdef OR1200_BIST
+assign mbist_so_o = mbist_si_i;
+`endif
+
+`endif
+
+endmodule
diff --git a/Example/CPU_Example/CPU_Example.srcs/sources_1/imports/Sources/or1200/or1200_reg2mem.v b/Example/CPU_Example/CPU_Example.srcs/sources_1/imports/Sources/or1200/or1200_reg2mem.v
