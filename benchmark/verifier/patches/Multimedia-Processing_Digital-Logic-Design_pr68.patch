+	.din (wb_data_o_buf),
+	.rd_clk (wb_clk ),
+	.rd_en (wr_en2),
+	.rst( rst),
+	.wr_clk (clk_i),
+	.wr_en (resume_req_r),
+	.dout (wb_data_o_temp)
+	
+	);
