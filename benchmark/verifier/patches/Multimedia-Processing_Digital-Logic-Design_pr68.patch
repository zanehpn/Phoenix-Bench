+	.rd_en (resume_req_r),
+	.rst( rst),
+	.wr_clk (wb_clk),
+	.wr_en (wr_en1),
+	.dout ({dma_ack_i_buf,wb_addr_i_buf})
+	);
+	
+// output fifo
