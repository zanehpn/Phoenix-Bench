+	   3'h0: dtmp = main_csr;
+	   3'h1: dtmp = { 25'h0, funct_adr};
+	   3'h2: dtmp = {  7'h0, intb_msk, 7'h0, inta_msk};
+	   3'h3: dtmp = {  3'h0, int_srcb, 4'h0, int_srca};
+	   3'h4: dtmp = frm_nat;
+	   default: dtmp = { 24'h0, utmi_vend_stat_r +1'b1}; // to remove latches
+//	   3'h5: dtmp = { 24'h0, utmi_vend_stat_r +1'b1}; 
