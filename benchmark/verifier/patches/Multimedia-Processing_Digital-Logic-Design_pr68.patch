diff --git a/Example/VerilogHDL_Practice/CH7/binary_square_generator_assign.v b/Example/VerilogHDL_Practice/CH7/binary_square_generator_assign.v
new file mode 100644
index 00000000..ae37c1d6
--- /dev/null
+++ b/Example/VerilogHDL_Practice/CH7/binary_square_generator_assign.v
@@ -0,0 +1,10 @@
+module binary_square_generator_assign (i0, i1, o0, o1, o2, o3);
+input i0, i1;
+output o0, o1, o2, o3;
+
+assign o3 = (i0 & i1);
+assign o2 = (~i0 & i1);
+assign o1 = 0;
+assign o0 = (i0 & ~i1) | (i0 & i1);
+
+endmodule // binary_square_generator_assign
