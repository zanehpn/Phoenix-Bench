+always @(posedge wb_clk)
+   dma_ack_i_reg <= dma_ack_i;
+   
+   
+ assign wr_en0 = dma_ack_i_reg[3] | dma_ack_i_reg[2] | dma_ack_i_reg[1] | dma_ack_i_reg[0];
