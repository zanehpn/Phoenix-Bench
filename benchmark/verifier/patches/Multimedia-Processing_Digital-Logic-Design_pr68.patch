diff --git a/Example/VerilogHDL_Practice/CH7/binary_square_generator_assign_test.v b/Example/VerilogHDL_Practice/CH7/binary_square_generator_assign_test.v
new file mode 100644
index 00000000..0398e266
--- /dev/null
+++ b/Example/VerilogHDL_Practice/CH7/binary_square_generator_assign_test.v
@@ -0,0 +1,26 @@
+`timescale 1ns / 1ps
+
+module binary_square_generator_assign_test ();
+
+reg i1;
+reg i0;
+wire o0, o1, o2, o3;
+integer i;
+
+binary_square_generator_assign UUT (.i0(i0), .i1(i1), .o0(o0), .o1(o1), .o2(o2), .o3(o3));
+
+initial begin
+  for (i = 0; i < 4; i = i + 1)
+    begin
+      {i1, i0} = i[1:0];
+      #10;
+    end
+
+end
+
+initial begin
+  #40;
+  $finish;
+end
+
+endmodule // binary_square_generator_assign_test
diff --git a/Example/VerilogHDL_Practice/CH7/binary_square_generator_case.v b/Example/VerilogHDL_Practice/CH7/binary_square_generator_case.v
new file mode 100644
index 00000000..50353115
--- /dev/null
+++ b/Example/VerilogHDL_Practice/CH7/binary_square_generator_case.v
@@ -0,0 +1,16 @@
+module binary_square_generator_case (i, o);
+
+input [1:0] i;
+output [3:0] o;
+reg [3:0] o;
+
+always @ (i) begin
+  case (i)
+    2'b00: o = 4'b0000;
+    2'b01: o = 4'b0001;
+    2'b10: o = 4'b0100;
+    default: o = 4'b1001;
+  endcase
+end
+
+endmodule // binary_square_generator_case
