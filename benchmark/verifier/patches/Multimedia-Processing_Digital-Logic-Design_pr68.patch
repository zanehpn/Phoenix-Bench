+FifoBuffer dma_out (
+	.din ({dma_req_o_buf,DataOut_pad_o_buf, vend_ctrl, OpModeBuf,2'b01}),
+	.rd_clk (wb_clk ),
+	.rd_en (wr_en3),
+	.rst( rst),
+	.wr_clk (clk_i),
+	.wr_en (resume_req_r),
+	.dout ({dma_req_o_temp,DataOut_pad_o, VControl_pad_o, OpMode_pad_o})
+	);	 
