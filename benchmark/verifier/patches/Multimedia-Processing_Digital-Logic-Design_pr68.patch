+// synopsys translate_on
+`include "or1200_defines.v"
+
+module or1200_ic_tag(
+	// Clock and reset
+	clk, rst,
+
+`ifdef OR1200_BIST
+	// RAM BIST
+	mbist_si_i, mbist_so_o, mbist_ctrl_i,
+`endif
+
+	// Internal i/f
+	addr, en, we, datain, tag_v, tag
+);
+
+parameter dw = `OR1200_ICTAG_W;
+parameter aw = `OR1200_ICTAG;
+
+//
+// I/O
+//
+
+//
+// Clock and reset
+//
+input				clk;
+input				rst;
+
+`ifdef OR1200_BIST
+//
+// RAM BIST
+//
