+	.we(we),
+	.oe(1'b1),
+	.addr(addr),
+	.di(datain),
+	.doq({tag, tag_v})
+);
+
+`endif
+
+endmodule
diff --git a/Example/CPU_Example/CPU_Example.srcs/sources_1/imports/Sources/or1200/or1200_ic_top.v b/Example/CPU_Example/CPU_Example.srcs/sources_1/imports/Sources/or1200/or1200_ic_top.v
