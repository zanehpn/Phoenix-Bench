diff --git a/Example/VerilogHDL_Practice/CH7/excess_three_assign_test.v b/Example/VerilogHDL_Practice/CH7/excess_three_assign_test.v
new file mode 100644
index 00000000..4cbe0ee5
--- /dev/null
+++ b/Example/VerilogHDL_Practice/CH7/excess_three_assign_test.v
@@ -0,0 +1,24 @@
+`timescale 1ns / 1ps
+
+module excess_three_assign_test ();
+
+reg [2:0] i;
+wire [2:0] o;
+integer conut;
+
+excess_three_assign UUT (.i(i), .o(o));
+
+initial begin
+  for (conut = 0; conut < 8; conut = conut + 1)
+    begin
+      i = conut[2:0];
+      #10;
+    end
+end
+
+initial begin
+  #80;
+  $finish;
+end
+
+endmodule // excess_three_assign_test
diff --git a/Example/VerilogHDL_Practice/CH7/excess_three_case.v b/Example/VerilogHDL_Practice/CH7/excess_three_case.v
new file mode 100644
index 00000000..6852de02
--- /dev/null
+++ b/Example/VerilogHDL_Practice/CH7/excess_three_case.v
@@ -0,0 +1,20 @@
+module excess_three_case (i, o);
+  input [2:0] i;
+  output [2:0] o;
+  reg [2:0] o;
+
+
+always @ (i) begin
+  case (i)
+    3'b000: o = 3'b011;
+    3'b001: o = 3'b100;
+    3'b010: o = 3'b101;
+    3'b011: o = 3'b110;
+    3'b100: o = 3'b111;
+    3'b101: o = 3'b000;
+    3'b110: o = 3'b001;
+    default: o = 3'b010;
+  endcase
+end
+
+endmodule // excess_three_case
