+  output        fftClk_o,
+  // Status and control signals
+  input         RESET
+ );
+
+  // Clocking primitive
+  //------------------------------------
+  // Instantiation of the MMCM primitive
+  //    * Unused inputs are tied off
+  //    * Unused outputs are labeled unused
+  wire [15:0] do_unused;
+  wire        drdy_unused;
+  wire        psdone_unused;
+  wire        locked_unused;
+  wire        clkfbout;
+  wire        clkfbout_buf;
