+   wire [31:0] s1_data_o;
+   wire  [31:0] s1_data_i;
+   wire s1_ack_i;
+   wire s1_err_i;
+   wire s1_rty_i;
+   wire [31:0] s1_addr_o;
+   wire s1_we_o;
+   wire s1_cyc_o;
+   wire [15:0] s1_sel_o;
+
+   // wishbone slave 2 signals
+   wire s2_stb_o;
+   wire [31:0] s2_data_o;
+   wire  [31:0] s2_data_i;
+   wire s2_ack_i;
+   wire s2_err_i;
+   wire s2_rty_i;
