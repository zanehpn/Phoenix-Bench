+    assign  gt7_rxpd_i                           =  tied_to_ground_vec_i[1:0];
+    assign  gt7_rxbufreset_i                     =  tied_to_ground_i;
+
+end
+endgenerate //End generate for EXAMPLE_USE_CHIPSCOPE
+
+endmodule
