diff --git a/Example/VerilogHDL_Practice/CH7/excess_three_case_test.v b/Example/VerilogHDL_Practice/CH7/excess_three_case_test.v
new file mode 100644
index 00000000..9ef8c00d
--- /dev/null
+++ b/Example/VerilogHDL_Practice/CH7/excess_three_case_test.v
@@ -0,0 +1,24 @@
+`timescale 1ns / 1ps
+
+module excess_three_case_test ();
+
+reg [2:0] i;
+wire [2:0] o;
+integer conut;
+
+excess_three_case UUT (.i(i), .o(o));
+
+initial begin
+  for (conut = 0; conut < 8; conut = conut + 1)
+    begin
+      i = conut[2:0];
+      #10;
+    end
+end
+
+initial begin
+  #80;
+  $finish;
+end
+
+endmodule // excess_three_case_test
diff --git a/Example/VerilogHDL_Practice/CH7/excess_three_if.v b/Example/VerilogHDL_Practice/CH7/excess_three_if.v
new file mode 100644
index 00000000..f9d9eda2
--- /dev/null
+++ b/Example/VerilogHDL_Practice/CH7/excess_three_if.v
@@ -0,0 +1,26 @@
+module excess_three_if (i, o);
+input [2:0] i;
+output [2:0] o;
+reg [2:0] o;
+
+always @ (i) begin
+  if (i == 3'b000) begin
+    o = 3'b011;
+  end else if (i == 3'b001) begin
+    o = 3'b100;
+  end else if (i == 3'b010) begin
+    o = 3'b101;
+  end else if (i == 3'b011) begin
+    o = 3'b110;
+  end else if (i == 3'b100) begin
+    o = 3'b111;
+  end else if (i == 3'b101) begin
+    o = 3'b000;
+  end else if (i == 3'b110) begin
+    o = 3'b001;
+  end else begin
+    o = 3'b010;
+  end
+end
+
+endmodule // excess_three_assign
