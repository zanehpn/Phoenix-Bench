From 62da6cc89224a4e8f9beec40681ffcfe23973f3f Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Wed, 11 Sep 2024 17:13:02 +0200
Subject: [PATCH 4/5] minor

---
 cores/simson/hdl/jt053246.sv | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/cores/simson/hdl/jt053246.sv b/cores/simson/hdl/jt053246.sv
index 3374143c7..10b3bd43e 100644
--- a/cores/simson/hdl/jt053246.sv
+++ b/cores/simson/hdl/jt053246.sv
@@ -119,8 +119,8 @@ always @(posedge clk) begin
     xadj <= xoffset - 10'd61 /*{debug_bus,2'd0}*/;
     yadj <= yoffset + (XMEN==1   ? 10'h107 :
                        simson    ? 10'h11f : 10'h10f); // Vendetta
-    vscl <= rd_pzoffset(vzoom, zoffset, pzoffset);//|vzoom[9:8]? zoffset[ 8'hFF ] : zoffset[ vzoom[7:0] ];
-    hscl <= rd_pzoffset(hzoom, zoffset, pzoffset);//|hzoom[9:8]? zoffset[ 8'hFF ] : zoffset[ hzoom[7:0] ];
+    vscl <= rd_pzoffset(vzoom, zoffset, pzoffset);
+    hscl <= rd_pzoffset(hzoom, zoffset, pzoffset);
     /* verilator lint_off WIDTH */
     yz_add  <= vzoom[9:0]*ydiff_b; // vzoom < 10'h40 enlarge, >10'h40 reduce
                                    // opposite to the one in Aliens, which always
@@ -144,8 +144,7 @@ function [8:0] rd_pzoffset( input [11:0] zoom, input [ 8:0] offset1 [0:255], inp
         0:       rd_pzoffset =       offset1 [zoom[7:0]];
         1:       rd_pzoffset = {5'b0,offset2 [zoom[7:4]]};
         2:       rd_pzoffset =  9'd3;
-        /*4,*/3:     rd_pzoffset =  9'd2;
-        // default: rd_pzoffset =  9'd1;
+        3:       rd_pzoffset =  9'd2;
     endcase
 endfunction 
 

From f3613d21aa7fab945e32132a2dd2a77fb367d5f6 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Thu, 12 Sep 2024 09:26:28 +0200
Subject: [PATCH 5/5] minor

---
 cores/riders/hdl/jtriders_sound.v | 2 +-
 cores/simson/hdl/jt053246.sv      | 6 +++---
 cores/xmen/hdl/jtxmen_game.v      | 2 +-
 3 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/cores/riders/hdl/jtriders_sound.v b/cores/riders/hdl/jtriders_sound.v
index 9922b8fda..e0eca1afb 100644
--- a/cores/riders/hdl/jtriders_sound.v
+++ b/cores/riders/hdl/jtriders_sound.v
@@ -63,9 +63,9 @@ module jtriders_sound(
     // Sound output
     output     signed [15:0] fm_l,  fm_r, k60_l, k60_r
 );
-`ifndef NOSOUND
 parameter   [ 0:0] FULLRAM = 0,
                    XMEN = 0;
+`ifndef NOSOUND
 wire        [ 7:0]  cpu_dout, cpu_din,  ram_dout, fm_dout,
                     k60_dout, k39_dout, latch_dout;
 wire        [ 3:0]  rom_hi;
diff --git a/cores/simson/hdl/jt053246.sv b/cores/simson/hdl/jt053246.sv
index 10b3bd43e..0b813133e 100644
--- a/cores/simson/hdl/jt053246.sv
+++ b/cores/simson/hdl/jt053246.sv
@@ -119,8 +119,8 @@ always @(posedge clk) begin
     xadj <= xoffset - 10'd61 /*{debug_bus,2'd0}*/;
     yadj <= yoffset + (XMEN==1   ? 10'h107 :
                        simson    ? 10'h11f : 10'h10f); // Vendetta
-    vscl <= rd_pzoffset(vzoom, zoffset, pzoffset);
-    hscl <= rd_pzoffset(hzoom, zoffset, pzoffset);
+    vscl <= rd_pzoffset(vzoom[9:0], zoffset, pzoffset);
+    hscl <= rd_pzoffset(hzoom[9:0], zoffset, pzoffset);
     /* verilator lint_off WIDTH */
     yz_add  <= vzoom[9:0]*ydiff_b; // vzoom < 10'h40 enlarge, >10'h40 reduce
                                    // opposite to the one in Aliens, which always
@@ -139,7 +139,7 @@ function [8:0] zmove( input [1:0] sz, input[8:0] scl );
     endcase
 endfunction
 
-function [8:0] rd_pzoffset( input [11:0] zoom, input [ 8:0] offset1 [0:255], input [3:0] offset2[0:15]);
+function [8:0] rd_pzoffset( input [9:0] zoom, input [ 8:0] offset1 [0:255], input [3:0] offset2[0:15]);
     case( zoom[9:8] )
         0:       rd_pzoffset =       offset1 [zoom[7:0]];
         1:       rd_pzoffset = {5'b0,offset2 [zoom[7:4]]};
diff --git a/cores/xmen/hdl/jtxmen_game.v b/cores/xmen/hdl/jtxmen_game.v
index 654839998..dff5e5534 100644
--- a/cores/xmen/hdl/jtxmen_game.v
+++ b/cores/xmen/hdl/jtxmen_game.v
@@ -192,7 +192,7 @@ jtxmen_video u_video (
 );
 
 /* verilator tracing_off */
-jtriders_sound `ifndef NOSOUND #(.FULLRAM(1), .XMEN(1))`endif u_sound(
+jtriders_sound #(.FULLRAM(1), .XMEN(1)) u_sound(
     .rst        ( rst           ),
     .clk        ( clk           ),
     .cen_8      ( cen_8         ),
