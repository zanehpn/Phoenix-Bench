From 188e8a5f7da7863f4fd743bbe2af8f9943f6f0be Mon Sep 17 00:00:00 2001
From: Ibrahim Abu Kharmeh 84175316 <ibrahim.abu.kharmeh@huawei.com>
Date: Mon, 7 Feb 2022 15:34:16 +0000
Subject: [PATCH] Update the assertions and tracer ifdefs

---
 bhv/cv32e41p_apu_tracer.sv      |  4 ++--
 bhv/cv32e41p_tracer.sv          |  4 ++--
 bhv/cv32e41p_wrapper.sv         | 14 +++++++-------
 rtl/cv32e41p_aligner.sv         |  2 +-
 rtl/cv32e41p_alu_div.sv         |  2 +-
 rtl/cv32e41p_apu_disp.sv        |  2 +-
 rtl/cv32e41p_controller.sv      |  2 +-
 rtl/cv32e41p_core.sv            |  2 +-
 rtl/cv32e41p_cs_registers.sv    |  2 +-
 rtl/cv32e41p_fifo.sv            |  2 +-
 rtl/cv32e41p_hwloop_regs.sv     |  2 +-
 rtl/cv32e41p_id_stage.sv        |  2 +-
 rtl/cv32e41p_if_stage.sv        |  2 +-
 rtl/cv32e41p_load_store_unit.sv |  2 +-
