 rtl/cv32e41p_sleep_unit.sv      |  2 +-
 17 files changed, 25 insertions(+), 25 deletions(-)

diff --git a/bhv/cv32e41p_apu_tracer.sv b/bhv/cv32e41p_apu_tracer.sv
index b476b7f..dee4ef5 100644
--- a/bhv/cv32e41p_apu_tracer.sv
+++ b/bhv/cv32e41p_apu_tracer.sv
@@ -35,7 +35,7 @@
 //                                                                            //
 ////////////////////////////////////////////////////////////////////////////////
 
-`ifdef CV32E40P_APU_TRACE
+`ifdef CV32E41P_APU_TRACE
 
 module cv32e41p_apu_tracer (
     input logic        clk_i,
@@ -76,4 +76,4 @@ module cv32e41p_apu_tracer (
 
 endmodule  // cv32e41p_apu_tracer
 
-`endif  // CV32E40P_APU_TRACE
+`endif  // CV32E41P_APU_TRACE
diff --git a/bhv/cv32e41p_tracer.sv b/bhv/cv32e41p_tracer.sv
index 60430b1..d84ca18 100644
--- a/bhv/cv32e41p_tracer.sv
+++ b/bhv/cv32e41p_tracer.sv
@@ -22,7 +22,7 @@
 //                                                                            //
 ////////////////////////////////////////////////////////////////////////////////
 
-`ifdef CV32E40P_TRACE_EXECUTION
+`ifdef CV32E41P_TRACE_EXECUTION
 
 `include "uvm_macros.svh"
 
@@ -472,4 +472,4 @@ module cv32e41p_tracer
 endmodule : cv32e41p_tracer
 
 
-`endif // CV32E40P_TRACE_EXECUTION
+`endif // CV32E41P_TRACE_EXECUTION
diff --git a/bhv/cv32e41p_wrapper.sv b/bhv/cv32e41p_wrapper.sv
index 5ab766d..d6d6efb 100644
--- a/bhv/cv32e41p_wrapper.sv
+++ b/bhv/cv32e41p_wrapper.sv
@@ -11,17 +11,17 @@
 // Wrapper for a cv32e41p, containing cv32e41p, and tracer
 // Contributor: Davide Schiavone <davide@openhwgroup.org>
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 `include "cv32e41p_prefetch_controller_sva.sv"
 `endif
 
 `include "cv32e41p_core_log.sv"
 
-`ifdef CV32E40P_APU_TRACE
+`ifdef CV32E41P_APU_TRACE
 `include "cv32e41p_apu_tracer.sv"
 `endif
 
-`ifdef CV32E40P_TRACE_EXECUTION
+`ifdef CV32E41P_TRACE_EXECUTION
 `include "cv32e41p_tracer.sv"
 `endif
 
@@ -94,7 +94,7 @@ module cv32e41p_wrapper
     output logic core_sleep_o
 );
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   // RTL Assertions
   bind cv32e41p_prefetch_controller:
@@ -107,7 +107,7 @@ module cv32e41p_wrapper
       .FIFO_ADDR_DEPTH(FIFO_ADDR_DEPTH)
   ) prefetch_controller_sva (.*);
 
-`endif  // CV32E40P_ASSERT_ON
+`endif  // CV32E41P_ASSERT_ON
 
   cv32e41p_core_log #(
       .PULP_XPULP      (PULP_XPULP),
@@ -123,7 +123,7 @@ module cv32e41p_wrapper
       .pc_id_i           (core_i.pc_id)
   );
 
-`ifdef CV32E40P_APU_TRACE
+`ifdef CV32E41P_APU_TRACE
   cv32e41p_apu_tracer apu_tracer_i (
       .clk_i       (core_i.rst_ni),
       .rst_n       (core_i.clk_i),
@@ -134,7 +134,7 @@ module cv32e41p_wrapper
   );
 `endif
 
-`ifdef CV32E40P_TRACE_EXECUTION
+`ifdef CV32E41P_TRACE_EXECUTION
   cv32e41p_tracer tracer_i (
       .clk_i(core_i.clk_i),  // always-running clock for tracing
       .rst_n(core_i.rst_ni),
diff --git a/rtl/cv32e41p_aligner.sv b/rtl/cv32e41p_aligner.sv
index 83701ea..9661e60 100644
--- a/rtl/cv32e41p_aligner.sv
+++ b/rtl/cv32e41p_aligner.sv
@@ -237,7 +237,7 @@ module cv32e41p_aligner (
   // Assertions
   //////////////////////////////////////////////////////////////////////////////
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   // Hardware Loop check
   property p_hwlp_update_pc;
diff --git a/rtl/cv32e41p_alu_div.sv b/rtl/cv32e41p_alu_div.sv
index 95a5435..ae21802 100644
--- a/rtl/cv32e41p_alu_div.sv
+++ b/rtl/cv32e41p_alu_div.sv
@@ -216,7 +216,7 @@ module cv32e41p_alu_div #(
   // assertions
   ///////////////////////////////////////////////////////////////////////////////
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
   initial begin : p_assertions
     assert (C_LOG_WIDTH == $clog2(C_WIDTH + 1))
     else $error("C_LOG_WIDTH must be $clog2(C_WIDTH+1)");
diff --git a/rtl/cv32e41p_apu_disp.sv b/rtl/cv32e41p_apu_disp.sv
index 87296a1..14394d5 100644
--- a/rtl/cv32e41p_apu_disp.sv
+++ b/rtl/cv32e41p_apu_disp.sv
@@ -229,7 +229,7 @@ module cv32e41p_apu_disp (
   // Assertions
   //
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
   assert property (@(posedge clk_i) (apu_rvalid_i) |-> (valid_req | valid_inflight | valid_waiting))
   else $warning("[APU Dispatcher] instruction returned while no instruction is in-flight");
 `endif
diff --git a/rtl/cv32e41p_controller.sv b/rtl/cv32e41p_controller.sv
index 848bb10..c1f43eb 100644
--- a/rtl/cv32e41p_controller.sv
+++ b/rtl/cv32e41p_controller.sv
@@ -1516,7 +1516,7 @@ endgenerate
   // Assertions
   //----------------------------------------------------------------------------
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   // make sure that taken branches do not happen back-to-back, as this is not
   // possible without branch prediction in the IF stage
diff --git a/rtl/cv32e41p_core.sv b/rtl/cv32e41p_core.sv
index 0209c2b..2920469 100644
--- a/rtl/cv32e41p_core.sv
+++ b/rtl/cv32e41p_core.sv
@@ -1099,7 +1099,7 @@ module cv32e41p_core
     end
   endgenerate
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   //----------------------------------------------------------------------------
   // Assumptions
diff --git a/rtl/cv32e41p_cs_registers.sv b/rtl/cv32e41p_cs_registers.sv
index ba8ce10..67293b8 100644
--- a/rtl/cv32e41p_cs_registers.sv
+++ b/rtl/cv32e41p_cs_registers.sv
@@ -1571,7 +1571,7 @@ module cv32e41p_cs_registers
     end
   endgenerate
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   //----------------------------------------------------------------------------
   // Assertions
diff --git a/rtl/cv32e41p_fifo.sv b/rtl/cv32e41p_fifo.sv
index ffe34ef..c2cbd46 100644
--- a/rtl/cv32e41p_fifo.sv
+++ b/rtl/cv32e41p_fifo.sv
@@ -149,7 +149,7 @@ module cv32e41p_fifo #(
   // Assertions
   //////////////////////////////////////////////////////////////////////////////
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   initial begin
     assert (DEPTH > 0)
diff --git a/rtl/cv32e41p_hwloop_regs.sv b/rtl/cv32e41p_hwloop_regs.sv
index 355020e..3229d9b 100644
--- a/rtl/cv32e41p_hwloop_regs.sv
+++ b/rtl/cv32e41p_hwloop_regs.sv
@@ -110,7 +110,7 @@ module cv32e41p_hwloop_regs #(
   //----------------------------------------------------------------------------
   // Assertions
   //----------------------------------------------------------------------------
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
   // do not decrement more than one counter at once
   assert property (@(posedge clk) (valid_i) |-> ($countones(hwlp_dec_cnt_i) <= 1));
 `endif
diff --git a/rtl/cv32e41p_id_stage.sv b/rtl/cv32e41p_id_stage.sv
index dde1ed0..c3d9692 100644
--- a/rtl/cv32e41p_id_stage.sv
+++ b/rtl/cv32e41p_id_stage.sv
@@ -1658,7 +1658,7 @@ module cv32e41p_id_stage
   //----------------------------------------------------------------------------
   // Assertions
   //----------------------------------------------------------------------------
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   always_comb begin
     if (FPU == 1) begin
diff --git a/rtl/cv32e41p_if_stage.sv b/rtl/cv32e41p_if_stage.sv
index 9905767..4a5a66b 100644
--- a/rtl/cv32e41p_if_stage.sv
+++ b/rtl/cv32e41p_if_stage.sv
@@ -282,7 +282,7 @@ module cv32e41p_if_stage #(
   // Assertions
   //----------------------------------------------------------------------------
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   generate
     if (!PULP_XPULP) begin : gen_no_pulp_xpulp_assertions
diff --git a/rtl/cv32e41p_load_store_unit.sv b/rtl/cv32e41p_load_store_unit.sv
index 8cfa6f4..fccbc7e 100644
--- a/rtl/cv32e41p_load_store_unit.sv
+++ b/rtl/cv32e41p_load_store_unit.sv
@@ -487,7 +487,7 @@ module cv32e41p_load_store_unit #(
   // Assertions
   //////////////////////////////////////////////////////////////////////////////
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   // External data bus errors are not supported yet. PMP errors are not supported yet.
   // 
diff --git a/rtl/cv32e41p_mult.sv b/rtl/cv32e41p_mult.sv
index 5bb6935..98d78c1 100644
--- a/rtl/cv32e41p_mult.sv
+++ b/rtl/cv32e41p_mult.sv
@@ -354,7 +354,7 @@ module cv32e41p_mult
   //----------------------------------------------------------------------------
 
   // check multiplication result for mulh
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
   assert property (
     @(posedge clk) ((mulh_CS == FINISH) && (operator_i == MUL_H) && (short_signed_i == 2'b11))
     |->
diff --git a/rtl/cv32e41p_prefetch_buffer.sv b/rtl/cv32e41p_prefetch_buffer.sv
index ac7989c..29a9c9f 100644
--- a/rtl/cv32e41p_prefetch_buffer.sv
+++ b/rtl/cv32e41p_prefetch_buffer.sv
@@ -185,7 +185,7 @@ module cv32e41p_prefetch_buffer #(
   // Assertions
   //----------------------------------------------------------------------------
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   // FIFO_DEPTH must be greater than 1. Otherwise, the property
   // p_hwlp_end_already_gnt_when_hwlp_branch in cv32e41p_prefetch_controller
diff --git a/rtl/cv32e41p_sleep_unit.sv b/rtl/cv32e41p_sleep_unit.sv
index b761128..5242931 100644
--- a/rtl/cv32e41p_sleep_unit.sv
+++ b/rtl/cv32e41p_sleep_unit.sv
@@ -162,7 +162,7 @@ module cv32e41p_sleep_unit #(
   // Assertions
   //----------------------------------------------------------------------------
 
-`ifdef CV32E40P_ASSERT_ON
+`ifdef CV32E41P_ASSERT_ON
 
   // Clock gate is disabled during RESET state of the controller
   property p_clock_en_0;
