From bcf2c54bb499687fe0db3b93825024bd033116be Mon Sep 17 00:00:00 2001
From: Dan Petrisko <petrisko@cs.washington.edu>
Date: Wed, 1 Dec 2021 00:07:36 -0800
Subject: [PATCH] Fix inferred latches

---
 bp_me/src/v/network/bp_me_axil_client.sv | 2 ++
 bp_me/src/v/network/bp_me_axil_master.sv | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/bp_me/src/v/network/bp_me_axil_client.sv b/bp_me/src/v/network/bp_me_axil_client.sv
index 41e40706b1..6603611599 100644
--- a/bp_me/src/v/network/bp_me_axil_client.sv
+++ b/bp_me/src/v/network/bp_me_axil_client.sv
@@ -74,6 +74,8 @@ module bp_me_axil_client
 
   always_comb
     begin
+      state_n = state_r;
+
       // BP side
       io_cmd_header_cast_o = '0;
       io_cmd_data_o        = '0;
diff --git a/bp_me/src/v/network/bp_me_axil_master.sv b/bp_me/src/v/network/bp_me_axil_master.sv
index 7c592b9be2..e5c05a5b6b 100644
--- a/bp_me/src/v/network/bp_me_axil_master.sv
+++ b/bp_me/src/v/network/bp_me_axil_master.sv
@@ -82,6 +82,8 @@ module bp_me_axil_master
   // combinational Logic
   always_comb
     begin
+      state_n = state_r;
+
       io_cmd_ready_and_o    = 1'b0;
       io_resp_header_cast_o = io_cmd_header_r;
       io_resp_data_o        = m_axil_rdata_i;
