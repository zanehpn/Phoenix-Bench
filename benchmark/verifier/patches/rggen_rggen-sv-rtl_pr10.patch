From 985282031d9c86a17dd786deff439c2f76fb328b Mon Sep 17 00:00:00 2001
From: Taichi Ishitani <taichi730@gmail.com>
Date: Sun, 17 Oct 2021 16:37:09 +0900
Subject: [PATCH] add workaround for unexpected hierarchical lookup error
 reported by Xcelium simulator

(refs: #9)
---
 rggen_backdoor_if.sv | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/rggen_backdoor_if.sv b/rggen_backdoor_if.sv
index 271ff9a..566012a 100644
--- a/rggen_backdoor_if.sv
+++ b/rggen_backdoor_if.sv
@@ -31,12 +31,13 @@ interface rggen_backdoor_if(
     output  write_data;
     input   read_data;
     input   value;
-
-    sequence at_clock_edge;
-      1;
-    endsequence
   endclocking
 
+  event at_clock_edge;
+  always @(backdoor_cb) begin
+    ->at_clock_edge;
+  end
+
   semaphore backdoor_access_lock;
   initial begin
     backdoor_access_lock  = new(1);
@@ -63,7 +64,7 @@ interface rggen_backdoor_if(
   );
     backdoor_access_lock.get(1);
 
-    if (!backdoor_cb.at_clock_edge.triggered) begin
+    if (!at_clock_edge.triggered) begin
       @(backdoor_cb);
     end
 
