From a3a63448953ea81bc1b85e5456c40a19b83da487 Mon Sep 17 00:00:00 2001
From: Jose Tejada <jose.tejada@jotego.es>
Date: Sun, 8 Jun 2025 17:06:08 +0200
Subject: [PATCH 01/10] Dumpable VRAM

---
 cores/circus/cfg/macros.def        |  3 +++
 cores/circus/cfg/mem.yaml          | 21 ++++++++++++++++++++
 cores/circus/hdl/jtcircus_game.v   | 22 ++++++++++++--------
 cores/circus/hdl/jtcircus_obj.v    | 29 ++++++++++-----------------
 cores/circus/hdl/jtcircus_video.v  | 29 +++++++++++++++++----------
 cores/kicker/hdl/jtkicker_scroll.v | 32 +++++++++++++++++-------------
 6 files changed, 85 insertions(+), 51 deletions(-)

diff --git a/cores/circus/cfg/macros.def b/cores/circus/cfg/macros.def
index 1181cdd8a..0b3a1a273 100644
--- a/cores/circus/cfg/macros.def
+++ b/cores/circus/cfg/macros.def
@@ -9,3 +9,6 @@ JTFRAME_BA3_START=0x18000
 JTFRAME_PROM_START=0x24000
 
 JTFRAME_CREDITS_PAGES=4
+
+# debug
+JTFRAME_IOCTL_RD=3072
\ No newline at end of file
diff --git a/cores/circus/cfg/mem.yaml b/cores/circus/cfg/mem.yaml
index 0d863abbe..d14c9eed1 100644
--- a/cores/circus/cfg/mem.yaml
+++ b/cores/circus/cfg/mem.yaml
@@ -46,3 +46,24 @@ sdram:
       - name: objrom
         addr_width: 16
         data_width: 32
+bram:
+  - name: vram
+    addr_width: 11
+    data_width: 16
+    sim_file: true
+    dual_port:
+      name: vramrw
+      din:  "{2{cpu_dout}}"
+      dout: vramrw_dout
+      rw:   true
+    ioctl: { save: true, order: 0 }
+  - name: olut
+    addr_width: 10
+    data_width: 8
+    dual_port:
+      name: oram
+      addr: main_addr[9:0]
+      din:  "cpu_dout"
+      dout: oram_dout
+      rw: true
+    ioctl: { save: true, order: 1 }
\ No newline at end of file
diff --git a/cores/circus/hdl/jtcircus_game.v b/cores/circus/hdl/jtcircus_game.v
index 5e2e59bf1..efa216118 100644
--- a/cores/circus/hdl/jtcircus_game.v
+++ b/cores/circus/hdl/jtcircus_game.v
@@ -27,12 +27,14 @@ localparam [24:0] PROM_START = `JTFRAME_PROM_START;
 
 wire        cpu_rnw, cpu_irqn, cpu_nmin, cpu_cen, obj_frame,
             snd_on, main_pause, mute;
-wire        vram_cs, vgap_cs, objram_cs, flip;
-wire [ 7:0] vram_dout, obj_dout, cpu_dout, st_snd, snd_latch;
+wire        vram_cs, vgap_cs, oram_cs, flip;
+wire [ 7:0] vcpu_din, obj_dout, st_snd, snd_latch;
 
 assign dip_flip   = flip^dipsw[16]; // extra DIPSW, not in the original
 assign main_pause = dip_pause & ~ioctl_ram;
 assign debug_view = { mute, st_snd[4], 1'd0, dip_flip, st_snd[3:0] };
+assign oram_we    = oram_cs & ~cpu_rnw;
+assign ioctl_din  = 0;
 
 jtcircus_main u_main(
     .rst            ( rst24         ),
@@ -55,10 +57,10 @@ jtcircus_main u_main(
     .cpu_rnw        ( cpu_rnw       ),
     .vgap_cs        ( vgap_cs       ),
     .vram_cs        ( vram_cs       ),
-    .vram_dout      ( vram_dout     ),
+    .vram_dout      ( vcpu_din      ),
 
-    .objram_cs      ( objram_cs     ),
-    .obj_dout       ( obj_dout      ),
+    .objram_cs      ( oram_cs       ),
+    .obj_dout       ( oram_dout     ),
     // Sound control
     .snd_latch      ( snd_latch     ),
     .snd_irq        ( snd_on        ),
@@ -119,10 +121,14 @@ jtcircus_video u_video(
     .vram_cs    ( vram_cs   ),
     .vram_dout  ( vram_dout ),
     .vscr_cs    ( vgap_cs   ),
+    .vcpu_din   ( vcpu_din  ),
+    .vramrw_we  ( vramrw_we ),
+    .vramrw_dout(vramrw_dout),
+    .vramrw_addr(vramrw_addr),
+    .vram_addr  ( vram_addr ),
     // Objects
-    .objram_cs  ( objram_cs ),
-    .obj_dout   ( obj_dout  ),
-
+    .olut_addr  ( olut_addr ),
+    .olut_dout  ( olut_dout ),
     // PROMs
     .prog_data  ( prog_data ),
     .prog_addr  ( prog_addr[9:0] ),
diff --git a/cores/circus/hdl/jtcircus_obj.v b/cores/circus/hdl/jtcircus_obj.v
index 2864bd2dc..476596311 100644
--- a/cores/circus/hdl/jtcircus_obj.v
+++ b/cores/circus/hdl/jtcircus_obj.v
@@ -27,14 +27,9 @@ module jtcircus_obj(
     input               clk24,      // 24 MHz
 
     input               pxl_cen,
-
-    // CPU interface
-    input         [9:0] cpu_addr,
-    input         [7:0] cpu_dout,
-    input               objram_cs,
-    input               cpu_rnw,
-    output        [7:0] obj_dout,
-
+    // Video RAM
+    output       [ 9:0] olut_addr,
+    input        [ 7:0] olut_dout,
     // video inputs
     input               obj_frame,
     input               hs,
@@ -64,16 +59,14 @@ parameter REV_SCAN = 0;
 
 localparam FIX = 9'h2d, FIXF = 9'hde;
 
-wire [ 7:0] dma_din, scan_dout;
-wire        obj_we, obj_bl;
+wire [ 7:0] scan_dout;
+wire        obj_bl;
 reg  [ 7:0] scan_addr=0;
 reg         dma_we, dma_done;
-wire [ 9:0] eff_dma;
 reg  [ 7:0] dma_addr;
 wire [ 3:0] pal_data, pre_pxl, pxl_dly;
 
-assign obj_we  = objram_cs & ~cpu_rnw;
-assign eff_dma = {1'b0,obj_frame,dma_addr};
+assign olut_addr = {1'b0,obj_frame,dma_addr};
 assign pxl     = obj_bl ? 4'd0 : flip ? pre_pxl : pxl_dly;
 assign obj_bl  = flip ? hdump>=FIXF : hdump <= FIX;
 jtframe_sh #(.W(4),.L(5)) u_sh(
@@ -82,7 +75,7 @@ jtframe_sh #(.W(4),.L(5)) u_sh(
     .din    ( pre_pxl   ),
     .drop   ( pxl_dly   )
 );
-
+/*
 jtframe_dual_ram u_hi(
     // Port 0, CPU
     .clk0   ( clk24      ),
@@ -93,16 +86,16 @@ jtframe_dual_ram u_hi(
     // Port 1
     .clk1   ( clk        ),
     .data1  (            ),
-    .addr1  ( eff_dma    ),
+    .addr1  ( olut_addr    ),
     .we1    ( 1'b0       ),
-    .q1     ( dma_din    )
+    .q1     ( olut_dout    )
 );
-
+*/
 // LUT frame buffer and DMA
 jtframe_dual_ram #(.AW(8)) u_fb(
     // Port 0, DMA
     .clk0   ( clk           ),
-    .data0  ( dma_din       ),
+    .data0  ( olut_dout       ),
     .addr0  ( dma_addr      ),
     .we0    ( dma_we        ),
     .q0     (               ),
diff --git a/cores/circus/hdl/jtcircus_video.v b/cores/circus/hdl/jtcircus_video.v
index 09a6eefda..fdd2f8f37 100644
--- a/cores/circus/hdl/jtcircus_video.v
+++ b/cores/circus/hdl/jtcircus_video.v
@@ -35,11 +35,17 @@ module jtcircus_video(
 
     input               vram_cs,
     input               vscr_cs,
-    output        [7:0] vram_dout,
+    output        [7:0] vcpu_din,
 
-    input               objram_cs,
-    output        [7:0] obj_dout,
+    output       [ 1:0] vramrw_we,
+    input        [15:0] vramrw_dout,
+    output       [10:1] vramrw_addr,
+    // VRAM read out
+    output       [10:1] vram_addr,
+    input        [15:0] vram_dout,
 
+    output       [ 9:0] olut_addr,
+    input        [ 7:0] olut_dout,
     // PROMs
     input         [7:0] prog_data,
     input         [9:0] prog_addr,
@@ -107,8 +113,13 @@ jtkicker_scroll #(.LAYOUT(6)) u_scroll(
     .cpu_rnw    ( cpu_rnw   ),
     .vram_cs    ( vram_cs   ),
     .vscr_cs    ( vscr_cs   ),
-    .vram_dout  ( vram_dout ),
+    .cpu_din    ( vcpu_din  ),
     .vscr_dout  (           ),
+    .vramrw_we  ( vramrw_we ),
+    .vramrw_dout(vramrw_dout),
+    .vramrw_addr(vramrw_addr),
+    .vram_dout  ( vram_dout ),
+    .rd_addr    ( vram_addr ),
 
     // video inputs
     .LHBL       ( LHBL      ),
@@ -139,13 +150,9 @@ jtcircus_obj u_obj(
 
     .pxl_cen    ( pxl_cen   ),
     .obj_frame  ( obj_frame ),
-    // CPU interface
-    .cpu_addr   ( cpu_addr[9:0] ),
-    .cpu_dout   ( cpu_dout  ),
-    .objram_cs  ( objram_cs ),
-    .cpu_rnw    ( cpu_rnw   ),
-    .obj_dout   ( obj_dout  ),
-
+    // Video RAM
+    .olut_addr  ( olut_addr ),
+    .olut_dout  ( olut_dout ),
     // video inputs
     .hs         ( HS        ),
     .LHBL       ( LHBL      ),
diff --git a/cores/kicker/hdl/jtkicker_scroll.v b/cores/kicker/hdl/jtkicker_scroll.v
index 276d8d5cb..4e5814b75 100644
--- a/cores/kicker/hdl/jtkicker_scroll.v
+++ b/cores/kicker/hdl/jtkicker_scroll.v
@@ -29,9 +29,16 @@ module jtkicker_scroll(
     input               cpu_rnw,
     input               vram_cs,
     input               vscr_cs,
-    output        [7:0] vram_dout,
+    output        [7:0] cpu_din,
     output        [7:0] vscr_dout,
 
+    output       [ 1:0] vramrw_we,
+    input        [15:0] vramrw_dout,
+    output reg   [10:1] vramrw_addr,
+
+    // VRAM read out
+    output       [10:1] rd_addr,
+    input        [15:0] vram_dout,
     // video inputs
     input               LHBL,
     input               LVBL,
@@ -83,26 +90,23 @@ reg  [ 3:0] pal_msb;
 reg  [ 3:0] cur_pal;
 reg  [ 1:0] code_msb;
 reg  [31:0] pxl_data;
-wire [ 9:0] rd_addr;
 reg  [ 7:0] hdf, vpos, vscr;
 reg         cur_hf;
-wire        vram_we_low, vram_we_high;
 reg         vflip, hflip;
-wire        vram_we;
-reg  [ 9:0] eff_addr;
+wire        vram_prewe;
 reg         scr_prio;
 reg         cur_prio;
 
-assign vram_we      = vram_cs & ~cpu_rnw;
-assign vram_we_low  = vram_we & ~cpu_addr[BSEL];
-assign vram_we_high = vram_we &  cpu_addr[BSEL];
-assign vram_dout    = cpu_addr[BSEL] ? vram_high : vram_low;
+assign vram_prewe = vram_cs & ~cpu_rnw;
+assign vramrw_we  = {2{vram_prewe}} &  {cpu_addr[BSEL],~cpu_addr[BSEL]};
+assign cpu_din    = cpu_addr[BSEL] ? vramrw_dout[15:8] : vramrw_dout[7:0];
+assign {code,attr}= vram_dout;
 
 always @* begin
     hdf = flip ? (~hdump[7:0]-8'd3) : hdump[7:0];
-    eff_addr =  LAYOUT==5 ? cpu_addr[9:0] :
-                (NOSCROLL && LAYOUT!=3) ? cpu_addr[10:1] :
-                cpu_addr[9:0];
+    vramrw_addr =  LAYOUT==5 ? cpu_addr[9:0] :
+            (NOSCROLL && LAYOUT!=3) ? cpu_addr[10:1] :
+            cpu_addr[9:0];
     case( LAYOUT )
         0: begin // Kicker
             vflip    = attr[5];
@@ -195,7 +199,7 @@ always @(posedge clk) if(pxl_cen) begin
         pxl_data <= cur_hf ? pxl_data>>4 : pxl_data<<4;
     end
 end
-
+/*
 jtframe_dual_ram #(.SIMFILE("vram_lo.bin")) u_low(
     // Port 0, CPU
     .clk0   ( clk24         ),
@@ -225,7 +229,7 @@ jtframe_dual_ram #(.SIMFILE("vram_hi.bin")) u_high(
     .we1    ( 1'b0          ),
     .q1     ( code          )
 );
-
+*/
 generate
     if( BYPASS_PROM ) begin
         assign pxl = pal_addr[3:0];

