From 57e035ad978c33b571ed82a76ee714f8979e4734 Mon Sep 17 00:00:00 2001
From: Matt Stroud <matt.c.stroud@gmail.com>
Date: Tue, 21 Oct 2025 18:19:12 -0500
Subject: [PATCH 1/5] Update FST trace test to include missing nettypes

---
 test_regress/t/t_trace_fst.v | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/test_regress/t/t_trace_fst.v b/test_regress/t/t_trace_fst.v
index 44ac7feac7c..2e4f24dd442 100644
--- a/test_regress/t/t_trace_fst.v
+++ b/test_regress/t/t_trace_fst.v
@@ -38,7 +38,13 @@ module t (/*AUTOARG*/
    tri0            fst_tri0;
    tri1            fst_tri1;
    tri             fst_tri;
+   triand          fst_triand;
+   trior           fst_trior;
+   //trireg          fst_trireg; // Error-UNSUPPORTED
+   wand            fst_wand;
+   wor             fst_wor;
    wire            fst_wire;
+   uwire           fst_uwire;
    inout           fst_inout;
 
    Test test (/*AUTOINST*/

From 02b0e1dca5719af690838dede5f26c5e5126bdde Mon Sep 17 00:00:00 2001
From: Matt Stroud <matt.c.stroud@gmail.com>
Date: Tue, 21 Oct 2025 18:21:52 -0500
Subject: [PATCH 2/5] Fix: add missing net types to FST trace module

---
 include/verilated_fst_c.cpp | 3 +++
 include/verilated_trace.h   | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/include/verilated_fst_c.cpp b/include/verilated_fst_c.cpp
index 604bee57605..8c15533f761 100644
--- a/include/verilated_fst_c.cpp
+++ b/include/verilated_fst_c.cpp
@@ -230,6 +230,9 @@ void VerilatedFst::declare(uint32_t code, const char* name, int dtypenum,
     else if (kind == VerilatedTraceSigKind::TRI) varType = FST_VT_VCD_TRI;
     else if (kind == VerilatedTraceSigKind::TRI0) varType = FST_VT_VCD_TRI0;
     else if (kind == VerilatedTraceSigKind::TRI1) varType = FST_VT_VCD_TRI1;
+    else if (kind == VerilatedTraceSigKind::TRIAND) varType = FST_VT_VCD_TRIAND;
+    else if (kind == VerilatedTraceSigKind::TRIOR) varType = FST_VT_VCD_TRIOR;
+    else if (kind == VerilatedTraceSigKind::TRIREG) varType = FST_VT_VCD_TRIREG;
     else if (kind == VerilatedTraceSigKind::WIRE) varType = FST_VT_VCD_WIRE;
     //
     else if (type == VerilatedTraceSigType::INTEGER) varType = FST_VT_VCD_INTEGER;
diff --git a/include/verilated_trace.h b/include/verilated_trace.h
index 39725394dfd..3418e6e4ee7 100644
--- a/include/verilated_trace.h
+++ b/include/verilated_trace.h
@@ -77,6 +77,9 @@ enum class VerilatedTraceSigKind : uint8_t {
     TRI,
     TRI0,
     TRI1,
+    TRIAND,
+    TRIOR,
+    TRIREG,
     WIRE,
     VAR,
 };

