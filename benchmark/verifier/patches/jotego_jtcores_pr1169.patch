+// assign new_we = (is_opaque && is_not_just_a_shadow) &&
+//        (was_blank || (KEEP_OLD==0 &&
+       // ( ((is_not_just_a_shadow || was_just_a_shadow) && shade && SHADOW==1) || SHADOW==0 )));
+
+always @* begin
+    new_we = is_opaque && is_not_just_a_shadow;
+    if( KEEP_OLD==1 && !was_blank ) new_we = 0;
+end
 
 
 `ifdef SIMULATION
