From 1e491b04b1682883aa50a846058da346c192268c Mon Sep 17 00:00:00 2001
From: RafaP <rafael.paiva@jotego.es>
Date: Tue, 9 Sep 2025 18:52:07 +0200
Subject: [PATCH 2/8] minor: Regression script print help (#1176)

* Regression script: print help
---
 modules/jtframe/bin/run_regression.sh | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/modules/jtframe/bin/run_regression.sh b/modules/jtframe/bin/run_regression.sh
index f93fd928e..31afb8776 100755
--- a/modules/jtframe/bin/run_regression.sh
+++ b/modules/jtframe/bin/run_regression.sh
@@ -124,16 +124,16 @@ parse_args() {
     local_rom=false
     push=false
 
-    if [[ $# -lt 2 ]]; then
-        echo "Usage: $0 <core> <setname> [--frames <number_of_frames>] [--port <ssh_port>] [--user <sftp_user>] [--host <server_ip>] [--path REMOTE_DIR] [--check] [--local-check LOCAL_DIR] [--local-rom] [--push] [-h|--help]"
-        exit 1
-    fi
-    if [[ $1 == --help ]]; then
+    if [[ $1 == --help || $1 == -h ]]; then
         echo "Usage: $0 <core> <setname> [--frames <number_of_frames>] [--port <ssh_port>] [--user <sftp_user>] [--host <server_ip>] [--path REMOTE_DIR] [--check] [--local-check LOCAL_DIR] [--local-rom] [--push] [-h|--help]"
         echo ""
         print_help
         exit 0
     fi
+    if [[ $# -lt 2 ]]; then
+        echo "Usage: $0 <core> <setname> [--frames <number_of_frames>] [--port <ssh_port>] [--user <sftp_user>] [--host <server_ip>] [--path REMOTE_DIR] [--check] [--local-check LOCAL_DIR] [--local-rom] [--push] [-h|--help]"
+        exit 1
+    fi
     core=$1; shift
     setname=$1; shift
 
@@ -143,7 +143,7 @@ parse_args() {
         --local-check) shift; local_check=true; LOCAL_DIR="$1" ;;
         --local-rom) local_rom=true ;;
         --push) push=true ;;
-        --help)
+        -h|--help)
             echo "Usage: $0 <core> <setname> [--frames <number_of_frames>] [--port <ssh_port>] [--user <sftp_user>] [--host <server_ip>] [--path REMOTE_DIR] [--check] [--local-check LOCAL_DIR] [--local-rom] [--push] [-h|--help]"
             echo ""
             print_help

