+`ifdef SIMULATION
+reg [8:0] ln_cnt, pxl_cnt, ln_tot, pxl_tot;
+reg       hs_l, start;
+wire      cnt_check;
+
+always @(posedge clk) hs_l <= hs;
+assign cnt_check = ln_tot==pxl_tot;
+
+always @(posedge clk) begin
+    if(rst) begin
+        {ln_cnt,pxl_cnt, ln_tot, pxl_tot} <= 0;
+        start  <= 0;
