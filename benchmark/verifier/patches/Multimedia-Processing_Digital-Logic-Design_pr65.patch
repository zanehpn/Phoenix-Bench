new file mode 100644
index 00000000..9302f2b6
--- /dev/null
+++ b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/and_gate.v	
@@ -0,0 +1,7 @@
+module and_date (a, b, c);
+input a, b;
+output c;
+
+assign c = a & b;
+
+endmodule // and_date
diff --git a/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/and_gate_test.v b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/and_gate_test.v
new file mode 100644
index 00000000..7924ce58
--- /dev/null
+++ b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/and_gate_test.v	
@@ -0,0 +1,22 @@
+`timescale 1ns / 1ps
+
+module and_date_test ();
+
+reg a, b;
+wire c;
+
+and_date UUT (.a(a), .b(b), .c(c));
+
+initial begin
+  #100; a = 0; b = 0;
+  #100; a = 0; b = 1;
+  #100; a = 1; b = 0;
+  #100; {a, b} = 3;
+end
+
+initial begin
+  #500;
+    $finish;
+end
+
+endmodule // and_date_test
diff --git a/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/dreg.v b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/dreg.v
new file mode 100644
index 00000000..d1d6b28b
--- /dev/null
+++ b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/dreg.v	
@@ -0,0 +1,14 @@
+module dreg (clk, rst, d, q);
+input clk, rst, d;
+output q;
+reg q;
+
+always @ (posedge clk or posedge rst) begin
+  if (rst) begin
+    q <= 0;
+  end else begin
+    q <= d;
+  end
+end
+
+endmodule // dreg
diff --git a/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/dreg_test.v b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/dreg_test.v
new file mode 100644
index 00000000..215ef1a5
--- /dev/null
+++ b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/dreg_test.v	
@@ -0,0 +1,36 @@
+`timescale 1ns / 1ps
+
+module dreg_test ();
+  reg clk, rst, d;
+  wire q;
+
+  dreg UUT (.clk(clk), .rst(rst), .d(d), .q(q));
+
+  initial begin
+    #100; clk = 1; #100; clk = 0;
+    #100; clk = 1; #100; clk = 0;
+    #100; clk = 1; #100; clk = 0;
+    #100; clk = 1; #100; clk = 0;
+    #100; clk = 1; #100; clk = 0;
+
+  end
+
+  initial begin
+    #650; rst = 1;
+    #200; rst = 0;
+  end
+
+  initial begin
+    #250; d = 1;
+    #200; d = 0;
+    #600; d = 1;
+    #200; d = 0;
+
+  end
+
+  initial begin
+    #1300;
+      $finish;
+  end
+
+endmodule // dreg_test
diff --git a/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/drise.v b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/drise.v
new file mode 100644
index 00000000..14088d76
--- /dev/null
+++ b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/drise.v	
@@ -0,0 +1,16 @@
+module drise (clock, reset, D, T);
+input clock, reset, D;
+output T;
+reg Q;
+
+always @ (posedge clock or posedge reset) begin
+  if (reset) begin
+    Q <= 1;
+  end else begin
+    Q <= D;
+  end
+end
+
+assign T = (D & ~Q);
+
+endmodule // drise
diff --git a/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/drise_test.v b/ARM9 CPU Design With an Practice to Verilog HDL on FPGA/CH2/drise_test.v
new file mode 100644
