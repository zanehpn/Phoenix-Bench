From ad978da432566ce437c4ededef90db9653dc684a Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Fri, 27 Jun 2025 15:54:00 +0200
Subject: [PATCH 3/3] HFLIP_OFFSET at correct level. Added also for paroda

---
 cores/riders/hdl/jtriders_obj.v   | 5 +++--
 cores/riders/hdl/jtriders_video.v | 2 +-
 cores/simson/hdl/jtsimson_video.v | 2 +-
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/cores/riders/hdl/jtriders_obj.v b/cores/riders/hdl/jtriders_obj.v
index 55cf59ef5..9fd9cd7d7 100644
--- a/cores/riders/hdl/jtriders_obj.v
+++ b/cores/riders/hdl/jtriders_obj.v
@@ -18,7 +18,8 @@
 
 // 053244/5
 module jtriders_obj #(parameter
-    RAMW   = 12
+    RAMW   = 12,
+    HFLIP_OFFSET = 0
 )(
     input             rst,
     input             clk,
@@ -120,7 +121,7 @@ assign pxl     = gfx_en[3] ? {pre_pxl[8:4], pen_eff} : 9'd0;
 
 assign sorted = rom_data;
 
-jt053244 #(.HFLIP_OFFSET(10'd325)
+jt053244 #(.HFLIP_OFFSET(HFLIP_OFFSET)
     )u_scan(    // sprite logic
     .rst        ( rst       ),
     .clk        ( clk       ),
diff --git a/cores/riders/hdl/jtriders_video.v b/cores/riders/hdl/jtriders_video.v
index e3cebdebc..e564a1637 100644
--- a/cores/riders/hdl/jtriders_video.v
+++ b/cores/riders/hdl/jtriders_video.v
@@ -283,7 +283,7 @@ assign oramd = lgtnfght ? cpu_dout : oram_din;
 assign oramw = lgtnfght ? {2{cpu_we}}&~cpu_dsn : oram_we;
 assign vmux  = vrender;
 
-jtriders_obj #(.RAMW(13)) u_obj(    // sprite logic
+jtriders_obj #(.RAMW(13),.HFLIP_OFFSET(10'd325)) u_obj(    // sprite logic
     .rst        ( rst       ),
     .clk        ( clk       ),
     .pxl_cen    ( pxl_cen   ),
diff --git a/cores/simson/hdl/jtsimson_video.v b/cores/simson/hdl/jtsimson_video.v
index 7127badce..e67c97b23 100644
--- a/cores/simson/hdl/jtsimson_video.v
+++ b/cores/simson/hdl/jtsimson_video.v
@@ -202,7 +202,7 @@ jtsimson_obj #(.RAMW(ORAMW)) u_obj(    // sprite logic
     .simson     ( simson    ),
