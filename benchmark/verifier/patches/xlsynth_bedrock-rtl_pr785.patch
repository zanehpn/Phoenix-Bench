From d416a92b84c0d2d7062a91bf1124188b2cafef85 Mon Sep 17 00:00:00 2001
From: Mark Gottscho <mgottscho@openai.com>
Date: Tue, 22 Jul 2025 21:21:31 +0000
Subject: [PATCH] Change br_flow_serializer's SerializeMostSignificantFirst
 param default to 0, matching deserializer default

---
 flow/rtl/br_flow_serializer.sv | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/flow/rtl/br_flow_serializer.sv b/flow/rtl/br_flow_serializer.sv
index 168be161a..3c77add83 100644
--- a/flow/rtl/br_flow_serializer.sv
+++ b/flow/rtl/br_flow_serializer.sv
@@ -92,7 +92,7 @@ module br_flow_serializer #(
     // If 0, the least significant bits are sent first (little endian).
     // The order of bits within each flit is always the same that they
     // appear on the push interface.
-    parameter bit SerializeMostSignificantFirst = 1,
+    parameter bit SerializeMostSignificantFirst = 0,
     // If 1, assert that push_data is always known (not X) when push_valid is asserted.
     parameter bit EnableAssertPushDataKnown = 1,
     // If 1, then assert there are no valid bits asserted at the end of the test.
