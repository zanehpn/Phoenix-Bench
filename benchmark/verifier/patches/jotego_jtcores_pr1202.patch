From 5bd155f7c69ee262f30e12c3da9857e37dba81c7 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Mon, 22 Sep 2025 17:41:29 +0200
Subject: [PATCH] karnov obj: Fix for #1199

---
 cores/karnov/hdl/jtkarnov_obj.v | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/cores/karnov/hdl/jtkarnov_obj.v b/cores/karnov/hdl/jtkarnov_obj.v
index 75cde6ee1..453ebf5dc 100644
--- a/cores/karnov/hdl/jtkarnov_obj.v
+++ b/cores/karnov/hdl/jtkarnov_obj.v
@@ -50,7 +50,8 @@ reg  [ 1:0] st;
 reg         dr_draw, adv;
 wire        dr_busy;
 reg  [11:0] dr_code;
-reg  [ 8:0] dr_xpos, xpos, ypos, ydiff, vf;
+reg  [ 8:0] dr_xpos, xpos, ypos, ydiff, vf,
+            xoff, hdf;
 reg  [ 3:0] dr_ysub, dr_pal;
 reg         hflip, vflip, dr_hflip, dr_vflip;
 
@@ -60,10 +61,16 @@ always @* begin
     vf = vrender^{1'd0,{8{flip}}};
     ydiff = ypos-vf;
     match = ram_data[4] ? ydiff[8:5]==0 : ydiff[8:4]==0;
+    xoff  = flip ? 9'd24 : 9'd8;
 end
 
 always @(posedge clk) cen <= ~cen;
 
+always @(posedge clk) if(pxl_cen) begin
+    hdf <= hdump;
+    if(flip) hdf[7] <= hdump[8]^hdump[7];
+end
+
 always @* begin
     case( st )
         0: adv = !ram_data[15];
@@ -102,7 +109,7 @@ always @(posedge clk, posedge rst ) begin
                         dr_code  <= ram_data[11:0];
                         if( tall ) dr_code[0] <= vflip^ydiff[4];
                         dr_pal   <= ram_data[15:12];
-                        dr_xpos  <= xpos + (flip ? -25: -7);
+                        dr_xpos  <= xpos - xoff;
                         dr_ysub  <= ydiff[3:0];
                         dr_hflip <= hflip;
                         dr_vflip <= vflip;
@@ -127,7 +134,7 @@ jtframe_objdraw #(.HJUMP(1)) u_objdraw(
     .pxl_cen    ( pxl_cen   ),
     .hs         ( hs        ),
     .flip       ( flip      ),
-    .hdump      ( hdump     ),
+    .hdump      ( hdf       ),
 
     .draw       ( dr_draw   ),
     .busy       ( dr_busy   ),
