diff --git a/src/ControlFSM.sv b/src/ControlFSM.sv
index de2e467..95b516d 100644
--- a/src/ControlFSM.sv
+++ b/src/ControlFSM.sv
@@ -38,6 +38,11 @@ module ControlFSM(
 	parameter MEMWB = 4'b1001;
 	parameter BRANCHIFEQ = 4'b1010;
 
+	//new states for lui and auipc
+	parameter LUI = 4'b1011;
+	parameter AUIPC = 4'b1100;
+
+
 	//declare state registers
 	reg [3:0] current_state, next_state;
 
@@ -60,10 +65,18 @@ module ControlFSM(
 
 				else if (opcode == BType) next_state = BRANCHIFEQ;
 
+				else if (opcode == UType_auipc) next_state = AUIPC;
+
+				else if (opcode == UType_lui) next_state = LUI;
+
 				else next_state = DECODE;
 
 			end
 
+			AUIPC: next_state = ALUWB;
+
+			LUI: next_state = ALUWB;
+
 			UNCONDJUMP: next_state = ALUWB;
 
 			EXECUTER: next_state = ALUWB;
@@ -123,6 +136,22 @@ module ControlFSM(
 
 			end
 
+			AUIPC: begin
+				
+				ALUSrcA <= ALU_SRC_A__OLD_PC;
+				ALUSrcB <= ALU_SRC_B__IMM_EXT;
+				ALUOp <= 2'b00;
+
+			end
+
+			LUI: begin
+				
+				ALUSrcA <= ALU_SRC_A__ZERO;
+				ALUSrcB <= ALU_SRC_B__IMM_EXT;
+				ALUOp <= 2'b00;
+
+			end
+
 			EXECUTER: begin
 
 				ALUSrcA <= ALU_SRC_A__RD1;
diff --git a/src/Instruction_Decode/Instruction_Decode.v b/src/Instruction_Decode/Instruction_Decode.v
index 340183b..c2fa6ad 100644
--- a/src/Instruction_Decode/Instruction_Decode.v
+++ b/src/Instruction_Decode/Instruction_Decode.v
@@ -117,6 +117,9 @@ module Instruction_Decode(
 			SType       : imm_ext = {{20{instr[31]}}, instr[31:25], instr[11:7]};
 			BType       : imm_ext = {{20{instr[31]}}, instr[7], instr[30:25], instr[11:8], 1'b0};
 			JType       : imm_ext = {{12{instr[31]}}, instr[19:12], instr[20], instr[30:21], 1'b0};
+			UType_auipc	: imm_ext = {instr[31:12], 12'b0};
+			UType_lui	: imm_ext = {instr[31:12], 12'b0};
+			
 		endcase
 	end
 
diff --git a/src/params.vh b/src/params.vh
index f484b69..2c766c2 100644
--- a/src/params.vh
+++ b/src/params.vh
