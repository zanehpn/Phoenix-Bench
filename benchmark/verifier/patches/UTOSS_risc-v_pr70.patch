From 500e797de28c266b7eae21ccc2c002e1d5fc2af3 Mon Sep 17 00:00:00 2001
From: zerotoasic <zerotoasic@zerotoasic.vm.com>
Date: Fri, 3 Oct 2025 23:03:18 +0200
Subject: [PATCH 4/5] Fix the NOP tb issue

---
 Makefile                              | 4 ++--
 src/Instruction_Decode/RegisterFile.v | 4 ++--
 test/nop_tb.sv                        | 8 ++++----
 3 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/Makefile b/Makefile
index b0aefca..1f468dc 100644
--- a/Makefile
+++ b/Makefile
@@ -1,8 +1,8 @@
 SRC_DIR  := src
 OUTPUT 	 := out/top.vvp
-IVERILOG := iverilog
+IVERILOG := /opt/iverilog-12/bin/iverilog
 # /opt/iverilog-12/bin/iverilog
-VVP 		 := vvp
+VVP 		 := /opt/iverilog-12/bin/vvp
 # /opt/iverilog-12/bin/vvp
 
 SRCS := $(shell find $(SRC_DIR) -name "*.sv" -o -name "*.v")
diff --git a/src/Instruction_Decode/RegisterFile.v b/src/Instruction_Decode/RegisterFile.v
index c43b6c4..b628016 100644
--- a/src/Instruction_Decode/RegisterFile.v
+++ b/src/Instruction_Decode/RegisterFile.v
@@ -27,8 +27,8 @@ output wire [31:0] writeData //data read line #2 - from second source register
 	//note that RFMem[0:31] means there are 32 elements (with addr for each element), each of which are 32-bit regs
 	reg [31:0] RFMem [0:31] /* synthesis ramstyle = M10K*/;
 
-	assign baseAddr = RFMem[Addr1]; //read out 32-bit contents of rs1 register
-	assign writeData = RFMem[Addr2]; //read out 32-bit contents of rs2 register
+	assign baseAddr  = (Addr1 == 5'd0) ? 32'd0 : RFMem[Addr1]; // x0 always 0, read out 32-bit contents of rs1 register
+    assign writeData = (Addr2 == 5'd0) ? 32'd0 : RFMem[Addr2]; // x0 always 0 on read, read out 32-bit contents of rs2 register
 
 	always@(posedge clk) begin
 
diff --git a/test/nop_tb.sv b/test/nop_tb.sv
index ff12943..e5e8c26 100644
--- a/test/nop_tb.sv
+++ b/test/nop_tb.sv
@@ -30,7 +30,7 @@ module nop_tb;
         uut.memory.M[0] = 32'h00000013; //NOP instruction - addi x0, x0, 0
 
         // set up register file to a known value
-        uut.instruction_decode.instanceRegFile.RFMem[0] = 32'h01010101; // x0
+        uut.instruction_decode.instanceRegFile.RFMem[0] = 32'h01010101; // x0, and it should still be 0 even we try to write it as 0
 
         //wait until reset makes FSM go to fetch state
         wait_till_next_cfsm_state(uut.control_fsm.FETCH);
@@ -45,14 +45,14 @@ module nop_tb;
         `assert_equal(uut.instruction_decode.imm_ext, 0)
 
         wait_till_next_cfsm_state(uut.control_fsm.EXECUTEI);
-        `assert_equal(uut.alu.a, 32'h01010101)
+        `assert_equal(uut.alu.a, 32'h0)
         `assert_equal(uut.alu.b, 0)
-        `assert_equal(uut.alu.out, 32'h01010101)
+        `assert_equal(uut.alu.out, 32'h0)
 
         wait_till_next_cfsm_state(uut.control_fsm.ALUWB);
 
         wait_till_next_cfsm_state(uut.control_fsm.FETCH);
-        `assert_equal(uut.instruction_decode.instanceRegFile.RFMem[0], 32'h01010101)
+        `assert_equal(uut.instruction_decode.instanceRegFile.RFMem[0], 32'h0)
         `assert_equal(uut.fetch.pc_cur, 4)
 
         $finish;

