From 46c5ad30fa6e1906a94718c9b7ed9e434badcf5d Mon Sep 17 00:00:00 2001
From: Yvan Tortorella <ytortorella@lagrev3.ee.ethz.ch>
Date: Fri, 12 May 2023 18:18:50 +0200
Subject: [PATCH] Removed AND between input ready and valid to solve timing
 loops.

---
 src/reg_to_tlul.sv | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/reg_to_tlul.sv b/src/reg_to_tlul.sv
index d1dd15e..94bf2f1 100644
--- a/src/reg_to_tlul.sv
+++ b/src/reg_to_tlul.sv
@@ -28,7 +28,7 @@ module reg_to_tlul #(
 );
 
 
-  assign tl_o.a_valid    = reg_req_i.valid & tl_i.a_ready;
+  assign tl_o.a_valid    = reg_req_i.valid;
   assign tl_o.a_opcode   = reg_req_i.write ? PutFullData : Get;
   assign tl_o.a_param    = '0;
   assign tl_o.a_size     = 'h2;
