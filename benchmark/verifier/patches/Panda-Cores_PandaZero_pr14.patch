diff --git a/tests/rtl/common/testbench.h b/tests/rtl/common/testbench.h
index 9ced6e3..698bf44 100644
--- a/tests/rtl/common/testbench.h
+++ b/tests/rtl/common/testbench.h
@@ -6,8 +6,8 @@ vluint64_t main_time = 0;       // Current simulation time
 // used in Verilog (or from --timescale-override)
 
