+  , .rd2              ( rd2              )
+  , .result           ( result           )
+  , .regWrite         ( cfsm__reg_write  )
   );
   
 endmodule

From dfe9b8b57ebb87a82ddc28e3e328cdbdd465cf85 Mon Sep 17 00:00:00 2001
From: marwannismail <marwan.ismail2004@gmail.com>
Date: Sun, 2 Nov 2025 20:52:54 -0500
Subject: [PATCH 4/8] Formatting for memory address

---
 src/Logger.sv | 4 ++--
