-    SType:         complete_instruction = {operation, " ", source_register2, ", ", $sformatf("%0h", imm_ext), "(", source_register1, ")"};
-    BType:         complete_instruction = {operation, " ", source_register1, ", ", source_register2, ", 0x", $sformatf("%0h", imm_ext)};
