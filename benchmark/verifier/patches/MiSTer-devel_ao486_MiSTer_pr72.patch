From b26fc4f81ab76aacab282fd81c8a8964eb18a554 Mon Sep 17 00:00:00 2001
From: Vincent Pelletier <plr.vincent@gmail.com>
Date: Sun, 23 May 2021 17:08:14 +0000
Subject: [PATCH] soc/joystick: Produce infinite axis timeout on unseen
 joysticks.

Should prevent games from assuming there is a joystick plugged in until
the core is aware of one being actually present.
Detect a joystick presence by any button being pressed, or any axis being
pushed outside of the center deadzone, and remember presence until reset.
---
 rtl/soc/joystick.v | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/rtl/soc/joystick.v b/rtl/soc/joystick.v
index 310df18..744a646 100644
--- a/rtl/soc/joystick.v
+++ b/rtl/soc/joystick.v
@@ -124,6 +124,7 @@ reg       gravis_clk = 0;
 always @(posedge clk) begin : joy_block
 	reg [4:0] gravis_pos;
 	reg use_dpad1, use_dpad2;
+	reg seen_joy1, seen_joy2;
 
 	if (!rst_n) begin
 		JOY1_X <= 128;
@@ -136,6 +137,8 @@ always @(posedge clk) begin : joy_block
 		{jb1, jb2, jb3, jb4} <= 4'b1111;
 		use_dpad1 <= 1;
 		use_dpad2 <= 1;
+		seen_joy1 <= 0;
+		seen_joy2 <= 0;
 	end
 	else begin
 		jb1 <= mode == 2 ? gravis_clk : !JOY1_BUT1;
@@ -177,17 +180,19 @@ always @(posedge clk) begin : joy_block
 		CLK_DIV <= CLK_DIV + 1'b1;
 		if (CLK_DIV==100) begin
 			CLK_DIV <= 0;
-			if (JOY1_X) JOY1_X <= JOY1_X - 1'b1;
-			if (JOY1_Y) JOY1_Y <= JOY1_Y - 1'b1;
-			if (JOY2_X) JOY2_X <= JOY2_X - 1'b1;
-			if (JOY2_Y) JOY2_Y <= JOY2_Y - 1'b1;
+			if (seen_joy1 && JOY1_X) JOY1_X <= JOY1_X - 1'b1;
+			if (seen_joy1 && JOY1_Y) JOY1_Y <= JOY1_Y - 1'b1;
+			if (seen_joy2 && JOY2_X) JOY2_X <= JOY2_X - 1'b1;
+			if (seen_joy2 && JOY2_Y) JOY2_Y <= JOY2_Y - 1'b1;
 		end
 
 		if((ana_1[7:0] > 60 && ana_1[7:0] < 196) || (ana_1[15:8] > 60 && ana_1[15:8] < 196)) use_dpad1 <= 0;
 		else if(dig_1[3:0]) use_dpad1 <= 1;
+		seen_joy1 <= seen_joy1 || ~use_dpad1 || dig_1;
 
 		if((ana_2[7:0] > 60 && ana_2[7:0] < 196) || (ana_2[15:8] > 60 && ana_2[15:8] < 196)) use_dpad2 <= 0;
 		else if(dig_2[3:0]) use_dpad2 <= 1;
+		seen_joy2 <= seen_joy2 || ~use_dpad2 || dig_2;
 
 		if (write) begin
 			JOY1_X <= ~use_dpad1 ? {~ana_1[7],  ana_1[6:0]}  : JOY1_LEFT  ? 8'd4 : JOY1_RIGHT ? 8'd252 : 8'd128;
