diff --git a/src/gpio/fpga/bit2bin.bif b/src/gpio/fpga/bit2bin.bif
new file mode 100644
index 00000000..df3de64e
--- /dev/null
+++ b/src/gpio/fpga/bit2bin.bif
@@ -0,0 +1,6 @@
+the_ROM_image:
+{
+	[bootloader]dummy.elf
+	./system.runs/impl_1/system_wrapper.bit
+}
+
diff --git a/src/gpio/fpga/build.sh b/src/gpio/fpga/build.sh
new file mode 100755
index 00000000..da2dc345
--- /dev/null
+++ b/src/gpio/fpga/build.sh
@@ -0,0 +1,15 @@
+#!/bin/bash
+
+#clean up
+rm system_wrapper.bit.bin bit2bin.bin
+
+#package IP
+vivado -mode batch -source package.tcl
+
+#create bit stream
+vivado -mode batch -source run.tcl
+
+#xilinx stuff...
+bootgen -image bit2bin.bif -split bin 
+cp system_wrapper.bit.bin parallella.bit.bin
+
