From de8d7b71322b168171b443f77bf6fcb72d6cb2da Mon Sep 17 00:00:00 2001
From: Ola Jeppsson <ola@adapteva.com>
Date: Thu, 28 Apr 2016 00:35:38 +0200
Subject: [PATCH] GPIO: Fix hardcoded address width

Use parameter value (which can be smaller).

Signed-off-by: Ola Jeppsson <ola@adapteva.com>
---
 src/gpio/hdl/gpio.v | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/gpio/hdl/gpio.v b/src/gpio/hdl/gpio.v
index a2ccd016..cd34b63e 100644
--- a/src/gpio/hdl/gpio.v
+++ b/src/gpio/hdl/gpio.v
@@ -223,7 +223,7 @@ module gpio #(
 		   .clk			(clk),
 		   .access_in		(access_in),
 		   .packet_in		(packet_in[PW-1:0]),
-		   .read_data		(read_data[63:0]),
+		   .read_data		(read_data[AW-1:0]),
 		   .wait_in		(wait_in));
    
 endmodule // gpio
