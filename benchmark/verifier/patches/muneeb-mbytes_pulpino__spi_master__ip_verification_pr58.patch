-              data_ready    = 1'b1;
-            end else begin
-              clk_en_o = 1'b0;
-              tx_NS    = IDLE;
-            end
-          end
-        end
-      end
-    endcase
-  end
-
-  always_ff @(posedge clk, negedge rstn)
-  begin
-    if (~rstn)
-    begin
-      counter      <= 0;
-      counter_trgt <= 'h8;
-      data_int     <= 'h0;
