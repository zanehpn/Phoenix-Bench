+
+
+  //-------------------------------------------------------
+  // SPIADDR
+  //-------------------------------------------------------
+  
+  begin
+    bit [31:0] spi_adr;
+    spi_adr = 32'h1a1f_fa11;
+    wdata = 0;
+    wdata = (wdata & (~ `MASK_SPIADR_SPIADR)) | (spi_adr << `POS_SPIADR_SPIADR);
+  end
+  
+  //Writing into the SPI_ADDR Register
