From: Muneeb <muneebullashariff@gmail.com>
Date: Mon, 28 Feb 2022 15:40:48 +0530
Subject: [PATCH 1/5] Has the fix for slave driver bfm

---
 .../spi_slave_agent_bfm/spi_slave_driver_bfm.sv        | 10 ++++++++--
 .../spi_slave_agent_bfm/spi_slave_monitor_bfm.sv       |  3 +++
 .../hvl_top/spi_slave_agent/spi_slave_monitor_proxy.sv |  3 +++
 3 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/dv/hdl_top/spi_slave_agent_bfm/spi_slave_driver_bfm.sv b/src/dv/hdl_top/spi_slave_agent_bfm/spi_slave_driver_bfm.sv
index ff61b8b..8385d33 100644
--- a/src/dv/hdl_top/spi_slave_agent_bfm/spi_slave_driver_bfm.sv
+++ b/src/dv/hdl_top/spi_slave_agent_bfm/spi_slave_driver_bfm.sv
@@ -133,16 +133,22 @@ interface spi_slave_driver_bfm(input pclk, input areset,
           // Driving MISO at posedge of sclk for CPOL=1 and CPHA=1
           miso0 <= data_packet.master_in_slave_out[row_no][bit_no];
           data_packet.no_of_miso_bits_transfer++;
+          `uvm_info("DEBUG MISO0 spi_slave_driver_bfm",$sformatf("miso=\n %0p",miso0),UVM_HIGH)
+          `uvm_info("DEBUG MISO TRANSFER COUNT spi_slave_driver_bfm",$sformatf("miso count=\n %0d",
+          data_packet.no_of_miso_bits_transfer),UVM_HIGH)
 
           detect_sclk();
           if(end_of_transfer) break; 
 
           // Sampling MOSI at posedge of sclk for CPOL=0 and CPHA=1  OR
           // Sampling MOSI at negedge of sclk for CPOL=1 and CPHA=1
-          detect_sclk();
-          if(end_of_transfer) break; 
           data_packet.master_out_slave_in[row_no][bit_no] = mosi0;
           data_packet.no_of_mosi_bits_transfer++;
+          `uvm_info("DEBUG MOSI spi_slave_driver_bfm",$sformatf("mosi=\n %0p",mosi0),UVM_HIGH)
+          `uvm_info("DEBUG MOSI TRANSFER COUNT spi_slave_driver_bfm",$sformatf("mosi count=\n %0d",
+          data_packet.no_of_mosi_bits_transfer),UVM_HIGH)
+          detect_sclk();
+          if(end_of_transfer) break; 
         
         end
 
diff --git a/src/dv/hdl_top/spi_slave_agent_bfm/spi_slave_monitor_bfm.sv b/src/dv/hdl_top/spi_slave_agent_bfm/spi_slave_monitor_bfm.sv
index c525a11..9151bcd 100644
--- a/src/dv/hdl_top/spi_slave_agent_bfm/spi_slave_monitor_bfm.sv
+++ b/src/dv/hdl_top/spi_slave_agent_bfm/spi_slave_monitor_bfm.sv
@@ -161,6 +161,9 @@ interface spi_slave_monitor_bfm(input pclk, input areset,
 
           data_packet.master_out_slave_in[row_no][bit_no] = mosi0;
           data_packet.no_of_mosi_bits_transfer++;
+          `uvm_info("DEBUG MOSI spi_monitor_driver_bfm",$sformatf("mosi=\n %0p",mosi0),UVM_HIGH)
+          `uvm_info("DEBUG MOSI TRANSFER COUNT spi_monitor_driver_bfm",$sformatf("mosi count=\n %0d",
+          data_packet.no_of_mosi_bits_transfer),UVM_HIGH)
 
           data_packet.master_in_slave_out[row_no][bit_no] = miso0;
           data_packet.no_of_miso_bits_transfer++;
diff --git a/src/dv/hvl_top/spi_slave_agent/spi_slave_monitor_proxy.sv b/src/dv/hvl_top/spi_slave_agent/spi_slave_monitor_proxy.sv
index ee7c5a3..584bc01 100644
--- a/src/dv/hvl_top/spi_slave_agent/spi_slave_monitor_proxy.sv
+++ b/src/dv/hvl_top/spi_slave_agent/spi_slave_monitor_proxy.sv
@@ -251,6 +251,9 @@ task spi_slave_monitor_proxy::run_phase(uvm_phase phase);
 
     spi_slave_mon_bfm_h.sample_data(struct_packet, struct_cfg);
 
+    `uvm_info(get_type_name(),$sformatf("Received struct from spi_slave MONITOR BFM : , \n %p",
+                                        struct_packet),UVM_HIGH)
+
     spi_slave_seq_item_converter::to_class(struct_packet, spi_slave_packet);
 
     `uvm_info(get_type_name(),$sformatf("Received packet from spi_slave MONITOR BFM : , \n %s",

