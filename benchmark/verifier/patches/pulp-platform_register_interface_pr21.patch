From b92e60c90305c3085933bdf774922b548d86f22d Mon Sep 17 00:00:00 2001
From: davide schiavone <davide@openhwgroup.org>
Date: Wed, 7 Sep 2022 15:04:39 +0200
Subject: [PATCH 1/2] add reg to tlul

---
 Bender.yml         |  1 +
 src/reg_to_tlul.sv | 39 +++++++++++++++++++++++++++++++++++++++
 src_files.yml      |  1 +
 3 files changed, 41 insertions(+)
 create mode 100644 src/reg_to_tlul.sv

diff --git a/Bender.yml b/Bender.yml
index 0043b90..bad5df2 100644
--- a/Bender.yml
+++ b/Bender.yml
@@ -23,6 +23,7 @@ sources:
   - src/reg_mux.sv
   - src/reg_to_mem.sv
   - src/reg_uniform.sv
+  - src/reg_to_tlul.sv
   - vendor/lowrisc_opentitan/src/prim_subreg_shadow.sv
   - vendor/lowrisc_opentitan/src/prim_subreg.sv
   # Level 2
diff --git a/src/reg_to_tlul.sv b/src/reg_to_tlul.sv
new file mode 100644
index 0000000..7036609
--- /dev/null
+++ b/src/reg_to_tlul.sv
@@ -0,0 +1,39 @@
+// Copyright 2022 OpenHW Group
+// Solderpad Hardware License, Version 2.1, see LICENSE.md for details.
+// SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
+
+/**
+ * Reg Interface to Tile-Link
+ */
+
+module reg_to_tlul
+  import tlul_pkg::*;
+  import reg_pkg::*;
+(
+    // TL-UL interface
+    output tl_h2d_t tl_o,
+    input  tl_d2h_t tl_i,
+
+    // Register interface
+    input  reg_req_t reg_req_i,
+    output reg_rsp_t reg_rsp_o
+);
+
+
+  assign tl_o.a_valid    = reg_req_i.valid & tl_i.a_ready;
+  assign tl_o.a_opcode   = reg_req_i.write ? PutFullData : Get;
+  assign tl_o.a_param    = '0;
+  assign tl_o.a_size     = 'h2;
+  assign tl_o.a_source   = '0;
+  assign tl_o.a_address  = reg_req_i.addr;
+  assign tl_o.a_mask     = reg_req_i.wstrb;
+  assign tl_o.a_data     = reg_req_i.wdata;
+  assign tl_o.a_user     = tlul_pkg::TL_A_USER_DEFAULT;
+  assign tl_o.d_ready    = 1'b1;
+
+  assign reg_rsp_o.ready = tl_i.d_valid & tl_o.d_ready;
+  assign reg_rsp_o.rdata = tl_i.d_data;
+  assign reg_rsp_o.error = tl_i.d_error;
+
+
+endmodule
diff --git a/src_files.yml b/src_files.yml
index 160a0a4..d503436 100644
--- a/src_files.yml
+++ b/src_files.yml
@@ -19,6 +19,7 @@ register_interface:
     - src/reg_mux.sv
     - src/reg_to_mem.sv
     - src/reg_uniform.sv
+    - src/reg_to_tlul.sv
     # Level 2
     - src/axi_lite_to_reg.sv
 

