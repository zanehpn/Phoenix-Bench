From 4f493b2c7cb4553b81aaeff488dee30891a8ab7e Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Tue, 5 Nov 2024 15:28:31 +0100
Subject: [PATCH] Removed horizontal delay in jtframe_tilemap when flip==1

---
 modules/jtframe/hdl/video/jtframe_tilemap.v | 1 -
 1 file changed, 1 deletion(-)

diff --git a/modules/jtframe/hdl/video/jtframe_tilemap.v b/modules/jtframe/hdl/video/jtframe_tilemap.v
index a6fc1cb9a..e091386fd 100644
--- a/modules/jtframe/hdl/video/jtframe_tilemap.v
+++ b/modules/jtframe/hdl/video/jtframe_tilemap.v
@@ -83,7 +83,6 @@ assign veff = FLIP_VDUMP ? vdump ^ { FLIP_MSB[0]&flip, {8{flip}}} : vdump;
 always @* begin
     hoff = hdump - HDUMP_OFFSET[8:0];
     heff = FLIP_HDUMP ? hoff ^ {9{flip}} : hoff;
-    if( flip ) heff = heff - 9'd7;
 end
 
 initial begin
