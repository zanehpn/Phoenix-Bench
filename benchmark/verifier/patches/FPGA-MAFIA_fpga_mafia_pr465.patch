+    next_csr             = csr;
+    CsrMstatusMieBit     = 0; 
+    CsrMieMieBit         = 0;
+    TimerInterruptEnable = 0;
+    //==========================================================================
+    // RW/V -> HW updates (may be overwritten by SW writes)
