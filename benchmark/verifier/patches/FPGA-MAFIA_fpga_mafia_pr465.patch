+        next_csr.csr_mip     = 32'h80;
+        CsrMstatusMieBit     = csr.csr_mstatus[3]; 
+        CsrMieMieBit         = csr.csr_mie[7];
+        TimerInterruptEnable = CsrMstatusMieBit & CsrMieMieBit;
+    end
+    
+    //==========================================================================   
