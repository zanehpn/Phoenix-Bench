+      10'b0000000111: o_lut = 11'b11101000111;  // D.07.0, RDin = -1, RDout = +1
+      10'b0000001000: o_lut = 11'b00010100111;  // D.08.0, RDin = -1, RDout = -1
+      10'b0000001001: o_lut = 11'b11101101001;  // D.09.0, RDin = -1, RDout = +1
