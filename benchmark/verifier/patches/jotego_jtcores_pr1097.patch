From 6d8d6c7100fc58bad7f5c6ca9338e09eb381f6b2 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Fri, 20 Jun 2025 12:25:20 +0200
Subject: [PATCH 1/6] riders: Lgtnfght uses full 16kB for objects. Scenes
 working well with objects

---
 cores/riders/cfg/macros.def             | 2 +-
 cores/riders/hdl/jtriders_dump.v        | 2 +-
 cores/riders/ver/game/dump_split.sh     | 4 ++--
 cores/riders/ver/lgtnfght/dump_split.sh | 1 +
 cores/riders/ver/lgtnfght/sim.sh        | 1 +
 5 files changed, 6 insertions(+), 4 deletions(-)
 create mode 120000 cores/riders/ver/lgtnfght/dump_split.sh
 create mode 120000 cores/riders/ver/lgtnfght/sim.sh

diff --git a/cores/riders/cfg/macros.def b/cores/riders/cfg/macros.def
index 014e00940..2c478b20b 100644
--- a/cores/riders/cfg/macros.def
+++ b/cores/riders/cfg/macros.def
@@ -23,7 +23,7 @@ SND_RAMW=11
 
 # default EEPROM needed to prevent game from booting upside down with error
 JTFRAME_IOCTL_RD=128
-debug JTFRAME_IOCTL_RD+=28705
+debug JTFRAME_IOCTL_RD+=36897
 
 # But MiST/SiDi cannot handle that much
 [mist|sidi]
diff --git a/cores/riders/hdl/jtriders_dump.v b/cores/riders/hdl/jtriders_dump.v
index 6047f3f67..84c9c9274 100644
--- a/cores/riders/hdl/jtriders_dump.v
+++ b/cores/riders/hdl/jtriders_dump.v
@@ -42,7 +42,7 @@ parameter FULLRAM = 0;
 `ifndef JTFRAME_RELEASE
 localparam SCR_END  = FULLRAM==1 ? 16'h6000 : 16'h4000,
            PAL_END  = SCR_END +16'h1000,
-           OBJ_END  = PAL_END +16'h2000,
+           OBJ_END  = PAL_END +16'h4000,
            PMMR_END = OBJ_END +16'h0010,
            SMMR_END = PMMR_END+16'h0008,
            OMMR_END = SMMR_END+16'h0008;
diff --git a/cores/riders/ver/game/dump_split.sh b/cores/riders/ver/game/dump_split.sh
index fb7542562..2770dbb61 100755
--- a/cores/riders/ver/game/dump_split.sh
+++ b/cores/riders/ver/game/dump_split.sh
@@ -58,8 +58,8 @@ if [ $FULLRAM = 1 ]; then
 	dd if=$TMP  of=scrx.bin    count=16 skip=$SKIP      2> /dev/null; SKIP=$((SKIP +16))   # 8kB
 fi
 dd if=$TMP      of=pal.bin     count=8  skip=$SKIP      2> /dev/null; SKIP=$((SKIP +8 ))   # 4kB
-dd if=$TMP      of=obj.bin     count=16 skip=$SKIP      2> /dev/null; SKIP=$((SKIP +16))   # 8kB
-dd if=/dev/zero of=obj.bin     count=16 conv=notrunc oflag=append 2> /dev/null; SKIP=$((SKIP*512/8)) # 8kB blank
+dd if=$TMP      of=obj.bin     count=32 skip=$SKIP      2> /dev/null; SKIP=$((SKIP +32))   # 16kB
+SKIP=$((SKIP*512/8))
 # MMR
 dd if=$TMP of=pal_mmr.bin bs=8 count=2  skip=$SKIP      2> /dev/null; SKIP=$((SKIP +2))
 dd if=$TMP of=scr_mmr.bin bs=8 count=1  skip=$SKIP      2> /dev/null; SKIP=$((SKIP +1))
diff --git a/cores/riders/ver/lgtnfght/dump_split.sh b/cores/riders/ver/lgtnfght/dump_split.sh
new file mode 120000
index 000000000..029f5dcc7
--- /dev/null
+++ b/cores/riders/ver/lgtnfght/dump_split.sh
@@ -0,0 +1 @@
+../game/dump_split.sh
\ No newline at end of file
diff --git a/cores/riders/ver/lgtnfght/sim.sh b/cores/riders/ver/lgtnfght/sim.sh
new file mode 120000
index 000000000..e29081dc8
--- /dev/null
+++ b/cores/riders/ver/lgtnfght/sim.sh
@@ -0,0 +1 @@
+../ssriders/sim.sh
\ No newline at end of file

