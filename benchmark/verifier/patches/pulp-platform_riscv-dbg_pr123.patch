From 6c0703eae20224a2ec5e52a765aec4a02f97a259 Mon Sep 17 00:00:00 2001
From: Manuel Eggimann <meggimann@iis.ee.ethz.ch>
Date: Fri, 1 Apr 2022 17:48:13 +0200
Subject: [PATCH 09/11] Make dmi_rst_ni synchronous in dm_csrs & filter
 glitches on dmi_rst_no

The dmi_rst_ni signal of dm_top was previously asynchronously resetting the
response FIFO within dm_csrs. In this commit this behavior changed to make the
dmi_rst_ni a synchronous clear signal that flushes the FIFO. That way,
power-on-reset and functional resets are orthogonal to each other. Still, since
the (undocumented) semantic of the dmi_rst_no signal changed, this commit also
adds a glitch filter on the dmi_rst_no signal to make it a glitch free
core_clock synchronous signal. That way, it is safe to use the dmi_rst_no signal
as either an async or a synchronous reset signal for the core clock domain.
---
 src/dm_csrs.sv      | 10 ++++++----
 src/dm_top.sv       |  4 +++-
 src/dmi_cdc.sv      | 31 +++++++++++++++++++++++++++++--
 src/dmi_jtag.sv     |  7 ++++---
 src/dmi_jtag_tap.sv | 13 ++++++++++---
 5 files changed, 52 insertions(+), 13 deletions(-)

diff --git a/src/dm_csrs.sv b/src/dm_csrs.sv
index f742a2b..350c6c5 100644
--- a/src/dm_csrs.sv
+++ b/src/dm_csrs.sv
@@ -23,7 +23,8 @@ module dm_csrs #(
   input  logic                              clk_i,           // Clock
   input  logic                              rst_ni,          // Asynchronous reset active low
   input  logic                              testmode_i,
-  input  logic                              dmi_rst_ni,      // Debug Module Intf reset active-low
+  input  logic                              dmi_rst_ni,      // sync. DTM reset,
+                                                             // active-low
   input  logic                              dmi_req_valid_i,
   output logic                              dmi_req_ready_o,
   input  dm::dmi_req_t                      dmi_req_i,
@@ -559,9 +560,10 @@ module dm_csrs #(
     .dtype            ( logic [31:0]         ),
     .DEPTH            ( 2                    )
   ) i_fifo (
-    .clk_i            ( clk_i                ),
-    .rst_ni           ( dmi_rst_ni           ), // reset only when system is re-set
-    .flush_i          ( 1'b0                 ), // we do not need to flush this queue
+    .clk_i,
+    .rst_ni,
+    .flush_i          ( ~dmi_rst_ni          ), // Flush the queue if the DTM is
+                                                // reset
     .testmode_i       ( testmode_i           ),
     .full_o           ( resp_queue_full      ),
     .empty_o          ( resp_queue_empty     ),
diff --git a/src/dm_top.sv b/src/dm_top.sv
index ce71d07..3c9c445 100644
--- a/src/dm_top.sv
+++ b/src/dm_top.sv
@@ -57,7 +57,9 @@ module dm_top #(
   input  logic [BusWidth-1:0]   master_r_rdata_i,
 
   // Connection to DTM - compatible to RocketChip Debug Module
-  input  logic                  dmi_rst_ni,
+  input  logic                  dmi_rst_ni, // Synchronous clear request from
+                                            // the DTM to clear the DMI response
+                                            // FIFO.
   input  logic                  dmi_req_valid_i,
   output logic                  dmi_req_ready_o,
   input  dm::dmi_req_t          dmi_req_i,
diff --git a/src/dmi_cdc.sv b/src/dmi_cdc.sv
index 91ff3ca..f9d66fd 100644
--- a/src/dmi_cdc.sv
+++ b/src/dmi_cdc.sv
@@ -35,6 +35,7 @@ module dmi_cdc (
   input  logic             clk_i,
   input  logic             rst_ni,
 
+  output logic             core_dmi_rst_no,
   output dm::dmi_req_t     core_dmi_req_o,
   output logic             core_dmi_valid_o,
   input  logic             core_dmi_ready_i,
@@ -44,7 +45,7 @@ module dmi_cdc (
   input  logic             core_dmi_valid_i
 );
 
-
+  logic                    core_clear_pending;
 
   cdc_2phase_clearable #(.T(dm::dmi_req_t)) i_cdc_req (
     .src_rst_ni  ( trst_ni              ),
@@ -58,7 +59,10 @@ module dmi_cdc (
     .dst_rst_ni  ( rst_ni               ),
     .dst_clear_i ( 1'b0                 ), // No functional reset from core side
                                            // used (only async).
-    .dst_clear_pending_o(), // Not used
+    .dst_clear_pending_o( core_clear_pending ), // use the clear pending signal
+                                                // to synchronously clear the
+                                                // response FIFO in the dm_top
+                                                // csrs
     .dst_clk_i   ( clk_i                ),
     .dst_data_o  ( core_dmi_req_o       ),
     .dst_valid_o ( core_dmi_valid_o     ),
@@ -84,4 +88,27 @@ module dmi_cdc (
     .dst_ready_i ( jtag_dmi_ready_i     )
   );
 
+  // We need to flush the DMI response FIFO in DM top using the core clock
+  // synchronous clear signal core_dmi_rst_no. We repurpose the clear
+  // pending signal in the core clock domain by generating a 1 cycle pulse from
+  // it.
+
+  logic                    core_clear_pending_q;
+  logic                    core_dmi_rst_nq;
+  logic                    clear_pending_rise_edge_detect;
+
+  assign clear_pending_rise_edge_detect = !core_clear_pending_q && core_clear_pending;
+
+  always_ff @(posedge clk_i, negedge rst_ni) begin
+    if (!rst_ni) begin
+      core_dmi_rst_nq       <= 1'b1;
+      core_clear_pending_q <= 1'b0;
+    end else begin
+      core_dmi_rst_nq       <= ~clear_pending_rise_edge_detect; // active-low!
+      core_clear_pending_q <= core_clear_pending;
+    end
+  end
+
+  assign core_dmi_rst_no = core_dmi_rst_nq;
+
 endmodule : dmi_cdc
