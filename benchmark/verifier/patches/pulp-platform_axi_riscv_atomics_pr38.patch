   parameter type          axi_req_t       = logic,
   parameter type          axi_rsp_t       = logic
 ) (
@@ -64,19 +65,20 @@ module axi_riscv_atomics_structs #(
   `AXI_ASSIGN_FROM_RESP(mst, axi_mst_rsp_i)
 
   axi_riscv_atomics_wrap #(
