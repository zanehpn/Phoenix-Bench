From 591bdecd4665cd06876353e6338d2f406e97a2c4 Mon Sep 17 00:00:00 2001
From: Greg Taylor <gtaylor@sonic.net>
Date: Sun, 23 Feb 2025 18:34:27 -0500
Subject: [PATCH] fix envelope RELEASE state on reset

---
 rtl/soc/sound/opl3/control_operators.sv  | 35 ++++++++++++++++++++----
 rtl/soc/sound/opl3/envelope_generator.sv |  8 ++----
 2 files changed, 31 insertions(+), 12 deletions(-)

diff --git a/rtl/soc/sound/opl3/control_operators.sv b/rtl/soc/sound/opl3/control_operators.sv
index c7ca7fe..451c2eb 100755
--- a/rtl/soc/sound/opl3/control_operators.sv
+++ b/rtl/soc/sound/opl3/control_operators.sv
@@ -313,15 +313,38 @@ module control_operators
         .dob(fnum[7:0])
     );
 
-    localparam kon_block_fnum_high_mem_width = $bits(kon) + $bits(block) + $bits(fnum[9:8]);
+    // store kon in separate memory that is wrapped in reset state machine, so kon goes low on
+    // reset, bringing envelope into RELEASE state
+    mem_multi_bank_reset #(
+        .DATA_WIDTH(1),
+        .DEPTH('h9),
+        .OUTPUT_DELAY(0),
+        .DEFAULT_VALUE(0),
+        .NUM_BANKS(NUM_BANKS)
+    ) kon_mem (
+        .clk,
+        .reset('0),
+        .reset_mem(reset),
+        .wea(opl3_reg_wr.valid && opl3_reg_wr.address >= 'hB0 && opl3_reg_wr.address <= 'hB8),
+        .reb(op_sample_clk_en),
+        .banka(opl3_reg_wr.bank_num),
+        .addra(opl3_reg_wr.address[$clog2('h9)-1:0]),
+        .bankb(bank_num),
+        .addrb(kon_block_fnum_channel_mem_rd_address),
+        .dia(opl3_reg_wr.data[5]),
+        .dob(kon),
+        .reset_mem_done_pulse()
+    );
+
+    localparam block_fnum_high_mem_width = $bits(block) + $bits(fnum[9:8]);
 
     mem_multi_bank #(
-        .DATA_WIDTH(kon_block_fnum_high_mem_width),
+        .DATA_WIDTH(block_fnum_high_mem_width),
         .DEPTH('h9),
         .OUTPUT_DELAY(0),
         .DEFAULT_VALUE(0),
         .NUM_BANKS(NUM_BANKS)
-    ) kon_block_fnum_high_mem (
+    ) block_fnum_high_mem (
         .clk,
         .wea(opl3_reg_wr.valid && opl3_reg_wr.address >= 'hB0 && opl3_reg_wr.address <= 'hB8),
         .reb(op_sample_clk_en),
@@ -329,8 +352,8 @@ module control_operators
         .addra(opl3_reg_wr.address[$clog2('h9)-1:0]),
         .bankb(bank_num),
         .addrb(kon_block_fnum_channel_mem_rd_address),
-        .dia(opl3_reg_wr.data[kon_block_fnum_high_mem_width-1:0]),
-        .dob({kon, block, fnum[9:8]})
+        .dia(opl3_reg_wr.data[block_fnum_high_mem_width-1:0]),
+        .dob({block, fnum[9:8]})
     );
 
     localparam fb_cnt_mem_width = $bits(fb_p1) + $bits(cnt0_p1);
@@ -534,4 +557,4 @@ module control_operators
     always_ff @(posedge clk)
         ops_done_pulse <= operator_out.valid && operator_out.bank_num == 1 && operator_out.op_num == 17;
 endmodule
-`default_nettype wire
\ No newline at end of file
+`default_nettype wire
diff --git a/rtl/soc/sound/opl3/envelope_generator.sv b/rtl/soc/sound/opl3/envelope_generator.sv
index d88330c..8a4aa04 100755
--- a/rtl/soc/sound/opl3/envelope_generator.sv
+++ b/rtl/soc/sound/opl3/envelope_generator.sv
@@ -184,8 +184,7 @@ module envelope_generator
         .*
     );
 
-    // on reset all operators will go into RELEASE state
-    mem_multi_bank_reset #(
+    mem_multi_bank #(
         .DATA_WIDTH($bits(state_t)),
         .DEPTH(NUM_OPERATORS_PER_BANK),
         .OUTPUT_DELAY(0),
@@ -193,8 +192,6 @@ module envelope_generator
         .NUM_BANKS(NUM_BANKS)
     ) state_mem (
         .clk,
-        .reset('0),
-        .reset_mem(reset),
         .wea(sample_clk_en_p[3]),
         .reb(sample_clk_en),
         .banka(bank_num_p[3]),
@@ -202,8 +199,7 @@ module envelope_generator
         .bankb(bank_num),
         .addrb(op_num),
         .dia({state_p3}),
-        .dob({state_p0}),
-        .reset_mem_done_pulse()
+        .dob({state_p0})
     );
 
     always_comb begin
