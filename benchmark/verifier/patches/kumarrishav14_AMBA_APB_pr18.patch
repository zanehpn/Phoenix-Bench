                     end
-                end
+                    _next_state <= `ACCESS;
+                end   
+                else
+                    _next_state <= _state;
             end
-            else begin
-                PREADY <= 0;
-            end
-        end
+
+            `ACCESS:
+            begin
+                $display("[%0t] In Access State", $time);
+                if(_PWRITE && !_PSLVERR) begin
+                    mem[_PADDR[DEPTH-1:0]] = #0 _PWDATA;
+                end
+                _PREADY <= 0;
+                if(!_PSEL1)
+                    _next_state <= `IDLE;
+                else
+                    _next_state <= `SETUP;
+            end 
+        endcase
     end
+
 endmodule
