From f21be19c28fd39b65f86f0e5a1a04bdc05f4f004 Mon Sep 17 00:00:00 2001
From: aolofsson <andreas@zeroasic.com>
Date: Mon, 17 Oct 2022 21:05:55 -0400
Subject: [PATCH 1/2] Simplifying bin2gray converter

---
 stdlib/rtl/oh_bin2gray.v | 15 +--------------
 1 file changed, 1 insertion(+), 14 deletions(-)

diff --git a/stdlib/rtl/oh_bin2gray.v b/stdlib/rtl/oh_bin2gray.v
index 452592dc..24dd5891 100644
--- a/stdlib/rtl/oh_bin2gray.v
+++ b/stdlib/rtl/oh_bin2gray.v
@@ -13,19 +13,6 @@ module oh_bin2gray
     output [N-1:0] out //gray encoded output
     );
 
-   reg [N-1:0] 	   gray;
-   wire [N-1:0]    bin;
-
-   integer 	   i;
-
-   assign bin[N-1:0]  = in[N-1:0];
-   assign out[N-1:0]  = gray[N-1:0];
-
-   always @*
-     begin
-	gray[N-1] = bin[N-1];
-	for (i=0; i<(N-1); i=i+1)
-	  gray[i] = bin[i] ^ bin[i+1];
-     end
+   assign out[N-1:0] =  in[N-1:0] ^ {1'b0, in[N-1:1]};
 
 endmodule // oh_bin2gray

