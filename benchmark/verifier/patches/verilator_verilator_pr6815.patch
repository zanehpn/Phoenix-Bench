+
+import vltest_bootstrap
+
+test.scenarios('vlt')
+
+# Use --output-split-cfuncs to create small functions that can be inlined
+test.compile(verilator_flags2=["--stats", "--exe", "--main", "--output-split-cfuncs", "1"])
