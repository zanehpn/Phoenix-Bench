+
+// highlights a signal in the waveform for easier viewing
+module signal_highlighter #(
+    parameter type T = logic
+)(
+    input logic ready_i,
+    input logic valid_i,
+    input T data_i
+);
+
+    T in_wave;
+
+    always_comb begin
+        in_wave = 'Z;
+        if (ready_i & valid_i) begin
+            in_wave = data_i;
+        end
+    end
+
+endmodule
