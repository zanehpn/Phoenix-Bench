From fd500175c9fbea6f589311a4b3ec7eadb18d6c98 Mon Sep 17 00:00:00 2001
From: Aleksander Kiryk <akiryk@antmicro.com>
Date: Tue, 12 Nov 2024 14:49:33 +0100
Subject: [PATCH 1/5] Add custom test

---
 .github/workflows/test-regression.yml | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/.github/workflows/test-regression.yml b/.github/workflows/test-regression.yml
index b87cfb4bbbc..e07426e8cec 100644
--- a/.github/workflows/test-regression.yml
+++ b/.github/workflows/test-regression.yml
@@ -78,3 +78,22 @@ jobs:
         with:
           name: regression_tests_coverage_data
           path: results/*.info
+
+  custom-regression-tests:
+    name: Custom regression tests
+    runs-on: [ self-hosted, Linux, X64, gcp-custom-runners ]
+    container: centos:8
+    env:
+      GHA_EXTERNAL_DISK: additional-tools
+    steps:
+      - uses: actions/checkout@v3
+        with:
+          submodules: recursive
+
+      - name: Prepare Environment
+        run: _secret_prepare_env
+        continue-on-error: true
+
+      - name: Run tests
+        run: _secret_custom_test
+        continue-on-error: true

From b45f5097dd57759702759043f00e1907676ae5cb Mon Sep 17 00:00:00 2001
From: Aleksander Kiryk <akiryk@antmicro.com>
Date: Thu, 7 Nov 2024 15:29:03 +0100
Subject: [PATCH 2/5] Add missing includes

---
 tools/Makefile | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tools/Makefile b/tools/Makefile
index 2a279cfb679..0f92ea3bcfe 100755
--- a/tools/Makefile
+++ b/tools/Makefile
@@ -184,8 +184,8 @@ vcs-build: ${TBFILES} ${BUILD_DIR}/defines.h
 	$(VCS) -full64 -assert svaext -sverilog +define+RV_OPENSOURCE $(ASSERT_DEFINES) \
 	  +error+500 +incdir+${RV_ROOT}/design/lib \
 	  +incdir+${RV_ROOT}/design/include ${BUILD_DIR}/common_defines.vh \
-	  +incdir+$(BUILD_DIR)  +libext+.v $(defines) \
-	  -f ${RV_ROOT}/testbench/flist ${TBFILES} -l vcs.log
+	  +incdir+$(BUILD_DIR)  +libext+.v $(defines) -CFLAGS "${CFLAGS}" \
+	  -f ${RV_ROOT}/testbench/flist ${TBFILES} ${TB_DPI_SRCS} -l vcs.log
 	touch vcs-build
 
 irun-build: ${TBFILES} ${BUILD_DIR}/defines.h

