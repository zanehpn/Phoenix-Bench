From e6ee47680e5829dad8f3da36c7a71800f1def9d6 Mon Sep 17 00:00:00 2001
From: Tobias Senti <git@tsenti.li>
Date: Tue, 29 Jul 2025 16:06:56 +0200
Subject: [PATCH] reg_to_axi: fix axi error detection

---
 src/reg_to_axi.sv | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/reg_to_axi.sv b/src/reg_to_axi.sv
index caf30f2..443f647 100644
--- a/src/reg_to_axi.sv
+++ b/src/reg_to_axi.sv
@@ -75,7 +75,7 @@ module reg_to_axi #(
   // Regbus response
   assign reg_rsp_o = '{
     rdata:  axi_rsp_i.r.data,
-    error:  (reg_req_i.write ? axi_rsp_i.b.resp : axi_rsp_i.r.resp) == axi_pkg::RESP_OKAY,
+    error:  (reg_req_i.write ? axi_rsp_i.b.resp : axi_rsp_i.r.resp) != axi_pkg::RESP_OKAY,
     ready:  axi_rsp_i.r_valid | axi_rsp_i.b_valid
   };
 
