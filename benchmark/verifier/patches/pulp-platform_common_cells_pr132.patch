From 3154dd620bd0f0ea0284e1184fea018f59fa9e37 Mon Sep 17 00:00:00 2001
From: Manuel Eggimann <meggimann@iis.ee.ethz.ch>
Date: Mon, 21 Mar 2022 18:04:21 +0100
Subject: [PATCH 11/21] Waive non-blocking assignment lint rule for clock
 divider

The rule to use only blocking assignment for sequential logic does not apply to
clock generating logic like clock dividers. There it might actually cause race
conditions!! (See [1]S. Sutherland and D. Mills, Verilog and System Verilog
gotchas: 101 common coding errors and how to avoid them. New York: Springer,
2007. pp.64)
---
 lint/common_cells.style.waiver | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/lint/common_cells.style.waiver b/lint/common_cells.style.waiver
index 0cec45fd..44526510 100644
--- a/lint/common_cells.style.waiver
+++ b/lint/common_cells.style.waiver
@@ -4,3 +4,7 @@ waive --rule=typedef-structs-unions --line=29 --location="src/ecc_encode.sv"
 # That is a known issue with string parameter in Synopsys DC
 waive --rule=explicit-parameter-storage-type --line=19 --location="src/stream_arbiter.sv"
 waive --rule=explicit-parameter-storage-type --line=19 --location="src/stream_arbiter_flushable.sv"
+waive --rule=always-ff-non-blocking --line=234 --location="src/clk_int_div.sv"
+waive --rule=always-ff-non-blocking --line=237 --location="src/clk_int_div.sv"
+waive --rule=always-ff-non-blocking --line=247 --location="src/clk_int_div.sv"
+waive --rule=always-ff-non-blocking --line=250 --location="src/clk_int_div.sv"
\ No newline at end of file

