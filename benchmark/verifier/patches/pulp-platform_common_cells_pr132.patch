@@ -259,6 +279,17 @@ module clk_int_div #(
     end
   end
 
+  always_comb begin
+    if (clear_toggle_flops) begin
+      t_ff1_d = '0;
+      t_ff2_d = '0;
+    end else begin
+      t_ff1_d = t_ff1_en? !t_ff1_q: t_ff1_q;
+      t_ff2_d = t_ff2_en? !t_ff2_q: t_ff2_q;
+    end
+  end
+
+
   //----- FSM to control T-FF enable and clk_div_bypass_en -----
 
   always_comb begin

