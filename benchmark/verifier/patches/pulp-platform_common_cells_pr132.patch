From c6a857e7d6d4a57965575c00c980ec92d7939737 Mon Sep 17 00:00:00 2001
From: Manuel Eggimann <meggimann@iis.ee.ethz.ch>
Date: Mon, 21 Mar 2022 22:04:05 +0100
Subject: [PATCH 14/21] Change en_i signal logic in clk_int_div for faster
 response time

Since the output clock gate is glitch free by design, it is perfectly fine to
drive the clk_gate enable signal with combinational logic. With this change, the
deasserting the en_i signal disables the clock immediately (next falling edge)
in contrast to the previous implementation which had 1 cycle delay.
---
 src/clk_int_div.sv | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/src/clk_int_div.sv b/src/clk_int_div.sv
index a28162cf..bece3d48 100644
--- a/src/clk_int_div.sv
+++ b/src/clk_int_div.sv
@@ -124,9 +124,7 @@ module clk_int_div #(
     case (clk_gate_state_q)
       IDLE: begin
         gate_en_d = 1'b1;
-        if (!en_i) begin
-          gate_en_d = 1'b0;
-        end else if (div_valid_i) begin
+        if (div_valid_i) begin
           clk_gate_state_d = LOAD_DIV;
           gate_en_d = 1'b0;
         end
@@ -306,7 +304,7 @@ module clk_int_div #(
                       // remove it to save ICGs (e.g. in FPGAs).
   ) i_clk_gate (
     .clk_i     ( ungated_output_clock ),
-    .en_i      ( gate_en_q            ),
+    .en_i      ( gate_en_q & en_i     ),
     .test_en_i ( test_mode_en_i       ),
     .clk_o
   );

