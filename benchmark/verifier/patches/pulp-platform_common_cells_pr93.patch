From 0437f12e35aa3df3db3e075618e77c10ea9408b0 Mon Sep 17 00:00:00 2001
From: SebastianZa <sebastian.zanker@de.bosch.com>
Date: Fri, 10 Jul 2020 17:31:20 +0200
Subject: [PATCH] stream_register: Fix `DATA_WIDTH` of instantiated FIFO

Changed `$size()` to `$bits()`.
---
 CHANGELOG.md           | 1 +
 src/stream_register.sv | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 3be07d58..a05da8fc 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -7,6 +7,7 @@ and this project adheres to [Semantic Versioning](http://semver.org/spec/v2.0.0.
 ## Unreleased
 
 ### Fixed
+- `stream_register`: Fix `DATA_WIDTH` of instantiated FIFO.
 - `stream_xbar`: Add missing argument in assertion error string.
 
 ## 1.19.0 - 2020-05-25
diff --git a/src/stream_register.sv b/src/stream_register.sv
index e83228b3..f529d6a2 100644
--- a/src/stream_register.sv
+++ b/src/stream_register.sv
@@ -33,7 +33,7 @@ module stream_register #(
 
     fifo_v2 #(
         .FALL_THROUGH   (1'b0),
-        .DATA_WIDTH     ($size(T)),
+        .DATA_WIDTH     ($bits(T)),
         .DEPTH          (1),
         .dtype          (T)
     ) i_fifo (
