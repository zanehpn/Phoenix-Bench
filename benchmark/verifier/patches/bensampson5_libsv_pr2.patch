Subject: [PATCH 1/6] Implement counter.v

---
 counter.v | 12 ++++++++++++
 1 file changed, 12 insertions(+)
 create mode 100644 counter.v

diff --git a/counter.v b/counter.v
new file mode 100644
index 0000000..28ce9c6
--- /dev/null
+++ b/counter.v
@@ -0,0 +1,12 @@
+// Author: Ben Sampson
+
+module counter #(parameter N = 8)
+(
+    input clk,
+    output reg[N-1:0] q
+);
+
+    always @ (posedge clk)
+        q <= q + 1;
+
+endmodule
\ No newline at end of file

