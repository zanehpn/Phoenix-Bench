From 91f9743528070025ad859afada8ad06b20f0f18a Mon Sep 17 00:00:00 2001
From: Ben Sampson <bensampson5@gmail.com>
Date: Wed, 23 Dec 2020 17:11:16 -0600
Subject: [PATCH 5/6] Add async active low reset to counter

---
 src/counter.v | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/counter.v b/src/counter.v
index 28ce9c6..bb50eee 100644
--- a/src/counter.v
+++ b/src/counter.v
@@ -2,11 +2,15 @@
 
 module counter #(parameter N = 8)
 (
-    input clk,
+    input  wire       clk,
+    input  wire       aresetn,
     output reg[N-1:0] q
 );
 
-    always @ (posedge clk)
-        q <= q + 1;
+    always @ (posedge clk or negedge aresetn)
+        if (!aresetn)
+            q <= 0;
+        else
+            q <= q + 1;
 
 endmodule
\ No newline at end of file

From ee60758ca697bc2a899fe9742bc4a93162061722 Mon Sep 17 00:00:00 2001
From: Ben Sampson <bensampson5@gmail.com>
Date: Wed, 23 Dec 2020 17:11:29 -0600
Subject: [PATCH 6/6] Add counter_tb

---
 tb/counter_tb.sv | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/tb/counter_tb.sv b/tb/counter_tb.sv
index e69de29..116059f 100644
--- a/tb/counter_tb.sv
+++ b/tb/counter_tb.sv
@@ -0,0 +1,32 @@
+// Author: Ben Sampson
+`include "../src/counter.v"
+`timescale 1ns/1ns
+
+`define CLK_HALF_PERIOD 1
+
+module counter_tb;
+
+    localparam N = 4;
+    
+    reg clk;
+    reg aresetn;
+    wire[N-1:0] q;
+
+    counter #(.N(N)) counter_0(.clk(clk), .aresetn(aresetn), .q(q));
+
+    always #`CLK_HALF_PERIOD clk = ~clk;
+
+    initial begin
+        $dumpfile("counter_tb.vcd");
+        $dumpvars(0, counter_tb);
+
+        $monitor("Time = %0t clk = %0d q = %0d", $time, clk, q);
+
+        clk <= 1;
+        aresetn <= 0;
+        #1 aresetn <= 1;
+
+        #50 $finish;
+    end
+
+endmodule
\ No newline at end of file
