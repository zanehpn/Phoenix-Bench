-module Half_subtractor_vlg_sample_tst(
-	A,
-	B,
-	sampler_tx
-);
-input  A;
-input  B;
-output sampler_tx;
-
-reg sample;
-time current_time;
-always @(A or B)
-                                                                                
-begin                                                 
- if ($realtime > 0)                                   
- begin                                                
-    if ($realtime == 0 || $realtime != current_time)  
-    begin                                             
-        if (sample === 1'bx)                          
-            sample = 0;                               
-        else                                          
-            sample = ~sample;                         
-    end                                               
-    current_time = $realtime;                         
- end                                                  
-end                                                   
-
-assign sampler_tx = sample;
-endmodule
