-module Half_subtractor_vlg_check_tst (
-	Bo,
-	Do,
-	sampler_rx
-);
-input  Bo;
-input  Do;
-input sampler_rx;
-
-reg  Bo_expected;
-reg  Do_expected;
-
-reg  Bo_prev;
-reg  Do_prev;
-
-reg  Bo_expected_prev;
-reg  Do_expected_prev;
-
-reg  last_Bo_exp;
-reg  last_Do_exp;
-
-reg trigger;
-
-integer i;
-integer nummismatches;
-
-reg [1:2] on_first_change ;
-
-
-initial
-begin
-trigger = 0;
-i = 0;
-nummismatches = 0;
-on_first_change = 2'b1;
-end
-
-// update real /o prevs
-
-always @(trigger)
-begin
-	Bo_prev = Bo;
-	Do_prev = Do;
-end
-
-// update expected /o prevs
-
-always @(trigger)
-begin
-	Bo_expected_prev = Bo_expected;
-	Do_expected_prev = Do_expected;
-end
-
-
-
-// expected Bo
-initial
-begin
-	Bo_expected = 1'bX;
-	Bo_expected = #999000 1'b0;
-end 
-
-// expected Do
-initial
-begin
-	Do_expected = 1'bX;
-	Do_expected = #999000 1'b0;
-end 
-// generate trigger
-always @(Bo_expected or Bo or Do_expected or Do)
-begin
-	trigger <= ~trigger;
-end
-
-always @(posedge sampler_rx or negedge sampler_rx)
-begin
-`ifdef debug_tbench
-	$display("Scanning pattern %d @time = %t",i,$realtime );
-	i = i + 1;
-	$display("| expected Bo = %b | expected Do = %b | ",Bo_expected_prev,Do_expected_prev);
-	$display("| real Bo = %b | real Do = %b | ",Bo_prev,Do_prev);
-`endif
-	if (
-		( Bo_expected_prev !== 1'bx ) && ( Bo_prev !== Bo_expected_prev )
-		&& ((Bo_expected_prev !== last_Bo_exp) ||
-			on_first_change[1])
-	)
