new file mode 100644
index 00000000..9b2476b0
--- /dev/null
+++ b/VerilogHDL_Practice/CH4/full_adder_one.v
@@ -0,0 +1,12 @@
+module full_adder_one (A, B, Ci, Co, S);
+
+input A, B, Ci;
+output Co, S;
+
+and (AB, A, B);
+and (ACi, A, Ci);
+and (BCi, B, Ci);
+or (Co, AB, ACi, BCi);
+xor (S, A, B, Ci);
+
+endmodule // full_adder_one
diff --git a/VerilogHDL_Practice/CH4/full_adder_one_test.v b/VerilogHDL_Practice/CH4/full_adder_one_test.v
new file mode 100644
index 00000000..ef70d706
--- /dev/null
+++ b/VerilogHDL_Practice/CH4/full_adder_one_test.v
@@ -0,0 +1,29 @@
+`timescale 1ns / 1ps
+
+module full_adder_one_test ();
+
+reg A = 1'b0;
+reg B = 1'b0;
+reg Ci = 1'b0;
+wire Co, S;
+
+full_adder_one UUT (.A(A), .B(B), .Ci(Ci), .Co(Co), .S(S));
+
+initial begin
+  A = 1'b0; B = 1'b0; Ci = 1'b0;
+  #100; A = 1'b0; B = 1'b0; Ci = 1'b1;
+  #100; A = 1'b0; B = 1'b1; Ci = 1'b0;
+  #100; A = 1'b0; B = 1'b1; Ci = 1'b1;
+  #100; A = 1'b1; B = 1'b0; Ci = 1'b0;
+  #100; A = 1'b1; B = 1'b0; Ci = 1'b1;
+  #100; A = 1'b1; B = 1'b1; Ci = 1'b0;
+  #100; A = 1'b1; B = 1'b1; Ci = 1'b1;
+
+end
+
+initial begin
+  #800;
+    $stop;
+end
+
+endmodule // full_adder_one_test

