From ee9a264a6fe3b491e4162454b510547a826704a4 Mon Sep 17 00:00:00 2001
From: Paul Scheffler <paulsc@iis.ee.ethz.ch>
Date: Wed, 20 Apr 2022 22:42:57 +0200
Subject: [PATCH 1/5] snitch: Fix some latches possibly hidden by optimization

---
 hw/ip/snitch_cluster/src/snitch_cc.sv        | 1 +
 hw/ip/snitch_dma/src/axi_dma_tc_snitch_fe.sv | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/hw/ip/snitch_cluster/src/snitch_cc.sv b/hw/ip/snitch_cluster/src/snitch_cc.sv
index 21aa35f28..274735ec8 100644
--- a/hw/ip/snitch_cluster/src/snitch_cc.sv
+++ b/hw/ip/snitch_cluster/src/snitch_cc.sv
@@ -646,6 +646,7 @@ module snitch_cc #(
       ssr_cfg_req.word = '0;
       ssr_cfg_req.write = '0;
 
+      addr = '0;
       unique casez (acc_snitch_demux_q.data_op)
         SCFGRI,
         SCFGWI: begin
diff --git a/hw/ip/snitch_dma/src/axi_dma_tc_snitch_fe.sv b/hw/ip/snitch_dma/src/axi_dma_tc_snitch_fe.sv
index f0d4dd895..7fcb9d56f 100644
--- a/hw/ip/snitch_dma/src/axi_dma_tc_snitch_fe.sv
+++ b/hw/ip/snitch_dma/src/axi_dma_tc_snitch_fe.sv
@@ -268,6 +268,7 @@ module axi_dma_tc_snitch_fe #(
                   automatic logic [1:0] cfg;
 
                   // Parse the transfer parameters from the register or immediate.
+                  cfg = '0;
                   unique casez (acc_qdata_op_i)
                       riscv_instr::DMCPYI : cfg = acc_qdata_op_i[24:20];
                       riscv_instr::DMCPY :  cfg = acc_qdata_argb_i;
@@ -304,6 +305,7 @@ module axi_dma_tc_snitch_fe #(
                   automatic logic [1:0] status;
 
                   // Parse the status index from the register or immediate.
+                  status = '0;
                   unique casez (acc_qdata_op_i)
                       riscv_instr::DMSTATI: status = acc_qdata_op_i[24:20];
                       riscv_instr::DMSTAT:  status = acc_qdata_argb_i;

