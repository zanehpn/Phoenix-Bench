Date: Sat, 12 Jul 2025 11:17:41 -0400
Subject: [PATCH 3/8] muxes made and instantiated

instantiated in bottom of top.v and created the module in a seperate file Mux.v
---
 src/Mux.v |  9 +++++++++
 src/top.v | 21 +++++++++++++++++++++
 2 files changed, 30 insertions(+)
 create mode 100644 src/Mux.v

diff --git a/src/Mux.v b/src/Mux.v
new file mode 100644
index 0000000..b5b7ab3
--- /dev/null
+++ b/src/Mux.v
@@ -0,0 +1,9 @@
+module mux (
+  input  wire [31:0] input1,
+  input  wire [31:0] input0,
+  input  wire        sel,
+  output wire [31:0] out
+);
+  assign out = sel ? input1 : input0;
+endmodule
+
diff --git a/src/top.v b/src/top.v
index dd1da0f..c935ee1 100644
--- a/src/top.v
+++ b/src/top.v
@@ -68,4 +68,25 @@ module top ( input wire clk
       .writeData  (writeData)   
   );
 
+  mux pc (
+    .input0(PCPlus4),  
+    .input1(PCTarget),  
+    .sel(PCSrc),  
+    .out(PCNext)     
+  );
+
+  mux alu (
+    .input0(RD2),    
+    .input1(ImmExt),  
+    .sel(ALUSrc),   
+    .out(SrcB)
+  );
+
+  mux result (
+    .input0(ALUResult),
+    .input1(ReadData),
+    .sel(ResultSrc), 
+    .out(Result)
+  );
+
 endmodule
\ No newline at end of file

