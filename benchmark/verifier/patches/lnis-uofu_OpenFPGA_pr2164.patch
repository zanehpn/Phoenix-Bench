+            <interconnect>
+              <direct name="clk2clk" input="mult_8x8_slice.clk" output="mult_8x8_regin.clk"/>
+              <direct name="rst2rst" input="mult_8x8_slice.reset" output="mult_8x8_regin.reset"/>
+              <direct name="a2a" input="mult_8x8_slice.A_cfg" output="mult_8x8_regin.A">
