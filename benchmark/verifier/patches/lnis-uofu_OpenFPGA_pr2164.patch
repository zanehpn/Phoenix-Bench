@@ -0,0 +1,30 @@
+//-------------------------------------------------------
+//  Functionality: Two 8-bit multiply circuit using macro, one with input registers while the other without
+//  Author:        Xifan Tang
+//-------------------------------------------------------
+
+module dual_mult8_mix_design(clk, rst, a0, b0, out0, a1, b1, out1);
+parameter DATA_WIDTH = 8;  /* declare a parameter. default required */
+input clk;
+input rst;
+input [0 : DATA_WIDTH - 1] a0, b0, a1, b1;
+output [0 : 2*DATA_WIDTH - 1] out0, out1;
+
+(* keep *)
+  mult_8 mult8_dsp (
+		.A(a0),
+		.B(b0),
+		.Y(out0),
+	);
+
+(* keep *)
+  mult_8_regin mult8_regin_dsp (
+        .clk(clk),
+        .reset(rst),
+		.A(a1),
+		.B(b1),
+		.Y(out1),
+	);
+
+
+endmodule
diff --git a/openfpga_flow/openfpga_yosys_techlib/k4_frac_N8_tileable_reset_softadder_register_scan_chain_frac_dsp16_regin_nonLR_caravel_io_skywater130nm_cell_sim.v b/openfpga_flow/openfpga_yosys_techlib/k4_frac_N8_tileable_reset_softadder_register_scan_chain_frac_dsp16_regin_nonLR_caravel_io_skywater130nm_cell_sim.v
new file mode 100644
index 0000000000..3b09b1a245
--- /dev/null
+++ b/openfpga_flow/openfpga_yosys_techlib/k4_frac_N8_tileable_reset_softadder_register_scan_chain_frac_dsp16_regin_nonLR_caravel_io_skywater130nm_cell_sim.v
@@ -0,0 +1,53 @@
+//-----------------------------
+// 8-bit multiplier
+//-----------------------------
+module mult_8(
+  input [0:7] A,
+  input [0:7] B,
+  output [0:15] Y
+);
+
+assign Y = A * B;
+
+endmodule
+
+//-----------------------------
+// 16-bit multiplier
+//-----------------------------
+module mult_16(
+  input [0:15] A,
+  input [0:15] B,
+  output [0:31] Y
+);
+
+assign Y = A * B;
+
+endmodule
+
+//-----------------------------
+// 8-bit multiplier with input register
+//-----------------------------
+module mult_8_regin(
+  input clk,
+  input rst,
+  input [0:7] A,
+  input [0:7] B,
+  output [0:15] Y
+);
+
+reg [0:7] A_reg;
+reg [0:7] B_reg;
+always @(posedge clk or posedge rst) begin
+  if (rst == 1'b1) begin
+    A_reg <= 0;
+    B_reg <= 0;
+  end else begin
+    A_reg <= A;
+    B_reg <= B;
+  end
+end
+
+assign Y = A_reg * B_reg;
+
+endmodule
+
