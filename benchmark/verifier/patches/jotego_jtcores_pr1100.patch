 cores/riders/hdl/jtriders_colmix.v | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cores/riders/hdl/jtriders_colmix.v b/cores/riders/hdl/jtriders_colmix.v
index ab91465bf..10342fa6e 100644
--- a/cores/riders/hdl/jtriders_colmix.v
+++ b/cores/riders/hdl/jtriders_colmix.v
@@ -106,7 +106,7 @@ always @* begin
         3,1: dim_cmn[0] = brit | dim_cmn[1];
         2,0: dim_cmn[0] = brit;
     endcase
-    if(lgtnfght) dim_cmn = 2'b11;
+    if(lgtnfght) dim_cmn = {1'b1, brit};
 end
 
 function [7:0] conv58(input [4:0] cin );
