From 8bab52c92aa6e76f9fa5316dedb5147231b21a02 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Wed, 25 Jun 2025 12:16:02 +0200
Subject: [PATCH 1/4] Dimming in lgtnfght

---
 cores/riders/hdl/jtriders_colmix.v | 3 +++
 cores/riders/hdl/jtriders_video.v  | 1 +
 2 files changed, 4 insertions(+)

diff --git a/cores/riders/hdl/jtriders_colmix.v b/cores/riders/hdl/jtriders_colmix.v
index f56f994f4..ab91465bf 100644
--- a/cores/riders/hdl/jtriders_colmix.v
+++ b/cores/riders/hdl/jtriders_colmix.v
@@ -21,6 +21,8 @@ module jtriders_colmix(
     input             clk,
     input             pxl_cen,
 
+    input             lgtnfght,
+
     // Base Video
     input             lhbl,
     input             lvbl,
@@ -104,6 +106,7 @@ always @* begin
         3,1: dim_cmn[0] = brit | dim_cmn[1];
         2,0: dim_cmn[0] = brit;
     endcase
+    if(lgtnfght) dim_cmn = 2'b11;
 end
 
 function [7:0] conv58(input [4:0] cin );
diff --git a/cores/riders/hdl/jtriders_video.v b/cores/riders/hdl/jtriders_video.v
index e53747c9f..e3cebdebc 100644
--- a/cores/riders/hdl/jtriders_video.v
+++ b/cores/riders/hdl/jtriders_video.v
@@ -335,6 +335,7 @@ jtriders_colmix u_colmix(
     .rst        ( rst       ),
     .clk        ( clk       ),
     .pxl_cen    ( pxl_cen   ),
+    .lgtnfght   ( lgtnfght  ),
 
     // Base Video
     .lhbl       ( lhbl      ),

From 0676d8fe06869b62bdbb77482ed0b7ca08664396 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Wed, 25 Jun 2025 12:16:20 +0200
Subject: [PATCH 2/4] minor

---
 cores/riders/ver/ssriders/runall.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cores/riders/ver/ssriders/runall.sh b/cores/riders/ver/ssriders/runall.sh
index 4103ef382..a0278e5b3 100755
--- a/cores/riders/ver/ssriders/runall.sh
+++ b/cores/riders/ver/ssriders/runall.sh
@@ -3,7 +3,7 @@
 BAD=
 
 for i in scenes/*; do
-    if ! sim.sh -s $(basename $i) --batch $*; then
+    if ! sim.sh -s $(basename $i) --batch $* > /dev/null 2>&1; then
         BAD="$(basename $i) $BAD"
     fi
 done

