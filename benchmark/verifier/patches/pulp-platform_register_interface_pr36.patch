-      .req_t(req_t),
-      .rsp_t(rsp_t)
+      .CDC4Phase ( CDC4Phase ),
+      .req_t     ( req_t     ),
+      .rsp_t     ( rsp_t     )
    ) i_reg_cdc_dst (
        .dst_clk_i   ( dst_clk_i  ),
        .dst_rst_ni  ( dst_rst_ni ),

