+            .clk_i        ( dst_clk_i     ),
+            .data_o       ( dst_req       ),
+            .valid_o      ( dst_req_valid ),
+            .ready_i      ( dst_req_ready ),
+            .async_req_i  ( async_req_i   ),
+            .async_ack_o  ( async_ack_o   ),
+            .async_data_i ( async_data_i  )
