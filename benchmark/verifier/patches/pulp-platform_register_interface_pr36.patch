    reg_cdc_src #(
-      .req_t(req_t),
-      .rsp_t(rsp_t)
+      .CDC4Phase ( CDC4Phase ),
+      .req_t     ( req_t     ),
+      .rsp_t     ( rsp_t     )
    ) i_reg_cdc_src (
        .src_clk_i    ( src_clk_i  ),
        .src_rst_ni   ( src_rst_ni ),
@@ -247,8 +311,9 @@ module reg_cdc #(
    );
 
