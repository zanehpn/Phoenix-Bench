+          cdc_4phase_src #(.T(rsp_t)) i_cdc_rsp_src (
+            .rst_ni       ( dst_rst_ni    ),
+            .clk_i        ( dst_clk_i     ),
+            .data_i       ( dst_rsp_q     ),
+            .valid_i      ( dst_rsp_valid ),
+            .ready_o      ( dst_rsp_ready ),
+            .async_req_o  ( async_req_o   ),
+            .async_ack_i  ( async_ack_i   ),
+            .async_data_o ( async_data_o  )
+          );
+
+       end else begin : gen_cdc_2phase
