From 4086c595d383d76349fee6ad1ce8f9f2decf00ed Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Thu, 6 Nov 2025 14:09:33 +0100
Subject: [PATCH 3/8] paroda: scene simulation working on both parodius and
 suratk

---
 cores/paroda/ver/game/dump_split.sh | 1 +
 cores/paroda/ver/game/rest2bin.sh   | 9 ++++++++-
 cores/paroda/ver/game/sim.sh        | 8 +++++++-
 3 files changed, 16 insertions(+), 2 deletions(-)
 create mode 120000 cores/paroda/ver/game/dump_split.sh

diff --git a/cores/paroda/ver/game/dump_split.sh b/cores/paroda/ver/game/dump_split.sh
new file mode 120000
index 000000000..d9001c939
--- /dev/null
+++ b/cores/paroda/ver/game/dump_split.sh
@@ -0,0 +1 @@
+../../../riders/ver/game/dump_split.sh
\ No newline at end of file
diff --git a/cores/paroda/ver/game/rest2bin.sh b/cores/paroda/ver/game/rest2bin.sh
index 515d0897d..50c8e969e 100755
--- a/cores/paroda/ver/game/rest2bin.sh
+++ b/cores/paroda/ver/game/rest2bin.sh
@@ -1,3 +1,10 @@
 #!/bin/bash -e
 
-../game/dump_split.sh -f "rest.bin" --fullobj
+FULLOBJ=
+FSIZE=$(wc -c <"rest.bin")
+
+if [[ $FSIZE -gt 0x70A0 ]]; then
+	FULLOBJ="--fullobj"
+fi
+
+../game/dump_split.sh -f "rest.bin" $FULLOBJ
diff --git a/cores/paroda/ver/game/sim.sh b/cores/paroda/ver/game/sim.sh
index 99276acd0..279ca53da 100755
--- a/cores/paroda/ver/game/sim.sh
+++ b/cores/paroda/ver/game/sim.sh
@@ -4,6 +4,8 @@ OTHER=
 SCENE=
 BATCH=
 CRC=
+FULLOBJ=
+FSIZE=$(wc -c <"rest.bin")
 
 while [ $# -gt 0 ]; do
     case $1 in
@@ -23,7 +25,11 @@ while [ $# -gt 0 ]; do
     shift
 done
 
-dump_split.sh --scene "$SCENE" --nvram
+if [[ $FSIZE -gt 0x70A0 ]]; then
+    FULLOBJ="--fullobj"
+fi
+
+dump_split.sh --scene "$SCENE" --nvram $FULLOBJ
 
 jtsim $OTHER
 

