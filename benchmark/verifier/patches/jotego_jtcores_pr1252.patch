 cores/paroda/cfg/mame2mra.toml    | 10 +++++++---
 cores/paroda/cfg/reg.yaml         |  1 +
 cores/simson/hdl/jtsimson_video.v |  4 +---
 4 files changed, 12 insertions(+), 7 deletions(-)

diff --git a/cores/paroda/cfg/macros.def b/cores/paroda/cfg/macros.def
index bcd9610e9..c7d244d98 100644
--- a/cores/paroda/cfg/macros.def
+++ b/cores/paroda/cfg/macros.def
@@ -1,3 +1,5 @@
 include ../../simson/cfg/macros.def
 -JTFRAME_SDRAM96
-CORENAME=JTPARODA
\ No newline at end of file
+CORENAME=JTPARODA
+-JTFRAME_PROM_START
+debug JTFRAME_IOCTL_RD+=8192
diff --git a/cores/paroda/cfg/mame2mra.toml b/cores/paroda/cfg/mame2mra.toml
index 90e48f76d..3f4f6c56a 100644
--- a/cores/paroda/cfg/mame2mra.toml
+++ b/cores/paroda/cfg/mame2mra.toml
@@ -1,5 +1,5 @@
 [parse]
-sourcefile=[ "parodius.cpp" ]
+sourcefile=[ "parodius.cpp","surpratk.cpp"  ]
 
 [Audio]
 volume = [
@@ -9,6 +9,7 @@ volume = [
 [buttons]
 names = [
     { names="Power-up,Shoot,Missile/Bell", machine="parodius" },
+    { names="Shot,Jump", machine="suratk" },
 ]
 
 [dipsw]
@@ -17,17 +18,20 @@ delete=[{names=["Unused","Unknown"]}]
 [header]
 info = """ Header to identify the PCB type
         Byte 0 = 1 - Parodius
+        Byte 0 = 4 - Surprise Attack
                  """
 data = [
     { machine="parodius", offset=0, data="01" },
+    { machine="suratk",   offset=0, data="04" },
 ]
 
 [ROM]
 regions = [
     { name="maincpu" },
-    { name="audiocpu", start="JTFRAME_BA1_START", machine="parodius" },
-    { name="k053260",  start="PCM_START", rename="pcm", machine ="parodius", sequence=[0,0] },
+    { name="audiocpu", start="JTFRAME_BA1_START",       machine="parodius" },
+    { name="k053260",  start="PCM_START", rename="pcm", machine="parodius", sequence=[0,0] },
     { name="k052109",  start="JTFRAME_BA2_START", width=32, rename="tiles" }, # tiles
+    { name="k053244",  start="JTFRAME_BA3_START", width=32, rename="obj", machine="suratk"   }, # sprites
     { name="k053245",  start="JTFRAME_BA3_START", width=32, rename="obj", machine="parodius" }, # sprites
     { name="eeprom",   skip=true },
     { name="plds",     skip=true },
diff --git a/cores/paroda/cfg/reg.yaml b/cores/paroda/cfg/reg.yaml
index 5d7deef83..b632d1484 100644
--- a/cores/paroda/cfg/reg.yaml
+++ b/cores/paroda/cfg/reg.yaml
@@ -1 +1,2 @@
 parodius:
+suratk:
diff --git a/cores/simson/hdl/jtsimson_video.v b/cores/simson/hdl/jtsimson_video.v
index e02aac1d9..e000dc985 100644
--- a/cores/simson/hdl/jtsimson_video.v
+++ b/cores/simson/hdl/jtsimson_video.v
@@ -88,7 +88,7 @@ module jtsimson_video(
     output     [ 7:0] st_dout
 );
 
-localparam FULLOBJ = `ifdef SURATK 1 `else 0 `endif;
+localparam FULLOBJ = `ifdef PARODA 1 `else 0 `endif;
 
 wire [ 8:0] hdump, vdump, vrender, vrender1;
 wire [ 7:0] lyrf_pxl, st_scr,
@@ -221,9 +221,7 @@ assign obj_shd[1] = 1'b0;
 jtriders_obj #(
     .RAMW         ( ORAMW   ),
     .HFLIP_OFFSET ( 10'd134 )
-`ifdef SURATK
    ,.SHADOW       ( 1       )
-`endif
 ) u_obj(
     .lgtnfght   ( 1'b0      ),
 `endif

