     end
 
+    // last stich fix thanks to Serg Ko (@vfr1200f)
+    always_ff @(posedge clk_pix) last_h_stitch <= h_line && h_on;
+
     // paint colour: yellow lines, blue background
     logic [3:0] paint_r, paint_g, paint_b;
     always_comb begin
