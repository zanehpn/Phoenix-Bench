+        module="full_adder_cocotb",
+        sim_build=build_dir,
+        waves=True,
+    )
+
+    wavefile = build_dir / "dump.fst"
+    if wavefile.exists():
+        wavefile.rename(build_dir / "test_full_adder.fst")
