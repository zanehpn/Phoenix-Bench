-        cw->m_counter->clk = 0;
-        cw->m_counter->aresetn = 1;
-        cw->m_counter->q = COUNTER_MAX_VALUE;
-        cw->tick(false, 0); // initialize trace
-
-        // Increment by 1 so that counter will wraparound to 0
