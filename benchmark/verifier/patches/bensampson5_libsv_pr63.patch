-        cw->m_counter->aresetn = 1;
-        cw->tick(false, 0); // initialize trace
-
-        // Reset counter so that 'q' is 0
-        cw->reset();
-        REQUIRE(cw->m_counter->q == 0);
-
-        uint64_t prev_q = static_cast<uint64_t>(cw->m_counter->q);
-        WHEN("Clocked")
