new file mode 100644
index 0000000..33cccdc
--- /dev/null
+++ b/tests/math/full_adder/full_adder_cocotb.py
@@ -0,0 +1,20 @@
+import cocotb
+from cocotb.triggers import Timer
+
+@cocotb.test()
+async def test_full_adder(dut):
+    """ Full adder test. """
+
+    for i in range(2 ** 3):
+        i_a = i & 1
+        i_b = (i >> 1) & 1
+        i_carry = (i >> 2) & 1
+        o_sum = i_a ^ i_b ^ i_carry;
+        o_carry = ((i_a | i_b) & i_carry) | (i_a & i_b);
+
+        dut.i_a <= i_a
+        dut.i_b <= i_b
+        dut.i_carry <= i_carry
+        await Timer(1)
+        assert dut.o_sum == o_sum
+        assert dut.o_carry == o_carry
\ No newline at end of file
