Subject: [PATCH 1/3] rungun: don't consider blanking for fix

---
 cores/rungun/hdl/jtrungun_video.v | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cores/rungun/hdl/jtrungun_video.v b/cores/rungun/hdl/jtrungun_video.v
index 787a8fb5e..e7e62c7e2 100644
--- a/cores/rungun/hdl/jtrungun_video.v
+++ b/cores/rungun/hdl/jtrungun_video.v
@@ -252,7 +252,7 @@ jtframe_tilemap #(
 
     .vdump      ( virt_vdumpf   ),
     .hdump      ( virt_hdumpf   ),
-    .blankn     ( blankn        ),
+    .blankn     ( 1'b1          ),
     .flip       ( 1'b0          ),    // Screen flip
 
     .vram_addr  (vram_addr[11:1]),

