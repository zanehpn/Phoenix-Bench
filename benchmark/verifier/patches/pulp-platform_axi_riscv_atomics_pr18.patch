From 6c3e01cad0311891965ef2271ca50ab561d0078c Mon Sep 17 00:00:00 2001
From: Samuel Riedel <sriedel@iis.ee.ethz.ch>
Date: Mon, 14 Mar 2022 14:40:29 +0100
Subject: [PATCH 1/7] tb_axi_pkg: Use parameter to encode LRSC pair in
 testbench

---
 test/golden_memory.sv | 2 +-
 test/tb_axi_pkg.sv    | 4 +++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/test/golden_memory.sv b/test/golden_memory.sv
index 27e0240..6e598a5 100644
--- a/test/golden_memory.sv
+++ b/test/golden_memory.sv
@@ -209,7 +209,7 @@ package golden_model_pkg;
 
             b_resp = axi_pkg::RESP_OKAY;
 
-            if (atop == 6'b000111) begin
+            if (atop == tb_axi_pkg::ATOP_LRSC) begin
                 // LR/SC pair
                 // Wait for LR
                 read(addr, r_data, size, m_id, master);
diff --git a/test/tb_axi_pkg.sv b/test/tb_axi_pkg.sv
index 7b17cb3..97d1d0c 100644
--- a/test/tb_axi_pkg.sv
+++ b/test/tb_axi_pkg.sv
@@ -14,6 +14,8 @@ import axi_test::*;
 
 package tb_axi_pkg;
 
+    axi_pkg::atop_t ATOP_LRSC = 6'b000111;
+
     class axi_access #(
         parameter int  AW = 32  , // AXI address width
         parameter int  DW = 32  , // AXI data width
@@ -81,7 +83,7 @@ package tb_axi_pkg;
             w_beat.w_data    = axi_data;
             w_beat.w_strb    = strb;
             w_beat.w_last    = 1'b1;
-            if (atop == 6'b000111) begin
+            if (atop == ATOP_LRSC) begin
                 // LRSC pair
                 axi_read(address, result, size, id, 1'b1);
                 rand_delay(0,10*RAND_DELAY);

