From 7c9820296b3ef4bb89b32de41214a3dc1cf7ad55 Mon Sep 17 00:00:00 2001
From: Mojtaba Bisheh Niasar <“mojtabab@microsoft.com”>
Date: Mon, 16 Dec 2024 08:14:50 -0800
Subject: [PATCH 1/6] fixe issue 48 for leaking privkey

---
 src/mldsa_top/rtl/mldsa_ctrl.sv | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/mldsa_top/rtl/mldsa_ctrl.sv b/src/mldsa_top/rtl/mldsa_ctrl.sv
index 789b67eb..a15c19e2 100644
--- a/src/mldsa_top/rtl/mldsa_ctrl.sv
+++ b/src/mldsa_top/rtl/mldsa_ctrl.sv
@@ -227,9 +227,17 @@ always_ff @(posedge clk or negedge rst_b) begin : mldsa_kv_reg
   end
 end
 
-always_comb mldsa_privkey_lock = kv_seed_data_present;
 always_comb pcr_sign_mode = mldsa_reg_hwif_out.MLDSA_CTRL.PCR_SIGN.value;
 
+always_ff @(posedge clk or negedge rst_b) begin : mldsa_privkey_lock_reg
+  if (!rst_b)
+    mldsa_privkey_lock <= '0;
+  else (zeroize)
+    mldsa_privkey_lock <= '0;
+  else if (kv_seed_data_present_set)
+    mldsa_privkey_lock <= '1;
+end
+
 `else
 always_comb begin: mldsa_kv_ctrl_reg
   //ready when fsm is not busy

From fceacf9455ed5e16338520f77a495a08a062da70 Mon Sep 17 00:00:00 2001
From: Mojtaba Bisheh Niasar <“mojtabab@microsoft.com”>
Date: Mon, 16 Dec 2024 08:56:42 -0800
Subject: [PATCH 2/6] added zeroize to mldsa_top regs

---
 src/mldsa_top/rtl/mldsa_ctrl.sv | 25 +++++++++++++++++++++----
 src/mldsa_top/rtl/mldsa_top.sv  | 13 +++++++++++++
 2 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/src/mldsa_top/rtl/mldsa_ctrl.sv b/src/mldsa_top/rtl/mldsa_ctrl.sv
