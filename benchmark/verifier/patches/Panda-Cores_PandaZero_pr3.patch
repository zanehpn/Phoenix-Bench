-wire [31:0] mem_IF_data;
-wire [31:0] IF_mem_data;
 wire [31:0] MEM_addr;
 wire [31:0] mem_MEM_data;
 wire [31:0] MEM_mem_data;
-wire [3:0]  IF_write;
 wire [3:0]  MEM_write;
-wire        IF_en;
 wire        MEM_en;
 
 assign rst_o = ~rst_reqn;
-assign IF_mem_data = 'b0;
+
+wb_master_bus_t#(.TAGSIZE(1)) IF_wb_bus[1];
+wb_slave_bus_t#(.TAGSIZE(1))  rom_wb_bus[1];
 
 core_top core_i
 (
@@ -46,11 +44,7 @@ core_top core_i
     .rstn_i     ( rstn_i       ),
     .halt_core_i( halt_core_i  ),
     .rst_reqn_o ( rst_reqn     ),
-    .IF_en_o    ( IF_en        ),
-    .IF_write_o ( IF_write     ),
-    .IF_addr_o  ( IF_addr      ),
-    .IF_data_i  ( mem_IF_data  ),
-    .IF_data_o  ( IF_mem_data  ),
+    .IF_wb_bus  ( IF_wb_bus[0] ),
     .MEM_en_o   ( MEM_en       ),
     .MEM_addr_o ( MEM_addr     ),
     .MEM_data_i ( mem_MEM_data ),
@@ -63,9 +57,8 @@ dual_ram #(
 ) ram_i (
   .clk      ( clk          ),
   .rstn_i   ( rst_reqn     ),
-  .addra_i  ( IF_addr      ),
-  .ena_i    ( IF_en        ),
-  .douta_o  ( mem_IF_data  ),
+  .addra_i  ( 32'b0        ),
+  .ena_i    ( 1'b0         ),
   .addrb_i  ( MEM_addr     ),
   .enb_i    ( MEM_en       ),
   .web_i    ( MEM_write    ),
@@ -73,4 +66,25 @@ dual_ram #(
   .doutb_o  ( mem_MEM_data )
 );
 
+wb_ram_wrapper #(
+  .SIZE (32)
+) IF_mem (
+  .clk    ( clk       ),
+  .rstn_i ( rstn_i    ),
+  .wb_bus ( rom_wb_bus[0])
+);
+
+wishbone_interconnect #(
+    .TAGSIZE    ( 1 ),
+    .N_SLAVE    ( 1 ),
+    .N_MASTER   ( 1 )
+) intercon (
+    .clk_i      ( clk ),
+    .rst_i      ( ~rstn_i ),
+    .SSTART_ADDR({32'h0}),
+    .SEND_ADDR  ({32'h40}),
+    .wb_master_bus(IF_wb_bus),
+    .wb_slave_bus(rom_wb_bus)
+);
+
 endmodule
\ No newline at end of file
