From 755a3016bb6431b7a99146d3f2c3e762a56e0234 Mon Sep 17 00:00:00 2001
From: Luca Hanel <lhanel@pm.me>
Date: Fri, 24 Jul 2020 23:27:30 +0200
Subject: [PATCH 1/3] added wishbone to IF stage, surprisingly, CPI = 1. There
 might be an issue coming when MEM stage is integrated: it is possible that
 multiple, unnessecary reads are done at the same address by IF stage

---
 common                                        |  2 +-
 rtl/core/core_top.sv                          | 13 +----
 .../instructionFetch/IF_stage.sv              | 34 ++++++++++----
 rtl/core_wrapper.sv                           | 42 +++++++++++------
 rtl/memory/dual_ram.sv                        | 47 ++++++++++---------
 rtl/memory/wb_ram_wrapper.sv                  |  4 +-
 tests/rtl/common/sources.txt                  | 12 +++--
 7 files changed, 91 insertions(+), 63 deletions(-)

diff --git a/common b/common
index 7bae71b..868abb0 160000
--- a/common
+++ b/common
@@ -1 +1 @@
-Subproject commit 7bae71beebacdca9bf96335afb3b0ac59310c673
+Subproject commit 868abb0663806f2c5b75734936c17a4a0d5961f9
diff --git a/rtl/core/core_top.sv b/rtl/core/core_top.sv
index 5238263..439d378 100644
--- a/rtl/core/core_top.sv
+++ b/rtl/core/core_top.sv
@@ -26,11 +26,7 @@ module core_top (
     output logic         rst_reqn_o,
     input logic          halt_core_i,
 // IF-Memory
-    output logic [31:0]  IF_addr_o,
-    output logic         IF_en_o,
-    input logic  [31:0]  IF_data_i,
-    output logic [31:0]  IF_data_o,
-    output logic [3:0]   IF_write_o,
+    wb_master_bus_t      IF_wb_bus,
 // MEM-Memory
     output logic [31:0]  MEM_addr_o,
     output logic         MEM_en_o,
@@ -41,8 +37,6 @@ module core_top (
 
 
 assign rst_reqn_o = rstn_i;
-assign IF_data_o = 'b0;
-assign IF_write_o = 'b0;
 
 //IF-ID
 logic                ID_IF_ack;
@@ -113,10 +107,7 @@ IF_stage IF_i (
     .valid_o     ( IF_ID_valid   ),
     .instr_o     ( IF_ID_instr   ),
     .pc_o        ( IF_ID_pc      ),
-    //TODO: Cache
-    .MEM_en_o    ( IF_en_o      ),
-    .MEM_addr_o  ( IF_addr_o     ),
-    .MEM_data_i  ( IF_data_i     ),
+    .wb_bus      ( IF_wb_bus     ),
     //Branching
     .branch_i    ( branch        ),
     .pc_i        ( EX_MEM_result )
diff --git a/rtl/core/pipelineStages/instructionFetch/IF_stage.sv b/rtl/core/pipelineStages/instructionFetch/IF_stage.sv
index 9958d43..b00d960 100644
--- a/rtl/core/pipelineStages/instructionFetch/IF_stage.sv
+++ b/rtl/core/pipelineStages/instructionFetch/IF_stage.sv
@@ -26,10 +26,8 @@ module IF_stage (
     output logic         valid_o,
     output logic  [31:0] instr_o,
     output logic  [31:0] pc_o,
-    //IF-MEM (TODO: cache)
-    output logic         MEM_en_o,
-    output logic [31:0]  MEM_addr_o,
-    input logic [31:0]   MEM_data_i,
+    //Memory
+    wb_master_bus_t      wb_bus,
     //Branching
     input logic [31:0]   pc_i,
     input logic          branch_i
@@ -38,6 +36,9 @@ module IF_stage (
 logic incr_pc;
 logic [31:0] pc_n;
 logic [31:0] pc_q;
+logic [31:0] mem_data;
+logic read;
+logic read_valid;
 
 // Data register, 2x32 bit + valid: instr, pc
 struct packed {
@@ -46,27 +47,44 @@ struct packed {
     logic [31:0]    pc;
 } data_n, data_q;
 
-assign MEM_addr_o = pc_q;
 
 assign valid_o = data_q.valid;
 assign instr_o = data_q.instr;
 assign pc_o = data_q.pc;
 
+load_unit lu_i
+(
+    .clk                ( clk       ),
+    .rstn_i             ( rstn_i    ),
+    .read_i             ( read      ),
+    .addr_i             ( pc_q      ),
+    .valid_o            ( read_valid),
+    .data_o             ( mem_data  ),
+    .wb_bus             ( wb_bus    )
+);
+
 always_comb
 begin
-    MEM_en_o = 1'b1;
+    read    = 1'b0;
     data_n  = data_q;
     incr_pc = 1'b0;
 
+    if(ack_i)
+        data_n.valid = 1'b0;
+
     if((!data_q.valid || ack_i)) begin
-        data_n         = {1'b1, MEM_data_i, pc_q};
-        incr_pc        = 1'b1;
+        read = 1'b1;
+        if(read_valid) begin
+            data_n         = {1'b1, mem_data, pc_q};
+            incr_pc        = 1'b1;
+        end
     end
 
     // Invalidate if flush and use the provided pc
     if(flush_i) begin
         data_n.valid     = 1'b0;
         incr_pc          = 1'b0;
+        read             = 1'b0;
     end
 end
 
diff --git a/rtl/core_wrapper.sv b/rtl/core_wrapper.sv
index a8bd753..666752d 100644
--- a/rtl/core_wrapper.sv
+++ b/rtl/core_wrapper.sv
@@ -17,6 +17,7 @@
 //
 // ------------------------------------------------------------
 
+/* verilator lint_off PINMISSING */
 module core_wrapper
 (
     input wire          clk,
@@ -26,19 +27,16 @@ module core_wrapper
 );
 
 wire        rst_reqn;
