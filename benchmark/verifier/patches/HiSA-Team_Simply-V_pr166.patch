+            "lr.d t0, (%1)\n"
+            "sc.d %0, %2, (%1)\n"
+            : "=r"(success)
+            : "r"(addr), "r"(new_val)
+            : "t0", "memory"
+        );
+        return success;
+    }
+
+    // LR.D.aq / SC.D.rl function
