diff --git a/hw/units/custom_hls_conv_hbus/assets/conv_hbus/hw/src/krnl_conv_hbus.cpp b/hw/units/custom_hls_conv_hbus/assets/conv_hbus/hw/src/krnl_conv_hbus.cpp
