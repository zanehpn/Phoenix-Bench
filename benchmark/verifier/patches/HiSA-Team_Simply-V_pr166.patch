+            .s_axi_bready   ( sync_HLS_CONTROL_axi_bready   ),
+            .s_axi_arid     ( sync_HLS_CONTROL_axi_arid     ),
+            .s_axi_araddr   ( sync_HLS_CONTROL_axi_araddr   ),
+            .s_axi_arlen    ( sync_HLS_CONTROL_axi_arlen    ),
+            .s_axi_arsize   ( sync_HLS_CONTROL_axi_arsize   ),
