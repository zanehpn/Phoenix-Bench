+            .s_axi_awsize   ( sync_HLS_CONTROL_axi_awsize   ),
+            .s_axi_awburst  ( sync_HLS_CONTROL_axi_awburst  ),
+            .s_axi_awvalid  ( sync_HLS_CONTROL_axi_awvalid  ),
