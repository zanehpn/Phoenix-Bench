+        int success;
+        asm volatile (
+            "lr.d.aq t0, (%1)\n"
+            "sc.d.rl %0, %2, (%1)\n"
+            : "=r"(success)
+            : "r"(addr), "r"(new_val)
+            : "t0", "memory"
+        );
+        return success;
+    }
+
+    // LR.D.aqrl / SC.D.aqrl function
