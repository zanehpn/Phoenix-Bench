 reg        rvfm_hwrite_dph;
 reg [1:0]  rvfm_htrans_dph;
 reg [2:0]  rvfm_hsize_dph;
+reg        rvfm_hexcl_dph;
 
 always @ (posedge clk) begin
 	if (bus_aph_ready_d) begin
