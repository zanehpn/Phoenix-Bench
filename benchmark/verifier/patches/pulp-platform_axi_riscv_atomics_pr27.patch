From a47d265364e904250fd4830a61c12f4f62682feb Mon Sep 17 00:00:00 2001
From: Nils Wistoff <nwistoff@iis.ee.ethz.ch>
Date: Wed, 2 Aug 2023 17:35:28 +0200
Subject: [PATCH] [fix] lrsc: Add missing sequential logic for aw_wait reg

Signed-off-by: Nils Wistoff <nwistoff@iis.ee.ethz.ch>
---
 src/axi_riscv_lrsc.sv | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/axi_riscv_lrsc.sv b/src/axi_riscv_lrsc.sv
index 53f8c7c..4fc4f66 100644
--- a/src/axi_riscv_lrsc.sv
+++ b/src/axi_riscv_lrsc.sv
@@ -1040,6 +1040,7 @@ module axi_riscv_lrsc #(
             clr_addr_q = '0;
             clr_len_q  = '0;
             clr_id_q   = '0;
+            aw_wait_q  = '0;
         end else begin
             ar_state_q = ar_state_d;
             aw_state_q = aw_state_d;
@@ -1047,6 +1048,7 @@ module axi_riscv_lrsc #(
             clr_addr_q = clr_addr_d;
             clr_len_q  = clr_len_d;
             clr_id_q   = clr_id_d;
+            aw_wait_q  = aw_wait_d;
         end
     end
 
