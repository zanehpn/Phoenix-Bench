+//+define+SIM_ONLY
 -f ../../../source/core_rrv/core_rrv_rtl_list.f
 -f ../../../verif/core_rrv/tb/core_rrv_verif_list.f

From 18446a3069e937c1de3b6aad7a00a3cf9abecdb8 Mon Sep 17 00:00:00 2001
