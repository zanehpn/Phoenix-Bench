From bf19b5ebdcbf8344a41b4431be2b88ac1dd6077b Mon Sep 17 00:00:00 2001
From: Henrik Fegran <Henrik.Fegran@silabs.com>
Date: Mon, 31 Jul 2023 12:45:46 +0200
Subject: [PATCH] Fixed issue #893 mpu sva vs pma rtl mismatch

Signed-off-by: Henrik Fegran <Henrik.Fegran@silabs.com>
---
 sva/cv32e40x_mpu_sva.sv | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/sva/cv32e40x_mpu_sva.sv b/sva/cv32e40x_mpu_sva.sv
index 5b1b7c54..af4aec74 100644
--- a/sva/cv32e40x_mpu_sva.sv
+++ b/sva/cv32e40x_mpu_sva.sv
@@ -229,11 +229,12 @@ module cv32e40x_mpu_sva import cv32e40x_pkg::*; import uvm_pkg::*;
   logic        pma_expected_err;
   logic        pma_expected_misaligned_err;
   always_comb begin
-    pma_expected_cfg = NO_PMA_R_DEFAULT;
     if (PMA_NUM_REGIONS) begin
       pma_expected_cfg = is_pma_dbg_matched ? '{main    : 1'b1, default : '0} :
                          is_pma_matched     ? PMA_CFG[pma_lowest_match]       : PMA_R_DEFAULT;
-
+    end else begin
+      pma_expected_cfg = is_pma_dbg_matched ? '{main    : 1'b1, default : '0} :
+                         NO_PMA_R_DEFAULT;
     end
   end
   assign pma_expected_err = (instr_fetch_access && !pma_expected_cfg.main)  ||
