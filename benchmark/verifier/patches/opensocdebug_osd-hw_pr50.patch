From 758c8ebf9600a2ee575420f0872f1355608d2cbe Mon Sep 17 00:00:00 2001
From: Philipp Wagner <philipp.wagner@tum.de>
Date: Wed, 17 Oct 2018 13:31:43 +0200
Subject: [PATCH 5/8] DEM UART: Give correct information in the LSR

Previously, the UART LSR was hardcoded to always have data available to
be received. This is wrong, instead the actual FIFO status must be used.
---
 modules/dem_uart/common/osd_dem_uart_16550.sv |  8 ++++++--
 modules/dem_uart/test/test_dem_uart_wb.py     | 15 ++++++++++++++-
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/modules/dem_uart/common/osd_dem_uart_16550.sv b/modules/dem_uart/common/osd_dem_uart_16550.sv
index 23b315f..c8deb57 100644
--- a/modules/dem_uart/common/osd_dem_uart_16550.sv
+++ b/modules/dem_uart/common/osd_dem_uart_16550.sv
@@ -224,8 +224,12 @@ module osd_dem_uart_16550
                bus_ack = bus_req;
             end
             REG_LSR: begin
-               // TEMT=1, THRE=1, DR (data ready) when input
-               bus_rdata = {7'b0110000, in_valid};
+               // Line Status Register (LSR)
+               bus_rdata = 8'h0;
+               bus_rdata[BIT_LSR_DR] = in_valid;
+               bus_rdata[BIT_LSR_TEMT] = out_ready;
+               bus_rdata[BIT_LSR_THRE] = out_ready;
+
                bus_ack = bus_req;
             end
             default: begin
diff --git a/modules/dem_uart/test/test_dem_uart_wb.py b/modules/dem_uart/test/test_dem_uart_wb.py
index f7bfb38..cc698b3 100644
--- a/modules/dem_uart/test/test_dem_uart_wb.py
+++ b/modules/dem_uart/test/test_dem_uart_wb.py
@@ -119,8 +119,14 @@ def _bus_to_di_tx(dut, num_transfers=500, max_delay=100, random_data=False):
         for _ in range(delay):
             yield RisingEdge(dut.clk)
 
-        data = random.randint(0, 255) if random_data else 0x42
+        # Wait until the UART signals that it is ready for writes
+        while True:
+            lsr_can_write = yield _lsr_can_write(dut, wb_master)
+            if lsr_can_write:
+                break
+            yield RisingEdge(dut.clk)
 
+        data = random.randint(0, 255) if random_data else 0x42
         _bus_to_di_fifo.append(data)
 
         yield wb_master.send_cycle([WBOp(adr=0x0, dat=data, sel=0x8)])
@@ -206,6 +212,13 @@ def _di_to_bus_rx(dut, num_transfers=500, max_delay=100):
         for _ in range(delay):
             yield RisingEdge(dut.clk)
 
+        # Wait until the UART signals that it is ready for a read
+        while True:
+            lsr_can_read = yield _lsr_can_read(dut, wb_master)
+            if lsr_can_read:
+                break
+            yield RisingEdge(dut.clk)
+
         # Only look at the LSB of the 32-bit wide result.
         ret = yield wb_master.send_cycle([WBOp(adr=0x0, dat=None, sel=0x8)])
         res = ret.pop(0).datrd & 0xFF

