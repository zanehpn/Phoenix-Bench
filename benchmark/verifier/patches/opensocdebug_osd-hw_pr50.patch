          erbfi <= nxt_erbfi;
          etbei <= nxt_etbei;
          elsi <= nxt_elsi;
@@ -135,6 +124,8 @@ module osd_dem_uart_16550
    logic dlab;
    assign dlab = lcr[7];
 
+   assign bus_ack = bus_req;
+
    always_comb begin
       nxt_erbfi = erbfi;
       nxt_etbei = etbei;
@@ -150,51 +141,45 @@ module osd_dem_uart_16550
       out_valid = 1'b0;
       in_ready = 1'b0;
       bus_rdata = 8'h0;
-      bus_ack = 1'b0;
 
-      if (req) begin
-         case (addr)
+      if (bus_req) begin
