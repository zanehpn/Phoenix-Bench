+//    Thomas Leyk <thomas.leyk@tum.de>
 
 import dii_package::dii_flit;
 
@@ -97,16 +98,8 @@ module osd_dem_uart_16550
    logic        nxt_fifo_tx_clear;
    logic        nxt_dma_mode;
 
-   reg          req;
-   reg [2:0]    addr;
-   reg          write;
-
    always_ff @(posedge clk) begin
       if (rst) begin
-         req <= 1'b0;
