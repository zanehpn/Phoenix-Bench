-logic csr_mcycle_overflow;
-logic csr_minstret_overflow;
 logic [63:0] csr_minstret_high_low;
 logic [63:0] csr_mcycle_high_low;
 logic CsrMstatusMieBit, CsrMieMieBit;
@@ -49,10 +47,10 @@ logic left_lfsr_bit;
 // ==============================================================================
 // mtime and mtimecmp
