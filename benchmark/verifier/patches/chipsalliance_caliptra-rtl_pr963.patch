From 4e7b177771b4d18f7bf81d9d1cc88be80956ecc3 Mon Sep 17 00:00:00 2001
From: Michael Norris <michnorris@microsoft.com>
Date: Tue, 26 Aug 2025 20:45:32 -0700
Subject: [PATCH 04/16] remove flop stuck at reset to avoid lint error

---
 src/sha3/rtl/kmac_app.sv | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/sha3/rtl/kmac_app.sv b/src/sha3/rtl/kmac_app.sv
index 144b77939..43e36711c 100644
--- a/src/sha3/rtl/kmac_app.sv
+++ b/src/sha3/rtl/kmac_app.sv
@@ -624,6 +624,11 @@ module kmac_app
       (st_d == StIdle)                                                      ? 1'b0 : // clear
       err_during_sw_q;                                                               // hold
 
+`ifdef CALIPTRA
+      // In Caliptra st_d can never leave StIdle, so this flop is stuck in reset state.
+      // Remoing it to avoid lint errors.
+  assign err_during_sw_q = '0;
+`else
   always_ff @(posedge clk_i or negedge rst_ni) begin
     if (!rst_ni) begin
       err_during_sw_q <= 1'b0;
@@ -631,6 +636,7 @@ module kmac_app
       err_during_sw_q <= err_during_sw_d;
     end
   end
+  `endif
 
   //////////////
   // Datapath //

