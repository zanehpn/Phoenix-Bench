+
+  pulpino_spi_master_ip_env_cfg_h = pulpino_spi_master_env_config::type_id::create("pulpino_spi_master_ip_env_cfg_h");
+  pulpino_spi_master_ip_env_cfg_h.no_of_spi_slaves  = 1;
