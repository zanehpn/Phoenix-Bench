+  spi_fd_8b_slave_seq  spi_fd_8b_slave_seq_h;
+  
+  //-------------------------------------------------------
+  // Externally defined Tasks and Functions
+  //-------------------------------------------------------
+  extern function new(string name ="pulpino_spi_master_ip_virtual_basic_write_seq");
+  extern task body();
+
