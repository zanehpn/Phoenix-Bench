From 70ddff947d4629e1720b8bd82973fb0bb849c4b5 Mon Sep 17 00:00:00 2001
From: Bruno Duarte Gouveia <bgouveia@gmail.com>
Date: Sat, 29 Dec 2018 22:25:30 +0000
Subject: [PATCH 1/2] SAVE: fixed backup ram save and load

---
 Gameboy.sv | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Gameboy.sv b/Gameboy.sv
index e8985f5..1567c2c 100644
--- a/Gameboy.sv
+++ b/Gameboy.sv
@@ -648,8 +648,8 @@ dpram #(16) cram_l (
 	.q_a (cram_q_l),
 	
 	.clock_b (clk_sys),
-	.address_b (bk_addr[16:1]),
-	.wren_b (bk_wr & ~bk_addr[0]),
+	.address_b (bk_addr[15:0]),
+	.wren_b (bk_wr),
 	.data_b (bk_data[7:0]),
 	.q_b (bk_q[7:0])
 );
@@ -662,8 +662,8 @@ dpram #(16) cram_h (
 	.q_a (cram_q_h),
 	
 	.clock_b (clk_sys),
-	.address_b (bk_addr[16:1]),
-	.wren_b (bk_wr & bk_addr[0]),
+	.address_b (bk_addr[15:0]),
+	.wren_b (bk_wr),
 	.data_b (bk_data[15:8]),
 	.q_b (bk_q[15:8])
 );

