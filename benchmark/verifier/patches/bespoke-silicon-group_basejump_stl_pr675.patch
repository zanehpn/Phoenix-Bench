From e346ad7ce1749142c27855e2d2126ff64e378ab7 Mon Sep 17 00:00:00 2001
From: Marcus Mellor <infinitymdm@gmail.com>
Date: Mon, 11 Mar 2024 15:01:11 -0500
Subject: [PATCH] bsg_mem/bsg_mem_1rw_sync_mask_write_bit_from_1r1w.sv: Fix
 variable order

Reorder variable declarations so that addr_li is not referenced before its declaration
---
 bsg_mem/bsg_mem_1rw_sync_mask_write_bit_from_1r1w.sv | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/bsg_mem/bsg_mem_1rw_sync_mask_write_bit_from_1r1w.sv b/bsg_mem/bsg_mem_1rw_sync_mask_write_bit_from_1r1w.sv
index 2cc7f01f4..25542a8b5 100644
--- a/bsg_mem/bsg_mem_1rw_sync_mask_write_bit_from_1r1w.sv
+++ b/bsg_mem/bsg_mem_1rw_sync_mask_write_bit_from_1r1w.sv
@@ -62,11 +62,10 @@ module bsg_mem_1rw_sync_mask_write_bit_from_1r1w #(
     );
 
   wire [addr_width_lp-1:0]  w_addr_r;
+  wire [addr_width_lp-1:0]  addr_li = els_p > 1 ? addr_i : '0;
   wire                      addr_match = w_addr_r == addr_li;
   wire                      bypass_n = v_and_w_r & addr_match;
   wire                      bypass_r;
-  
-  wire [addr_width_lp-1:0]  addr_li = els_p > 1 ? addr_i : '0;
 
   bsg_dff_en
     #(.width_p(addr_width_lp+1))
