From 64b1582ab0e2ecc887e84a67d363c9abb1344d4d Mon Sep 17 00:00:00 2001
From: moritz <moritz@moore.mosaic-soc.ch>
Date: Thu, 17 Jul 2025 14:33:10 +0200
Subject: [PATCH 1/3] Refactor Source side CDC for lint compliance

---
 src/cdc_fifo_gray.sv | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/cdc_fifo_gray.sv b/src/cdc_fifo_gray.sv
index a4e3d839..bba54d47 100644
--- a/src/cdc_fifo_gray.sv
+++ b/src/cdc_fifo_gray.sv
@@ -192,10 +192,12 @@ module cdc_fifo_gray_src #(
 
   // Data FIFO.
   assign async_data_o = data_q;
-  for (genvar i = 0; i < 2**LOG_DEPTH; i++) begin : gen_word
-    `FFLNR(data_q[i], src_data_i,
-          src_valid_i & src_ready_o & (wptr_bin[LOG_DEPTH-1:0] == i), src_clk_i)
+
+  always_comb begin
+    data_d                          = data_q;
+    data_d[wptr_bin[LOG_DEPTH-1:0]] = src_data_i;
   end
+  `FFLARN(data_q, data_d, src_valid_i & src_ready_o, '0, src_clk_i, src_rst_ni)
 
   // Read pointer.
   for (genvar i = 0; i < PtrWidth; i++) begin : gen_sync

