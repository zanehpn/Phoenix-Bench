 test_regress/t/t_vlt_timing.v   | 39 ++++++++++++++
 test_regress/t/t_vlt_timing.vlt | 10 ++--
 test_regress/t/t_vlt_warn.v     |  4 ++
 9 files changed, 160 insertions(+), 37 deletions(-)
