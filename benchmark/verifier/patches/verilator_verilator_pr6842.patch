-            warnOn(V3ErrorCode::WIDTHTRUNC, flag);
-            warnOn(V3ErrorCode::WIDTHEXPAND, flag);
-            warnOn(V3ErrorCode::WIDTHXZEXPAND, flag);
+            warnSet(subset, V3ErrorCode::WIDTHTRUNC, flag);
+            warnSet(subset, V3ErrorCode::WIDTHEXPAND, flag);
