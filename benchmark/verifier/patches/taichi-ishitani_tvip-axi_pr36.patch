From e2d29ef857fe73a8ec33747ad25e6717951e25ea Mon Sep 17 00:00:00 2001
From: Taichi Ishitani <taichi730@gmail.com>
Date: Thu, 19 May 2022 14:51:32 +0900
Subject: [PATCH] add null check to avoid null pointer exception

(refs: #35)
---
 src/tvip_axi_slave_driver.svh | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/src/tvip_axi_slave_driver.svh b/src/tvip_axi_slave_driver.svh
index 264546b..d0f3054 100644
--- a/src/tvip_axi_slave_driver.svh
+++ b/src/tvip_axi_slave_driver.svh
@@ -47,7 +47,6 @@ class tvip_axi_slave_driver_start_delay_consumer;
       automatic tvip_axi_id __id  = id;
       delay_thread(__id);
     join_none
-    //#0;
   endtask
 
   protected task delay_thread(tvip_axi_id id);
@@ -63,7 +62,7 @@ class tvip_axi_slave_driver_start_delay_consumer;
       join_any
       disable fork;
 
-      if (!item.item.ended()) begin
+      if ((item.item != null) && (!item.item.ended())) begin
         parent.end_tr(item.item);
       end
 
