Subject: [PATCH 1/4] Fix the reg reset issue to make all riscof test passing

---
 CONTRIBUTORS.md                       | 4 +++-
 src/Instruction_Decode/RegisterFile.v | 9 +++++----
 2 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/CONTRIBUTORS.md b/CONTRIBUTORS.md
index eb63b6e..ab8fd9b 100644
--- a/CONTRIBUTORS.md
+++ b/CONTRIBUTORS.md
@@ -20,4 +20,6 @@ Boris Potapov (TheDeepestSpace)
 
 Mihir Maringanti
 
-Marwan Ismail (marwannismail)
\ No newline at end of file
+Marwan Ismail (marwannismail)
+
+Tony Zhu (RunzeZhu28)
\ No newline at end of file
diff --git a/src/Instruction_Decode/RegisterFile.v b/src/Instruction_Decode/RegisterFile.v
index f3a905c..8173ab7 100644
--- a/src/Instruction_Decode/RegisterFile.v
+++ b/src/Instruction_Decode/RegisterFile.v
@@ -33,10 +33,11 @@ module registerFile
 
   always @(posedge clk) begin
 
-    if (reset) RFMem[0] <= 0;
-
-    if (regWrite && Addr3 != 0) begin
-
+    if (reset) begin
+      for (int i = 0; i < 32; i = i + 1) begin
+            RFMem[i] <= 32'b0;
+        end
+    end else if (regWrite && Addr3 != 0) begin
       RFMem[Addr3] <= dataIn; //write into destination register if RegWrite = 1
 
     end

From d17bdcca69f013364c2378bc8fdb02d75fadb901 Mon Sep 17 00:00:00 2001
From: TonyZhu <1207555640@qq.com>
Date: Mon, 1 Dec 2025 19:58:46 -0500
Subject: [PATCH 2/4] Add the macro of TESTBENCH

---
 Makefile                              | 3 ++-
 src/Instruction_Decode/RegisterFile.v | 4 ++++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 4e9db9d..a216bde 100644
--- a/Makefile
+++ b/Makefile
@@ -8,6 +8,7 @@ VVP 		 :=vvp
 # = /opt/iverilog-12/bin/vvp
 
 ENV := simulation
+TB_MACROS := -DTESTBENCH
 
 SRCS := $(shell find $(SRC_DIR) -name "*.sv" -o -name "*.v") \
         $(shell find $(ENVS_DIR)/$(ENV) -name "*.sv" -o -name "*.v")
@@ -45,7 +46,7 @@ $(OUTPUT): $(SRCS)
 	$(IVERILOG) -g2012 -o $(OUTPUT) $(SRCS)
 
 $(TB_OUT_PATTERN): $(TB_SRC_PATTERN) $(TB_UTILS) $(SRCS)
-	$(IVERILOG) -g2012 -o $@ $(SRCS) $<
+	$(IVERILOG) $(TB_MACROS) -g2012 -o $@ $(SRCS) $<
 
 new_tb:
 	@if [ -z "$(name)" ]; then \
diff --git a/src/Instruction_Decode/RegisterFile.v b/src/Instruction_Decode/RegisterFile.v
index 8173ab7..37b460b 100644
--- a/src/Instruction_Decode/RegisterFile.v
+++ b/src/Instruction_Decode/RegisterFile.v
@@ -34,9 +34,13 @@ module registerFile
   always @(posedge clk) begin
 
     if (reset) begin
+    `ifndef TESTBENCH
       for (int i = 0; i < 32; i = i + 1) begin
             RFMem[i] <= 32'b0;
         end
+    `else 
+      RFMem[0] <= 32'b0;
+    `endif
     end else if (regWrite && Addr3 != 0) begin
       RFMem[Addr3] <= dataIn; //write into destination register if RegWrite = 1
 

