-    logic [ENTRIES-1:0] select
-  );
-    logic [INDEX_WIDTH-1:0] index;
-    for (int i = 0;i < INDEX_WIDTH;++i) begin
-      logic [ENTRIES-1:0] temp;
-      for (int j = 0;j < ENTRIES;++j) begin
-        temp[j] = select[j] & j[i];
-      end
-      index[i]  = |temp;
-    end
-    return index;
-  endfunction
