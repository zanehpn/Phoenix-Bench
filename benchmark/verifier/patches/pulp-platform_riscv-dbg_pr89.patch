From d7483db8597c22e3f19fd21057a3bbb2e9b8f317 Mon Sep 17 00:00:00 2001
From: Arjan Bink <Arjan.Bink@silabs.com>
Date: Mon, 12 Oct 2020 09:04:42 -0500
Subject: [PATCH] Fix for issue #77 and #88

Signed-off-by: Arjan Bink <Arjan.Bink@silabs.com>
---
 src/dmi_jtag.sv     | 2 +-
 src/dmi_jtag_tap.sv | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/dmi_jtag.sv b/src/dmi_jtag.sv
index 2039e25..fb09927 100644
--- a/src/dmi_jtag.sv
+++ b/src/dmi_jtag.sv
@@ -162,7 +162,7 @@ module dmi_jtag #(
       error_d = DMIBusy;
     end
     // clear sticky error flag
-    if (dmi_reset && dtmcs_select) begin
+    if (update_dr && dmi_reset && dtmcs_select) begin
       error_d = DMINoError;
     end
   end
diff --git a/src/dmi_jtag_tap.sv b/src/dmi_jtag_tap.sv
index 3d11145..c2e8d6e 100644
--- a/src/dmi_jtag_tap.sv
+++ b/src/dmi_jtag_tap.sv
@@ -156,7 +156,7 @@ module dmi_jtag_tap #(
                       dmireset     : 1'b0,
                       zero0        : '0,
                       idle         : 3'd1, // 1: Enter Run-Test/Idle and leave it immediately
-                      dmistat      : dmi_error_i, // 0: No error, 1: Op failed, 2: too fast
+                      dmistat      : dmi_error_i, // 0: No error, 2: Op failed, 3: too fast
                       abits        : 6'd7, // The size of address in dmi
                       version      : 4'd1  // Version described in spec version 0.13 (and later?)
                     };
