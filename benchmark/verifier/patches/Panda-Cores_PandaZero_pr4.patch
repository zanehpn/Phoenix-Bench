diff --git a/rtl/memory/ram.sv b/rtl/memory/ram.sv
new file mode 100644
index 0000000..b0f1b5b
--- /dev/null
+++ b/rtl/memory/ram.sv
@@ -0,0 +1,64 @@
+// ------------------------ Disclaimer -----------------------
+// No warranty of correctness, synthesizability or 
+// functionality of this code is given.
+// Use this code under your own risk.
+// When using this code, copy this disclaimer at the top of 
+// Your file
+//
+// (c) Luca Hanel 2020
+//
+// ------------------------------------------------------------
+//
+// Module name: ram
+// 
+// Functionality: Single port ram
+//
+// ------------------------------------------------------------
+
+module ram #(
+    parameter SIZE = 1024
+)(
+    input logic           clk,
+    input logic           rstn_i,
+    input logic [31:0]    addr_i,
+    input logic           en_i,
+    input logic [3:0]     we_i,
+    input logic [31:0]    din_i,
+    output logic [31:0]   dout_o
+);
+
+logic [31:0]    addr;
+
+(*ram_style = "block" *) reg [31:0] data[SIZE];
+
+assign addr = $signed(addr_i >> 2);
+
+always_comb
+begin
+    if(en_i)
+        dout_o = data[addr];
+end
+
+always_ff @(posedge clk, negedge rstn_i)
+begin
+    if(!rstn_i) begin
+    end else begin
+        if(en_i) begin
+            case(we_i)
+                4'b1111:
+                    data[addr] <= din_i;
+                
+                4'b0011:
+                    data[addr][15:0] <= din_i[15:0];
+                
+                4'b0001:
+                    data[addr][7:0] <= din_i[7:0];
+                
+                default: begin
+                end
+            endcase
+        end
+    end
+end
+
+endmodule
