From 957e6c7d2b656c71cbcba38647c515850052ead5 Mon Sep 17 00:00:00 2001
From: marwannismail <marwan.ismail2004@gmail.com>
Date: Mon, 13 Oct 2025 14:44:52 -0400
Subject: [PATCH] Passed funct7 = instr[31:25] for IType_logic instructions

---
 src/Instruction_Decode/Instruction_Decode.v | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/Instruction_Decode/Instruction_Decode.v b/src/Instruction_Decode/Instruction_Decode.v
index 1bc3e80..eb70945 100644
--- a/src/Instruction_Decode/Instruction_Decode.v
+++ b/src/Instruction_Decode/Instruction_Decode.v
@@ -26,14 +26,14 @@ module Instruction_Decode(
 	//combinational logic for extracting funct3 and funct7[5] for ALU Decoder input
 	always@(*) begin
 
-		if (opcode == RType) begin //R-Type
+		if (opcode == RType || opcode == IType_logic) begin //R-Type
 
 			funct3 = instr[14:12];
 			funct7 = instr[31:25];
 
 		end
 
-		else if (opcode == IType_logic || opcode == IType_load ||
+		else if (opcode == IType_load ||
             opcode == SType || opcode == BType) begin
 
 			funct3 = instr[14:12];
