-      logic [31:0] exp_3; // 32 bits wide target
+      logic [27:0] dst_3; // 28 bits wide target
+      logic [27:0] exp_3; // 28 bits wide target
 
       string expv;
       string gotv;
@@ -57,7 +57,7 @@ module t;
       // verilator lint_off WIDTHEXPAND
