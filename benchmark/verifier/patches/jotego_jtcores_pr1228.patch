From 9b02007c158a84d51d8dfe753b69ea70fe033ed1 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Wed, 15 Oct 2025 10:19:14 +0200
Subject: [PATCH 1/2] Shadow used in riders_obj. Fixes #1220

---
 cores/riders/hdl/jtriders_video.v | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cores/riders/hdl/jtriders_video.v b/cores/riders/hdl/jtriders_video.v
index b369c99ab..fa23a5b30 100644
--- a/cores/riders/hdl/jtriders_video.v
+++ b/cores/riders/hdl/jtriders_video.v
@@ -379,7 +379,7 @@ assign oramd = lgtnfght ? cpu_dout : oram_din;
 assign oramw = lgtnfght ? {2{cpu_we}}&~cpu_dsn : oram_we;
 assign vmux  = vrender;
 /* verilator tracing_on */
-jtriders_obj #(.RAMW(13),.HFLIP_OFFSET(10'd325)) u_obj(    // sprite logic
+jtriders_obj #(.RAMW(13),.HFLIP_OFFSET(10'd325),.SHADOW (1)) u_obj(    // sprite logic
     .rst        ( rst       ),
     .clk        ( clk       ),
     .pxl_cen    ( pxl_cen   ),

From 22a0313f50f92f594d32c4dc6a852849ddbb88f7 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Wed, 15 Oct 2025 14:31:34 +0200
Subject: [PATCH 2/2] No shadow for Mist/Sidi

---
 cores/riders/cfg/macros.def       | 1 +
 cores/riders/hdl/jtriders_video.v | 4 +++-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/cores/riders/cfg/macros.def b/cores/riders/cfg/macros.def
index 4f61c8d1f..ebbd51569 100644
--- a/cores/riders/cfg/macros.def
+++ b/cores/riders/cfg/macros.def
@@ -39,6 +39,7 @@ NODIMMING
 
 [mist|sidi]
 NOPSAC
+NOSHADOW
 
 [sidi]
 NOTMNT2
diff --git a/cores/riders/hdl/jtriders_video.v b/cores/riders/hdl/jtriders_video.v
index fa23a5b30..d88ecbd9a 100644
--- a/cores/riders/hdl/jtriders_video.v
+++ b/cores/riders/hdl/jtriders_video.v
@@ -133,6 +133,8 @@ module jtriders_video(
     output     [ 7:0] st_dout
 );
 
+localparam SHADOW = `ifdef NOSHADOW 0 `else 1 `endif;
+
 wire [31:0] sort_f, sort_a, sort_b;
 wire [21:2] lyro_prea;
 wire [15:0] cpu_saddr, dump_addr;
@@ -379,7 +381,7 @@ assign oramd = lgtnfght ? cpu_dout : oram_din;
 assign oramw = lgtnfght ? {2{cpu_we}}&~cpu_dsn : oram_we;
 assign vmux  = vrender;
 /* verilator tracing_on */
-jtriders_obj #(.RAMW(13),.HFLIP_OFFSET(10'd325),.SHADOW (1)) u_obj(    // sprite logic
+jtriders_obj #(.RAMW(13),.HFLIP_OFFSET(10'd325),.SHADOW(SHADOW)) u_obj(    // sprite logic
     .rst        ( rst       ),
     .clk        ( clk       ),
     .pxl_cen    ( pxl_cen   ),
