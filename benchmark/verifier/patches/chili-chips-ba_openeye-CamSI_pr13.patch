From df2200c484a4af7abf846aa498925e9cbce20dde Mon Sep 17 00:00:00 2001
From: Juninho99 <azunic1@etf.unsa.ba>
Date: Mon, 3 Jun 2024 16:01:28 +0200
Subject: [PATCH 1/2] Fixed I2C reset first issue

---
 1.hw/lib/ip/i2c_master/i2c_ctrl.sv | 6 +++---
 1.hw/lib/ip/i2c_master/i2c_top.sv  | 8 ++++----
 1.hw/misc/clkrst_gen.sv            | 4 ++--
 1.hw/top.sv                        | 2 +-
 4 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/1.hw/lib/ip/i2c_master/i2c_ctrl.sv b/1.hw/lib/ip/i2c_master/i2c_ctrl.sv
index 7ca7824..f118209 100644
--- a/1.hw/lib/ip/i2c_master/i2c_ctrl.sv
+++ b/1.hw/lib/ip/i2c_master/i2c_ctrl.sv
@@ -39,7 +39,7 @@
 module i2c_ctrl (
    input  logic        clk,
    input  logic        strobe_400kHz,
-   input  logic        reset,
+   input  logic        areset_n,
 
    input  logic        enable,
    input  logic        read_write,
@@ -79,8 +79,8 @@ module i2c_ctrl (
    assign bit_cnt_dec = 4'(bit_cnt - 4'd1);
    
 
-   always_ff @(posedge reset or posedge clk) begin
-      if (reset == 1'b1) begin
+   always_ff @(negedge areset_n or posedge clk) begin
+      if (areset_n == 1'b0) begin
          register_done         <= 1'b0;
          state                 <= IDLE;
          post_state            <= IDLE;
diff --git a/1.hw/lib/ip/i2c_master/i2c_top.sv b/1.hw/lib/ip/i2c_master/i2c_top.sv
index edc9ec0..a908417 100644
--- a/1.hw/lib/ip/i2c_master/i2c_top.sv
+++ b/1.hw/lib/ip/i2c_master/i2c_top.sv
@@ -43,7 +43,7 @@ module i2c_top (
  //clocks and resets
    input  logic  clk,
    input  logic  strobe_400kHz, // 400kHz strobe synchrnous to 'clk'
-   input  logic  reset,         // active-1 synchronous reset
+   input  logic  areset_n,      // active-1 synchronous reset
 
  //I/O pads
    inout  wire   i2c_scl,
@@ -75,7 +75,7 @@ module i2c_top (
     i2c_ctrl u_ctrl (
        .clk              (clk),            //i 
        .strobe_400kHz    (strobe_400kHz),  //i 
-       .reset            (reset),          //i 
+       .areset_n         (areset_n),          //i 
 
        .enable           (i2c_enable),     //i 
        .read_write       (i2c_read_write), //i 
@@ -108,8 +108,8 @@ module i2c_top (
     end
 `endif
    
-    always_ff @(posedge reset or posedge clk) begin
-       if (reset == 1'b1) begin
+    always_ff @(negedge areset_n or posedge clk) begin
+       if (areset_n == 1'b0) begin
           i2c_enable       <= 1'b1;
           i2c_read_write   <= 1'b0;
           i2c_slave_addr   <= '0;
diff --git a/1.hw/misc/clkrst_gen.sv b/1.hw/misc/clkrst_gen.sv
index abe90ee..2d64487 100644
--- a/1.hw/misc/clkrst_gen.sv
+++ b/1.hw/misc/clkrst_gen.sv
@@ -124,7 +124,7 @@ module clkrst_gen
          rst_delay_cnt <= '0; 
 
          cam_en        <= 1'b0;
-         i2c_reset     <= 1'b1;
+         i2c_reset     <= 1'b0;
       end 
       else if (strobe_400kHz == 1'b1) begin
 
@@ -146,7 +146,7 @@ module clkrst_gen
           
                 // I2C exits reset after 4 secs, 
                 //  to then start initializing camera
-                i2c_reset <= (rst_delay_cnt < 4'd4);
+                i2c_reset <= (rst_delay_cnt > 4'd4);
             end            
          end
       end // if (strobe_400kHz == 1'b1)
diff --git a/1.hw/top.sv b/1.hw/top.sv
index 14bbff8..3bbbf7c 100644
--- a/1.hw/top.sv
+++ b/1.hw/top.sv
@@ -107,7 +107,7 @@ glbl glbl();
      //clocks and resets
       .clk           (clk_100),       //i
       .strobe_400kHz (strobe_400kHz), //i
-      .reset         (i2c_reset),     //i
+      .areset_n      (i2c_reset),     //i
 
      //I2C_Master to Camera
       .i2c_scl       (i2c_scl),       //io 

From c7dd6d0d01e429d267dd894d3e9f0c4403c76c43 Mon Sep 17 00:00:00 2001
From: Juninho99 <azunic1@etf.unsa.ba>
Date: Tue, 4 Jun 2024 19:15:28 +0200
Subject: [PATCH 2/2] Minor clean up

---
 1.hw/lib/ip/i2c_master/i2c_top.sv | 13 ++++++-------
 1.hw/misc/clkrst_gen.sv           |  2 +-
 1.hw/top.sv                       |  4 +++-
 3 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/1.hw/lib/ip/i2c_master/i2c_top.sv b/1.hw/lib/ip/i2c_master/i2c_top.sv
index a908417..d04fe9f 100644
--- a/1.hw/lib/ip/i2c_master/i2c_top.sv
+++ b/1.hw/lib/ip/i2c_master/i2c_top.sv
@@ -38,12 +38,14 @@
 //   - for most part operates in sync with external 400kHz strobe
 //========================================================================
 
-module i2c_top (
+module i2c_top #(
+   parameter I2C_SLAVE_ADDR = 7'd16 
+)(
 
  //clocks and resets
    input  logic  clk,
    input  logic  strobe_400kHz, // 400kHz strobe synchrnous to 'clk'
-   input  logic  areset_n,      // active-1 synchronous reset
+   input  logic  areset_n,      // active-0 asynchronous reset
 
  //I/O pads
    inout  wire   i2c_scl,
@@ -56,7 +58,6 @@ module i2c_top (
 //--------------------------------
     logic        i2c_enable;
     logic        i2c_read_write;
-    logic [6:0]  i2c_slave_addr;
 
     logic [15:0] i2c_reg_addr;
     logic [6:0]  i2c_reg_cnt;
@@ -79,7 +80,7 @@ module i2c_top (
 
        .enable           (i2c_enable),     //i 
        .read_write       (i2c_read_write), //i 
-       .slave_address    (i2c_slave_addr), //i[6:0] 
+       .slave_address    (I2C_SLAVE_ADDR), //i[6:0] 
        .register_address (i2c_reg_addr),   //i[15:0] 
        .data_in          (i2c_data_in),    //i[7:0] 
        .register_done    (i2c_reg_done),   //o 
@@ -112,7 +113,6 @@ module i2c_top (
        if (areset_n == 1'b0) begin
           i2c_enable       <= 1'b1;
           i2c_read_write   <= 1'b0;
-          i2c_slave_addr   <= '0;
           i2c_reg_addr     <= '0;
           i2c_reg_cnt      <= '0;
           i2c_reg_cnt_done <= 1'b0;
@@ -120,12 +120,11 @@ module i2c_top (
        end 
        else if ({strobe_400kHz, i2c_reg_cnt_done} == 2'b10) begin
           i2c_enable       <= 1'b1;
-          i2c_slave_addr   <= 7'd16;   
           i2c_reg_addr     <= i2c_data_init[i2c_reg_cnt][23:8];
           i2c_data_in      <= i2c_data_init[i2c_reg_cnt][7:0];
 
           if (i2c_reg_done == 1'd1) begin
-             if (i2c_reg_cnt < 7'd65) begin
+             if (i2c_reg_cnt < 7'd64) begin
                 i2c_reg_cnt <= 7'(i2c_reg_cnt + 7'd1);
              end
              else begin
diff --git a/1.hw/misc/clkrst_gen.sv b/1.hw/misc/clkrst_gen.sv
index 2d64487..f518472 100644
--- a/1.hw/misc/clkrst_gen.sv
+++ b/1.hw/misc/clkrst_gen.sv
@@ -146,7 +146,7 @@ module clkrst_gen
           
                 // I2C exits reset after 4 secs, 
                 //  to then start initializing camera
-                i2c_reset <= (rst_delay_cnt > 4'd4);
+                i2c_reset <= (rst_delay_cnt > 4'd3);
             end            
          end
       end // if (strobe_400kHz == 1'b1)
diff --git a/1.hw/top.sv b/1.hw/top.sv
index 3bbbf7c..3513359 100644
--- a/1.hw/top.sv
+++ b/1.hw/top.sv
@@ -103,7 +103,9 @@ glbl glbl();
 //--------------------------------
 // I2C Master
 //--------------------------------
-   i2c_top u_i2c  (
+   i2c_top  #(
+      .I2C_SLAVE_ADDR (7'd16)
+   ) u_i2c  (
      //clocks and resets
       .clk           (clk_100),       //i
       .strobe_400kHz (strobe_400kHz), //i
