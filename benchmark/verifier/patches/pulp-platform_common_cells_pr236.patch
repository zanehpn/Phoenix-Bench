From ff6ac5fdc88faecf8d107bbd63175cf83969e0a6 Mon Sep 17 00:00:00 2001
From: Riccardo Tedeschi <riccardo.tedeschi6@unibo.it>
Date: Mon, 30 Sep 2024 14:34:42 +0200
Subject: [PATCH] stream_join_dynamic: Assert inp readies only for selected
 streams

---
 src/stream_join_dynamic.sv | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/stream_join_dynamic.sv b/src/stream_join_dynamic.sv
index 16551bee..41ad52b8 100644
--- a/src/stream_join_dynamic.sv
+++ b/src/stream_join_dynamic.sv
@@ -34,7 +34,7 @@ module stream_join_dynamic #(
   // Corner case when `sel_i` is all 0s should not generate valid
   assign oup_valid_o = &(inp_valid_i | ~sel_i) && |sel_i;
   for (genvar i = 0; i < N_INP; i++) begin : gen_inp_ready
-    assign inp_ready_o[i] = oup_valid_o & oup_ready_i;
+    assign inp_ready_o[i] = oup_valid_o & oup_ready_i & sel_i[i];
   end
 
 `ifndef SYNTHESIS
