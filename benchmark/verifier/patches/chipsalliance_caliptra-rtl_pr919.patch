 1 file changed, 2 insertions(+)

diff --git a/src/axi/rtl/axi_if.sv b/src/axi/rtl/axi_if.sv
index f23fc050f..cfcaae41a 100644
--- a/src/axi/rtl/axi_if.sv
+++ b/src/axi/rtl/axi_if.sv
@@ -176,6 +176,7 @@ interface axi_if #(parameter integer AW = 32, parameter integer DW = 32, paramet
     `endif
 
     `ifndef SYNTHESIS
+    `ifndef XCELIUM
         task rst_mgr();
             araddr  `EQ__ '0;
             arburst `EQ__ AXI_BURST_FIXED;
@@ -395,6 +396,7 @@ interface axi_if #(parameter integer AW = 32, parameter integer DW = 32, paramet
                     .resp_user(resp_user));
         endtask
     `endif
+    `endif
 
     `undef EQ__
     `undef TIME_ALGN

