 cores/karnov/hdl/jtkarnov_game.v |  5 ++++-
 cores/karnov/hdl/jtkarnov_main.v | 14 +++++++++++---
 5 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/cores/karnov/cfg/files.yaml b/cores/karnov/cfg/files.yaml
index 8e54e5fa8..131bda81e 100644
--- a/cores/karnov/cfg/files.yaml
+++ b/cores/karnov/cfg/files.yaml
@@ -25,6 +25,9 @@ jtframe:
     unless: [NOMCU]
     get:
       - jtframe_8751.yaml
+  - from: debug
+    get:
+      - jtframe_simdumper.v
   - from: ram
     get:
       - jtframe_ram.v
diff --git a/cores/karnov/cfg/macros.def b/cores/karnov/cfg/macros.def
index 1d4169bfb..cbd3de7fd 100644
--- a/cores/karnov/cfg/macros.def
+++ b/cores/karnov/cfg/macros.def
@@ -27,4 +27,6 @@ JTFRAME_WIDTH=256
 JTFRAME_HEIGHT=240
 
 JTFRAME_ARX=5
-JTFRAME_ARY=4
\ No newline at end of file
+JTFRAME_ARY=4
+
+debug JTFRAME_IOCTL_RD=8216
\ No newline at end of file
diff --git a/cores/karnov/cfg/mem.yaml b/cores/karnov/cfg/mem.yaml
index 544c40759..99d0d55e3 100644
--- a/cores/karnov/cfg/mem.yaml
+++ b/cores/karnov/cfg/mem.yaml
@@ -55,12 +55,14 @@ bram:
     data_width: 16
     addr_width: 11
     sim_file: true
+    ioctl: { save: true, order: 0 }
     dual_port: { name: main, we: vram_we, rw: true }
 
   - name: scrram
     data_width: 16
     addr_width: 11
     sim_file: true
+    ioctl: { save: true, order: 1 }
     dual_port: { name: main, we: scrram_we, rw: true }
 
   - name: objram
@@ -68,6 +70,7 @@ bram:
     addr_width: 12
     addr: dma_addr
     sim_file: true
+    ioctl: { save: true, order: 2 }
     dual_port: { name: main, we: objram_we, rw: true }
 
   - name: objbuf
diff --git a/cores/karnov/hdl/jtkarnov_game.v b/cores/karnov/hdl/jtkarnov_game.v
index cf44e71d8..f9d877831 100644
--- a/cores/karnov/hdl/jtkarnov_game.v
+++ b/cores/karnov/hdl/jtkarnov_game.v
@@ -46,7 +46,8 @@ assign objram_we  = {2{objram_cs & ~main_wrn}} & ~main_dsn;
 assign sdtkn = 0;
 
 always @(posedge clk) begin
-    if( ioctl_addr=='h163 ) wndrplnt <= prog_data==2;
+    if( ioctl_addr=='h163 && !ioctl_ram )
+        wndrplnt <= prog_data==2;
 end
 
 jtkarnov_main u_main(
@@ -106,6 +107,8 @@ jtkarnov_main u_main(
     .dipsw      ( dipsw[15:0]   ),
 
     // Debug
+    .ioctl_addr ( ioctl_addr[1:0]),
+    .ioctl_din  ( ioctl_din     ),
     .st_addr    ( debug_bus     ),
     .st_dout    ( st_main       )
 );
diff --git a/cores/karnov/hdl/jtkarnov_main.v b/cores/karnov/hdl/jtkarnov_main.v
index f19d181cc..5d450c810 100644
--- a/cores/karnov/hdl/jtkarnov_main.v
+++ b/cores/karnov/hdl/jtkarnov_main.v
@@ -75,6 +75,8 @@ module jtkarnov_main(
     input       [15:0] dipsw,
 
     // Debug
+    input    [1:0]     ioctl_addr,
+    output   [7:0]     ioctl_din,
     input    [7:0]     st_addr,
     output   [7:0]     st_dout
 );
@@ -278,16 +280,15 @@ assign sonreq   = 0;
 assign RnW      = 1;
 assign st_dout  = 0;
 assign secreq   = 0;
-assign flip     = 0;
 assign mcu_din  = 0;
 assign dsn      = 3;
 // Read the scroll values in simulation
 reg [8:0] scrfile[0:1];
 
 initial begin
-    $readmemh( "scrpos.hex", scrfile);
+    // $readmemh( "scrpos.hex", scrfile);
     scrx = scrfile[0];
-    scry = scrfile[1];
+    // scry = scrfile[1];
 end
 always @(negedge LVBL) begin
     scrx <= scrx+1'd1;
@@ -295,4 +296,11 @@ end
 always @(posedge clk) dmarq <= LVBL;
 
 `endif
+
+jtframe_simdumper #(.DW(19)) dumper(
+    .clk        ( clk           ),
+    .data       ( {flip,scry,`ifndef NOMAIN scrx `else scrfile[0] `endif} ),
+    .ioctl_addr ( ioctl_addr    ),
+    .ioctl_din  ( ioctl_din     )
+);
 endmodule
\ No newline at end of file

