 src/fuse_ctrl/templates/fuse_ctrl_mmap.h.tpl  | 113 +--
 src/integration/rtl/fuse_ctrl_mmap.c          | 664 ++++++++++++++++
 src/integration/rtl/fuse_ctrl_mmap.h          | 708 ++----------------
 tools/scripts/Makefile                        |   8 +
 .../gen_fuse_ctrl_partitions.py               |  19 +-
 6 files changed, 845 insertions(+), 758 deletions(-)
 create mode 100644 src/fuse_ctrl/templates/fuse_ctrl_mmap.c.tpl
 create mode 100644 src/integration/rtl/fuse_ctrl_mmap.c

