-                        id_d     = slv_aw_id_i;
-                        size_d   = slv_aw_size_i;
-                        cache_d  = slv_aw_cache_i;
-                        prot_d   = slv_aw_prot_i;
-                        qos_d    = slv_aw_qos_i;
