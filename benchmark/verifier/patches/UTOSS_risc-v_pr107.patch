diff --git a/envs/de1-soc/poc/Makefile b/envs/de1-soc/poc/Makefile
new file mode 100644
index 0000000..c5bfa10
--- /dev/null
+++ b/envs/de1-soc/poc/Makefile
@@ -0,0 +1,21 @@
+RISCV_PREFIX := riscv32-unknown-elf
+RISCV_GCC := $(RISCV_PREFIX)-gcc
+RISCV_OBJCOPY := $(RISCV_PREFIX)-objcopy
+
+all: poc.mem
+
+poc.elf: poc.c link.ld
+	$(RISCV_GCC) -march=rv32i -mabi=ilp32 -mno-relax \
+		-static -mcmodel=medany -fvisibility=hidden \
+		-nostdlib -nostartfiles -g \
+		-T link.ld \
+		poc.c \
+		-o $@
+
+poc.mem: poc.elf
+	$(RISCV_OBJCOPY) -O verilog --verilog-data-width=4 $< $@
+
+clean:
+	rm poc.elf poc.mem
+
+.PHONY: clean
diff --git a/envs/de1-soc/poc/link.ld b/envs/de1-soc/poc/link.ld
new file mode 100644
index 0000000..25be50a
--- /dev/null
+++ b/envs/de1-soc/poc/link.ld
@@ -0,0 +1,31 @@
+OUTPUT_ARCH( "riscv" )
+ENTRY(main)
+
+SECTIONS
+{
+  . = 0x00000000;
+
+  .text : {
+    *(.text)
+    *(.text.*)
+  }
+
+  .rodata : {
+    *(.rodata)
+    *(.rodata.*)
+  }
+
+  .data : {
+    *(.data)
+    *(.data.*)
+  }
+
+  .bss : {
+    *(.bss)
+    *(.bss.*)
+    *(COMMON)
+  }
+
+  _end = .;
+}
+
diff --git a/envs/de1-soc/poc/poc.c b/envs/de1-soc/poc/poc.c
new file mode 100644
index 0000000..492b6f6
--- /dev/null
+++ b/envs/de1-soc/poc/poc.c
@@ -0,0 +1,7 @@
+#define LEDR ((volatile int*)0x10000000)
+
