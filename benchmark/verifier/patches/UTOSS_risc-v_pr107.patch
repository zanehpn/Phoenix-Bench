index 383957a..4e9db9d 100644
--- a/Makefile
+++ b/Makefile
@@ -111,13 +111,3 @@ svlint_tb:
 
 .PHONY: all run svlint svlint_tb build_top run_top build_tb run_tb new_tb
 
-# tmp
-
-DE1_SOC_SRCS := $(shell find $(SRC_DIR) -name "*.sv" -o -name "*.v") \
-        			  $(shell find $(ENVS_DIR)/de1-soc -name "*.sv" -o -name "*.v")
-
-envs/de1-soc/top_tb.vvp: $(DE1_SOC_SRCS)
-	$(IVERILOG) -g2012 -o $@ $(DE1_SOC_SRCS)
-
-run_de1_soc_top_tb: envs/de1-soc/top_tb.vvp
-	$(VVP) -N $<
diff --git a/envs/de1-soc/Makefile b/envs/de1-soc/Makefile
new file mode 100644
index 0000000..35a8035
--- /dev/null
+++ b/envs/de1-soc/Makefile
@@ -0,0 +1,19 @@
+IVERILOG := iverilog
+VVP 		 := vvp
+
+BASE_INCLUDE_DIR=../../
+CORE_SRC := $(shell find $(BASE_INCLUDE_DIR)src -name "*.sv" -o -name "*.v")
+LOCAL_SRCS := $(wildcard *.sv)
+
+all: run_tb
+
+poc:
+	$(MAKE) -C poc
+
+top_tb.vvp: poc $(LOCAL_SRCS) $(CORE_SRC)
+	$(IVERILOG) -g2012 -I$(BASE_INCLUDE_DIR) -o $@ $(LOCAL_SRCS) $(CORE_SRC)
+
+run_tb: top_tb.vvp
+	$(VVP) -N $<
+
+.PHONY: run_tb poc

