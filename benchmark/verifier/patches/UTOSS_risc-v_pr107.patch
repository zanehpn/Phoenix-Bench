From 1da5427fcb95a570b77383361163d19942f55adf Mon Sep 17 00:00:00 2001
From: Boris <boris.potapov@mail.utoronto.ca>
Date: Fri, 31 Oct 2025 00:15:14 +0000
Subject: [PATCH 06/30] update memory map for DE1-SoC env

---
 envs/de1-soc/MA.sv         | 20 --------------------
 envs/de1-soc/memory_map.sv | 37 +++++++++++++++++++++++++++++++++++++
 envs/de1-soc/top.sv        | 14 +++++++++++---
 quartus/utoss-risc-v.qsf   |  2 +-
 4 files changed, 49 insertions(+), 24 deletions(-)
 delete mode 100644 envs/de1-soc/MA.sv
 create mode 100644 envs/de1-soc/memory_map.sv

diff --git a/envs/de1-soc/MA.sv b/envs/de1-soc/MA.sv
deleted file mode 100644
index 493843c..0000000
--- a/envs/de1-soc/MA.sv
+++ /dev/null
@@ -1,20 +0,0 @@
-module MA #( parameter SIZE = 1024 )
-  ( input  wire   clk
-  , input  addr_t address
-  , input  data_t write_data
-  , input  logic  write_enable
-  , output data_t read_data
-  );
-
-    reg [31:0] M[0:SIZE -1];
-
-    initial $readmemh("poc.mem", M);
-
-    assign read_data = M[address[31:2]]; // 2 LSBs used for byte addressing
-    always @(posedge clk) begin
-        if (write_enable) begin
-            M[address[31:2]] <= write_data;
-        end
-    end
-
-endmodule
diff --git a/envs/de1-soc/memory_map.sv b/envs/de1-soc/memory_map.sv
new file mode 100644
index 0000000..0571466
--- /dev/null
+++ b/envs/de1-soc/memory_map.sv
@@ -0,0 +1,37 @@
+module memory_map #( parameter SIZE = 1024 )
+  ( input  wire   clk
+
+  , input  addr_t address
+  , input  data_t write_data
+  , input  logic  write_enable
+  , output data_t read_data
+
+  , output reg [9:0] LEDR
+  );
+
+    reg [31:0] M[0:SIZE -1];
+
+    // need to run make in the poc directory before this command can succeed
+    initial $readmemh("poc/poc.mem", M);
+
+    localparam LEDR_ADDRESS = 32'h10000000;
+
+    always_comb begin
+      case (address)
+        LEDR_ADDRESS: read_data = {22'b0, LEDR};
+        default: read_data = M[address[31:2]];
+      endcase
+    end
+
+    always @(posedge clk) begin
+      case (address)
+        LEDR_ADDRESS: LEDR <= write_data[9:0];
+        default: begin
+          if (write_enable) begin
+              M[address[31:2]] <= write_data;
+          end
+        end
+      endcase
+    end
+
+endmodule
diff --git a/envs/de1-soc/top.sv b/envs/de1-soc/top.sv
index f5b26d8..4927a86 100644
--- a/envs/de1-soc/top.sv
+++ b/envs/de1-soc/top.sv
@@ -9,18 +9,26 @@ module top
   logic  memory__write_enable;
   data_t memory__read_data;
 
-  MA #( .SIZE ( 8192 ) )
-    memory
-      ( .clk          ( clk                  )
+  memory_map #( .SIZE ( 8192 ) )
+    memory_map
+      ( .clk ( clk )
+
       , .address      ( memory__address      )
       , .write_data   ( memory__write_data   )
       , .write_enable ( memory__write_enable )
       , .read_data    ( memory__read_data    )
+
+      , .LEDR ( LEDR )
       );
 
   utoss_riscv core
     ( .clk   ( CLOCK_50 )
     , .reset ( KEY[0]   )
+
+    , .memory__address      ( memory__address      )
+    , .memory__write_data   ( memory__write_data   )
+    , .memory__write_enable ( memory__write_enable )
+    , .memory__read_data    ( memory__read_data    )
     );
 
 endmodule
