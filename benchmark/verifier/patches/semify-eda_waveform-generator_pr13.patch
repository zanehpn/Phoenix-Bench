-    assign cfg_sync_q_o             = cfg_sync_ff;
-    assign ctrl_en_q_o              = ctrl_en_ff;
-    
+
+    assign cfg_subcycle_q_o = cfg_subcycle_ff;
+    assign cfg_sync_q_o     = cfg_sync_ff;
+    assign ctrl_en_q_o      = ctrl_en_ff;
+
     //marker_template_end
