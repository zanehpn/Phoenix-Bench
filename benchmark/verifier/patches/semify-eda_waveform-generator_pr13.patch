From b3ce492db2b7562c15a9774555e6ec40bcdac3b1 Mon Sep 17 00:00:00 2001
From: mole99 <leomoser99@gmail.com>
Date: Mon, 6 Jun 2022 10:34:39 +0200
Subject: [PATCH 2/4] Remove unnecessary bloat

---
 fpga/ulx3s/soc/Makefile                    |   4 +-
 fpga/ulx3s/soc/csr.csv                     |  74 +++++++++++----------
 fpga/ulx3s/soc/firmware/firmware_build.bin | Bin 7148 -> 7148 bytes
 fpga/ulx3s/soc/firmware/firmware_build.elf | Bin 175984 -> 175848 bytes
 fpga/ulx3s/soc/firmware/firmware_sim.bin   | Bin 8100 -> 7684 bytes
 fpga/ulx3s/soc/firmware/firmware_sim.elf   | Bin 184516 -> 179448 bytes
 fpga/ulx3s/soc/ulx3s_soc.py                |  41 ------------
 fpga/ulx3s/ulx3s_top.sv                    |   8 +--
 8 files changed, 44 insertions(+), 83 deletions(-)

diff --git a/fpga/ulx3s/soc/Makefile b/fpga/ulx3s/soc/Makefile
index cef6741..4390d13 100644
--- a/fpga/ulx3s/soc/Makefile
+++ b/fpga/ulx3s/soc/Makefile
@@ -7,10 +7,10 @@ firmware/firmware_build.bin:
 	cd firmware; make -f build.make clean; make -f build.make
 
 sim-prebuild:
-	python3 ulx3s_soc.py --with-analyzer --sim-debug --gtkwave-savefile --trace --trace-fst --with-wfg --simulate --cpu-type=femtorv
+	python3 ulx3s_soc.py --sim-debug --gtkwave-savefile --trace --trace-fst --with-wfg --simulate
 
 sim: firmware/firmware_sim.bin
-	python3 ulx3s_soc.py --rom-init=firmware/firmware_sim.bin --with-analyzer --sim-debug --gtkwave-savefile --trace --trace-fst --with-wfg --simulate --cpu-type=femtorv
+	python3 ulx3s_soc.py --rom-init=firmware/firmware_sim.bin --sim-debug --gtkwave-savefile --trace --trace-fst --with-wfg --simulate
 
 build-prebuild:
