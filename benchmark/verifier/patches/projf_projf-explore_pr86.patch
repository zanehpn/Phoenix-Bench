 // Learn more at https://projectf.io
 
 `default_nettype none
@@ -8,16 +8,22 @@
 module lfsr_tb();
 
     parameter CLK_PERIOD = 10;  // 10 ns == 100 MHz
-
+    parameter LEN  = 8;
+    parameter TAPS = 8'b10111000;
     logic rst;
     logic clk_100m;
     logic en;
-    logic [7:0] sreg;
+    logic [LEN-1:0] seed;
+    logic [LEN-1:0] sreg;
 
-    lfsr lfsr_inst (
+    lfsr #(
+        .LEN(LEN),
+        .TAPS(TAPS)
+        ) lfsr_inst (
         .clk(clk_100m),
         .rst,
         .en,
+        .seed,
         .sreg
     );
 
@@ -26,6 +32,7 @@ module lfsr_tb();
 
     initial begin
         rst = 1;
+        seed = '1;
         clk_100m = 1;
 
         #100 rst = 0;
