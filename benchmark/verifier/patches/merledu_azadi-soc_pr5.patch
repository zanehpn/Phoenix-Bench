-assign	G_4[10]=G_3[10];
-assign	G_4[12]=G_3[12];
-assign	G_4[14]=G_3[14];
-
-//stage 5
-wire	[15:0]G_5;
-assign	G_5[2]=G_4[2]&G_4[1];
-assign	G_5[4]=G_4[4]&G_4[3];
