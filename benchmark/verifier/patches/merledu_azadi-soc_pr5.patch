-assign	G_3[6]=G_2[6];
-assign	G_3[8]=G_2[8];
-assign	G_3[10]=G_2[10];
-assign	G_3[12]=G_2[12];
-assign	G_3[14]=G_2[14];
-
-//stage 4
-wire	[15:0]G_4;
-assign	G_4[9]=G_3[9]&G_3[1];
-assign	G_4[11]=G_3[11]&G_3[3];
-assign	G_4[13]=G_3[13]&G_3[5];
