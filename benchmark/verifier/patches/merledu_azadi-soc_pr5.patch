-              r_Clock_Count <= 0;
-              r_SM_Main     <= s_CLEANUP;
-            end
-        end // case: s_RX_STOP_BIT
-   
-       
-      // Stay here 1 clock
-      s_CLEANUP :
-        begin
-          r_SM_Main <= s_IDLE;
