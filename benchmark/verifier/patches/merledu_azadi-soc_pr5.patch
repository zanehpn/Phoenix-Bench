-                  r_Bit_Index <= 0;
-                  r_SM_Main   <= s_RX_STOP_BIT;
-                end
-            end
-        end // case: s_RX_DATA_BITS
-   
-   
-      // Receive Stop bit.  Stop bit = 1
-      s_RX_STOP_BIT :
-        begin
-          // Wait CLKS_PER_BIT-1 clock cycles for Stop bit to finish
-          if (r_Clock_Count < CLKS_PER_BIT-1)
