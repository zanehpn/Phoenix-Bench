From db10f234391121c23fc5a4e47e89408cb3d0b062 Mon Sep 17 00:00:00 2001
From: Michael Bedford Taylor <taylor-bsg@users.noreply.github.com>
Date: Tue, 23 Sep 2025 10:48:26 -0700
Subject: [PATCH] Define BSG_HIDE_FROM_SYNTHESIS_EXPR macro

Add macro for conditional synthesis hiding expression
---
 bsg_misc/bsg_defines.sv | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/bsg_misc/bsg_defines.sv b/bsg_misc/bsg_defines.sv
index 300ba6e0f..005501572 100644
--- a/bsg_misc/bsg_defines.sv
+++ b/bsg_misc/bsg_defines.sv
@@ -112,6 +112,12 @@
   `define BSG_HIDE_FROM_SYNTHESIS
 `endif
 
+`ifdef SYNTHESIS
+`define BSG_HIDE_FROM_SYNTHESIS_EXPR(val)
+`else
+`define BSG_HIDE_FROM_SYNTHESIS_EXPR(val) val
+`endif
+
 `define BSG_STRINGIFY(x) `"x`"
 
 
