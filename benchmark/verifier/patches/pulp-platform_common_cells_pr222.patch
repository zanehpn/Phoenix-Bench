From 350b6139229553e6b7f91f739c33b1db1689dac0 Mon Sep 17 00:00:00 2001
From: Nils Wistoff <nwistoff@iis.ee.ethz.ch>
Date: Wed, 15 May 2024 14:02:20 +0200
Subject: [PATCH] stream_arbiter_flushable: Do not lock prio arbiter

Setting `LockIn` while `ExtPrio = 1'b1` is disallowed by the
`rr_arb_tree` and has no effect. Furthermore, locking a decision with a
possibly lower priority violates the intent of the priority arbiter.

Therefore, clear the `LockIn` parameter for the priority arbiter.

Signed-off-by: Nils Wistoff <nwistoff@iis.ee.ethz.ch>
---
 src/stream_arbiter_flushable.sv | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/stream_arbiter_flushable.sv b/src/stream_arbiter_flushable.sv
index 2c456a32..5ba84bbe 100644
--- a/src/stream_arbiter_flushable.sv
+++ b/src/stream_arbiter_flushable.sv
@@ -58,7 +58,7 @@ module stream_arbiter_flushable #(
       .DataType   (DATA_T),
       .ExtPrio    (1'b1),
       .AxiVldRdy  (1'b1),
-      .LockIn     (1'b1)
+      .LockIn     (1'b0)
     ) i_arbiter (
       .clk_i,
       .rst_ni,
