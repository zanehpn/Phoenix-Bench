+	output reg [3:0] MemWrite,
 	output reg Branch,
 	output alu_src_a_t ALUSrcA,
 	output alu_src_b_t ALUSrcB,
@@ -115,7 +116,7 @@ module ControlFSM(
     pc_src <= 1'b0;
     PCUpdate <= 1'b0;
     IRWrite <= 1'b0;
