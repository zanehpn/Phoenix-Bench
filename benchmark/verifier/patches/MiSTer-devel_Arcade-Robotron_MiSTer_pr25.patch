 reg				pause_toggle	= 1'b0;					// User paused (active-high)
 reg [31:0]		pause_timer		= 1'b0;					// Time since pause
-reg [31:0]		dim_timeout		= (CLKSPD*10000000);	// Time until video output dim (10 seconds @ CLKSPD Mhz)
-
