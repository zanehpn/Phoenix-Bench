-	if(pause_cpu & options[dim_video])
+	if(reset)
+	begin
+		pause_cpu <= 1'b0;
+	end
+	else
+	begin
+		pause_cpu <= (pause_request | pause_toggle  | (OSD_STATUS & options[pause_in_osd]));
