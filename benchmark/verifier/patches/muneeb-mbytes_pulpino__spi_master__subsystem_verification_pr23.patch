+      bins TRANSFER_16BIT = {16};
+      bins TRANSFER_24BIT = {24};
+      bins TRANSFER_32BIT = {32};
+      bins TRANSFER_64BIT = {64};
+      bins TRANSFER_MANY_BITS = {[72:MAXIMUM_BITS]};
