+      desc = "Reserved for further usage";
+
+      hw = na;
+      sw = r;
+      fieldwidth = 2;
+    } RESERVED6[7:6] = 2'h0;
+
+    field {
+      name = "SPI Command Length";
+      desc = "The number of bits of the SPI command that should be sent.";
+      //hdl_path_slice = "";
+      
+      hw = r;
+      sw = rw;
+      fieldwidth = 6;
