From 372c0d26639269b3f6bde4df75e7aa211541d225 Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Thu, 23 Oct 2025 11:30:48 +0200
Subject: [PATCH 2/6] correct HOFFSET and enable object in scene simulation
 again

---
 cores/rungun/hdl/jtrungun_video.v | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/cores/rungun/hdl/jtrungun_video.v b/cores/rungun/hdl/jtrungun_video.v
index 6b3fb544c..ecd04d6ad 100644
--- a/cores/rungun/hdl/jtrungun_video.v
+++ b/cores/rungun/hdl/jtrungun_video.v
@@ -91,6 +91,8 @@ module jtrungun_video(
     input            ioctl_ram
 );
 
+localparam EDGE_TRIGGER = `ifndef NOMAIN 1 `else 0 `endif;
+
 wire [31:0] fix_sort;
 wire [11:0] fix_code;
 wire [ 8:0] virt_hdumpf, obj_pxl, virt_hdump;
@@ -310,7 +312,8 @@ jtrungun_psac u_psac(
 
 localparam [9:0] OVOFFSET = 10'h111;
 
-jtsimson_obj #(.PACKED(0),.SHADOW(1),.K55673(1),.HOFFSET(10'd18),.EDGE_TRIGGER(1)) u_obj(    // sprite logic
+jtsimson_obj #(.PACKED(0),.SHADOW(1),.K55673(1),
+               .HOFFSET(10'd3),.EDGE_TRIGGER(EDGE_TRIGGER)) u_obj(    // sprite logic
     .rst        ( rst       ),
     .clk        ( clk       ),
     .pxl_cen    ( virt_cen  ),

From ab6b709a83a88d6681c73e7f691e7b8936780b3b Mon Sep 17 00:00:00 2001
From: Rafael Paiva <rafael.paiva@jotego.es>
Date: Thu, 23 Oct 2025 16:32:37 +0200
Subject: [PATCH 3/6] Fix sprites riders/paroda

---
 cores/simson/hdl/jt053246_dma.v | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cores/simson/hdl/jt053246_dma.v b/cores/simson/hdl/jt053246_dma.v
index 3e01918bd..39d9a53ea 100644
--- a/cores/simson/hdl/jt053246_dma.v
+++ b/cores/simson/hdl/jt053246_dma.v
@@ -102,7 +102,7 @@ always @(posedge clk) begin
             lvbl_sh    <= lvbl_sh<<1;
             lvbl_sh[0] <= lvbl;
         end
-        if(!dma_bsy && (trigger || (dma_44&&dma_en)) ) begin
+        if(!dma_bsy && (trigger || dma_44) ) begin
             dma_bsy  <= 1;
             dma_clr  <= 1;
             dma_wait <= !k44_en && mode8; // 8-bit speed: 595us, 16-bit: 297.5us

