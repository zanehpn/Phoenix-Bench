+mkdir ${RTL_DIR}
+
+#######################################
+# Fetch CVA6 sources and depencencies #
+#######################################
+
+# clone repo (Release v5.1.0 Jul 11 2024 (including H extension))
+GIT_URL=https://github.com/pulp-platform/cva6.git
