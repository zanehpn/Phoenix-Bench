--- /dev/null
+++ b/VerilogHDL_Practice/CH6/CH6-3/mid_test.v
@@ -0,0 +1,21 @@
+`timescale 1ns / 1ps
+
+module mid_test ();
+reg [3:0] A, B ,C;
+wire [3:0] X;
+
+mid UUT (.A(A), .B(B), .C(C), .Z(X));
+
+initial begin
+  #100 A = 4'b0011; B = 4'b0001; C = 4'b0010;
+  #100 A = 4'b0001; B = 4'b0101; C = 4'b0100;
+  #100 A = 4'b1110; B = 4'b1001; C = 4'b1111;
+  #100 A = 4'b0001; B = 4'b0001; C = 4'b0001;
+end
+
+initial begin
+  #500;
+    $finish;
+end
+
+endmodule // mid_test
