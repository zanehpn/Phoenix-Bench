diff --git a/VerilogHDL_Practice/CH6/CH6-4/shift_reg_for.v b/VerilogHDL_Practice/CH6/CH6-4/shift_reg_for.v
new file mode 100644
index 00000000..cfd88537
--- /dev/null
+++ b/VerilogHDL_Practice/CH6/CH6-4/shift_reg_for.v
@@ -0,0 +1,19 @@
+module shift_reg_for (clk, d, q1, q2);
+input clk, d;
+output [3:0] q1, q2;
+reg [3:0] q1, q2;
+integer i;
+
+//使用for迴圈，阻隔性指定敘述
+always @ (posedge clk) begin
+  for (i = 3; i > 0; i = i - 1)
+    q1[i] = q1[i-1];
+  q1[0] = d;
+end
+
+always @ (posedge clk) begin
+  for (i = 1; i <= 3; i = i + 1)
+    q2[i] <= q2[i-1];
+  q2[0] = d;
+end
+endmodule // shift_reg_for
diff --git a/VerilogHDL_Practice/CH6/CH6-4/shift_reg_for_test.v b/VerilogHDL_Practice/CH6/CH6-4/shift_reg_for_test.v
