From ee7ed6e9548c75c460f388ceb105eea08fa08324 Mon Sep 17 00:00:00 2001
From: Srinivasan Venkataramanan <svenka3@gmail.com>
Date: Fri, 29 Dec 2023 23:42:49 +0000
Subject: [PATCH] Added new rule for #178

---
 exec_dir/Makefile            |  1 +
 exec_dir/pyslint.log         |  9 +++++++++
 py_src/pyslint.py            | 23 +++++++++++++++++++++++
 sv_tests/test_issue_178_f.sv |  3 +++
 4 files changed, 36 insertions(+)
 create mode 100644 sv_tests/test_issue_178_f.sv

diff --git a/exec_dir/Makefile b/exec_dir/Makefile
index ec7450c..acf339e 100644
--- a/exec_dir/Makefile
+++ b/exec_dir/Makefile
@@ -102,6 +102,7 @@ naming:
 	python3 ../py_src/pyslint.py -t ../sv_tests/test_issue_163_f.sv >> pyslint.log
 	python3 ../py_src/pyslint.py -t ../sv_tests/test_issue_170_f.sv >> pyslint.log
 	python3 ../py_src/pyslint.py -t ../sv_tests/test_issue_174_f.sv >> pyslint.log
+	python3 ../py_src/pyslint.py -t ../sv_tests/test_issue_178_f.sv >> pyslint.log
 
 	cat pyslint.log
 
diff --git a/exec_dir/pyslint.log b/exec_dir/pyslint.log
index af6f152..babd1c4 100644
--- a/exec_dir/pyslint.log
+++ b/exec_dir/pyslint.log
@@ -1127,3 +1127,12 @@ PySlint: Violation: [COMPAT_SVA_PROP_MISSING_SEMI]: A Concurrent property defini
   property p_no_semi_ex;
     @(posedge clk) a |=> b
   endproperty : p_no_semi_ex
+PySlint: Violation: [NAME_CLASS_SUFFIX]: Improper naming of identifier:  abstract_ifc: expected suffix: _c
+PySlint: Violation: [COMPAT_CL_MISSING_PARAM_DEF_VAL]: Found a parameter in a class declaration
+	 without default value. Parameter name:  awidth
+	 Though IEEE 1800 LRM allows such usage some tools do NOT compile.
+	 To avoid compatibility issues, assign a default value to this parameter.
+PySlint: Violation: [COMPAT_CL_MISSING_PARAM_DEF_VAL]: Found a parameter in a class declaration
+	 without default value. Parameter name:  dwidth
+	 Though IEEE 1800 LRM allows such usage some tools do NOT compile.
+	 To avoid compatibility issues, assign a default value to this parameter.
diff --git a/py_src/pyslint.py b/py_src/pyslint.py
index bbb76d3..32c5f07 100644
--- a/py_src/pyslint.py
+++ b/py_src/pyslint.py
@@ -69,6 +69,7 @@ def pyslint_update_rule_ids():
   lv_sv_ruleid_l.append ('DBG_SVA_AST_MISSING_LABEL')
   lv_sv_ruleid_l.append ('DBG_SVA_ASM_MISSING_LABEL')
   lv_sv_ruleid_l.append ('DBG_SVA_COV_MISSING_LABEL')
+  lv_sv_ruleid_l.append('COMPAT_CL_MISSING_PARAM_DEF_VAL')
 
 '''
 with open("cfg.toml", mode="rb") as fp:
@@ -268,6 +269,27 @@ def FUNC_CNST_WRONG_OPER_PRI (lv_cu_scope):
               lv_rule_id = "FUNC_CNST_WRONG_OPER_PRI"
               pyslint_msg(lv_rule_id, msg)
 
+def COMPAT_CL_MISSING_PARAM_DEF_VAL(lv_m):
+  if (lv_m.kind.name == 'ClassDeclaration'):
+    if (not hasattr(lv_m, 'parameters')):
+      return
+    if (not hasattr(lv_m.parameters, 'declarations')):
+      return
+
+    for cl_param_i in lv_m.parameters.declarations:
+      if (hasattr(cl_param_i, 'declarators')):
+        for cl_p_d_i in cl_param_i.declarators:
+          if ((cl_p_d_i.initializer is None)):
+            msg = 'Found a parameter in a class declaration'
+            msg += '\n\t without default value. Parameter name: '
+            msg += str(cl_p_d_i)
+            msg += '\n\t Though IEEE 1800 LRM allows such usage'
+            msg += ' some tools do NOT compile.'
+            msg += '\n\t To avoid compatibility issues, assign a default'
+            msg += ' value to this parameter.'
+            lv_rule_id = "COMPAT_CL_MISSING_PARAM_DEF_VAL"
+            pyslint_msg(lv_rule_id, msg)
+
 def COMPAT_CG_OPT_PI_CL(lv_m):
   if (lv_m.kind.name == 'ClassDeclaration'):
     for cl_item_i in (lv_m.items):
@@ -1232,6 +1254,7 @@ def chk_naming(lv_cu_scope):
   COMPAT_SVA_NO_CONC_IN_FE(scope_i)
   COMPAT_SVA_NO_EXPECT_EXPR_IN_INIT(scope_i)
   COMPAT_CG_OPT_PI_CL(scope_i)
+  COMPAT_CL_MISSING_PARAM_DEF_VAL(scope_i)
   REUSE_CG_NO_ILBINS_CL(scope_i)
   PERF_CG_NO_ABIN_W_DEF_CL(scope_i)
   REUSE_NO_WILDC_AA_CL(scope_i)
diff --git a/sv_tests/test_issue_178_f.sv b/sv_tests/test_issue_178_f.sv
new file mode 100644
index 0000000..ac26684
--- /dev/null
+++ b/sv_tests/test_issue_178_f.sv
@@ -0,0 +1,3 @@
+class abstract_ifc #(int cwidth=1, int awidth, int dwidth);
+endclass : abstract_ifc
+
