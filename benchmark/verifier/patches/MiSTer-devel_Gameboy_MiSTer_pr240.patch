From 625d5c2255717a8d02c2c965d15403486f09f371 Mon Sep 17 00:00:00 2001
From: Mark Johnson <mark.ai.johnson@pm.me>
Date: Sun, 30 Apr 2023 21:14:43 +0100
Subject: [PATCH] Save state slot fix #174.

Thanks to @RobertPeip
---
 rtl/savestate_ui.sv | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/rtl/savestate_ui.sv b/rtl/savestate_ui.sv
index bfdb522..d2784ee 100644
--- a/rtl/savestate_ui.sv
+++ b/rtl/savestate_ui.sv
@@ -56,7 +56,6 @@ always @(posedge clk) begin
 	ss_info_req  <= 1'b0;
 	statusUpdate <= 1'b0;
 	
-	lastOSDsetting <= status_slot;
 	
 	if(allow_ss) begin
 	
@@ -70,7 +69,8 @@ always @(posedge clk) begin
 				'h0C: begin ss_save <= pressed & alt; ss_load <= pressed & ~alt; ss_base <= 3; statusUpdate <= 1'b1; end // F4
 			endcase
 		end
-		
+	
+		lastOSDsetting <= status_slot;
 		if (lastOSDsetting != status_slot) begin
 			ss_base      <= status_slot;
 			statusUpdate <= 1'b1;
