From 67291576d28540e1d5bda9be0435e8728ea816dd Mon Sep 17 00:00:00 2001
From: marwannismail <marwan.ismail2004@gmail.com>
Date: Sun, 12 Oct 2025 22:23:13 -0400
Subject: [PATCH 1/2] Set regWrite = 0 in Fetch for CFSM

---
 src/ControlFSM.sv | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/ControlFSM.sv b/src/ControlFSM.sv
index 2a53ca8..f08db5a 100644
--- a/src/ControlFSM.sv
+++ b/src/ControlFSM.sv
@@ -125,7 +125,8 @@ module ControlFSM(
 
 				AdrSrc <= ADR_SRC__PC;
 				IRWrite <= 1'b1;
-        PCUpdate <= 1'b1;
+       			PCUpdate <= 1'b1;
+				RegWrite <= 1'b0;
 
 			end
 

From 290ab12bd8bea23c4cbdaadedaac2bfa197fb97d Mon Sep 17 00:00:00 2001
From: marwannismail <marwan.ismail2004@gmail.com>
Date: Sun, 12 Oct 2025 22:33:03 -0400
Subject: [PATCH 2/2] Set regWrite = 0 by default for CFSM

---
 src/ControlFSM.sv | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/ControlFSM.sv b/src/ControlFSM.sv
index f08db5a..31bf453 100644
--- a/src/ControlFSM.sv
+++ b/src/ControlFSM.sv
@@ -116,6 +116,7 @@ module ControlFSM(
     PCUpdate <= 1'b0;
     IRWrite <= 1'b0;
     MemWrite <= 1'b0;
+	RegWrite <= 1'b0;
 
 		FSMState <= current_state;
 
@@ -126,7 +127,6 @@ module ControlFSM(
 				AdrSrc <= ADR_SRC__PC;
 				IRWrite <= 1'b1;
        			PCUpdate <= 1'b1;
-				RegWrite <= 1'b0;
 
 			end
 
@@ -176,7 +176,7 @@ module ControlFSM(
 				ALUSrcB <= ALU_SRC_B__4;
 				ALUOp <= 2'b00;
 				ResultSrc <= RESULT_SRC__ALU_OUT;
-        PCUpdate <= 1'b1;
+        		PCUpdate <= 1'b1;
 
 			end
 
@@ -195,8 +195,8 @@ module ControlFSM(
 				ALUOp <= 2'b01;
 				ResultSrc <= RESULT_SRC__ALU_OUT;
 				Branch <= 1'b1;
-        pc_src <= zero_flag ? PC_SRC__JUMP : PC_SRC__INCREMENT;
-        PCUpdate <= 1'b1;
+        		pc_src <= zero_flag ? PC_SRC__JUMP : PC_SRC__INCREMENT;
+        		PCUpdate <= 1'b1;
 
 			end
 
