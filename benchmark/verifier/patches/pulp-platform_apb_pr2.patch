diff --git a/src/apb_test.sv b/src/apb_test.sv
index 7feaaec..cc16b59 100644
--- a/src/apb_test.sv
+++ b/src/apb_test.sv
@@ -29,7 +29,7 @@ package apb_test;
     function void reset_master();
       apb.paddr   <= '0;
       apb.pprot   <= '0;
-      apb.psel    <= 1'b0;
+      apb.psel    <= '0;
       apb.penable <= 1'b0;
       apb.pwrite  <= 1'b0;
       apb.pwdata  <= '0;
@@ -52,17 +52,18 @@ package apb_test;
 
     task read(
       input  logic [31:0] addr,
+      input  int unsigned psel_idx,
       output logic [31:0] data,
