       cycle_end();
-      apb.penable <= #TA 1'b1;
+      apb.penable        <= #TA 1'b1;
       cycle_start();
       while (!apb.pready) begin
         cycle_end();
@@ -72,13 +73,14 @@ package apb_test;
       err   = apb.pslverr;
       cycle_end();
       apb.paddr   <= #TA '0;
-      apb.psel    <= #TA 1'b0;
