+  parameter type         data_t    = logic[DataWidth-1:0],
+  parameter type         strb_t    = logic[StrbWidth-1:0]
 ) (
   // APB Interface
-  input  logic        pclk_i,
-  input  logic        preset_ni,
-  input  logic [31:0] paddr_i,
-  input  logic  [2:0] pprot_i,
