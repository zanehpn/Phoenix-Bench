From 0cfa94721ba540d8d0be0286cfb335f833afb726 Mon Sep 17 00:00:00 2001
From: Alex Solomatnikov <solomatnikov@gmail.com>
Date: Sun, 31 Aug 2025 00:00:46 -0700
Subject: [PATCH] $urandom_range() instead of std::randomize() with {} to
 simplify & make compatible with verilator

---
 src/rand_stream_mst.sv            | 7 +------
 src/rand_synch_holdable_driver.sv | 8 ++------
 src/rand_verif_pkg.sv             | 7 +------
 3 files changed, 4 insertions(+), 18 deletions(-)

diff --git a/src/rand_stream_mst.sv b/src/rand_stream_mst.sv
index 8de55ee..dfc5505 100644
--- a/src/rand_stream_mst.sv
+++ b/src/rand_stream_mst.sv
@@ -31,12 +31,7 @@ module rand_stream_mst #(
   int unsigned rand_wait_cycles;
 
   function static void randomize_wait_cycles();
-    int unsigned rand_success;
-    rand_success = std::randomize(rand_wait_cycles) with {
-      rand_wait_cycles >= MinWaitCycles;
-      rand_wait_cycles <= MaxWaitCycles;
-    };
-    assert (rand_success) else $error("Failed to randomize wait cycles!");
+    rand_wait_cycles = $urandom_range(MaxWaitCycles,MinWaitCycles);
   endfunction
 
   initial begin
diff --git a/src/rand_synch_holdable_driver.sv b/src/rand_synch_holdable_driver.sv
index c0c6d39..1b6c3b0 100644
--- a/src/rand_synch_holdable_driver.sv
+++ b/src/rand_synch_holdable_driver.sv
@@ -26,16 +26,12 @@ module rand_synch_holdable_driver #(
 );
 
   initial begin
-    int unsigned rand_delay, rand_success;
+    int unsigned rand_delay;
     data_o = '0;
     wait (rst_ni);
     @(posedge clk_i);
     forever begin
-      rand_success = std::randomize(rand_delay) with {
-        rand_delay >= MinWaitCycles;
-        rand_delay <= MaxWaitCycles;
-      };
-      assert (rand_success) else $error("Failed to randomize wait cycles!");
+      rand_delay = $urandom_range(MaxWaitCycles,MinWaitCycles);
       repeat(rand_delay) begin
         @(posedge clk_i);
       end
diff --git a/src/rand_verif_pkg.sv b/src/rand_verif_pkg.sv
index b86091b..5fb05d3 100644
--- a/src/rand_verif_pkg.sv
+++ b/src/rand_verif_pkg.sv
@@ -14,12 +14,7 @@ package rand_verif_pkg;
 
   // Pick a random number from the interval [min, max] and wait for that number of clock cyles.
   task automatic rand_wait(input int unsigned min, max, ref logic clk);
-      int unsigned rand_success, cycles;
-      rand_success = std::randomize(cycles) with {
-          cycles >= min;
-          cycles <= max;
-      };
-      assert (rand_success) else $error("Failed to randomize wait cycles!");
+      int unsigned cycles = $urandom_range(max,min);
       repeat (cycles) @(posedge clk);
   endtask
 
