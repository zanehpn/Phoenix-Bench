+    uintptr_t base_addr;
+    xlnx_gpio_in_interrupt_conf_t interrupt;
+} xlnx_gpio_in_t;
+
+
+//All the Functions return UNINASOC_ERROR in case of error and UNINASOC_OK otherwise
