From 38d080b92e92fed4619aac2cae6895b5c4424601 Mon Sep 17 00:00:00 2001
From: Nastenka <152696529+rknastenka@users.noreply.github.com>
Date: Sat, 20 Dec 2025 01:02:03 +0300
Subject: [PATCH] Fix ready_reg initialization in aes_key_mem.v

---
 src/rtl/aes_key_mem.v | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/rtl/aes_key_mem.v b/src/rtl/aes_key_mem.v
index 2291706..a6f684d 100644
--- a/src/rtl/aes_key_mem.v
+++ b/src/rtl/aes_key_mem.v
@@ -139,7 +139,7 @@ module aes_key_mem(
           for (i = 0 ; i <= AES_256_NUM_ROUNDS ; i = i + 1)
             key_mem [i] <= 128'h0;
 
-          ready_reg        <= 1'b0;
+          ready_reg        <= 1'b1;
           rcon_reg         <= 8'h0;
           round_ctr_reg    <= 4'h0;
           prev_key0_reg    <= 128'h0;
