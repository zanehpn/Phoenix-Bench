From ff458442b4e569e6890661fc7b5b8e637902bd36 Mon Sep 17 00:00:00 2001
From: Michael Norris <michnorris@microsoft.com>
Date: Tue, 29 Jul 2025 09:00:05 -0700
Subject: [PATCH 4/9] fix flop coding that was causing synthesis issues

---
 src/abr_libs/rtl/abr_piso_multi.sv | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/abr_libs/rtl/abr_piso_multi.sv b/src/abr_libs/rtl/abr_piso_multi.sv
index f6a6918b..882a9189 100644
--- a/src/abr_libs/rtl/abr_piso_multi.sv
+++ b/src/abr_libs/rtl/abr_piso_multi.sv
@@ -61,7 +61,10 @@ module abr_piso_multi #(
 
   // Storage element
   always_ff @(posedge clk or negedge rst_b) begin
-    if (!rst_b || zeroize) begin
+    if (!rst_b) begin
+      buffer <= '0;
+      buffer_wr_ptr <= '0;
+    end else if (zeroize) begin
       buffer <= '0;
       buffer_wr_ptr <= '0;
     end else if (update_buffer) begin

From b30a625cfc5a933151aca00e4b3e240d1a2d475e Mon Sep 17 00:00:00 2001
From: Michael Norris <michnorris@microsoft.com>
Date: Tue, 29 Jul 2025 12:35:19 -0700
Subject: [PATCH 5/9] correct the decompress change, can't use the 1/5/11
 decomp logic for d of 12. Instead just check for out of range inputs and zero
 them so that compress check will fail

---
 src/decompress/rtl/decompress.sv             | 11 ++++-------
 src/decompress/rtl/decompress_defines_pkg.sv |  8 ++++----
 src/decompress/rtl/decompress_top.sv         | 18 +++++++++---------
 3 files changed, 17 insertions(+), 20 deletions(-)

diff --git a/src/decompress/rtl/decompress.sv b/src/decompress/rtl/decompress.sv
index 6035d9e8..c2ad6d85 100644
--- a/src/decompress/rtl/decompress.sv
+++ b/src/decompress/rtl/decompress.sv
@@ -16,9 +16,6 @@
 // decompress.sv
 // --------
 // Converts d-bit coefficients into 12-bit representation where d is the decompression level.
-// Based on input mode, d is selected and the following equation is performed:
-// ((data[11:0] << d) + q/2) / q
-// To efficiently perform /q operation, barrett reduction is used.
 
 module decompress
     import abr_params_pkg::*;
@@ -34,12 +31,12 @@ module decompress
     
     always_comb begin
         if (mode == 3) begin
-            op_o = op_i; // No decompression, just pass through
