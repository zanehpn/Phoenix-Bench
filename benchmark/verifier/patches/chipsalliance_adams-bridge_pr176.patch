From 42c7f3a3305bc66d65f1b03dd22dc4dadcc73f58 Mon Sep 17 00:00:00 2001
From: Michael Norris <michnorris@microsoft.com>
Date: Tue, 29 Jul 2025 08:56:05 -0700
Subject: [PATCH 1/9] fix gh issue 167 	the write address was not clearing
 after done, which could cause a second decompress call to terminate
 immediately

---
 src/decompress/rtl/decompress_ctrl.sv | 5 ++++-
 src/decompress/rtl/decompress_top.sv  | 6 ++++--
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/src/decompress/rtl/decompress_ctrl.sv b/src/decompress/rtl/decompress_ctrl.sv
index fb17f266..25b412da 100644
--- a/src/decompress/rtl/decompress_ctrl.sv
+++ b/src/decompress/rtl/decompress_ctrl.sv
@@ -43,6 +43,9 @@ module decompress_ctrl
         else if (zeroize) begin
             mem_wr_addr <= '0;
         end
+        else if (last_poly_last_addr_wr) begin
+            mem_wr_addr <= '0;
+        end
         else if (decompress_enable) begin
             mem_wr_addr <= dest_base_addr;
         end
@@ -62,4 +65,4 @@ module decompress_ctrl
             done <= last_poly_last_addr_wr;
     end
 
-endmodule
\ No newline at end of file
+endmodule
diff --git a/src/decompress/rtl/decompress_top.sv b/src/decompress/rtl/decompress_top.sv
index b5d1018b..260b2de3 100644
--- a/src/decompress/rtl/decompress_top.sv
+++ b/src/decompress/rtl/decompress_top.sv
@@ -42,13 +42,15 @@ module decompress_top
         output logic decompress_done
     );
 
+    localparam DECOMP_DATA_W = MLKEM_Q_WIDTH;
+
     logic api_rd_en_f;
     logic piso_hold_o;
     logic read_done;
     logic [3:0] d; // Decompression count
     logic piso_data_valid;
-    logic [48-1:0] piso_data_o; //FIXME magic number
-    logic [COEFF_PER_CLK-1:0][12-1:0] decompress_data_i; //FIXME magic number
+    logic [(COEFF_PER_CLK*DECOMP_DATA_W)-1:0] piso_data_o;
+    logic [COEFF_PER_CLK-1:0][DECOMP_DATA_W-1:0] decompress_data_i;
     logic [COEFF_PER_CLK-1:0][MLKEM_Q_WIDTH-1:0] decompress_data_o;
     logic [ABR_MEM_ADDR_WIDTH-1:0] mem_wr_addr;
     logic write_done;

From e24eca81073ce5fceee27978619bd61bb29c4fbe Mon Sep 17 00:00:00 2001
From: Michael Norris <michnorris@microsoft.com>
Date: Tue, 29 Jul 2025 08:57:54 -0700
Subject: [PATCH 2/9] fix gh issue 166 	done signal asserts early due to
 uncovered pipe stages in done calculation

---
 src/compress/rtl/compress_top.sv | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/compress/rtl/compress_top.sv b/src/compress/rtl/compress_top.sv
index 6f08c162..6e73c413 100644
--- a/src/compress/rtl/compress_top.sv
+++ b/src/compress/rtl/compress_top.sv
@@ -46,11 +46,11 @@ module compress_top
         output logic compress_done
     );
 
-    localparam COMP_DATA_W = 12; //FIXME magic number
+    localparam COMP_DATA_W = MLKEM_Q_WIDTH;
 
     logic [COEFF_PER_CLK-1:0][MLKEM_Q_WIDTH-1:0] compress_data_i, compress_data_o, compress_data;
     logic [COEFF_PER_CLK-1:0][MLKEM_Q_WIDTH-1:0] mem_rd_data_stalled;
-    logic [11:0] compress_data_valid; //FIXME magic number
+    logic [COMP_DATA_W-1:0] compress_data_valid;
     logic read_done;
     logic mem_rd_data_valid;
     logic mem_rd_data_hold,mem_rd_data_hold_f ;
@@ -58,7 +58,7 @@ module compress_top
     logic [DATA_WIDTH-1:0] buffer_data, buffer_data_f;
     logic compress_busy;
 
-    always_comb compress_done = compress_busy & read_done & ~(|api_rw_en) & ~buffer_valid_f;
+    always_comb compress_done = compress_busy & read_done & ~(mem_rd_data_valid | (|api_rw_en) | buffer_valid | buffer_valid_f);
 
     always_ff @(posedge clk or negedge reset_n) begin
         if (!reset_n) begin
@@ -191,4 +191,4 @@ module compress_top
         end
     end
 
-endmodule
\ No newline at end of file
+endmodule

From 8c41a4f6b012784d9f8e1ac7a8d8b994f21003c9 Mon Sep 17 00:00:00 2001
From: Michael Norris <michnorris@microsoft.com>
Date: Tue, 29 Jul 2025 08:58:59 -0700
Subject: [PATCH 3/9] rename reset/zeroize states of sequencer with ABR prefix
 since they are common add input check for encaps and decaps flows

---
