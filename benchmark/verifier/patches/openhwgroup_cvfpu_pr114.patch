Subject: [PATCH 3/4] =?UTF-8?q?=F0=9F=92=A1=20Add=20new=20operation=20to?=
 =?UTF-8?q?=20comment=20in=20multi=20FMA=20src?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 src/fpnew_fma_multi.sv | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/fpnew_fma_multi.sv b/src/fpnew_fma_multi.sv
index 064e4897..d8cab9b3 100644
--- a/src/fpnew_fma_multi.sv
+++ b/src/fpnew_fma_multi.sv
@@ -230,8 +230,8 @@ module fpnew_fma_multi #(
   // | FMADD    | \c 1        | FMSUB: Invert sign of operand C
   // | FNMSUB   | \c 0        | FNMSUB: Invert sign of operand A
   // | FNMSUB   | \c 1        | FNMADD: Invert sign of operands A and C
-  // | ADD      | \c 0        | ADD: Set operand A to +1.0
-  // | ADD      | \c 1        | SUB: Set operand A to +1.0, invert sign of operand C
+  // | ADD/ADDS | \c 0        | ADD: Set operand A to +1.0
+  // | ADD/ADDS | \c 1        | SUB: Set operand A to +1.0, invert sign of operand C
   // | MUL      | \c 0        | MUL: Set operand C to +0.0 or -0.0 depending on the rounding mode
   // | *others* | \c -        | *invalid*
   // \note \c op_mod_q always inverts the sign of the addend.

From ba48b596ccbd86e7f04a7a028e43c1d5e96da5a5 Mon Sep 17 00:00:00 2001
From: Michael Platzer <michael.platzer@axelera.ai>
Date: Tue, 7 May 2024 08:44:34 +0000
Subject: [PATCH 4/4] =?UTF-8?q?=F0=9F=93=9D=20Document=20new=20symmetric?=
 =?UTF-8?q?=20add=20operation?=
