+    -direction vertical \
+    -width 2 \
+    -spacing 1 \
+    -start_offset [expr $center_x-$input_buffer_width/2+$input_buffer_offset] \
+    -stop_offset [expr $FP_width-( $center_x+$input_buffer_width/2-$input_buffer_offset+1)] \
