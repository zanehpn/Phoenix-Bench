+    -block_ring_bottom_layer_limit M1 \
+    -use_wire_group 0 \
+    -snap_wire_center_to_grid None \
+    -skip_via_on_pin {standardcell} \
+    -skip_via_on_wire_shape {noshape} \
+    -extend_to design_boundary
+
+createRouteBlk -box \
+    [expr $center_x-10] \
+    [expr $origin1_y] \
+    [expr $center_x+10] \
+    [expr $origin1_y-30*$cell_height] \
