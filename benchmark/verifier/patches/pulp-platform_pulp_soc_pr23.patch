From e35adcaf440e37e0843ab9bf09728345d5a6fe6c Mon Sep 17 00:00:00 2001
From: bluew <bluewww@users.noreply.github.com>
Date: Fri, 24 Jan 2020 13:42:21 +0000
Subject: [PATCH] Fix wrong ID WIDTH in soc/cluster AXI bus

This prevents synthesis
---
 rtl/pulp_soc/pulp_soc.sv | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/rtl/pulp_soc/pulp_soc.sv b/rtl/pulp_soc/pulp_soc.sv
index 4f302a1e..a0f72057 100644
--- a/rtl/pulp_soc/pulp_soc.sv
+++ b/rtl/pulp_soc/pulp_soc.sv
@@ -389,7 +389,7 @@ module pulp_soc
     AXI_BUS_ASYNC #(
         .AXI_ADDR_WIDTH ( AXI_ADDR_WIDTH    ),
         .AXI_DATA_WIDTH ( AXI_DATA_IN_WIDTH ),
-        .AXI_ID_WIDTH   ( AXI_ID_OUT_WIDTH  ),
+        .AXI_ID_WIDTH   ( AXI_ID_IN_WIDTH   ),
         .AXI_USER_WIDTH ( AXI_USER_WIDTH     ),
         .BUFFER_WIDTH   ( BUFFER_WIDTH       )
     ) s_data_slave ();
@@ -397,7 +397,7 @@ module pulp_soc
     AXI_BUS #(
         .AXI_ADDR_WIDTH ( AXI_ADDR_WIDTH    ),
         .AXI_DATA_WIDTH ( AXI_DATA_IN_WIDTH ),
-        .AXI_ID_WIDTH   ( AXI_ID_OUT_WIDTH  ),
+        .AXI_ID_WIDTH   ( AXI_ID_IN_WIDTH   ),
         .AXI_USER_WIDTH ( AXI_USER_WIDTH    )
     ) s_data_in_bus ();
 
