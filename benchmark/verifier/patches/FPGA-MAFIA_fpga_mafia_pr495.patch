From 6bcd01fc339f550739e19ae8a47f30858a92fb0f Mon Sep 17 00:00:00 2001
From: roman022285 <roman329@gmail.com>
Date: Tue, 20 Feb 2024 16:09:52 +0200
Subject: [PATCH 1/2] refactor CSR address from machine to user mode

---
 app/defines/csr.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/app/defines/csr.h b/app/defines/csr.h
index 8665803d..8b93f51b 100644
--- a/app/defines/csr.h
+++ b/app/defines/csr.h
@@ -37,8 +37,8 @@
 // sample relevant csr's for pmon
 void rvc_sample_csr(int *cycle_low, int *instret_low){
 
-    asm volatile ("csrr %0, 0xb00" : "=r" (*cycle_low)); 
-    asm volatile ("csrr %0, 0xb02" : "=r" (*instret_low)); 
+    asm volatile ("csrr %0, 0xC00" : "=r" (*cycle_low)); 
+    asm volatile ("csrr %0, 0xC02" : "=r" (*instret_low)); 
 
 }
 

