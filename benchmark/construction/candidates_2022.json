        "status": "modified",
        "content_base": "#!/bin/bash\nEXT=\nif [ \"$#\" -eq 1 ]; then\n    EXT=_$1\nfi\n\n# run through grc to highlight NOTEs, WARNings and ERRORs\ngrc --config=gw_sh.grc gw_sh ./build${EXT}.tcl\n",
        "content_head": "#!/bin/bash\nEXT=\nif [ \"$#\" -eq 1 ]; then\n    EXT=_$1\nfi\n\necho \"Convert misc/atarist.xml to misc/atarist_xml.hex\"\ncat misc/atarist.xml | gzip | xxd -p -c1 | unix2dos > misc/atarist_xml.hex\n\n\n# run through grc to highlight NOTEs, WARNings and ERRORs\ngrc --config=gw_sh.grc gw_sh ./build${EXT}.tcl\n"
      },
      {
        "filename": "src/misc/atarist.xml",
        "additions": 4,
        "deletions": 0,
        "changes": 4,
        "status": "modified",
        "content_base": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!-- Atari ST configuration -->\n<config name=\"MiSTeryNano\" version=\"0\">\n  <actions>\n    <!-- the init action is being executed immediately -->\n    <!-- when this file has been loaded -->\n    <action name=\"init\">\n      <!-- (try to) load config from sd card -->\n      <load file=\"atarist.ini\"/>\n      <set id=\"R\" value=\"1\"/>  <!-- keep machine in reset -->\n    </action>\n    \n    <!-- the ready action is being executed once all -->\n    <!-- initialization has been done -->\n    <action name=\"ready\">\n      <set id=\"R\" value=\"0\"/>  <!-- release reset -->\n    </action>\n      \n    <action name=\"save\">\n      <!-- save config to sd card -->\n      <save file=\"atarist.ini\"/>\n    </action>\n      \n    <action name=\"reset\">\n      <!-- trigger a system reset -->\n      <set id=\"R\" value=\"1\"/>\n      <delay ms=\"10\"/>\n      <set id=\"R\" value=\"0\"/>      \n    </action>\n    \n    <action name=\"reset_hide\">\n      <!-- trigger a system reset and hide OSD -->\n      <link action=\"reset\"/>\n      <hide/>      \n    </action>      \n\n    <action name=\"cold_reset\">\n      <!-- trigger a cold system reset -->\n      <set id=\"R\" value=\"3\"/>\n      <delay ms=\"10\"/>\n      <set id=\"R\" value=\"0\"/>      \n    </action>\n    \n    <action name=\"cold_reset_hide\">\n      <!-- trigger a cold reset and hide OSD -->\n      <link action=\"cold_reset\"/>\n      <hide/>      \n    </action>\n  </actions>\n  \n  <menu label=\"MiSTeryNano\">\n    <fileselector label=\"Disk A:\" ext=\"st\" index=\"0\"/>\n    <menu label=\"System\">\n      <list label=\"Chipset:\" id=\"C\" default=\"0\" action=\"cold_reset\">\n\t<listentry label=\"ST\" value=\"0\"/>\n\t<listentry label=\"Mega ST\" value=\"1\"/>\n\t<listentry label=\"STE\" value=\"2\"/>\n      </list>\n      <list label=\"Memory:\" id=\"M\" default=\"0\" action=\"cold_reset\">\n\t<listentry label=\"4MB\" value=\"0\"/>\n\t<listentry label=\"8MB\" value=\"1\"/>\n      </list>\n      <list label=\"Video:\" id=\"V\" default=\"0\">\n\t<listentry label=\"Color\" value=\"0\"/>\n\t<listentry label=\"Mono\" value=\"1\"/>\n      </list>\t\n      <list label=\"Cartridge:\" id=\"Q\" default=\"0\">\n\t<listentry label=\"None\" value=\"0\"/>\n\t<listentry label=\"Cubase 2&amp;3\" value=\"1\"/>\n      </list>\n      <list label=\"Mouse:\" id=\"J\" default=\"0\">\n\t<listentry label=\"USB\" value=\"0\"/>\n\t<listentry label=\"Atari ST\" value=\"1\"/>\n\t<listentry label=\"Amiga\" value=\"2\"/>\n      </list>\n      <list label=\"TOS Slot:\" id=\"T\" default=\"0\">\n\t<listentry label=\"Primary\" value=\"0\"/>\n\t<listentry label=\"Secondary\" value=\"1\"/>\n      </list>\n      <button label=\"Cold Boot\" action=\"cold_reset_hide\"/>\n    </menu>\n    <menu label=\"Storage\">\n      <fileselector label=\"Disk A:\" ext=\"st\" index=\"0\" default=\"disk_a.st\"/>\n      <fileselector label=\"Disk B:\" ext=\"st\" index=\"1\" default=\"disk_b.st\"/>\n      <fileselector label=\"ACSI #0:\" ext=\"hd;img\" index=\"2\" default=\"acsi_0.hd\"/>\n      <fileselector label=\"ACSI #1:\" ext=\"hd;img\" index=\"3\" default=\"acsi_1.hd\"/>\n      <list label=\"Disk prot.:\" id=\"P\" default=\"0\">\n\t<listentry label=\"None\" value=\"0\"/>\n\t<listentry label=\"A:\" value=\"1\"/>\n\t<listentry label=\"B:\" value=\"2\"/>\n\t<listentry label=\"Both\" value=\"3\"/>\n      </list>\n    </menu>\n    <menu label=\"Settings\">\n      <list label=\"Screen:\" id=\"W\" default=\"0\">\n\t<listentry label=\"Normal\" value=\"0\"/>\n\t<listentry label=\"Wide\" value=\"1\"/>\n      </list>\n      <list label=\"Scanlines:\" id=\"S\" default=\"0\">\n\t<listentry label=\"None\" value=\"0\"/>\n\t<listentry label=\"25%\" value=\"1\"/>\n\t<listentry label=\"50%\" value=\"2\"/>\n\t<listentry label=\"75%\" value=\"3\"/>\n      </list>\n      <list label=\"Volume:\" id=\"A\" default=\"1\">\n\t<listentry label=\"Mute\" value=\"0\"/>\n\t<listentry label=\"33%\" value=\"1\"/>\n\t<listentry label=\"66%\" value=\"2\"/>\n\t<listentry label=\"100%\" value=\"3\"/>\n      </list>\n      <button label=\"Save settings\" action=\"save\"/>\n    </menu>\n    <button label=\"Reset\" action=\"reset_hide\"/>\n  </menu>    \n</config>\n",
        "content_head": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!-- Atari ST configuration -->\n<config name=\"MiSTeryNano\" version=\"0\">\n  <actions>\n    <!-- the init action is being executed immediately -->\n    <!-- when this file has been loaded -->\n    <action name=\"init\">\n      <!-- (try to) load config from sd card -->\n      <load file=\"atarist.ini\"/>\n      <set id=\"R\" value=\"1\"/>  <!-- keep machine in reset -->\n    </action>\n    \n    <!-- the ready action is being executed once all -->\n    <!-- initialization has been done -->\n    <action name=\"ready\">\n      <set id=\"R\" value=\"0\"/>  <!-- release reset -->\n    </action>\n      \n    <action name=\"save\">\n      <!-- save config to sd card -->\n      <save file=\"atarist.ini\"/>\n    </action>\n      \n    <action name=\"reset\">\n      <!-- trigger a system reset -->\n      <set id=\"R\" value=\"1\"/>\n      <delay ms=\"10\"/>\n      <set id=\"R\" value=\"0\"/>      \n    </action>\n    \n    <action name=\"reset_hide\">\n      <!-- trigger a system reset and hide OSD -->\n      <link action=\"reset\"/>\n      <hide/>      \n    </action>      \n\n    <action name=\"cold_reset\">\n      <!-- trigger a cold system reset -->\n      <set id=\"R\" value=\"3\"/>\n      <delay ms=\"10\"/>\n      <set id=\"R\" value=\"0\"/>      \n    </action>\n    \n    <action name=\"cold_reset_hide\">\n      <!-- trigger a cold reset and hide OSD -->\n      <link action=\"cold_reset\"/>\n      <hide/>      \n    </action>\n  </actions>\n  \n  <menu label=\"MiSTeryNano\">\n    <fileselector label=\"Disk A:\" ext=\"st\" index=\"0\"/>\n    <menu label=\"System\">\n      <list label=\"Chipset:\" id=\"C\" default=\"0\" action=\"cold_reset\">\n\t<listentry label=\"ST\" value=\"0\"/>\n\t<listentry label=\"Mega ST\" value=\"1\"/>\n\t<listentry label=\"STE\" value=\"2\"/>\n      </list>\n      <list label=\"Memory:\" id=\"M\" default=\"0\" action=\"cold_reset\">\n\t<listentry label=\"4MB\" value=\"0\"/>\n\t<listentry label=\"8MB\" value=\"1\"/>\n      </list>\n      <list label=\"Video:\" id=\"V\" default=\"0\">\n\t<listentry label=\"Color\" value=\"0\"/>\n\t<listentry label=\"Mono\" value=\"1\"/>\n      </list>\t\n      <list label=\"Cartridge:\" id=\"Q\" default=\"0\">\n\t<listentry label=\"None\" value=\"0\"/>\n\t<listentry label=\"Cubase 2&amp;3\" value=\"1\"/>\n      </list>\n      <list label=\"Mouse:\" id=\"J\" default=\"0\">\n\t<listentry label=\"USB\" value=\"0\"/>\n\t<listentry label=\"Atari ST\" value=\"1\"/>\n\t<listentry label=\"Amiga\" value=\"2\"/>\n      </list>\n      <list label=\"USB Joy:\" id=\"U\" default=\"1\">\n\t<listentry label=\"Port0/Port1\" value=\"0\"/>\n\t<listentry label=\"Port1/Port0\" value=\"1\"/>\n      </list>\n      <list label=\"TOS Slot:\" id=\"T\" default=\"0\">\n\t<listentry label=\"Primary\" value=\"0\"/>\n\t<listentry label=\"Secondary\" value=\"1\"/>\n      </list>\n      <button label=\"Cold Boot\" action=\"cold_reset_hide\"/>\n    </menu>\n    <menu label=\"Storage\">\n      <fileselector label=\"Disk A:\" ext=\"st\" index=\"0\" default=\"disk_a.st\"/>\n      <fileselector label=\"Disk B:\" ext=\"st\" index=\"1\" default=\"disk_b.st\"/>\n      <fileselector label=\"ACSI #0:\" ext=\"hd;img\" index=\"2\" default=\"acsi_0.hd\"/>\n      <fileselector label=\"ACSI #1:\" ext=\"hd;img\" index=\"3\" default=\"acsi_1.hd\"/>\n      <list label=\"Disk prot.:\" id=\"P\" default=\"0\">\n\t<listentry label=\"None\" value=\"0\"/>\n\t<listentry label=\"A:\" value=\"1\"/>\n\t<listentry label=\"B:\" value=\"2\"/>\n\t<listentry label=\"Both\" value=\"3\"/>\n      </list>\n    </menu>\n    <menu label=\"Settings\">\n      <list label=\"Screen:\" id=\"W\" default=\"0\">\n\t<listentry label=\"Normal\" value=\"0\"/>\n\t<listentry label=\"Wide\" value=\"1\"/>\n      </list>\n      <list label=\"Scanlines:\" id=\"S\" default=\"0\">\n\t<listentry label=\"None\" value=\"0\"/>\n\t<listentry label=\"25%\" value=\"1\"/>\n\t<listentry label=\"50%\"