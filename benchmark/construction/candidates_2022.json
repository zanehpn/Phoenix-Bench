      {
        "filename": "test_benches/verilator/AXI_DDR_simulation/ddr_page.h",
        "additions": 0,
        "deletions": 13,
        "changes": 13,
        "status": "removed",
        "content_base": "#ifndef DDR_PAGEH\n#define DDR_PAGEH\n#include <stdint.h>\n\nclass ddr_page{\n\tpublic:\n\t\tddr_page();\n\t\tuint32_t return_data(int data_address);\n\t\tvoid write_data(int data_address, int data);\n\tprivate:\n\t\tuint32_t data[PAGE_SIZE/4];\n};\n#endif",
