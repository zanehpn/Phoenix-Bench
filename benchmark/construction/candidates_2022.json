  {
    "repo": "chili-chips-ba/openeye-CamSI",
    "pr_number": 26,
    "pr_title": "Added raw10 support and 4-lane simulation",
    "pr_url": "https://github.com/chili-chips-ba/openeye-CamSI/pull/26",
    "merged_at": "2024-09-02T01:31:49Z",
    "author": "Juninho99",
