  {
    "repo": "openhwgroup/cva5",
    "pr_number": 7,
    "pr_title": "L2: Move be (i.e. wstrb for AXI) into the data FIFO (Fixes #6)",
    "pr_url": "https://github.com/openhwgroup/cva5/pull/7",
    "merged_at": "2023-04-18T17:24:14Z",
