    ],
    "base_sha": "47f4ec8f1d823eb46055be71cc026d85d0122d93",
    "head_sha": "2c24d4b737956e57f3a3c2da6d7ffbbdf96f963d",
    "snapshot_tarball": "snapshots/microsoft_cheriot-ibex_47f4ec8f1d823eb46055be71cc026d85d0122d93.tar.gz",
    "patch_path": "patches/microsoft_cheriot-ibex_pr81.patch"
