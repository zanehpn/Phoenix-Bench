  {
    "repo": "chipsalliance/caliptra-rtl",
    "pr_number": 1102,
    "pr_title": "[DOC] Add release notes for 2.0.2 and apply 2.1 documentation updates",
    "pr_url": "https://github.com/chipsalliance/caliptra-rtl/pull/1102",
    "merged_at": "2025-10-30T22:28:59Z",
    "author": "calebofearth",
