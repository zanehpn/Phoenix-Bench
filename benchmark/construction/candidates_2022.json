src/integration/test_suites/fw_test_lms_n24_w1_h15/fw_test_lms_n24_w1_h15.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w1_h20/fw_test_lms_n24_w1_h20.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w2_h5/fw_test_lms_n24_w2_h5.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w2_h10/fw_test_lms_n24_w2_h10.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w2_h15/fw_test_lms_n24_w2_h15.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w2_h20/fw_test_lms_n24_w2_h20.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w4_h5/fw_test_lms_n24_w4_h5.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w4_h10/fw_test_lms_n24_w4_h10.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w4_h15/fw_test_lms_n24_w4_h15.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w4_h20/fw_test_lms_n24_w4_h20.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w8_h5/fw_test_lms_n24_w8_h5.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w8_h10/fw_test_lms_n24_w8_h10.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w8_h15/fw_test_lms_n24_w8_h15.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n24_w8_h20/fw_test_lms_n24_w8_h20.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w1_h5/fw_test_lms_n32_w1_h5.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w1_h10/fw_test_lms_n32_w1_h10.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w1_h15/fw_test_lms_n32_w1_h15.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w1_h20/fw_test_lms_n32_w1_h20.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w2_h5/fw_test_lms_n32_w2_h5.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w2_h10/fw_test_lms_n32_w2_h10.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w2_h15/fw_test_lms_n32_w2_h15.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w2_h20/fw_test_lms_n32_w2_h20.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w4_h5/fw_test_lms_n32_w4_h5.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w4_h10/fw_test_lms_n32_w4_h10.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w4_h15/fw_test_lms_n32_w4_h15.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w4_h20/fw_test_lms_n32_w4_h20.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w8_h5/fw_test_lms_n32_w8_h5.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w8_h10/fw_test_lms_n32_w8_h10.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w8_h15/fw_test_lms_n32_w8_h15.yml\n        - ${CALIPTRA_ROOT}/src/integration/test_suites/fw_test_lms_n32_w8_h20/fw_test_lms_n32_w8_h20.yml\n"
