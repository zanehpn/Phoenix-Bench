        "content_base": "+incdir+${JG_CVA5_RTL_PATH}\\\n${JG_CVA5_RTL_PATH}/core/cva5_config.sv \\\n${JG_CVA5_RTL_PATH}/core/riscv_types.sv \\\n${JG_CVA5_RTL_PATH}/core/cva5_types.sv \\\n${JG_CVA5_RTL_PATH}/l2_arbiter/l2_config_and_types.sv \\\n${JG_CVA5_RTL_PATH}/l2_arbiter/l2_interfaces.sv \\\n${JG_CVA5_RTL_PATH}/l2_arbiter/l2_external_interfaces.sv \\\n${JG_CVA5_RTL_PATH}/local_memory/local_memory_interface.sv \\\n${JG_CVA5_RTL_PATH}/local_memory/local_mem.sv \\\n${JG_CVA5_RTL_PATH}/core/interfaces.sv \\\n${JG_CVA5_RTL_PATH}/core/external_interfaces.sv \\\n${JG_CVA5_RTL_PATH}/core/csr_types.sv \\\n${JG_CVA5_RTL_PATH}/core/csr_regs.sv \\\n${JG_CVA5_RTL_PATH}/core/gc_unit.sv \\\n${JG_CVA5_RTL_PATH}/core/branch_comparator.sv \\\n${JG_CVA5_RTL_PATH}/core/branch_unit.sv \\\n${JG_CVA5_RTL_PATH}/core/barrel_shifter.sv \\\n${JG_CVA5_RTL_PATH}/core/alu_unit.sv \\\n${JG_CVA5_RTL_PATH}/core/axi_master.sv \\\n${JG_CVA5_RTL_PATH}/core/avalon_master.sv \\\n${JG_CVA5_RTL_PATH}/core/wishbone_master.sv \\\n${JG_CVA5_RTL_PATH}/core/axi_to_arb.sv \\\n${JG_CVA5_RTL_PATH}/core/one_hot_occupancy.sv \\\n${JG_CVA5_RTL_PATH}/core/binary_occupancy.sv \\\n${JG_CVA5_RTL_PATH}/core/cva5_fifo.sv \\\n${JG_CVA5_RTL_PATH}/core/shift_counter.sv \\\n${JG_CVA5_RTL_PATH}/core/set_clr_reg_with_rst.sv \\\n${JG_CVA5_RTL_PATH}/core/intel/intel_byte_enable_ram.sv \\\n${JG_CVA5_RTL_PATH}/core/xilinx/xilinx_byte_enable_ram.sv \\\n${JG_CVA5_RTL_PATH}/core/byte_en_BRAM.sv \\\n${JG_CVA5_RTL_PATH}/core/one_hot_to_integer.sv \\\n${JG_CVA5_RTL_PATH}/core/cycler.sv \\\n${JG_CVA5_RTL_PATH}/core/tag_bank.sv \\\n${JG_CVA5_RTL_PATH}/core/dbram.sv \\\n${JG_CVA5_RTL_PATH}/core/ddata_bank.sv \\\n${JG_CVA5_RTL_PATH}/core/dtag_banks.sv \\\n${JG_CVA5_RTL_PATH}/core/amo_alu.sv \\\n${JG_CVA5_RTL_PATH}/core/dcache.sv \\\n${JG_CVA5_RTL_PATH}/core/addr_hash.sv \\\n${JG_CVA5_RTL_PATH}/core/load_queue.sv \\\n${JG_CVA5_RTL_PATH}/core/store_queue.sv \\\n${JG_CVA5_RTL_PATH}/core/load_store_queue.sv \\\n${JG_CVA5_RTL_PATH}/core/load_store_unit.sv \\\n${JG_CVA5_RTL_PATH}/core/ibram.sv \\\n${JG_CVA5_RTL_PATH}/core/itag_banks.sv \\\n${JG_CVA5_RTL_PATH}/core/icache.sv \\\n${JG_CVA5_RTL_PATH}/core/div_algorithms/div_radix2.sv \\\n${JG_CVA5_RTL_PATH}/core/clz.sv \\\n${JG_CVA5_RTL_PATH}/core/div_algorithms/div_quick_clz.sv \\\n${JG_CVA5_RTL_PATH}/core/div_algorithms/div_algorithm.sv \\\n${JG_CVA5_RTL_PATH}/core/div_unit.sv \\\n${JG_CVA5_RTL_PATH}/core/lut_ram.sv \\\n${JG_CVA5_RTL_PATH}/core/tlb_lut_ram.sv \\\n${JG_CVA5_RTL_PATH}/core/mmu.sv \\\n${JG_CVA5_RTL_PATH}/core/mul_unit.sv \\\n${JG_CVA5_RTL_PATH}/core/l1_arbiter.sv \\\n${JG_CVA5_RTL_PATH}/core/ras.sv \\\n${JG_CVA5_RTL_PATH}/core/branch_predictor_ram.sv \\\n${JG_CVA5_RTL_PATH}/core/branch_predictor.sv \\\n${JG_CVA5_RTL_PATH}/core/fetch.sv \\\n${JG_CVA5_RTL_PATH}/core/illegal_instruction_checker.sv \\\n${JG_CVA5_RTL_PATH}/core/decode_and_issue.sv \\\n${JG_CVA5_RTL_PATH}/core/regfile_bank_sel.sv \\\n${JG_CVA5_RTL_PATH}/core/register_file.sv \\\n${JG_CVA5_RTL_PATH}/core/register_file_and_writeback.sv \\\n${JG_CVA5_RTL_PATH}/core/placer_randomizer.sv \\\n${JG_CVA5_RTL_PATH}/l2_arbiter/l2_fifo.sv \\\n${JG_CVA5_RTL_PATH}/l2_arbiter/l2_reservation_logic.sv \\\n${JG_CVA5_RTL_PATH}/l2_arbiter/l2_round_robin.sv \\\n${JG_CVA5_RTL_PATH}/l2_arbiter/l2_arbiter.sv \\\n${JG_CVA5_RTL_PATH}/core/toggle_memory.sv \\\n${JG_CVA5_RTL_PATH}/core/instruction_metadata_and_id_management.sv \\\n${JG_CVA5_RTL_PATH}/core/cva5.sv \\\n",
